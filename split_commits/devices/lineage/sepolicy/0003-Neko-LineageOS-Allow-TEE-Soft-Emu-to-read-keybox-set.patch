From 8bf85f6b3749c717d02ed719e98d36e581b115c9 Mon Sep 17 00:00:00 2001
From: WeiguangTWK <weiguangtwk@outlook.com>
Date: Wed, 1 Jul 2026 17:07:20 +0800
Subject: [PATCH] Neko LineageOS: Allow TEE Soft Emu to read keybox & setting
 profile

Change-Id: I42d3851042e9e54797b6c235068840cfa0b99ad2
---
 common/private/keystore.te                    | 4 ++++
 common/private/tee_soft_emulate_app_access.te | 9 +++++++++
 2 files changed, 13 insertions(+)
 create mode 100644 common/private/keystore.te
 create mode 100644 common/private/tee_soft_emulate_app_access.te

diff --git a/common/private/keystore.te b/common/private/keystore.te
new file mode 100644
index 0000000..265ae73
--- /dev/null
+++ b/common/private/keystore.te
@@ -0,0 +1,4 @@
+# TEE soft debug support in keystore2:
+# - Read user-provided keybox XML and runtime config from /data/adbroot.
+allow keystore adbroot_data_file:dir search;
+allow keystore adbroot_data_file:file r_file_perms;
diff --git a/common/private/tee_soft_emulate_app_access.te b/common/private/tee_soft_emulate_app_access.te
new file mode 100644
index 0000000..577b81b
--- /dev/null
+++ b/common/private/tee_soft_emulate_app_access.te
@@ -0,0 +1,9 @@
+# TEE soft emulate runtime files under /data/adbroot.
+allow platform_app adbroot_data_file:dir create_dir_perms;
+allow platform_app adbroot_data_file:file create_file_perms;
+allow system_app adbroot_data_file:dir create_dir_perms;
+allow system_app adbroot_data_file:file create_file_perms;
+
+# Keep nhoverride global switch in sync with TEE soft emulate toggle.
+set_prop(platform_app, nhoverride_prop)
+set_prop(system_app, nhoverride_prop)
-- 
2.43.0

