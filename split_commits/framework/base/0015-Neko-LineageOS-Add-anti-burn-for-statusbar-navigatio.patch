+    private void scheduleStatusBarBurnInProtection(long delayMillis) {
+        if (!mStatusBarScreenOnBurnInProtectionEnabled || mStatusBar == null) {
+            return;
+        }
+        mStatusBar.removeCallbacks(mUpdateStatusBarBurnInProtection);
+        mStatusBar.postDelayed(mUpdateStatusBarBurnInProtection, delayMillis);
+    }
+
+    private void cancelStatusBarBurnInProtection() {
+        if (mStatusBar == null) {
+            return;
+        }
+        mStatusBar.removeCallbacks(mUpdateStatusBarBurnInProtection);
+        applyStatusBarBurnInOffsets(0, 0);
+    }
+
+    private void updateStatusBarBurnInOffsets() {
+        if (!mStatusBarScreenOnBurnInProtectionEnabled || mStatusBar == null) {
+            return;
+        }
+        if (!shouldApplyStatusBarBurnInProtection()) {
+            applyStatusBarBurnInOffsets(0, 0);
+            scheduleStatusBarBurnInProtection(mScreenOnBurnInProtectionStartDelayMillis);
+            return;
+        }
+
+        applyStatusBarBurnInOffsets(
+                getCurrentStatusBarBurnInOffset(mStatusBarScreenOnBurnInOffsetX, true),
+                getCurrentStatusBarBurnInOffset(mStatusBarScreenOnBurnInOffsetY, false));
+        scheduleStatusBarBurnInProtection(mScreenOnBurnInProtectionUpdateIntervalMillis);
+    }
+
+    private boolean shouldApplyStatusBarBurnInProtection() {
+        return isResumed()
+                && mStatusBar.isAttachedToWindow()
+                && mStatusBar.getDisplay() != null
+                && mStatusBar.getDisplay().getState() == Display.STATE_ON
+                && !mKeyguardStateController.isShowing()
+                && !mStatusBarStateController.isDozing()
+                && mShadeExpansionStateManager.isClosed();
+    }
+
+    private int getCurrentBurnInOffset(int amplitude, boolean xAxis) {
+        if (amplitude <= 0) {
+            return 0;
+        }
+        return getBurnInOffset(amplitude, xAxis) - (amplitude / 2);
+    }
+
+    private int getCurrentStatusBarBurnInOffset(int amplitude, boolean xAxis) {
+        return mStatusBarScreenOnBurnInProtectionEnabled && shouldApplyStatusBarBurnInProtection()
+                ? getCurrentBurnInOffset(amplitude, xAxis) : 0;
+    }
+
+    private void applyStatusBarBurnInOffsets(int offsetX, int offsetY) {
+        if (mClockView != null) {
+            mClockView.setTranslationX(offsetX);
+            mClockView.setTranslationY(offsetY);
+        }
+        if (mNotificationIconAreaInner != null) {
+            mNotificationIconAreaInner.setTranslationX(offsetX);
+            mNotificationIconAreaInner.setTranslationY(offsetY);
+        }
+        if (mEndSideContent != null) {
+            mEndSideContent.setTranslationX(mSystemEventTranslationX + offsetX);
+            mEndSideContent.setTranslationY(offsetY);
+        }
+    }
+
     private final ContentObserver mVolumeSettingObserver = new ContentObserver(null) {
         @Override
         public void onChange(boolean selfChange) {
