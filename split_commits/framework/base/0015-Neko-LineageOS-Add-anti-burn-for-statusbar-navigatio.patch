@@ -1477,6 +1502,20 @@ public class NavigationBar extends ViewController<NavigationBarView> implements
     }
 
     private boolean onNavigationTouch(View v, MotionEvent event) {
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                mNavigationTouchActive = true;
+                applyNavigationHandleBurnInOffsets(0, 0);
+                break;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                mNavigationTouchActive = false;
+                mLastNavigationInteractionTimeMillis = System.currentTimeMillis();
+                break;
+            default:
+                break;
+        }
+        updateNavigationHandleBurnInProtection();
         if (mAutoHideController != null) {
             mAutoHideController.checkUserAutoHide(event);
         }
@@ -2076,9 +2115,80 @@ public class NavigationBar extends ViewController<NavigationBarView> implements
                 resetSecondaryHandle();
             }
             mView.setShouldShowSwipeUpUi(mLauncherProxyService.shouldShowSwipeUpUI());
+            mLastNavigationInteractionTimeMillis = System.currentTimeMillis();
+            updateNavigationHandleBurnInProtection();
         }
     };
 
+    private final Runnable mUpdateNavigationHandleBurnInProtection = new Runnable() {
+        @Override
+        public void run() {
+            updateNavigationHandleBurnInProtection();
+        }
+    };
+
+    private void scheduleNavigationHandleBurnInProtection(long delayMillis) {
+        if (!mNavHandleScreenOnBurnInProtectionEnabled) {
+            return;
+        }
+        mHandler.removeCallbacks(mUpdateNavigationHandleBurnInProtection);
+        mHandler.postDelayed(mUpdateNavigationHandleBurnInProtection, delayMillis);
+    }
+
+    private void cancelNavigationHandleBurnInProtection() {
+        mHandler.removeCallbacks(mUpdateNavigationHandleBurnInProtection);
+        applyNavigationHandleBurnInOffsets(0, 0);
+    }
+
+    private void updateNavigationHandleBurnInProtection() {
+        if (!mNavHandleScreenOnBurnInProtectionEnabled || mView == null) {
+            return;
+        }
+
+        if (!shouldApplyNavigationHandleBurnInProtection()) {
+            applyNavigationHandleBurnInOffsets(0, 0);
+            scheduleNavigationHandleBurnInProtection(mScreenOnBurnInProtectionStartDelayMillis);
+            return;
+        }
+
+        final long idleDuration = System.currentTimeMillis() - mLastNavigationInteractionTimeMillis;
+        if (idleDuration < mScreenOnBurnInProtectionStartDelayMillis) {
+            applyNavigationHandleBurnInOffsets(0, 0);
+            scheduleNavigationHandleBurnInProtection(
+                    mScreenOnBurnInProtectionStartDelayMillis - idleDuration);
+            return;
+        }
+
+        applyNavigationHandleBurnInOffsets(
+                getCurrentBurnInOffset(mNavHandleScreenOnBurnInOffsetX, true),
+                getCurrentBurnInOffset(mNavHandleScreenOnBurnInOffsetY, false));
+        scheduleNavigationHandleBurnInProtection(mScreenOnBurnInProtectionUpdateIntervalMillis);
+    }
+
+    private boolean shouldApplyNavigationHandleBurnInProtection() {
+        return mView.isAttachedToWindow()
+                && mIsScreenOn
+                && mNavigationBarWindowState == WINDOW_STATE_SHOWING
+                && isGesturalMode(mNavBarMode)
+                && !mNavigationTouchActive
+                && !mImeVisible
+                && mView.getVisibility() == View.VISIBLE;
+    }
+
+    private int getCurrentBurnInOffset(int amplitude, boolean xAxis) {
+        if (amplitude <= 0) {
+            return 0;
+        }
+        return getBurnInOffset(amplitude, xAxis) - (amplitude / 2);
+    }
+
+    private void applyNavigationHandleBurnInOffsets(int offsetX, int offsetY) {
+        if (mView == null) {
+            return;
+        }
+        mView.getHomeHandle().setTranslation(offsetX, offsetY, 0);
+    }
+
     private final Gefingerpoken mTouchHandler = new Gefingerpoken() {
         private boolean mDeadZoneConsuming;
 
