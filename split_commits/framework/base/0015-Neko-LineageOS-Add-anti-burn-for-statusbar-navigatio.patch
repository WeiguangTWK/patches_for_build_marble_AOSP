From 7bd71f10904a7dc195e710c5e43eec12e5b1b23e Mon Sep 17 00:00:00 2001
From: WeiguangTWK <weiguangtwk@outlook.com>
Date: Mon, 6 Jul 2026 09:05:29 +0800
Subject: [PATCH] Neko LineageOS: Add anti-burn for statusbar & navigation bar

To enable this feature, you also need to enable config_enableNavHandleScreenOnBurnInProtection & config_enableStatusBarScreenOnBurnInProtection

Change-Id: I9496f89262cebc68577496c13a422e29c1d1ee7e
---
 packages/SystemUI/res/values/config.xml       |  12 ++
 packages/SystemUI/res/values/dimens.xml       |  12 ++
 .../navigationbar/views/NavigationBar.java    | 110 ++++++++++++++++++
 .../fragment/CollapsedStatusBarFragment.java  | 106 ++++++++++++++++-
 4 files changed, 238 insertions(+), 2 deletions(-)

diff --git a/packages/SystemUI/res/values/config.xml b/packages/SystemUI/res/values/config.xml
index 81238bf13..01b4b91f3 100644
--- a/packages/SystemUI/res/values/config.xml
+++ b/packages/SystemUI/res/values/config.xml
@@ -50,6 +50,18 @@
     <!-- Whether or not long-pressing on keyguard will display to customize lockscreen -->
     <bool name="long_press_keyguard_customize_lockscreen_enabled">false</bool>
 
+    <!-- Whether to apply burn-in protection to the ordinary screen-on status bar. -->
+    <bool name="config_enableStatusBarScreenOnBurnInProtection">false</bool>
+
+    <!-- Whether to apply burn-in protection to the ordinary screen-on navigation handle. -->
+    <bool name="config_enableNavHandleScreenOnBurnInProtection">false</bool>
+
+    <!-- Delay before screen-on burn-in protection starts moving persistent UI after activity. -->
+    <integer name="config_screenOnBurnInProtectionStartDelayMillis">20000</integer>
+
+    <!-- Update interval for screen-on burn-in protection. -->
+    <integer name="config_screenOnBurnInProtectionUpdateIntervalMillis">60000</integer>
+
     <bool name="config_dead_zone_flash">false</bool>
 
     <!-- Whether to enable dimming navigation buttons when wallpaper is not visible, should be
