+package com.android.server;
+
+import android.content.Context;
+
+import miui.os.IMiuiInit;
+import miui.os.MiuiInit;
+
+/**
+ * Empty compatibility Binder published for MIUI clients.
+ */
+public class MiuiInitService extends IMiuiInit.Stub {
+    public static final class Lifecycle extends SystemService {
+        private MiuiInitService mService;
+
+        public Lifecycle(Context context) {
+            super(context);
+        }
+
+        @Override
+        public void onStart() {
+            mService = new MiuiInitService();
+            publishBinderService(MiuiInit.SERVICE_NAME, mService);
+        }
+    }
+}
