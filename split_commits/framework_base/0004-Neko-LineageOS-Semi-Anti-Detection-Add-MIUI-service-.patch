+package miui.os;
+
+import android.os.IBinder;
+import android.os.ServiceManager;
+import android.util.Singleton;
+
+/**
+ * Compatibility wrapper around the MIUI init Binder service.
+ *
+ * @hide
+ */
+public class MiuiInit {
+    public static final String SERVICE_NAME = "MiuiInit";
+
+    private static final Singleton<IMiuiInit> IMiuiInitSingleton =
+            new Singleton<IMiuiInit>() {
+                @Override
+                protected IMiuiInit create() {
+                    final IBinder b = ServiceManager.getService(SERVICE_NAME);
+                    return IMiuiInit.Stub.asInterface(b);
+                }
+            };
+
+    /** @hide */
+    public static IMiuiInit getService() {
+        return IMiuiInitSingleton.get();
+    }
+
+    private MiuiInit() {
+    }
+}
