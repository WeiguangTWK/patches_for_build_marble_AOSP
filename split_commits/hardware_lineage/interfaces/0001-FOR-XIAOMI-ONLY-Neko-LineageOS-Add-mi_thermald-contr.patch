+bool FastCharge::isBatteryPowerSupplyEvent(const char* msg, ssize_t len) const {
+    bool isPowerSupply = false;
+    bool isBattery = false;
+    const char* end = msg + len;
+
+    for (const char* entry = msg; entry < end && *entry != '\0'; entry += std::strlen(entry) + 1) {
+        std::string_view value(entry);
+        if (value == "SUBSYSTEM=power_supply") {
+            isPowerSupply = true;
+        } else if (value == "POWER_SUPPLY_NAME=battery" ||
+                   value.find("/power_supply/battery") != std::string_view::npos) {
+            isBattery = true;
+        }
+    }
+
+    return isPowerSupply && isBattery;
+}
