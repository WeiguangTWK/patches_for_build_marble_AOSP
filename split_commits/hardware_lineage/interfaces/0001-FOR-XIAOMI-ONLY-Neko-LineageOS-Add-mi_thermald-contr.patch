+std::optional<std::vector<uint8_t>> decodeHex(std::string_view input) {
+    std::vector<uint8_t> output;
+    output.reserve(input.size() / 2);
+
+    int highNibble = -1;
+    for (char ch : input) {
+        if (std::isspace(static_cast<unsigned char>(ch))) {
+            continue;
+        }
+
+        int nibble = 0;
+        if (ch >= '0' && ch <= '9') {
+            nibble = ch - '0';
+        } else if (ch >= 'a' && ch <= 'f') {
+            nibble = ch - 'a' + 10;
+        } else if (ch >= 'A' && ch <= 'F') {
+            nibble = ch - 'A' + 10;
+        } else {
+            LOG(ERROR) << "Invalid hex character: " << ch;
+            return {};
+        }
+
+        if (highNibble < 0) {
+            highNibble = nibble;
+            continue;
+        }
+
+        output.push_back(static_cast<uint8_t>((highNibble << 4) | nibble));
+        highNibble = -1;
+    }
+
+    if (highNibble >= 0) {
+        LOG(ERROR) << "Odd-length hex payload";
+        return {};
+    }
+
+    return output;
+}
+
+bool writeBlobAtomically(const char* path, const std::vector<uint8_t>& payload) {
+    std::string tempPath(path);
+    tempPath += ".tmp";
+
+    std::string content(reinterpret_cast<const char*>(payload.data()), payload.size());
+    if (!android::base::WriteStringToFile(content, tempPath)) {
+        PLOG(ERROR) << "Failed to write temporary file " << tempPath;
+        unlink(tempPath.c_str());
+        return false;
+    }
+
+    if (rename(tempPath.c_str(), path) < 0) {
+        PLOG(ERROR) << "rename failed for " << path;
+        unlink(tempPath.c_str());
+        return false;
+    }
+
+    return true;
+}
+
+bool deleteFileIfPresent(const char* path) {
+    if (unlink(path) == 0 || errno == ENOENT) {
+        return true;
+    }
+
+    PLOG(ERROR) << "unlink failed for " << path;
+    return false;
+}
