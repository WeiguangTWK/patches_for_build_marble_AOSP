+void FastCharge::monitorUevents() {
+    int ueventFd = uevent_open_socket(64 * 1024, true);
+    if (ueventFd < 0) {
+        PLOG(ERROR) << "uevent_open_socket failed";
+        return;
+    }
+
+    int epollFd = epoll_create1(EPOLL_CLOEXEC);
+    if (epollFd < 0) {
+        PLOG(ERROR) << "epoll_create1 failed";
+        close(ueventFd);
+        return;
+    }
+
+    epoll_event event = {
+            .events = EPOLLIN,
+            .data = {.fd = ueventFd},
+    };
+    if (epoll_ctl(epollFd, EPOLL_CTL_ADD, ueventFd, &event) < 0) {
+        PLOG(ERROR) << "epoll_ctl failed";
+        close(epollFd);
+        close(ueventFd);
+        return;
+    }
+
+    while (true) {
+        epoll_event events[1];
+        int eventCount = epoll_wait(epollFd, events, 1, -1);
+        if (eventCount < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            PLOG(ERROR) << "epoll_wait failed";
+            break;
+        }
+
+        char msg[4096 + 2] = {};
+        ssize_t len = recv(ueventFd, msg, sizeof(msg), 0);
+        if (len <= 0) {
+            if (errno != EINTR) {
+                PLOG(ERROR) << "recv failed";
+            }
+            continue;
+        }
+
+        if (!isBatteryPowerSupplyEvent(msg, len)) {
+            continue;
+        }
+
+        std::lock_guard lock(mLock);
+        reconcileLocked();
+    }
+
+    close(epollFd);
+    close(ueventFd);
 }
 
