+bool FastCharge::applyMarbleModeLocked(FastChargeMode mode) {
+    if (mode == FastChargeMode::NONE) {
+        return restoreMarbleDefaultLocked();
+    }
+
+    if (mode != FastChargeMode::FAST_CHARGE) {
+        LOG(ERROR) << "Unsupported marble fast charge mode: " << static_cast<int>(mode);
+        return false;
+    }
+
+    if (mAppliedMode && *mAppliedMode == mode) {
+        return true;
+    }
+
+    if (!writeMarbleThermalOverrideLocked()) {
+        return false;
+    }
+
+    if (!restartMarbleThermalDaemonLocked()) {
+        LOG(WARNING) << "Marble thermal override applied without daemon restart";
+    }
+
+    if (!kickMarbleChargeCurrentLimitLocked()) {
+        LOG(WARNING) << "Marble thermal override applied without FCC kick";
+    }
+
+    mAppliedMode = mode;
+    return true;
+}
+
+bool FastCharge::restoreMarbleDefaultLocked() {
+    bool ok = true;
+
+    for (const auto& entry : kMarbleSceneOverrides) {
+        ok = deleteFileIfPresent(entry.path) && ok;
+    }
+
+    // Clean up legacy marble overrides from the previous implementation.
+    ok = deleteFileIfPresent(kMarbleThermalMapPath) && ok;
+    ok = deleteFileIfPresent(kMarbleThermalOdmMapPath) && ok;
+
+    if (!ok) {
+        return false;
+    }
+
+    if (!restartMarbleThermalDaemonLocked()) {
+        LOG(WARNING) << "Marble thermal override removed without daemon restart";
+    }
+
+    mAppliedMode = FastChargeMode::NONE;
+    return true;
+}
+
+bool FastCharge::writeMarbleThermalOverrideLocked() {
+    if (!ensureDirExists("/data/vendor/thermal") || !ensureDirExists(kMarbleThermalConfigDir)) {
+        return false;
+    }
+
+    bool ok = true;
+    for (const auto& entry : kMarbleSceneOverrides) {
+        auto payload = decodeHex(entry.payloadHex);
+        if (!payload) {
+            LOG(ERROR) << "Failed to decode marble scene payload for " << entry.path;
+            return false;
+        }
+        ok = writeBlobAtomically(entry.path, *payload) && ok;
+    }
+
+    return ok;
+}
+
+bool FastCharge::restartMarbleThermalDaemonLocked() {
+    if (!android::base::SetProperty("ctl.stop", kMarbleThermalDaemonService)) {
+        LOG(WARNING) << "Failed to stop " << kMarbleThermalDaemonService;
+        return false;
+    }
+
+    std::this_thread::sleep_for(std::chrono::seconds(1));
+
+    if (!android::base::SetProperty("ctl.start", kMarbleThermalDaemonService)) {
+        LOG(WARNING) << "Failed to start " << kMarbleThermalDaemonService;
+        return false;
+    }
+
+    std::this_thread::sleep_for(std::chrono::seconds(1));
+    LOG(INFO) << "Restarted " << kMarbleThermalDaemonService;
+    return true;
+}
+
+bool FastCharge::kickMarbleChargeCurrentLimitLocked() {
+    if (!pathExists(kMarbleConstantChargeCurrentPath)) {
+        LOG(WARNING) << "Marble FCC kick node missing: " << kMarbleConstantChargeCurrentPath;
+        return false;
+    }
+
+    if (!android::base::WriteStringToFile(kMarbleFastChargeCurrentValue,
+                                          kMarbleConstantChargeCurrentPath)) {
+        PLOG(WARNING) << "Failed to kick marble FCC override";
+        return false;
+    }
+
+    LOG(INFO) << "Requested marble FCC override: " << kMarbleFastChargeCurrentValue;
+    return true;
+}
+
+std::optional<std::string> FastCharge::readMarbleChargeCurrentLimit() const {
+    if (!pathExists(kMarbleConstantChargeCurrentPath)) {
