From ed465ff46db20ccf11cd3dd0d10547f6a13983df Mon Sep 17 00:00:00 2001
From: WeiguangTWK <weiguangtwk@outlook.com>
Date: Thu, 12 Nov 2026 14:26:25 +0800
Subject: [PATCH] Neko LineageOS: Prepare for Adreno driver 837.0.7

Add proprietary file entries for the split OpenCL backend and compiler,
and include the 32-bit Vulkan driver.

Label libOpenCL_adreno as same_process_hal_file for both architectures.

Update the Vulkan API declaration to 1.3 after confirming that Marble
reports Vulkan 1.3.295 with the new driver. Keep the existing hardware
level, compute level and dEQP declarations.

Change-Id: I124e3e15e2758daf146760d6043aa91cf13edb02
---
 common.mk                     | 2 +-
 proprietary-files.txt         | 5 +++++
 sepolicy/vendor/file_contexts | 3 +++
 3 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/common.mk b/common.mk
index 112a7ef..1e6a1df 100644
--- a/common.mk
+++ b/common.mk
@@ -205,7 +205,7 @@ PRODUCT_COPY_FILES += \
     frameworks/native/data/etc/android.hardware.opengles.aep.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.opengles.aep.xml \
     frameworks/native/data/etc/android.hardware.vulkan.compute-0.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.vulkan.compute-0.xml \
     frameworks/native/data/etc/android.hardware.vulkan.level-1.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.vulkan.level-1.xml \
-    frameworks/native/data/etc/android.hardware.vulkan.version-1_1.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.vulkan.version-1_1.xml \
+    frameworks/native/data/etc/android.hardware.vulkan.version-1_3.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.vulkan.version-1_3.xml \
     frameworks/native/data/etc/android.software.opengles.deqp.level-2021-03-01.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.software.opengles.deqp.level.xml \
     frameworks/native/data/etc/android.software.vulkan.deqp.level-2021-03-01.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.software.vulkan.deqp.level.xml
 
diff --git a/proprietary-files.txt b/proprietary-files.txt
index 185e66b..d7444e2 100644
--- a/proprietary-files.txt
+++ b/proprietary-files.txt
@@ -354,7 +354,9 @@ vendor/lib/egl/libq3dtools_adreno.so;SYMLINK=vendor/lib/libq3dtools_adreno.so
 vendor/lib/egl/libq3dtools_esx.so
 vendor/lib/libCB.so
 vendor/lib/libOpenCL.so
+vendor/lib/libOpenCL_adreno.so
 vendor/lib/libadreno_app_profiles.so
+vendor/lib/libadreno_compiler_cl.so
 vendor/lib/libadreno_utils.so
 vendor/lib/libgpudataproducer.so
 vendor/lib/libgsl.so
@@ -372,7 +374,9 @@ vendor/lib64/egl/libq3dtools_adreno.so;SYMLINK=vendor/lib64/libq3dtools_adreno.s
 vendor/lib64/egl/libq3dtools_esx.so
 vendor/lib64/libCB.so
 vendor/lib64/libOpenCL.so
+vendor/lib64/libOpenCL_adreno.so
 vendor/lib64/libadreno_app_profiles.so
+vendor/lib64/libadreno_compiler_cl.so
 vendor/lib64/libadreno_utils.so
 vendor/lib64/libgpudataproducer.so
 vendor/lib64/libgsl.so
@@ -389,6 +393,7 @@ vendor/firmware/a730_sqe.fw
 vendor/firmware/gmu_gen70000.bin
 
 # Graphics (Vulkan)
+vendor/lib/hw/vulkan.adreno.so
 vendor/lib64/hw/vulkan.adreno.so
 
 # Hotword Enrollment
diff --git a/sepolicy/vendor/file_contexts b/sepolicy/vendor/file_contexts
index 64f1704..9fd0c57 100644
--- a/sepolicy/vendor/file_contexts
+++ b/sepolicy/vendor/file_contexts
@@ -47,6 +47,9 @@
 /mnt/vendor/persist/goodix(/.*)? u:object_r:vendor_fingerprint_data_file:s0
 /(vendor|system/vendor)/bin/hw/android\.hardware\.biometrics\.fingerprint-service\.xiaomi u:object_r:hal_fingerprint_default_exec:s0
 
+# Graphics
+/vendor/lib(64)?/libOpenCL_adreno\.so u:object_r:same_process_hal_file:s0
+
 # Frame-aware scheduling
 /(vendor|system/vendor)/bin/fasqtid u:object_r:fasqtid_exec:s0
 
-- 
2.43.0

