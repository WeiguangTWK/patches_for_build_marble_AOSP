+    ndk::ScopedAStatus stopWithPolicy(const std::string& policyIdentity, int32_t* result) override {
+        if (AIBinder_getCallingUid() != kSystemUid)
+            return ndk::ScopedAStatus::fromExceptionCode(EX_SECURITY);
+        std::scoped_lock lock(mMutex);
+        const auto current = integrity::currentPermit();
