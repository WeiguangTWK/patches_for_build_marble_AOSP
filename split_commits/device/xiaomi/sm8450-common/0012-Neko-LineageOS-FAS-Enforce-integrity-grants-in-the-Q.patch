@@ -0,0 +1,235 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Sequential host-control specification; no vendor calls, clocks or permissions."""
+
+from dataclasses import dataclass
+from enum import Enum, auto
+
+
+MAX_COUNTER = (1 << 64) - 1
+MAX_ORDER = (1 << 63) - 1  # AIDL long / native int64_t
+
+
+@dataclass(frozen=True)
+class Time:
+    boot_ms: int
+    mono_ms: int
+
+
+@dataclass(frozen=True)
+class Request:
+    instance: str
+    revision: int
+    generation: int
+    sequence: int
+    deadline_ms: int
+
+
+class Deadlines:
+    """BOOTTIME deadline plus local ticket; supplied booleans are external facts."""
+
+    def __init__(self, instance):
+        self.instance = instance
+        self.current = None
+        self.last_order = (-1, 0)
+        self.revision = 0
+        self.last_time = None
+        self.clock_fault = False
+
+    @staticmethod
+    def valid_time(now):
+        return (isinstance(now, Time)
+                and type(now.boot_ms) is int and type(now.mono_ms) is int
+                and 0 <= now.mono_ms <= now.boot_ms <= MAX_COUNTER)
+
+    def observe(self, now):
+        valid = self.valid_time(now)
+        if valid and self.last_time is not None:
+            valid = (now.boot_ms >= self.last_time.boot_ms
+                     and now.mono_ms >= self.last_time.mono_ms)
+        if not valid:
+            self.clock_fault = True
+            self.current = None
+            return False
+        self.last_time = now
+        return not self.clock_fault
+
+    def accept(self, generation, sequence, ttl_ms, received, *, now=None):
+        # received precedes lock acquisition. It may legitimately be older than
+        # another serialized operation's last observation; it is not "now".
+        if now is None:
+            now = received
+        if not self.observe(now):
+            return None
+        if (not self.valid_time(received) or received.boot_ms > now.boot_ms
+                or received.mono_ms > now.mono_ms):
+            self.clock_fault = True
+            self.current = None
+            return None
+        if (type(generation) is not int or type(sequence) is not int
+                or type(ttl_ms) is not int or not 0 <= generation <= MAX_ORDER
+                or not 0 < sequence <= MAX_ORDER or not 250 <= ttl_ms <= 5000):
+            return None
+        if (generation, sequence) <= self.last_order:
+            return None
+        if received.boot_ms > MAX_COUNTER - ttl_ms or self.revision == MAX_COUNTER:
+            self.clock_fault = True
+            self.current = None
+            return None
+        if received.boot_ms + ttl_ms <= now.boot_ms:
+            return None
+        self.revision += 1
+        self.last_order = (generation, sequence)
+        self.current = Request(self.instance, self.revision, generation, sequence,
+                               received.boot_ms + ttl_ms)
+        return self.current
+
+    def revoke(self):
+        # Do not reset order or clock history; old callbacks remain stale.
+        self.current = None
+
+    def budget(self, request, now, *, permit, thermal, minimum_submit_ms=1):
+        if not self.observe(now):
+            return 0
+        if (request is None or request != self.current or not permit or not thermal
+                or type(minimum_submit_ms) is not int or minimum_submit_ms <= 0):
+            return 0
+        remaining = request.deadline_ms - now.boot_ms
+        return remaining if remaining >= minimum_submit_ms else 0
+
+    def completion_requires_release(self, request, now, *, permit, thermal):
+        # Call after an acquire returned a positive handle. Rejection never
+        # erases that handle: the separate ledger must still account for it.
+        return self.budget(request, now, permit=permit, thermal=thermal) == 0
+
+
+class State(Enum):
+    RESERVED = auto()
+    ACQUIRING = auto()
+    ACQUIRE_UNKNOWN = auto()
+    HELD = auto()
+    NEEDS_RELEASE = auto()
+    RELEASING = auto()
+    RELEASE_FAILED = auto()
+
+
+@dataclass(frozen=True)
+class Slot:
+    instance: str
+    serial: int
+
+
+@dataclass
+class Record:
+    slot: Slot
+    handle: int | None = None
+    state: State = State.RESERVED
+
+
+class Releases:
+    """Bounded ownership records, not a hardware completion detector.
+
+    There is no automatic retry, TTL-based success, alarm reset or permit writer.
+    Successful release submissions fold into a bounded summary, not CLEAN.
+    """
+
+    def __init__(self, instance, capacity=4):
+        if capacity <= 0:
+            raise ValueError("positive capacity required")
+        self.instance = instance
+        self.capacity = capacity
+        self.serial = 0
+        self.records = {}
+        self.ambiguous_handles = set()
+        self.submitted_releases = 0
+        self.capacity_rejections = 0
+        self.last_submission = None
+        self.ever_acquired = False
+        self.counter_fault = False
+
+    @property
+    def unresolved(self):
+        return (self.counter_fault or bool(self.ambiguous_handles)
+                or any(r.state in (State.ACQUIRE_UNKNOWN, State.RELEASE_FAILED)
+                       for r in self.records.values()))
+
+    def reserve(self):
+        # Reserve before calling the vendor, so a returned handle always has storage.
+        if self.unresolved:
+            return None
+        if len(self.records) >= self.capacity:
+            self.capacity_rejections = min(MAX_COUNTER, self.capacity_rejections + 1)
+            return None
+        if self.serial == MAX_COUNTER:
+            self.counter_fault = True
+            return None
+        self.serial += 1
+        slot = Slot(self.instance, self.serial)
+        self.records[slot] = Record(slot)
+        return slot
+
+    def cancel_before_call(self, slot):
+        record = self.records.get(slot)
+        if record is None or record.state != State.RESERVED:
+            return False
+        del self.records[slot]
+        return True
+
+    def acquired(self, slot, handle, *, requires_release=False):
+        record = self.records.get(slot)
+        if record is None or record.state != State.ACQUIRING:
+            return False
+        if type(handle) is not int or handle <= 0:
+            # Without an established no-effect return contract, no positive
+            # handle is uncertainty, not permission to erase the operation.
+            record.state = State.ACQUIRE_UNKNOWN
+            return False
+        duplicate = any(r.handle == handle for r in self.records.values() if r is not record)
+        record.handle = handle
+        record.state = State.NEEDS_RELEASE if requires_release else State.HELD
+        self.ever_acquired = True
+        if duplicate:
+            # Ownership is ambiguous. Do not issue blind releases using a reused ID.
+            self.ambiguous_handles.add(handle)
+        return not duplicate
+
+    def start_acquire(self, slot):
+        record = self.records.get(slot)
+        if record is None or record.state != State.RESERVED or self.unresolved:
+            return False
+        record.state = State.ACQUIRING
+        return True
+
+    def start_release(self, slot):
+        record = self.records.get(slot)
+        if (record is None or record.state not in (State.HELD, State.NEEDS_RELEASE)
+                or record.handle in self.ambiguous_handles):
+            return None
+        record.state = State.RELEASING
+        return slot
+
+    def finish_release(self, ticket, result):
+        record = self.records.get(ticket)
+        if record is None or record.state != State.RELEASING:
+            return False
+        if type(result) is not int or result < 0:
+            # None models a missing/ambiguous result, not a completed release.
+            record.state = State.RELEASE_FAILED
+            return True
+        if self.submitted_releases == MAX_COUNTER:
+            self.counter_fault = True
+            record.state = State.RELEASE_FAILED
+            return True
+        self.submitted_releases += 1
+        self.last_submission = (ticket, record.handle, result)
+        del self.records[ticket]
+        return True
+
+    @property
+    def no_local_work(self):
+        # A scheduling fact only. It cannot be used as hardware release confirmation.
+        return not self.records and not self.unresolved
+
+    @property
+    def hardware_release_confirmed(self):
+        # No completion interface exists in this model or the current backend.
+        return False
