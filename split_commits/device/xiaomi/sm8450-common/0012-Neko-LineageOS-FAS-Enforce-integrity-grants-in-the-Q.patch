+        std::scoped_lock lock(mMutex);
+        const auto permit = integrity::currentPermit();
+        if (!validContext(context) || !permit || !permit->allows(0)
+                || permit->identity != context.policyIdentity || permit->allows(integrity::kFas))
+            return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_STATE);
+        revokeLocked();
+        mBinding = context;
+        *result = statusLocked(context.grant);
+        return ndk::ScopedAStatus::ok();
+    }
