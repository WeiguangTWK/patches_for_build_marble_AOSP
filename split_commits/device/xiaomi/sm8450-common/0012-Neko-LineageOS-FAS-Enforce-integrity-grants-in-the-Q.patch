@@ -0,0 +1,285 @@
+# SPDX-License-Identifier: Apache-2.0
+"""No device I/O or compilation. Run explicitly, never imported by the product."""
+
+import unittest
+from itertools import permutations, product
+
+from model import Deadlines, MAX_COUNTER, MAX_ORDER, Releases, State, Time
+
+
+class DeadlineTests(unittest.TestCase):
+    def setUp(self):
+        self.model = Deadlines("backend-A")
+        self.request = self.model.accept(1, 1, 1500, Time(1000, 1000))
+
+    def budget(self, now, **kwargs):
+        return self.model.budget(self.request, now, permit=True, thermal=True, **kwargs)
+
+    def test_lock_and_hal_delay_consume_original_budget(self):
+        self.assertEqual(900, self.budget(Time(1600, 1600)))
+        self.assertEqual(100, self.budget(Time(2400, 2400)))
+        self.assertEqual(0, self.budget(Time(2500, 2500)))
+
+    def test_queued_receipt_is_not_a_clock_regression_or_a_new_deadline(self):
+        self.budget(Time(1800, 1800))
+        replacement = self.model.accept(1, 2, 1500, Time(1100, 1100), now=Time(2000, 2000))
+        self.assertFalse(self.model.clock_fault)
+        self.assertEqual(2600, replacement.deadline_ms)
+        self.assertEqual(600, self.model.budget(replacement, Time(2000, 2000),
+                                              permit=True, thermal=True))
+
+    def test_request_expired_while_waiting_for_lock_is_not_installed(self):
+        self.assertIsNone(self.model.accept(1, 2, 1500, Time(1100, 1100),
+                                            now=Time(3000, 3000)))
+        self.assertFalse(self.model.clock_fault)
+        self.assertEqual(self.request, self.model.current)
+        self.assertEqual(0, self.budget(Time(3000, 3000)))
+
+    def test_suspend_time_expires_old_request_despite_fresh_permit(self):
+        self.assertEqual(0, self.budget(Time(10000, 1100)))
+
+    def test_short_suspend_consumes_budget_without_claiming_thermal_freshness(self):
+        self.assertEqual(1200, self.budget(Time(1300, 1100)))
+        self.assertEqual(0, self.model.budget(self.request, Time(1300, 1100),
+                                            permit=True, thermal=False))
+
+    def test_vendor_minimum_never_rounds_budget_up(self):
+        self.assertEqual(0, self.budget(Time(2400, 2400), minimum_submit_ms=250))
+
+    def test_completion_after_deadline_requires_release(self):
+        self.assertEqual(100, self.budget(Time(2400, 2400)))
+        self.assertTrue(self.model.completion_requires_release(
+            self.request, Time(2501, 2501), permit=True, thermal=True))
+
+    def test_revoked_or_superseded_callback_cannot_restore_request(self):
+        self.model.revoke()
+        self.assertEqual(0, self.budget(Time(1100, 1100)))
+        replacement = self.model.accept(1, 2, 1500, Time(1200, 1200))
+        self.assertIsNotNone(replacement)
+        self.assertTrue(self.model.completion_requires_release(
+            self.request, Time(1300, 1300), permit=True, thermal=True))
+        self.assertEqual(replacement, self.model.current)
+
+    def test_duplicate_and_regressed_order_do_not_refresh_deadline(self):
+        for generation, sequence in [(1, 1), (0, 99), (1, 0)]:
+            with self.subTest(order=(generation, sequence)):
+                self.assertIsNone(self.model.accept(generation, sequence, 5000, Time(1200, 1200)))
+                self.assertEqual(self.request, self.model.current)
+        self.assertEqual(0, self.budget(Time(2500, 2500)))
+
+    def test_valid_completion_still_requires_current_permit_and_temperature(self):
+        self.assertFalse(self.model.completion_requires_release(
+            self.request, Time(1200, 1200), permit=True, thermal=True))
+        for permit, thermal in [(False, True), (True, False), (False, False)]:
+            self.assertTrue(self.model.completion_requires_release(
+                self.request, Time(1200, 1200), permit=permit, thermal=thermal))
+
+    def test_clock_failure_and_regression_latch_unavailable(self):
+        for invalid in [None, Time(999, 999), Time(1100, 999), Time(1000, 1001),
+                        Time(-1, -1), Time(True, 0), Time(MAX_COUNTER + 1, 1000)]:
+            with self.subTest(invalid=invalid):
+                model = Deadlines("backend-A")
+                request = model.accept(1, 1, 1500, Time(1000, 1000))
+                self.assertEqual(0, model.budget(request, invalid, permit=True, thermal=True))
+                self.assertTrue(model.clock_fault)
+                self.assertIsNone(model.accept(1, 2, 1500, Time(2000, 2000)))
+
+    def test_deadline_and_revision_overflow_never_wrap(self):
+        model = Deadlines("backend-A")
+        self.assertIsNone(model.accept(1, 1, 1500, Time(MAX_COUNTER - 100, 1000)))
+        self.assertTrue(model.clock_fault)
+        model = Deadlines("backend-A")
+        model.revision = MAX_COUNTER
+        self.assertIsNone(model.accept(1, 1, 1500, Time(1000, 1000)))
+
+    def test_other_backend_ticket_is_not_authority(self):
+        other = Deadlines("backend-B")
+        other.accept(1, 1, 1500, Time(1000, 1000))
+        self.assertEqual(0, other.budget(self.request, Time(1100, 1100),
+                                       permit=True, thermal=True))
+
+    def test_invalid_ttl_cannot_replace_live_request(self):
+        for ttl in [0, 249, 5001, True]:
+            self.assertIsNone(self.model.accept(1, 2, ttl, Time(1100, 1100)))
+            self.assertEqual(self.request, self.model.current)
+
+    def test_order_is_bounded_by_signed_aidl_long(self):
+        self.assertIsNone(self.model.accept(MAX_ORDER + 1, 1, 1500, Time(1100, 1100)))
+        self.assertIsNone(self.model.accept(1, MAX_ORDER + 1, 1500, Time(1100, 1100)))
+        self.assertEqual(self.request, self.model.current)
+
+
+class ReleaseTests(unittest.TestCase):
+    def setUp(self):
+        self.model = Releases("backend-A", capacity=2)
+
+    def hold(self, handle, **kwargs):
+        slot = self.model.reserve()
+        self.assertIsNotNone(slot)
+        self.assertTrue(self.model.start_acquire(slot))
+        self.assertTrue(self.model.acquired(slot, handle, **kwargs))
+        return slot
+
+    def test_release_submission_is_not_hardware_confirmation(self):
+        slot = self.hold(10)
+        self.assertTrue(self.model.finish_release(self.model.start_release(slot), 0))
+        self.assertTrue(self.model.no_local_work)
+        self.assertFalse(self.model.hardware_release_confirmed)
+        self.assertTrue(self.model.ever_acquired)
+        self.assertEqual(1, self.model.submitted_releases)
+
+    def test_failed_retirement_keeps_both_handles_and_blocks_new_submission(self):
+        old = self.hold(10)
+        new = self.hold(20)
+        self.model.finish_release(self.model.start_release(old), -1)
+        self.assertEqual(State.RELEASE_FAILED, self.model.records[old].state)
+        self.assertEqual(State.HELD, self.model.records[new].state)
+        self.assertIsNone(self.model.reserve())
+        self.assertIsNone(self.model.start_release(old))  # no unapproved retry
+        self.assertFalse(self.model.no_local_work)
+        self.model.finish_release(self.model.start_release(new), 0)
+        self.assertIn(old, self.model.records)
+
+    def test_missing_result_is_not_success_or_retry_permission(self):
+        slot = self.hold(10)
+        self.model.finish_release(self.model.start_release(slot), None)
+        self.assertTrue(self.model.unresolved)
+        self.assertFalse(self.model.no_local_work)
+        self.assertIsNone(self.model.start_release(slot))
+
+    def test_capacity_refusal_happens_before_vendor_call_without_erasing_records(self):
+        first = self.hold(10)
+        second = self.hold(20)
+        self.assertIsNone(self.model.reserve())
+        self.assertEqual({first, second}, set(self.model.records))
+        self.assertEqual(1, self.model.capacity_rejections)
+        self.assertFalse(self.model.unresolved)  # refused work is not lost evidence
+        self.model.finish_release(self.model.start_release(first), 0)
+        self.assertIsNotNone(self.model.reserve())
+
+    def test_late_duplicate_completion_cannot_clear_reused_handle(self):
+        old = self.hold(10)
+        ticket = self.model.start_release(old)
+        self.model.finish_release(ticket, 0)
+        new = self.hold(10)
+        self.assertNotEqual(old, new)
+        self.assertFalse(self.model.finish_release(ticket, 0))
+        self.assertIn(new, self.model.records)
+
+    def test_simultaneous_duplicate_handle_is_ambiguous(self):
+        old = self.hold(10)
+        slot = self.model.reserve()
+        self.assertTrue(self.model.start_acquire(slot))
+        self.assertFalse(self.model.acquired(slot, 10))
+        self.assertEqual(2, len(self.model.records))
+        self.assertTrue(self.model.unresolved)
+        self.assertIsNone(self.model.start_release(old))
+        self.assertIsNone(self.model.start_release(slot))
+
+    def test_stale_acquire_success_still_needs_a_cleanup_record(self):
+        slot = self.hold(10, requires_release=True)
+        self.assertEqual(State.NEEDS_RELEASE, self.model.records[slot].state)
+        self.assertFalse(self.model.no_local_work)
+        self.assertIsNotNone(self.model.start_release(slot))
+
+    def test_reserved_and_inflight_work_are_not_idle(self):
+        slot = self.model.reserve()
+        self.assertFalse(self.model.no_local_work)
+        self.model.start_acquire(slot)
+        self.assertFalse(self.model.cancel_before_call(slot))
+        self.model.acquired(slot, 10)
+        self.model.start_release(slot)
+        self.assertFalse(self.model.no_local_work)
+        self.assertIsNone(self.model.start_release(slot))
+
+    def test_cancel_is_only_valid_before_vendor_call(self):
+        slot = self.model.reserve()
+        self.assertTrue(self.model.cancel_before_call(slot))
+        held = self.hold(10)
+        self.assertFalse(self.model.cancel_before_call(held))
+
+    def test_failed_acquire_keeps_old_handle_and_unknown_operation(self):
+        old = self.hold(10)
+        slot = self.model.reserve()
+        self.assertTrue(self.model.start_acquire(slot))
+        self.assertFalse(self.model.acquired(slot, None))
+        self.assertEqual(State.HELD, self.model.records[old].state)
+        self.assertEqual(State.ACQUIRE_UNKNOWN, self.model.records[slot].state)
+        self.assertTrue(self.model.unresolved)
+        self.assertIsNone(self.model.reserve())
+        self.assertFalse(self.model.cancel_before_call(slot))
+
+    def test_other_instance_cannot_complete_release(self):
+        slot = self.hold(10)
+        ticket = self.model.start_release(slot)
+        other = Releases("backend-B")
+        other_slot = other.reserve()
+        other.start_acquire(other_slot)
+        other.acquired(other_slot, 10)
+        other.start_release(other_slot)
+        self.assertFalse(other.finish_release(ticket, 0))
+        self.assertIn(other_slot, other.records)
+
+    def test_summary_is_bounded_without_promoting_unknown_to_clean(self):
+        for _ in range(1000):
+            slot = self.hold(10)
+            self.model.finish_release(self.model.start_release(slot), 0)
+            self.assertEqual(0, len(self.model.records))
+        self.assertEqual(1000, self.model.submitted_releases)
+        self.assertFalse(self.model.hardware_release_confirmed)
+        self.assertEqual(3, len(self.model.last_submission))
+
+    def test_counters_never_wrap_or_forget_pending_work(self):
+        self.model.serial = MAX_COUNTER
+        self.assertIsNone(self.model.reserve())
+        self.assertTrue(self.model.unresolved)
+        model = Releases("other")
+        slot = model.reserve()
+        model.start_acquire(slot)
+        model.acquired(slot, 10)
+        model.submitted_releases = MAX_COUNTER
+        model.finish_release(model.start_release(slot), 0)
+        self.assertIn(slot, model.records)
+        self.assertTrue(model.unresolved)
+
+    def test_release_result_order_preserves_each_unresolved_record(self):
+        for results in product((0, -1, None), repeat=2):
+            for order in permutations((0, 1)):
+                with self.subTest(results=results, order=order):
+                    model = Releases("backend-A", capacity=2)
+                    slots = []
+                    for handle in (10, 20):
+                        slot = model.reserve()
+                        model.start_acquire(slot)
+                        model.acquired(slot, handle)
+                        model.start_release(slot)
+                        slots.append(slot)
+                    for i in order:
+                        self.assertTrue(model.finish_release(slots[i], results[i]))
+                    for i, result in enumerate(results):
+                        self.assertEqual(result != 0, slots[i] in model.records)
+                    self.assertEqual(all(r == 0 for r in results), model.no_local_work)
+                    self.assertFalse(model.hardware_release_confirmed)
+
+
+class CombinedTests(unittest.TestCase):
+    def test_suspend_during_acquire_keeps_late_success_for_release(self):
+        deadlines = Deadlines("backend-A")
+        releases = Releases("backend-A")
+        request = deadlines.accept(1, 1, 1500, Time(1000, 1000))
+        self.assertEqual(1400, deadlines.budget(request, Time(1100, 1100),
+                                              permit=True, thermal=True))
+        slot = releases.reserve()
+        self.assertTrue(releases.start_acquire(slot))
+        requires_release = deadlines.completion_requires_release(
+            request, Time(9000, 1150), permit=True, thermal=True)
+        self.assertTrue(requires_release)
+        releases.acquired(slot, 10, requires_release=requires_release)
+        self.assertEqual(State.NEEDS_RELEASE, releases.records[slot].state)
+        releases.finish_release(releases.start_release(slot), -1)
+        self.assertFalse(releases.no_local_work)
+        self.assertIsNone(releases.reserve())
+
+
+if __name__ == "__main__":
+    unittest.main()
