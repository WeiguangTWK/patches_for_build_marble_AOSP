+    void invalidateIdleSample() {
+        // Require a fresh sample when requests resume. Keep the previous blocked
+        // state, but never count an unobserved idle gap toward thermal recovery.
+        mLastPoll = TimePoint{};
+        mAvailable = false;
+        mRecoverySince.reset();
