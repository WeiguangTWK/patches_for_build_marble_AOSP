   private:
+    bool validContext(const FasPolicyContext& context) const {
+        return context.backendInstance == gFasBackendInstance
+                && integrity::instanceId(context.grant)
+                && integrity::instanceId(context.collectorInstance)
+                && integrity::fasInstanceHealthy(integrity::kFasBackendBoot, gFasBackendInstance)
+                && integrity::fasInstanceHealthy(integrity::kFasDaemonBoot, context.daemonInstance);
+    }
+
+    bool boundContext(const FasPolicyContext& context) const {
+        // Changing an epoch does not change the controller authority; a different
+        // controller must bind again while FAS is disabled.
+        return mBinding && validContext(context)
+                && context.policyIdentity.size() >= 50 && mBinding->policyIdentity.size() >= 50
+                && context.policyIdentity.substr(0, 50) == mBinding->policyIdentity.substr(0, 50)
+                && context.daemonInstance == mBinding->daemonInstance
+                && context.collectorInstance == mBinding->collectorInstance
+                && context.grant == mBinding->grant && context.compromise == mBinding->compromise;
+    }
+
+    FasBackendStatus statusLocked(const std::string& challenge) const {
+        FasBackendStatus result;
+        result.challenge = challenge;
+        result.backendInstance = gFasBackendInstance;
+        result.bootRecord = android::base::GetProperty(integrity::kFasBackendBoot, "");
+        result.healthy = integrity::fasInstanceHealthy(integrity::kFasBackendBoot,
+                                                      gFasBackendInstance);
+        if (mBinding) {
+            result.boundDaemonInstance = mBinding->daemonInstance;
+            result.boundCollectorInstance = mBinding->collectorInstance;
+            result.boundGrant = mBinding->grant;
+            result.accepting = boundContext(*mBinding)
+                    && integrity::allowedForIdentity(mBinding->policyIdentity, integrity::kFas);
+        }
+        const auto record = integrity::FasBootRecord::parse(result.bootRecord);
+        result.bootSubmissionState = record.valid && !record.interrupted
+                ? (record.submitted ? 1 : 0) : 2;
+        return result;
+    }
+
     void watchdogLoop() {
         while (mRunning) {
             std::this_thread::sleep_for(250ms);
             std::scoped_lock lock(mMutex);
             const TimePoint now = Clock::now();
+            if (integrity::enabled() &&
+                (!mLatest || !mLatest->context || !boundContext(*mLatest->context)
+                    || !integrity::allowedForIdentity(mLatest->policyIdentity, integrity::kFas))) {
+                revokeLocked();
+            }
             const bool thermalWasAllowed = mThermal.allowed();
-            mThermal.refresh(now);
+            if (mLatest) {
+                mThermal.refresh(now);
+            } else {
+                mThermal.invalidateIdleSample();
+            }
             const bool actualEnabled = android::base::GetBoolProperty(kEnabledProperty, true);
             expireStaleVoteLocked(now);
             handleSafetyTransitionsLocked(now, thermalWasAllowed, actualEnabled, true);
         }
     }
 
+    static int32_t submissionState() {
+        const int fd = open("/dev/platform_integrity", O_RDONLY | O_CLOEXEC);
+        if (fd < 0) return 2;
+        const auto status = integrity::executionEvidence(fd);
+        close(fd);
+        return status ? status->submission : 2;
+    }
+
+    void revokeLocked() {
+        mLatest.reset();
+        mThermal.invalidateIdleSample();
+        mPerf.release();
+        mNodes.invalidate();
+        resetCeilingStateLocked();
+    }
+
     void prepareCallerLocked(pid_t callerPid, uid_t callerUid) {
         if (mClientPid == callerPid) return;
         if (mClientPid > 0) mPerf.release();
         mNodes.invalidate();
         resetCeilingStateLocked();
         mLatest.reset();
+        mThermal.invalidateIdleSample();
         mGeneration = 0;
         mLastSequence = 0;
         mClientPid = callerPid;
@@ -697,12 +883,14 @@ class Backend final : public BnFasBackend {
         ALOGW("vote watchdog expired generation=%lld after %d ms",
               static_cast<long long>(mLatest->generation), mLatest->ttlMillis);
         mLatest.reset();
+        mThermal.invalidateIdleSample();
         mPerf.release();
         mNodes.invalidate();
         resetCeilingStateLocked();
     }
 
     bool applyLocked(const VoteRequest& request) {
+        if (!integrity::allowedForIdentity(request.policyIdentity, integrity::kFas)) return false;
         mLastSubmitted.reset();
         if (mPerf.handle() <= 0 && !mNodes.readyForNewHandle()) return false;
         VoteRequest submitted = mExternalCeiling.reconcile(request);
@@ -742,6 +930,7 @@ class Backend final : public BnFasBackend {
               request.ttlMillis);
     }
 
