diff --git a/sepolicy/vendor/fasqtid.te b/sepolicy/vendor/fasqtid.te
new file mode 100644
index 0000000..a1befbd
--- /dev/null
+++ b/sepolicy/vendor/fasqtid.te
@@ -0,0 +1,23 @@
+# Isolated vendor bridge between the GPL system-side FAS algorithm and the proprietary QTI perf
+# client. The bridge is also a thermal HAL client and refuses actual votes without thermal state.
+type fasqtid, domain;
+type fasqtid_exec, exec_type, vendor_file_type, file_type;
+
+init_daemon_domain(fasqtid)
+binder_use(fasqtid)
+hwbinder_use(fasqtid)
+hal_server_domain(fasqtid, hal_power)
+hal_client_domain(fasqtid, hal_thermal)
+
+# libqti-perfd-client.so communicates with vendor.qti.hardware.perf@2.3.
+hal_client_domain(fasqtid, vendor_hal_perf)
+
+# The proprietary perf HAL resolves perf-lock clients through /proc/<pid> before applying
+# MPCTLV3 resources. Permit it to identify this isolated bridge just as it identifies app clients.
+r_dir_file(vendor_hal_perf_default, fasqtid)
+
+get_prop(fasqtid, vendor_fas_config_prop)
+set_prop(fasqtid, vendor_fas_prepare_prop)
+
+# Inspect only ownership and mode bits before asking vendor init to repair the QTI perf nodes.
+allow fasqtid vendor_sysfs_msm_perf:file getattr;
