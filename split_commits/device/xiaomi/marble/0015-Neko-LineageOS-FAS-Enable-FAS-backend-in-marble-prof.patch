 device.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/device.mk b/device.mk
index 58a76b6..85464df 100644
--- a/device.mk
+++ b/device.mk
@@ -23,6 +23,11 @@ $(call inherit-product, vendor/gapps/arm64/arm64-vendor.mk)
 PRODUCT_COPY_FILES += \
     $(LOCAL_PATH)/rootdir/etc/init.marble.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/init.marble.rc
 
+# Frame-aware scheduling
+PRODUCT_PACKAGES += \
+    fasd \
+    fasqtid
