From cb3155d80ff932d9fffc96d86c6a0b97403c4d81 Mon Sep 17 00:00:00 2001
From: WeiguangTWK <weiguangtwk@outlook.com>
Date: Mon, 27 Jul 2026 11:48:12 +0800
Subject: [PATCH] Neko LineageOS: [Anti Detection] Specialize SELinux domain
 for update URL prop

Change-Id: Iead6704fd1963d17275071dd8eaa34239941ff37
---
 common/private/property.te       | 3 +++
 common/private/property_contexts | 3 +++
 common/private/updater_app.te    | 1 +
 3 files changed, 7 insertions(+)

diff --git a/common/private/property.te b/common/private/property.te
index 4095e65..79483f6 100644
--- a/common/private/property.te
+++ b/common/private/property.te
@@ -11,5 +11,8 @@ system_internal_prop(custom_version_prop)
 # Recovery update
 system_internal_prop(recovery_update_prop)
 
+# Updater server
+system_internal_prop(updater_uri_prop)
+
 # nhoverride global state
 system_public_prop(nhoverride_prop)
diff --git a/common/private/property_contexts b/common/private/property_contexts
index 6a65717..1986cd6 100644
--- a/common/private/property_contexts
+++ b/common/private/property_contexts
@@ -42,6 +42,9 @@ ro.minui.default_touch_rotation        u:object_r:recovery_config_prop:s0
 # Recovery update
 persist.vendor.recovery_update         u:object_r:recovery_update_prop:s0
 
+# Updater server
+ro.updater.uri                         u:object_r:updater_uri_prop:s0 exact string
+
 # xtra-daemon control
 persist.sys.xtra-daemon.enabled        u:object_r:xtra_control_prop:s0 exact bool
 
diff --git a/common/private/updater_app.te b/common/private/updater_app.te
index 657588f..10224f2 100644
--- a/common/private/updater_app.te
+++ b/common/private/updater_app.te
@@ -25,5 +25,6 @@ allow updater_app ota_package_file:file create_file_perms;
 get_prop(updater_app, custom_version_prop)
 get_prop(updater_app, default_prop)
 get_prop(updater_app, build_prop)
+get_prop(updater_app, updater_uri_prop)
 
 set_prop(updater_app, recovery_update_prop)
-- 
2.43.0

