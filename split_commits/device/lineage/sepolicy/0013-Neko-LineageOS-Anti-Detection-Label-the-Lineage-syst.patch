From 361fa99e2714fd1a1b167d9fdb704514d3b7e5e7 Mon Sep 17 00:00:00 2001
From: WeiguangTWK <weiguangtwk@outlook.com>
Date: Sat, 10 Oct 2026 08:05:22 +0800
Subject: [PATCH] Neko LineageOS: [Anti Detection] Label the Lineage system
 resource APK separately

Restrict resource reads and mappings from untrusted apps, isolated
processes, SDK sandboxes, instant apps, app zygotes and WebView zygotes.
Retain access for system consumers and leave SDK file permissions
unchanged.

Add neverallow rules to enforce the restricted domain boundary.

Change-Id: Icb7b80c400d20395e3fcc61f4f732c7e2940191f
---
 common/private/file.te                       |  1 +
 common/private/file_contexts                 |  2 +-
 common/private/system_extension_resources.te | 21 ++++++++++++++++++++
 3 files changed, 23 insertions(+), 1 deletion(-)
 create mode 100644 common/private/system_extension_resources.te

diff --git a/common/private/file.te b/common/private/file.te
index d359cef..bd60ba3 100644
--- a/common/private/file.te
+++ b/common/private/file.te
@@ -1,5 +1,6 @@
 type sdcard_posix, sdcard_type, sdcard_posix_contextmount_type, fs_type, mlstrustedobject;
 type sysfs_perdev_minors, fs_type, sysfs_type;
 type lineage_platform_framework_file, file_type, system_file_type;
+type system_extension_resource_file, file_type, system_file_type;
 type lineage_permission_file, file_type, system_file_type;
 type lineage_privapp_pkg_file, file_type, system_file_type;
diff --git a/common/private/file_contexts b/common/private/file_contexts
index fe76b22..b9133d0 100644
--- a/common/private/file_contexts
+++ b/common/private/file_contexts
@@ -11,7 +11,7 @@
 /(system_ext|system/system_ext)/etc/selinux/system_ext_sepolicy\.cil u:object_r:sepolicy_file:s0
 
 # Keep Lineage platform framework artifacts out of untrusted app reach.
-/system/framework/org\.system\.platform-res\.apk u:object_r:lineage_platform_framework_file:s0
+/system/framework/org\.system\.platform-res\.apk u:object_r:system_extension_resource_file:s0
 /system/framework/miui-framework\.jar u:object_r:lineage_platform_framework_file:s0
 /system/framework/oat/arm64/miui-framework\.vdex u:object_r:lineage_platform_framework_file:s0
 /system/framework/oat/arm64/miui-framework\.odex u:object_r:lineage_platform_framework_file:s0
diff --git a/common/private/system_extension_resources.te b/common/private/system_extension_resources.te
new file mode 100644
index 0000000..e0000a8
--- /dev/null
+++ b/common/private/system_extension_resources.te
@@ -0,0 +1,21 @@
+# Keep resource access separate from SDK code access. Child zygotes must not
+# reopen these resources during application preload and pass them to children.
+allow {
+    appdomain
+    coredomain
+    -untrusted_app_all
+    -isolated_app_all
+    -sdk_sandbox_all
+    -ephemeral_app
+    -app_zygote
+    -webview_zygote
+} system_extension_resource_file:file r_file_perms;
+
+neverallow {
+    untrusted_app_all
+    isolated_app_all
+    sdk_sandbox_all
+    ephemeral_app
+    app_zygote
+    webview_zygote
+} system_extension_resource_file:file rx_file_perms;
-- 
2.43.0

