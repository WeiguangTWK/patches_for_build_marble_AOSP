From 56c322124f4f58ef0ef350959dc9eb38f0f4873c Mon Sep 17 00:00:00 2001
From: WeiguangTWK <weiguangtwk@outlook.com>
Date: Sat, 7 Nov 2026 18:55:40 +0800
Subject: [PATCH] Neko LineageOS: [ASTER] Integrate early module and syscall
 evidence hooks

Wire the external ASTER collector into the arm64 kernel build and enable it for
marble. Capture module input before signature stripping, associate load phases
with successful instances and record unloads.

Provide compiled native and compat syscall expectations for bounded change
observations. Bind the actual ASTER service task before fork publication and
apply its existing ptrace protection through the security hooks.

Keep the collector implementation and shared headers under external/aster.
Collection records evidence without blocking module loading or learning a
userspace-supplied baseline.

Change-Id: Ie9a20785540e59ec85be9da43a4b216141da7067
---
 Makefile                                    |  6 ++++++
 arch/arm64/configs/vendor/marble_GKI.config |  4 ++++
 arch/arm64/kernel/sys.c                     |  4 ++++
 arch/arm64/kernel/sys32.c                   |  4 ++++
 include/linux/platform_integrity.h          |  3 +++
 include/linux/platform_integrity_fence.h    |  3 +++
 init/Kconfig                                | 18 ++++++++++++++++++
 kernel/Makefile                             |  2 ++
 kernel/fork.c                               |  2 ++
 kernel/module.c                             | 19 +++++++++++++++++--
 kernel/platform_integrity.c                 |  3 +++
 security/security.c                         |  5 +++++
 12 files changed, 71 insertions(+), 2 deletions(-)
 create mode 100644 include/linux/platform_integrity.h
 create mode 100644 include/linux/platform_integrity_fence.h
 create mode 100644 kernel/platform_integrity.c

diff --git a/Makefile b/Makefile
index ac6ebd447..970b175f4 100644
--- a/Makefile
+++ b/Makefile
@@ -527,6 +527,12 @@ KBUILD_CFLAGS   := -Wall -Wundef -Werror=strict-prototypes -Wno-trigraphs \
 		   -Werror=return-type -Wno-format-security \
 		   -std=gnu89
 KBUILD_CPPFLAGS := -D__KERNEL__
+
+# Host integration only. ASTER sources and generated-header rules live outside
+# the kernel tree; the selected product supplies the component source root.
+ifneq ($(strip $(ASTER_SOURCE_ROOT)),)
+include $(ASTER_SOURCE_ROOT)/build/kernel.mk
+endif
 KBUILD_AFLAGS_KERNEL :=
 KBUILD_CFLAGS_KERNEL :=
 KBUILD_AFLAGS_MODULE  := -DMODULE
diff --git a/arch/arm64/configs/vendor/marble_GKI.config b/arch/arm64/configs/vendor/marble_GKI.config
index c49524cbd..2d5497e3e 100644
--- a/arch/arm64/configs/vendor/marble_GKI.config
+++ b/arch/arm64/configs/vendor/marble_GKI.config
@@ -10,3 +10,7 @@ CONFIG_HAVE_CHARGE_TEMP=y
 
 CONFIG_LOCALVERSION="-android12-9-00003-gfb24cf99ad97-ab14313284"
 # CONFIG_LOCALVERSION_AUTO is not set
+
+CONFIG_PLATFORM_INTEGRITY=y
+
+# CONFIG_PLATFORM_INTEGRITY_KSU_TSA_EXPERIMENT is not set
diff --git a/arch/arm64/kernel/sys.c b/arch/arm64/kernel/sys.c
index d5ffaaab3..93bbe88a5 100644
--- a/arch/arm64/kernel/sys.c
+++ b/arch/arm64/kernel/sys.c
@@ -59,3 +59,7 @@ const syscall_fn_t sys_call_table[__NR_syscalls] = {
 	[0 ... __NR_syscalls - 1] = __arm64_sys_ni_syscall,
 #include <asm/unistd.h>
 };
+
+#ifdef CONFIG_PLATFORM_INTEGRITY
+#include <aster/kernel/adapters/arm64/native_syscalls.inc>
+#endif
diff --git a/arch/arm64/kernel/sys32.c b/arch/arm64/kernel/sys32.c
index fc40386af..15f421e97 100644
--- a/arch/arm64/kernel/sys32.c
+++ b/arch/arm64/kernel/sys32.c
@@ -133,3 +133,7 @@ const syscall_fn_t compat_sys_call_table[__NR_compat_syscalls] = {
 	[0 ... __NR_compat_syscalls - 1] = __arm64_sys_ni_syscall,
 #include <asm/unistd32.h>
 };
+
+#ifdef CONFIG_PLATFORM_INTEGRITY
+#include <aster/kernel/adapters/arm64/compat_syscalls.inc>
+#endif
diff --git a/include/linux/platform_integrity.h b/include/linux/platform_integrity.h
new file mode 100644
index 000000000..2a47728d8
--- /dev/null
+++ b/include/linux/platform_integrity.h
@@ -0,0 +1,3 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Host integration only; definitions have one component source. */
+#include <aster/kernel/include/linux/platform_integrity.h>
diff --git a/include/linux/platform_integrity_fence.h b/include/linux/platform_integrity_fence.h
new file mode 100644
index 000000000..1e782cfb2
--- /dev/null
+++ b/include/linux/platform_integrity_fence.h
@@ -0,0 +1,3 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Host integration only; definitions have one component source. */
+#include <aster/kernel/include/linux/platform_integrity_fence.h>
diff --git a/init/Kconfig b/init/Kconfig
index e051cc148..e02c6eab0 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -2481,3 +2481,21 @@ config ARCH_HAS_SYSCALL_WRAPPER
 
 source "init/Kconfig.gki"
 source "init/Kconfig.gki-debug"
+
+config PLATFORM_INTEGRITY
+	bool "Early platform module integrity evidence"
+	depends on ARM64 && MODULES && PROC_FS
+	select CRYPTO_LIB_SHA256
+	help
+	  Record module input hashes before signature stripping or relocation,
+	  and compare native/compat syscall pointers to compiled expectations.
+	  Does not block module loading or learn a userspace supplied baseline.
+
+config PLATFORM_INTEGRITY_KSU_TSA_EXPERIMENT
+	bool "Fixed-input KernelSU TSA reconstruction experiment"
+	depends on PLATFORM_INTEGRITY && KALLSYMS
+	default n
+	help
+	  Include one fixed release KO and a root-only, once-per-boot digest
+	  reconstruction probe. Diagnostic only; does not authorize modules or
+	  publish addresses. Leave disabled in production builds.
diff --git a/kernel/Makefile b/kernel/Makefile
index c1b06126b..bf45d8677 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -156,3 +156,5 @@ $(obj)/kheaders_data.tar.xz: FORCE
 	$(call cmd,genikh)
 
 clean-files := kheaders_data.tar.xz kheaders.md5
+
+obj-$(CONFIG_PLATFORM_INTEGRITY) += platform_integrity.o
diff --git a/kernel/fork.c b/kernel/fork.c
index 559c41d54..0b85ad593 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -28,6 +28,7 @@
 #include <linux/init.h>
 #include <linux/unistd.h>
 #include <linux/module.h>
+#include <linux/platform_integrity.h>
 #include <linux/vmalloc.h>
 #include <linux/completion.h>
 #include <linux/personality.h>
@@ -2406,6 +2407,7 @@ static __latent_entropy struct task_struct *copy_process(
 	}
 
 	/* No more failure paths after this point. */
+	pi_source_fork(current, p);
 
 	/*
 	 * Copy seccomp details explicitly here, in case they were changed
diff --git a/kernel/module.c b/kernel/module.c
index 0750270d1..1a6c1a45b 100644
--- a/kernel/module.c
+++ b/kernel/module.c
@@ -58,6 +58,7 @@
 #include <linux/dynamic_debug.h>
 #include <linux/audit.h>
 #include <uapi/linux/module.h>
+#include <linux/platform_integrity.h>
 #include "module-internal.h"
 
 #define CREATE_TRACE_POINTS
@@ -1042,6 +1043,7 @@ SYSCALL_DEFINE2(delete_module, const char __user *, name_user,
 
 	/* Store the name of the last unloaded module for diagnostic purposes */
 	strlcpy(last_unloaded_module, mod->name, sizeof(last_unloaded_module));
+	pi_module_unload(mod);
 
 	free_module(mod);
 	/* someone could wait for the module in add_unformed_module() */
@@ -3737,7 +3739,8 @@ static void do_free_init(struct work_struct *w)
  * Keep it uninlined to provide a reliable breakpoint target, e.g. for the gdb
  * helper command 'lx-symbols'.
  */
-static noinline int do_init_module(struct module *mod)
+static noinline int do_init_module(struct module *mod,
+				  struct pi_measurement *measurement)
 {
 	int ret = 0;
 	struct mod_initfree *freeinit;
@@ -3786,6 +3789,8 @@ static noinline int do_init_module(struct module *mod)
 	ftrace_free_mem(mod, mod->init_layout.base, mod->init_layout.base +
 			mod->init_layout.size);
 	mutex_lock(&module_mutex);
+	/* Publish success before dropping the reference that excludes unload. */
+	pi_module_live(measurement, mod);
 	/* Drop initial reference. */
 	module_put(mod);
 	trim_init_extable(mod);
@@ -3979,6 +3984,7 @@ static void cfi_init(struct module *mod);
 static int load_module(struct load_info *info, const char __user *uargs,
 		       int flags)
 {
+	struct pi_measurement measurement;
 	struct module *mod;
 	long err = 0;
 	char *after_dashes;
@@ -3995,6 +4001,7 @@ static int load_module(struct load_info *info, const char __user *uargs,
 	 * off the sig length at the end of the module, making
 	 * checks against info->len more correct.
 	 */
+	pi_module_input(&measurement, info->hdr, info->len);
 	err = module_sig_check(info, flags);
 	if (err)
 		goto free_copy;
@@ -4017,6 +4024,8 @@ static int load_module(struct load_info *info, const char __user *uargs,
 	if (err)
 		goto free_copy;
 
+	pi_module_identified(&measurement, info->mod->name);
+
 	/*
 	 * Now that we know we have the correct module name, check
 	 * if it's blacklisted.
@@ -4116,6 +4125,8 @@ static int load_module(struct load_info *info, const char __user *uargs,
 	/* Ftrace init must be called in the MODULE_STATE_UNFORMED state */
 	ftrace_module_init(mod);
 
+	pi_module_executable(&measurement);
+
 	/* Finally it's fully formed, ready to start executing. */
 	err = complete_formation(mod, info);
 	if (err)
@@ -4154,7 +4165,10 @@ static int load_module(struct load_info *info, const char __user *uargs,
 	/* Done! */
 	trace_module_load(mod);
 
-	return do_init_module(mod);
+	err = do_init_module(mod, &measurement);
+	if (err)
+		pi_module_complete(&measurement, err);
+	return err;
 
  sysfs_cleanup:
 	mod_sysfs_teardown(mod);
@@ -4198,6 +4212,7 @@ static int load_module(struct load_info *info, const char __user *uargs,
 
 	module_deallocate(mod, info);
  free_copy:
+	pi_module_complete(&measurement, err);
 	free_copy(info);
 	return err;
 }
diff --git a/kernel/platform_integrity.c b/kernel/platform_integrity.c
new file mode 100644
index 000000000..318c8a7e7
--- /dev/null
+++ b/kernel/platform_integrity.c
@@ -0,0 +1,3 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Implementation is maintained by external/aster. */
+#include <aster/kernel/builtin/platform_integrity_impl.c>
diff --git a/security/security.c b/security/security.c
index 98e1c8793..f86509cdc 100644
--- a/security/security.c
+++ b/security/security.c
@@ -25,6 +25,7 @@
 #include <linux/mman.h>
 #include <linux/mount.h>
 #include <linux/personality.h>
+#include <linux/platform_integrity.h>
 #include <linux/backing-dev.h>
 #include <linux/string.h>
 #include <linux/msg.h>
@@ -714,11 +715,15 @@ int security_binder_transfer_file(const struct cred *from,
 
 int security_ptrace_access_check(struct task_struct *child, unsigned int mode)
 {
+	if (pi_source_ptrace_denied(child, current))
+		return -EACCES;
 	return call_int_hook(ptrace_access_check, 0, child, mode);
 }
 
 int security_ptrace_traceme(struct task_struct *parent)
 {
+	if (pi_source_ptrace_denied(current, parent))
+		return -EACCES;
 	return call_int_hook(ptrace_traceme, 0, parent);
 }
 
