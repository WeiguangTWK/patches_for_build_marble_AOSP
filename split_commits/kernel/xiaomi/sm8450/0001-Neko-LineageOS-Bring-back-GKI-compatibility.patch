 gcc-waipio.ko
 icc-rpmh.ko
 qcom_ipcc.ko
+qcom_ipc_logging.ko
 qcom-pdc.ko
 qcom_tsens.ko
 rpmh-regulator.ko
@@ -21,6 +22,7 @@ cqhci.ko
 crypto-qti-common.ko
 crypto-qti-hwkm.ko
 dcvs_fp.ko
+debug-regulator.ko
 dispcc-diwali.ko
 dispcc-waipio.ko
 gcc-diwali.ko
@@ -78,6 +80,7 @@ qcom_wdt_core.ko
 qnoc-diwali.ko
 qnoc-qos.ko
 qrtr.ko
+qti-regmap-debugfs.ko
 regmap-spmi.ko
 rtc-pm8xxx.ko
