+    private void scheduleMiniWindowDropTargetRemoval(View dropTargetView) {
+        // Hide immediately, but only remove the captured instance after the current traversal.
+        // Capturing instances also prevents an old gesture handler from removing a future target.
+        dropTargetView.setVisibility(View.INVISIBLE);
+        if (!mMiniWindowDropTargetsPendingRemoval.contains(dropTargetView)) {
+            mMiniWindowDropTargetsPendingRemoval.add(dropTargetView);
         }
+        if (mMiniWindowDropTargetRemovalPosted) {
+            return;
+        }
+        mMiniWindowDropTargetRemovalPosted = true;
+        MAIN_EXECUTOR
+                .getHandler()
+                .post(
+                        () -> {
+                            mMiniWindowDropTargetRemovalPosted = false;
+                            ArrayList<View> pendingRemoval =
+                                    new ArrayList<>(mMiniWindowDropTargetsPendingRemoval);
+                            mMiniWindowDropTargetsPendingRemoval.clear();
+                            for (View view : pendingRemoval) {
+                                if (view.getParent() instanceof ViewGroup parent) {
+                                    parent.removeView(view);
+                                }
+                            }
+                        });
     }
 
     private int pxFromDp(int dp) {
