+
+    TaskShortcutFactory LOCK_TOGGLE = new TaskShortcutFactory() {
+        @Override
+        public List<SystemShortcut> getShortcuts(RecentsViewContainer container,
+                TaskContainer taskContainer) {
+            RecentsView recentsView = taskContainer.getTaskView().getRecentsView();
+            if (recentsView == null) {
+                return null;
+            }
+            boolean isLocked = recentsView.isTaskLocked(taskContainer.getTask());
+            return Collections.singletonList(new LockToggleSystemShortcut(
+                    container, taskContainer, isLocked));
+        }
+
+        @Override
+        public boolean showForGroupedTask() {
+            return true;
+        }
+    };
+
+    class LockToggleSystemShortcut extends SystemShortcut<RecentsViewContainer> {
+        private final TaskContainer mTaskContainer;
+        private final boolean mIsLocked;
+
+        public LockToggleSystemShortcut(RecentsViewContainer target,
+                TaskContainer taskContainer, boolean isLocked) {
+            super(R.drawable.ic_lock,
+                    isLocked ? R.string.recent_task_option_unlock
+                            : R.string.recent_task_option_lock,
+                    target, taskContainer.getItemInfo(), taskContainer.getTaskView());
+            mTaskContainer = taskContainer;
+            mIsLocked = isLocked;
+        }
+
+        @Override
+        public void onClick(View view) {
+            RecentsView recentsView = mTaskContainer.getTaskView().getRecentsView();
+            if (recentsView != null) {
+                recentsView.setTaskLocked(mTaskContainer.getTask(), !mIsLocked);
+                mTaskContainer.getTaskView().updateLockStateUi();
+            }
+            dismissTaskMenuView();
+        }
+    }
+
     class MiniWindowSystemShortcut extends SystemShortcut<RecentsViewContainer> {
 
         private final TaskContainer mTaskContainer;
