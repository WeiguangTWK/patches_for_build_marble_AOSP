+    private void matchPrimaryActionButtonSize() {
+        if (mClearAllButton == null || mScreenshotButton == null) {
+            return;
+        }
+        int width = Math.max(mScreenshotButton.getMeasuredWidth(), mClearAllButton.getMeasuredWidth());
+        int height = Math.max(mScreenshotButton.getMeasuredHeight(),
+                mClearAllButton.getMeasuredHeight());
+        if (width <= 0 || height <= 0) {
+            return;
+        }
+
+        ViewGroup.LayoutParams screenshotParams = mScreenshotButton.getLayoutParams();
+        ViewGroup.LayoutParams clearAllParams = mClearAllButton.getLayoutParams();
+        boolean shouldRelayout = false;
+        if (screenshotParams.width != width || screenshotParams.height != height) {
+            screenshotParams.width = width;
+            screenshotParams.height = height;
+            mScreenshotButton.setLayoutParams(screenshotParams);
+            shouldRelayout = true;
+        }
+        if (clearAllParams.width != width || clearAllParams.height != height) {
