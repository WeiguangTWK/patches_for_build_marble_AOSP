+package com.android.quickstep.views;
+
+import android.content.Context;
+import android.graphics.Color;
+import android.graphics.Outline;
+import android.graphics.drawable.GradientDrawable;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewOutlineProvider;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+
+import com.android.launcher3.R;
+
+/** Visual drop target used to arm mini-window launch during swipe-up from apps. */
+public class MiniWindowDropTargetView extends FrameLayout {
+
+    private static final float BASE_ALPHA = 0.42f;
+    private static final float MAX_ALPHA = 0.96f;
+    private static final float BASE_SCALE = 0.94f;
+    private static final float ARMED_SCALE = 1.06f;
+
+    private final float mCornerRadiusPx;
+    private final float mMagneticMarginPx;
+    private final float mStickyMarginPx;
+
+    private final GradientDrawable mBackgroundDrawable;
+    private final ImageView mIconView;
+
+    private boolean mArmed;
+    private float mRevealProgress;
+
+    public MiniWindowDropTargetView(Context context) {
+        super(context);
+
+        mCornerRadiusPx = dpToPx(18);
+        mMagneticMarginPx = dpToPx(18);
+        mStickyMarginPx = dpToPx(30);
+
+        mBackgroundDrawable = new GradientDrawable();
+        mBackgroundDrawable.setColor(Color.WHITE);
+        mBackgroundDrawable.setCornerRadius(mCornerRadiusPx);
+        mBackgroundDrawable.setAlpha(Math.round(BASE_ALPHA * 255f));
+        setBackground(mBackgroundDrawable);
+
+        setClipToOutline(true);
+        setOutlineProvider(new ViewOutlineProvider() {
+            @Override
+            public void getOutline(View view, Outline outline) {
+                outline.setRoundRect(0, 0, view.getWidth(), view.getHeight(), mCornerRadiusPx);
+            }
+        });
+
+        mIconView = new ImageView(context);
+        mIconView.setImageResource(R.drawable.ic_select_windows);
+        mIconView.setColorFilter(Color.argb(200, 0, 0, 0));
+        LayoutParams lp = new LayoutParams((int) dpToPx(28), (int) dpToPx(28));
+        lp.gravity = Gravity.CENTER;
+        addView(mIconView, lp);
+
+        setScaleX(BASE_SCALE);
+        setScaleY(BASE_SCALE);
+        setVisibility(INVISIBLE);
+    }
+
+    public void setRevealProgress(float progress) {
+        mRevealProgress = clamp(progress);
+        applyState();
+    }
+
+    public void setArmed(boolean armed) {
+        if (mArmed == armed) {
+            return;
+        }
+        mArmed = armed;
+        animate().cancel();
+        animate()
+                .scaleX(armed ? ARMED_SCALE : BASE_SCALE + (0.04f * mRevealProgress))
+                .scaleY(armed ? ARMED_SCALE : BASE_SCALE + (0.04f * mRevealProgress))
+                .setDuration(140)
+                .start();
+        applyState();
+    }
+
+    public boolean containsTouch(float x, float y, boolean sticky) {
+        if (getVisibility() != VISIBLE) {
+            return false;
+        }
+        float left = getX();
+        float top = getY();
+        float right = left + getWidth();
+        float bottom = top + getHeight();
+        float margin = sticky ? mStickyMarginPx : mMagneticMarginPx;
+        return x >= left - margin && x <= right + margin
+                && y >= top - margin && y <= bottom + margin;
+    }
+
+    private void applyState() {
+        float alpha = BASE_ALPHA + ((MAX_ALPHA - BASE_ALPHA) * mRevealProgress);
+        if (mArmed) {
+            alpha = Math.max(alpha, 0.92f);
+        }
+        mBackgroundDrawable.setAlpha(Math.round(alpha * 255f));
+        mIconView.setAlpha(mArmed ? 1f : 0.74f + (0.26f * mRevealProgress));
+        if (!mArmed) {
+            setScaleX(BASE_SCALE + (0.04f * mRevealProgress));
+            setScaleY(BASE_SCALE + (0.04f * mRevealProgress));
+        }
+    }
+
+    private float clamp(float value) {
+        return Math.max(0f, Math.min(1f, value));
+    }
+
+    private float dpToPx(float dp) {
+        return TypedValue.applyDimension(
+                TypedValue.COMPLEX_UNIT_DIP, dp, getResources().getDisplayMetrics());
+    }
+}
