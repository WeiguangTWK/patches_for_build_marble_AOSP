+    private void updateMiniWindowEligibility() {
+        String packageName = mGestureState.getRunningTask() == null
+                ? null
+                : mGestureState.getRunningTask().getPackageName();
+        mMiniWindowEligible = !TextUtils.isEmpty(packageName)
+                && !MINI_WINDOW_SYSTEM_BLACKLIST.contains(packageName)
+                && !isPackageInMiniWindowBlacklist(packageName)
+                && mGestureState.getTopRunningTaskId() != -1;
+    }
+
+    private boolean isPackageInMiniWindowBlacklist(String packageName) {
+        String blacklist = Settings.System.getString(
+                mContext.getContentResolver(), Settings.System.POP_UP_NOTIFICATION_BLACKLIST);
+        if (TextUtils.isEmpty(blacklist)) {
+            return false;
+        }
+        for (String blockedPackage : blacklist.split(";")) {
+            if (packageName.equals(blockedPackage)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private void ensureMiniWindowDropTarget() {
+        if (!mMiniWindowEligible || mContainer == null || mMiniWindowDropTargetView != null) {
+            return;
+        }
+        removeMiniWindowDropTargetsFromDragLayer(mContainer.getDragLayer());
+        MiniWindowDropTargetView dropTargetView =
+                new MiniWindowDropTargetView(mContainer.asContext());
+        BaseDragLayer.LayoutParams lp = new BaseDragLayer.LayoutParams(
+                pxFromDp(MINI_WINDOW_DROP_TARGET_SIZE_DP),
+                pxFromDp(MINI_WINDOW_DROP_TARGET_SIZE_DP));
+        lp.gravity = Gravity.TOP | Gravity.END;
+        WindowInsets insets = mContainer.getDragLayer().getRootWindowInsets();
+        int topInset = insets == null ? 0 : insets.getInsets(WindowInsets.Type.systemBars()).top;
+        lp.topMargin = topInset + pxFromDp(MINI_WINDOW_DROP_TARGET_TOP_MARGIN_DP);
+        lp.rightMargin = pxFromDp(MINI_WINDOW_DROP_TARGET_RIGHT_MARGIN_DP);
+        mContainer.getDragLayer().addView(dropTargetView, lp);
+        mMiniWindowDropTargetView = dropTargetView;
+    }
+
+    private void updateMiniWindowDropTargetState() {
+        updateMiniWindowEligibility();
+        if (!canEnterMiniWindowInteraction()) {
+            clearMiniWindowDropTargetState();
+            return;
+        }
+        ensureMiniWindowDropTarget();
+        if (mMiniWindowDropTargetView == null) {
+            return;
+        }
+
+        boolean shouldShow = shouldShowMiniWindowDropTarget();
+        mMiniWindowDropTargetView.setVisibility(shouldShow ? View.VISIBLE : View.INVISIBLE);
+        if (!shouldShow) {
+            resetMiniWindowArmedState();
+            return;
+        }
+
+        mMiniWindowDropTargetView.setRevealProgress(getMiniWindowRevealProgress());
+
+        if (!mHasTouchPosition) {
+            return;
+        }
+
+        updateMiniWindowArmedState();
+    }
+
+    private boolean shouldLaunchMiniWindowOnRelease() {
+        return isMiniWindowReleaseTriggerSatisfied();
+    }
+
+    private boolean canEnterMiniWindowInteraction() {
+        return mMiniWindowEligible && mContainer != null && mGestureStarted
+                && !mStateCallback.hasStates(STATE_GESTURE_COMPLETED)
+                && !mMiniWindowLaunchRequested;
+    }
+
+    private boolean shouldShowMiniWindowDropTarget() {
+        return !mIsLikelyToStartNewTask && mCurrentShift.value > MINI_WINDOW_SHOW_SHIFT;
+    }
+
+    private float getMiniWindowRevealProgress() {
+        return Utilities.boundToRange(
+                (mCurrentShift.value - MINI_WINDOW_SHOW_SHIFT) / MINI_WINDOW_REVEAL_RANGE,
+                0f,
+                1f);
+    }
+
+    /**
+     * Release-to-launch is intentionally decoupled from swipe progress. Once the target is shown,
+     * only the armed state decides whether ACTION_UP launches the current task into mini-window.
+     */
+    private boolean isMiniWindowReleaseTriggerSatisfied() {
+        return mMiniWindowEligible && mMiniWindowArmed && !mMiniWindowLaunchRequested;
+    }
+
+    private void updateMiniWindowArmedState() {
+        boolean inTarget = mMiniWindowDropTargetView.containsTouch(
+                mLastTouchX, mLastTouchY, mMiniWindowArmed);
+        if (inTarget == mMiniWindowArmed) {
+            return;
+        }
+        mMiniWindowArmed = inTarget;
+        mMiniWindowDropTargetView.setArmed(inTarget);
+        if (inTarget && !mMiniWindowHapticPlayed) {
+            VibratorWrapper.INSTANCE.get(mContext).vibrate(OVERVIEW_HAPTIC);
+            mMiniWindowHapticPlayed = true;
+        } else if (!inTarget) {
+            mMiniWindowHapticPlayed = false;
+        }
+    }
+
+    private void resetMiniWindowArmedState() {
+        mMiniWindowArmed = false;
+        mMiniWindowHapticPlayed = false;
+        mMiniWindowDropTargetView.setArmed(false);
+    }
+
+    private void launchTaskAsMiniWindow() {
+        int taskId = mGestureState.getTopRunningTaskId();
+        if (taskId == -1) {
+            return;
+        }
+        TaskView launchTaskView = getMiniWindowLaunchTaskView(taskId);
+        TaskContainer launchTaskContainer = getMiniWindowLaunchTaskContainer(launchTaskView, taskId);
+        mMiniWindowLaunchRequested = true;
+        clearMiniWindowDropTargetState();
+        prepareLauncherForMiniWindowLaunch();
+
+        Runnable startMiniWindow = () -> {
+            prepareMiniWindowLaunchTransition(launchTaskView, launchTaskContainer, taskId);
+            ActivityOptions options = ActivityOptions.makeBasic();
+            options.setLaunchWindowingMode(WINDOWING_MODE_PINNED_WINDOW_EXT);
+            options.setSplashScreenStyle(SplashScreen.SPLASH_SCREEN_STYLE_ICON);
+            ActivityManagerWrapper.getInstance().startActivityFromRecents(taskId, options);
+            reset();
+            invalidateHandler();
+        };
+
+        if (mRecentsView != null) {
+            mRecentsView.switchToScreenshot(() -> mRecentsView.finishRecentsAnimation(
+                    /* toHome= */ true,
+                    /* shouldPip= */ false,
+                    () -> {
+                        if (mContainer != null) {
+                            mContainer.returnToHomescreen();
+                        }
+                        mRecentsView.getHandler().post(startMiniWindow);
+                    }));
+        } else if (mRecentsAnimationController != null) {
+            mRecentsAnimationController.finish(
+                    /* toHome= */ true,
+                    () -> {
+                        if (mContainer != null) {
+                            mContainer.returnToHomescreen();
+                        }
+                        startMiniWindow.run();
+                    },
+                    /* reason= */ new ActiveGestureLog.CompoundString(
+                            "AbsSwipeUpHandler.launchTaskAsMiniWindow"));
+        } else {
+            if (mContainer != null) {
+                mContainer.returnToHomescreen();
+            }
+            startMiniWindow.run();
+        }
+    }
+
+    private void prepareLauncherForMiniWindowLaunch() {
+        final GestureEndTarget endTarget = REJECT_HOME;
+        mGestureState.setEndTarget(endTarget, false /* isAtomic */);
+        mAnimationFactory.setEndTarget(endTarget);
+        if (mContainerInterface.getTaskbarInteractor() != null) {
+            mContainerInterface.getTaskbarInteractor().setUserIsNotGoingHome(false);
+        }
+    }
+
+    @Nullable
+    private TaskView getMiniWindowLaunchTaskView(int taskId) {
+        if (mRecentsView == null) {
+            return null;
+        }
+        TaskView runningTaskView = mRecentsView.getRunningTaskView();
+        if (runningTaskView != null && runningTaskView.containsTaskId(taskId)) {
+            return runningTaskView;
+        }
+        TaskView currentPageTaskView = mRecentsView.getCurrentPageTaskView();
+        if (currentPageTaskView != null && currentPageTaskView.containsTaskId(taskId)) {
+            return currentPageTaskView;
+        }
+        return mRecentsView.getTaskViewByTaskId(taskId);
+    }
+
+    @Nullable
+    private TaskContainer getMiniWindowLaunchTaskContainer(@Nullable TaskView taskView, int taskId) {
+        if (taskView == null) {
+            return null;
+        }
+        for (TaskContainer taskContainer : taskView.getTaskContainers()) {
+            if (taskContainer.getTask().key.id == taskId) {
+                return taskContainer;
+            }
+        }
+        return taskView.getTaskContainers().isEmpty() ? null : taskView.getTaskContainers().get(0);
+    }
+
+    private void prepareMiniWindowLaunchTransition(
+            @Nullable TaskView taskView,
+            @Nullable TaskContainer taskContainer,
+            int taskId) {
+        if (mRecentsView == null || taskView == null || taskContainer == null) {
+            return;
+        }
+        Bitmap thumbnail = createMiniWindowLaunchThumbnail(taskContainer, taskView);
+        if (thumbnail == null) {
+            return;
+        }
+
+        final Rect taskBounds = getMiniWindowLaunchTaskBounds(taskContainer, taskView);
+        final Runnable animStartedListener = () -> {
+            mRecentsView.setIgnoreResetTask(taskId);
+            taskView.setAlpha(0f);
+        };
+        AppTransitionAnimationSpecsFuture future =
+                new AppTransitionAnimationSpecsFuture(MINI_WINDOW_ANIMATION_HANDLER) {
+                    @Override
+                    public List<AppTransitionAnimationSpecCompat> composeSpecs() {
+                        return Collections.singletonList(
+                                new AppTransitionAnimationSpecCompat(taskId, thumbnail, taskBounds));
+                    }
+                };
+        try {
+            WindowManagerGlobal.getWindowManagerService()
+                    .overridePendingAppTransitionMultiThumbFuture(
+                            future.getFuture(),
+                            RecentsTransition.wrapStartedListener(
+                                    MINI_WINDOW_ANIMATION_HANDLER, animStartedListener),
+                            true /* scaleUp */,
+                            mGestureState.getDisplayId());
+        } catch (RemoteException e) {
+            Log.w(TAG, "Failed to override pending app transition for mini-window launch", e);
+        }
+    }
+
+    @Nullable
+    private Bitmap createMiniWindowLaunchThumbnail(TaskContainer taskContainer, TaskView taskView) {
+        if (enableRefactorTaskThumbnail()) {
