diff --git a/src/org/lineageos/lineageparts/integrity/IntegritySettings.java b/src/org/lineageos/lineageparts/integrity/IntegritySettings.java
new file mode 100644
index 0000000..16348b5
--- /dev/null
+++ b/src/org/lineageos/lineageparts/integrity/IntegritySettings.java
@@ -0,0 +1,478 @@
+// SPDX-License-Identifier: Apache-2.0
+package org.lineageos.lineageparts.integrity;
+
+import android.content.Intent;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.PlatformIntegrity;
+import android.os.PowerManager;
+import android.provider.Settings;
+import android.widget.Toast;
+import android.widget.EditText;
+import android.text.InputType;
+import androidx.appcompat.app.AlertDialog;
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreferenceCompat;
+import lineageos.preference.PartInfo;
+import lineageos.preference.PartsList;
+import org.lineageos.lineageparts.R;
+import org.lineageos.lineageparts.SettingsPreferenceFragment;
+
+/** Automatic device-wide permits; individual feature configuration stays independent. */
+public final class IntegritySettings extends SettingsPreferenceFragment {
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final Runnable mRefresh = new Runnable() {
+        @Override public void run() {
+            if (!isResumed()) return;
+            revokeExpiredPresentation();
+            refresh();
+            mHandler.postDelayed(this, 1000);
+        }
+    };
+    private final java.util.concurrent.ExecutorService mWorker =
+            java.util.concurrent.Executors.newSingleThreadExecutor();
+    private boolean mLoading, mChanging;
+    private int mGeneration;
+    private Bundle mSnapshot = new Bundle();
+    private SwitchPreferenceCompat mCompromise;
+    private final Preference[] mFeatures = new Preference[3];
+    private IntegrityStatusPreference mState;
+    private Preference mAlerts, mRecheck, mKsu;
+    private Preference mKsuGroup;
+    private String mShownAssetsToken = "";
+    private AlertDialog mAssetsDialog;
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        addPreferencesFromResource(R.xml.integrity_settings);
+        mState = findPreference("integrity_state");
+        mAlerts = findPreference("integrity_alerts");
+        mRecheck = findPreference("integrity_recheck");
+        mKsu = findPreference("integrity_ksu");
+        mKsuGroup = findPreference("integrity_ksu_group");
+        mKsuGroup.setVisible(false);
+        mKsu.setSummary(R.string.integrity_ksu_unavailable);
+        mKsu.setOnPreferenceClickListener(p -> { showKsu(); return true; });
+        mCompromise = findPreference("integrity_compromise");
+        mCompromise.setEnabled(false);
+        mRecheck.setEnabled(false);
+        mAlerts.setSummary(R.string.integrity_reason_checking);
+        mCompromise.setOnPreferenceChangeListener((preference, value) -> {
+            change(() -> PlatformIntegrity.requestCompromise((Boolean) value));
+            return false;
+        });
+        mState.setOnPreferenceClickListener(p -> {
+            if (needsReboot()) confirmReboot(); else showDetails();
+            return true;
+        });
+        mAlerts.setOnPreferenceClickListener(p -> { showDetails(); return true; });
+        mRecheck.setOnPreferenceClickListener(p -> { change(PlatformIntegrity::requestRecheck); return true; });
+        String[] keys = {"integrity_tee", "integrity_fas", "integrity_visibility"};
+        for (int i = 0; i < keys.length; i++) {
+            final int index = i;
+            mFeatures[i] = findPreference(keys[i]);
+            mFeatures[i].setSummary(R.string.integrity_reason_checking);
+            mFeatures[i].setOnPreferenceClickListener(p -> { showFeature(index); return true; });
+        }
+    }
+
+    private void failed() {
+        Toast.makeText(requireContext(), R.string.integrity_change_failed, Toast.LENGTH_LONG).show();
+    }
+
+    private void change(java.util.function.BooleanSupplier request) {
+        if (mChanging) return;
+        ++mGeneration;
+        mChanging = true;
+        mCompromise.setEnabled(false);
+        mRecheck.setEnabled(false);
+        mWorker.execute(() -> {
+            boolean result;
+            try { result = request.getAsBoolean(); }
+            catch (RuntimeException e) { result = false; }
+            final boolean saved = result;
+            mHandler.post(() -> {
+                mChanging = false;
+                if (!isAdded()) return;
+                if (!saved) failed();
+                if (isResumed()) refresh();
+            });
+        });
+    }
+
+    private void refresh() {
+        if (!isResumed() || mLoading || mChanging) return;
+        mLoading = true;
+        final int generation = mGeneration;
+        mWorker.execute(() -> {
+            Bundle state;
+            try { state = PlatformIntegrity.getState(); }
+            catch (RuntimeException e) { state = new Bundle(); }
+            final Bundle snapshot = state;
+            mHandler.post(() -> {
+                mLoading = false;
+                if (isResumed() && !mChanging && generation == mGeneration) render(snapshot);
+            });
+        });
+    }
+
+    private boolean needsReboot() {
+        String code = mSnapshot.getString("reason_code", "");
+        return mSnapshot.getBoolean("restart_required") && (code.equals("RESTART_REQUIRED")
+                || code.equals("RECOVERY_RESTART") || code.equals("CONTROL_INTERRUPTED"));
+    }
+
+    private void revokeExpiredPresentation() {
+        int shown = mSnapshot.getInt("effective_features", 0);
+        if (shown == 0 || PlatformIntegrity.current().allows(shown)) return;
+        // Binder may be slow or blocked. The local short lease must still
+        // expire the displayed permission without waiting for another reply.
+        Bundle expired = new Bundle(mSnapshot);
+        expired.putInt("effective_features", 0);
+        expired.putInt("allowed_features", 0);
+        expired.putString("state", "RESTRICTED_ERROR");
+        expired.putString("reason_code", "STALE");
+        expired.putString("coverage_code", "unavailable");
+        render(expired);
+    }
+
+    private String mode(String value) {
+        return getString(value.equals("COMPROMISE")
+                ? R.string.integrity_compromise_title : R.string.integrity_normal_mode);
+    }
+
+    private String recheckSummary() {
+        switch (mSnapshot.getString("syscall_recheck_status", "idle")) {
+            case "queued": return getString(R.string.integrity_recheck_queued);
+            case "running": return getString(R.string.integrity_recheck_running);
+            case "waiting_report": return getString(R.string.integrity_recheck_waiting_report);
+            case "completed": return getString(R.string.integrity_recheck_completed);
+            case "unsupported": return getString(R.string.integrity_recheck_unsupported);
+            case "throttled": return getString(R.string.integrity_recheck_throttled);
+            case "failed": return getString(R.string.integrity_recheck_failed);
+            default: return getString(R.string.integrity_recheck_summary);
+        }
+    }
+
+    private String coverage() {
+        if (mSnapshot.getBoolean("resident_partial_accepted", false))
+            return getString(R.string.integrity_partial_resident_coverage);
+        switch (mSnapshot.getString("coverage_code", "unavailable")) {
+            case "full": return getString(R.string.integrity_full_coverage);
+            case "limited": return getString(R.string.integrity_limited_coverage);
+            case "later_digest": return getString(R.string.integrity_later_digest_coverage);
+            default: return getString(R.string.integrity_coverage_unavailable);
+        }
+    }
+
+    private String reason() {
+        int resource;
+        switch (mSnapshot.getString("reason_code", "SERVICE_UNAVAILABLE")) {
+            case "CHECKING": resource = R.string.integrity_reason_checking; break;
+case "READY": resource = R.string.integrity_reason_ready; break;
+case "COMPROMISE_READY": resource = R.string.integrity_reason_compromise; break;
+case "UNKNOWN_MODULE": resource = R.string.integrity_reason_unknown; break;
+case "SYSCALL_CHANGED": resource = R.string.integrity_reason_syscall; break;
+case "HASH_MISMATCH": resource = R.string.integrity_reason_hash; break;
+case "EVIDENCE_LOST": resource = R.string.integrity_reason_lost; break;
+case "RECOVERY_RESTART": resource = R.string.integrity_reason_recovery_restart; break;
+case "HISTORICAL_ALERTS": resource = R.string.integrity_reason_historical; break;
+case "COVERAGE_INCOMPLETE": resource = R.string.integrity_reason_coverage; break;
+case "ENDPOINTS_UNCONFIRMED": resource = R.string.integrity_reason_endpoints; break;
+case "RESTART_REQUIRED": resource = R.string.integrity_reason_restart; break;
+case "CONTROL_INTERRUPTED": resource = R.string.integrity_reason_interrupted; break;
+case "POLICY_UNAVAILABLE": resource = R.string.integrity_reason_policy; break;
+case "POLICY_PENDING": resource = R.string.integrity_reason_policy_pending; break;
+case "STALE": resource = R.string.integrity_reason_stale; break;
+case "COLLECTOR_UNAVAILABLE": resource = R.string.integrity_reason_collector; break;
+case "CONTROL_UNAVAILABLE": resource = R.string.integrity_reason_control; break;
+case "TEE_UNAVAILABLE": resource = R.string.integrity_reason_tee; break;
+case "VALIDATION_FAILED": resource = R.string.integrity_reason_validation; break;
+            default: resource = R.string.integrity_reason_unavailable;
+        }
+        return getString(resource);
+    }
+
+    private String cardReason() {
+        switch (mSnapshot.getString("reason_code", "")) {
+            case "CHECKING": return getString(R.string.integrity_card_checking);
+            case "READY": return getString(R.string.integrity_card_ready);
+            case "COMPROMISE_READY": return getString(R.string.integrity_card_compromise);
+            case "UNKNOWN_MODULE": return getString(R.string.integrity_card_unknown);
+            case "SYSCALL_CHANGED": return getString(R.string.integrity_card_syscall);
+            case "HASH_MISMATCH": return getString(R.string.integrity_card_hash);
+            case "EVIDENCE_LOST": return getString(R.string.integrity_card_lost);
+            default: return reason();
+        }
+    }
+
+    private void render(Bundle state) {
+        mSnapshot = state;
+        String requested = state.getString("requested", "");
+        String status = state.getString("state", "BOOT_UNKNOWN");
+        String code = state.getString("reason_code", "SERVICE_UNAVAILABLE");
+        int permits = state.getInt("effective_features", 0) & state.getInt("allowed_features", 0);
+        boolean ready = permits != 0 && (status.equals("NORMAL_READY")
+                || status.equals("COMPROMISE_ACTIVE"));
+        boolean anomaly = code.equals("UNKNOWN_MODULE") || code.equals("SYSCALL_CHANGED")
+                || code.equals("HASH_MISMATCH") || code.equals("EVIDENCE_LOST");
+        boolean checking = code.equals("CHECKING");
+        int title = needsReboot() ? R.string.integrity_waiting_restart
+                : ready ? (status.equals("NORMAL_READY") ? R.string.integrity_ready : R.string.integrity_active)
+                : checking ? R.string.integrity_checking
+                : anomaly || code.equals("HISTORICAL_ALERTS") ? R.string.integrity_restricted
+                : R.string.integrity_cannot_verify;
+        int icon = ready ? R.drawable.ic_integrity_check
+                : needsReboot() || checking ? R.drawable.ic_integrity_wait
+                : anomaly ? R.drawable.ic_integrity_warning : R.drawable.ic_integrity_info;
+        String currentMode = mode(state.getString("mode", "NORMAL"));
+        String targetMode = mode(requested.equals("COMPROMISE") || requested.equals("ENTER_COMPROMISE")
+                ? "COMPROMISE" : "NORMAL");
+        String badge = requested.equals("ENTER_COMPROMISE") || requested.equals("EXIT_COMPROMISE")
+                ? getString(R.string.integrity_target_mode, targetMode) : currentMode;
+        String metrics = coverage() + "\n" + getString(R.string.integrity_permit_count,
+                Integer.bitCount(permits));
+        if (state.getBoolean("collection_healthy", false)
+                && state.getBoolean("classification_ready", false)
+                && !state.getBoolean("resident_partial_accepted", false)
+                && state.getInt("early_name_only_rows", 0) != 0) {
+            metrics += "\n" + getString(R.string.integrity_early_unverified_count,
+                    state.getInt("early_name_only_rows", 0));
+        }
+        if (state.getBoolean("current_findings_available", false)
+                && state.getInt("current_module_count", 0) != 0)
+            metrics += "\n" + getString(R.string.integrity_current_modules,
+                    state.getInt("current_module_count", 0));
+        mState.setPresentation(getString(title), cardReason(), badge, metrics,
+                getString(needsReboot() ? R.string.integrity_restart_action : R.string.integrity_view_details),
+                anomaly ? 2 : ready || checking ? 0 : 1, icon);
+        boolean supported = PlatformIntegrity.enabled() && !requested.isEmpty();
+        mCompromise.setEnabled(supported);
+        mRecheck.setEnabled(supported);
+        mRecheck.setSummary(recheckSummary());
+        mCompromise.setChecked(requested.equals("ENTER_COMPROMISE") || requested.equals("COMPROMISE"));
+        mAlerts.setSummary(alertSummary());
+        java.util.ArrayList<Bundle> candidates = state.getParcelableArrayList("ksu_candidates", Bundle.class);
+        boolean hasCandidate = state.getBoolean("current_findings_available", false)
+                && candidates != null && !candidates.isEmpty();
+        mKsuGroup.setVisible(hasCandidate);
+        mKsu.setVisible(hasCandidate);
+        mKsu.setSummary(ksuSummary());
+        maybeShowAssets();
+        for (int i = 0; i < mFeatures.length; i++) {
+            boolean allowed = (permits & (1 << i)) != 0;
+            mFeatures[i].setIcon(allowed ? R.drawable.ic_integrity_check : R.drawable.ic_integrity_info);
+            mFeatures[i].setSummary(allowed ? getString(R.string.integrity_feature_permitted)
+                    : getString(R.string.integrity_managed_blocked, reason()));
+        }
+    }
+
+    private String alertSummary() {
+        String text = getString(R.string.integrity_alarm_count, mSnapshot.getInt("historical_alarms", 0));
+        if (mSnapshot.getBoolean("alarm_overflow")) text += "\n" + getString(R.string.integrity_alarm_overflow);
+        if (mSnapshot.getBoolean("evidence_lost")) text += "\n" + getString(R.string.integrity_evidence_lost);
+        if (mSnapshot.getBoolean("legacy_alarm_uncertain")) text += "\n" + getString(R.string.integrity_legacy_alarm_uncertain);
+        return text;
+    }
+
+    private String ksuSummary() {
+        Bundle source = mSnapshot.getBundle("ksu_source");
+        if (source != null) switch (source.getString("status", "")) {
+            case "listing": return getString(R.string.integrity_ksu_listing);
+            case "downloading": return getString(R.string.integrity_ksu_downloading);
+            case "verifying": case "offline": return getString(R.string.integrity_ksu_verifying);
+            case "choose_asset": return getString(R.string.integrity_ksu_choose_asset);
+            case "unsupported": return getString(R.string.integrity_ksu_unsupported_file);
+            case "different": return getString(R.string.integrity_ksu_different_file);
+            case "asset_limit": return getString(R.string.integrity_ksu_asset_limit);
+            case "failed": case "capacity":
+                return getString(R.string.integrity_ksu_retry);
+        }
+        java.util.ArrayList<Bundle> candidates = mSnapshot.getParcelableArrayList("ksu_candidates", Bundle.class);
+        if (candidates != null && !candidates.isEmpty()) {
+            java.util.ArrayList<String> names = new java.util.ArrayList<>();
+            for (Bundle candidate : candidates) {
+                if (candidate.getString("status", "").equals("source_verified"))
+                    return getString(R.string.integrity_ksu_verified, candidate.getString("verified_name", ""));
+                java.util.ArrayList<String> forks = candidate.getStringArrayList("fork_names");
+                if (forks != null) names.add(String.join(" / ", forks));
+            }
+            return getString(R.string.integrity_ksu_pending, String.join(", ", names));
+        }
+        String status = mSnapshot.getString("ksu_candidate_status", "unavailable");
+        return getString(status.equals("observed") ? R.string.integrity_ksu_none
+                : status.equals("partial") ? R.string.integrity_ksu_partial : R.string.integrity_ksu_unavailable);
+    }
+
+    private void showKsu() {
+        String text = ksuSummary();
+        java.util.ArrayList<Bundle> candidates = mSnapshot.getParcelableArrayList("ksu_candidates", Bundle.class);
+        if (candidates != null) for (Bundle candidate : candidates) {
+            text += "\n\n" + candidate.getString("module_name", "") + ".ko";
+            java.util.ArrayList<String> repos = candidate.getStringArrayList("repositories");
+            if (repos != null) text += "\n" + String.join(" / ", repos);
+            if (candidate.getString("status", "").equals("source_verified")) {
+                text += "\n" + getString(R.string.integrity_ksu_release_info, candidate.getString("verified_tag", ""));
+                text += "\n" + getString(R.string.integrity_ksu_file_info, candidate.getString("verified_asset", ""));
+            }
+            text += "\n" + getString(R.string.integrity_ksu_manager_hash,
+                    candidate.getString("manager_certificate_sha256", ""));
+        }
+        if (mSnapshot.getString("ksu_candidate_status", "").equals("partial"))
+            text += "\n\n" + getString(R.string.integrity_ksu_partial);
+        AlertDialog.Builder dialog = new AlertDialog.Builder(requireContext()).setTitle(R.string.integrity_ksu_title)
+                .setMessage(text).setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(R.string.integrity_ksu_verify_action, (d, which) -> chooseSourceFork());
+        if (!mSnapshot.getBoolean("ksu_source_ready", false)) dialog.setPositiveButton(android.R.string.ok, null);
+        Bundle source = mSnapshot.getBundle("ksu_source");
+        if (source != null && source.getString("status", "").matches("listing|choose_asset|downloading|verifying|offline")) {
+            dialog.setPositiveButton(android.R.string.ok, null);
+            dialog.setNeutralButton(R.string.integrity_ksu_cancel, (d, which) -> cancelSource(source));
+        }
+        dialog.show();
+    }
+
+    private void sourceRequest(Bundle request) {
+        if (mChanging) return;
+        ++mGeneration; mChanging = true;
+        mWorker.execute(() -> {
+            Bundle result;
+            try { result = PlatformIntegrity.requestKernelSuSource(request); }
+            catch (RuntimeException e) { result = new Bundle(); }
+            final boolean rejected = result.getString("status", "rejected").equals("rejected");
+            mHandler.post(() -> {
+                mChanging = false;
+                if (!isAdded()) return;
+                if (rejected) Toast.makeText(requireContext(), R.string.integrity_ksu_request_rejected,
+                        Toast.LENGTH_LONG).show();
+                if (isResumed()) refresh();
+            });
+        });
+    }
+    private void cancelSource(Bundle source) {
+        Bundle request = new Bundle(); request.putString("action", "cancel");
+        request.putString("token", source.getString("token", "")); sourceRequest(request);
+    }
+    private void chooseSourceFork() {
+        java.util.ArrayList<Bundle> rows = mSnapshot.getParcelableArrayList("ksu_candidates", Bundle.class);
+        if (rows == null || rows.isEmpty()) return;
+        java.util.ArrayList<Bundle> choices = new java.util.ArrayList<>();
+        java.util.ArrayList<String> labels = new java.util.ArrayList<>();
+        for (Bundle row : rows) {
+            java.util.ArrayList<String> repos = row.getStringArrayList("repositories"), names = row.getStringArrayList("fork_names");
+            if (repos == null || names == null) continue;
+            for (int i = 0; i < repos.size(); ++i) {
+                Bundle choice = new Bundle(); choice.putLong("load_id", row.getLong("load_id"));
+                choice.putString("repository", repos.get(i)); choices.add(choice);
+                labels.add(names.get(i) + " · " + repos.get(i));
+            }
+        }
+        if (choices.size() == 1) enterReleaseTag(choices.get(0));
+        else if (!choices.isEmpty()) new AlertDialog.Builder(requireContext())
+                .setTitle(R.string.integrity_ksu_choose_fork).setItems(labels.toArray(new String[0]),
+                    (d, which) -> enterReleaseTag(choices.get(which))).setNegativeButton(android.R.string.cancel, null).show();
+    }
+    private void enterReleaseTag(Bundle choice) {
+        EditText tag = new EditText(requireContext());
+        tag.setSingleLine(true); tag.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI);
+        tag.setHint(R.string.integrity_ksu_tag_hint);
+        new AlertDialog.Builder(requireContext()).setTitle(R.string.integrity_ksu_release_title)
+                .setMessage(getString(R.string.integrity_ksu_release_help, choice.getString("repository")))
+                .setView(tag).setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(R.string.integrity_ksu_query_action, (d, which) -> {
+                    Bundle request = new Bundle(choice); request.putString("action", "list");
+                    request.putString("tag", tag.getText().toString().trim()); sourceRequest(request);
+                }).show();
+    }
+    private void maybeShowAssets() {
+        Bundle source = mSnapshot.getBundle("ksu_source");
+        if (!isResumed() || source == null || !source.getString("status", "").equals("choose_asset")) return;
+        String token = source.getString("token", "");
+        if (token.isEmpty() || token.equals(mShownAssetsToken)) return;
+        java.util.ArrayList<Bundle> assets = source.getParcelableArrayList("assets", Bundle.class);
+        if (assets == null) return;
+        mShownAssetsToken = token;
+        String[] labels = new String[assets.size()];
+        for (int i = 0; i < assets.size(); ++i) labels[i] = assets.get(i).getString("name", "");
+        int[] selected = {-1};
+        AlertDialog.Builder dialog = new AlertDialog.Builder(requireContext()).setTitle(R.string.integrity_ksu_choose_asset)
+                .setOnCancelListener(d -> cancelSource(source))
+                .setNegativeButton(android.R.string.cancel, (d, which) -> cancelSource(source));
+        if (assets.isEmpty()) dialog.setMessage(R.string.integrity_ksu_no_assets);
+        else dialog.setSingleChoiceItems(labels, -1, (d, which) -> {
+            selected[0] = which; ((AlertDialog) d).getButton(AlertDialog.BUTTON_POSITIVE).setEnabled(true);
+        }).setPositiveButton(R.string.integrity_ksu_download_action, (d, which) -> {
+            if (selected[0] < 0) return;
+            Bundle request = new Bundle(); request.putString("action", "download");
+            request.putString("token", token); request.putLong("asset_id", assets.get(selected[0]).getLong("id"));
+            sourceRequest(request);
+        });
+        mAssetsDialog = dialog.create(); mAssetsDialog.show();
+        if (!assets.isEmpty()) mAssetsDialog.getButton(AlertDialog.BUTTON_POSITIVE).setEnabled(false);
+    }
+
+    private void showDetails() {
+        String text = reason() + "\n\n" + coverage();
+        if (mSnapshot.getBoolean("current_findings_available", false)) {
+            text += "\n\n" + getString(R.string.integrity_current_modules,
+                    mSnapshot.getInt("current_module_count", 0));
+            java.util.ArrayList<String> current = mSnapshot.getStringArrayList("current_module_names");
+            if (current != null && !current.isEmpty()) text += "\n" + String.join(", ", current);
+        } else text += "\n\n" + getString(R.string.integrity_current_modules_pending);
+        text += "\n\n" + alertSummary();
+        java.util.ArrayList<String> names = mSnapshot.getStringArrayList("alarm_names");
+        if (names != null && !names.isEmpty()) text += "\n" + String.join(", ", names);
+        text += "\n\n" + getString(R.string.integrity_recovery_help);
+        new AlertDialog.Builder(requireContext()).setTitle(R.string.integrity_details_title)
+                .setMessage(text).setPositiveButton(android.R.string.ok, null).show();
+    }
+
+    private void showFeature(int index) {
+        int[] explanations = {R.string.integrity_tee_explain, R.string.integrity_fas_explain,
+                R.string.integrity_visibility_explain};
+        new AlertDialog.Builder(requireContext()).setTitle(mFeatures[index].getTitle())
+                .setMessage(mFeatures[index].getSummary() + "\n\n" + getString(explanations[index]))
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(R.string.integrity_open_settings, (dialog, which) -> {
+                    try {
+                        if (index == 2) startActivity(new Intent(Settings.ACTION_MANAGE_APPLICATIONS_SETTINGS));
+                        else {
+                            PartInfo part = PartsList.get(requireContext()).getPartInfo(
+                                    index == 0 ? "tee_soft_debug" : "fas");
+                            if (part == null || !part.isAvailable()) { failed(); return; }
+                            startActivity(part.getIntentForActivity());
+                        }
+                    } catch (RuntimeException e) { failed(); }
+                }).show();
+    }
+
+    private void confirmReboot() {
+        new AlertDialog.Builder(requireContext()).setTitle(R.string.integrity_restart_action)
+                .setMessage(R.string.integrity_restart_confirm)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(R.string.integrity_restart_action, (dialog, which) -> {
+                    if (!needsReboot()) return;
+                    try { requireContext().getSystemService(PowerManager.class).reboot(null); }
+                    catch (RuntimeException e) { failed(); }
+                }).show();
+    }
+
+    @Override public void onViewCreated(android.view.View view, Bundle state) {
+        super.onViewCreated(view, state);
+        setDivider(null);
+    }
+
+    @Override public void onResume() {
+        super.onResume();
+        ++mGeneration;
+        mHandler.removeCallbacks(mRefresh);
+        mHandler.post(mRefresh);
+    }
+    @Override public void onPause() {
+        ++mGeneration; mHandler.removeCallbacks(mRefresh);
+        if (mAssetsDialog != null) { mAssetsDialog.dismiss(); mAssetsDialog = null; mShownAssetsToken = ""; }
+        super.onPause();
+    }
+    @Override public void onDestroy() { mWorker.shutdown(); super.onDestroy(); }
+}
