@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: Apache-2.0
+package org.lineageos.lineageparts.integrity;
+
+import android.content.Context;
+import android.content.res.TypedArray;
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.util.AttributeSet;
+import android.widget.ImageView;
+import android.widget.TextView;
+import androidx.core.graphics.ColorUtils;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+import java.util.Objects;
+import org.lineageos.lineageparts.R;
+
+/** A tonal status card, with the same lifecycle as the surrounding preference list. */
+public final class IntegrityStatusPreference extends Preference {
+    private String mMode = "", mMetrics = "", mAction = "";
+    private int mTone, mIcon = R.drawable.ic_integrity_info;
+
+    public IntegrityStatusPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.integrity_status_card);
+    }
+
+    public void setPresentation(String title, String summary, String mode, String metrics,
+            String action, int tone, int icon) {
+        if (Objects.equals(getTitle(), title) && Objects.equals(getSummary(), summary)
+                && mMode.equals(mode) && mMetrics.equals(metrics) && mAction.equals(action)
+                && mTone == tone && mIcon == icon) return;
+        mMode = mode;
+        mMetrics = metrics;
+        mAction = action;
+        mTone = tone;
+        mIcon = icon;
+        setTitle(title);
+        setSummary(summary);
+        notifyChanged();
+    }
+
+    @Override public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        TypedArray theme = getContext().obtainStyledAttributes(new int[] {
+                android.R.attr.colorBackground, android.R.attr.colorAccent,
+                android.R.attr.textColorPrimary});
+        int background = theme.getColor(0, Color.WHITE);
+        int accent = theme.getColor(1, Color.GRAY);
+        int foreground = theme.getColor(2, Color.BLACK);
+        theme.recycle();
+        int tint = mTone == 2 ? getContext().getColor(R.color.trust_status_bad)
+                : mTone == 1 ? getContext().getColor(R.color.trust_status_poor) : accent;
+        GradientDrawable shape = new GradientDrawable();
+        shape.setColor(ColorUtils.blendARGB(background, tint, 0.16f));
+        shape.setCornerRadius(24 * getContext().getResources().getDisplayMetrics().density);
+        holder.findViewById(R.id.integrity_card).setBackground(shape);
+        ImageView icon = (ImageView) holder.findViewById(R.id.integrity_card_icon);
+        icon.setImageResource(mIcon);
+        icon.setColorFilter(foreground);
+        ((TextView) holder.findViewById(R.id.integrity_card_mode)).setText(mMode);
+        ((TextView) holder.findViewById(R.id.integrity_card_metrics)).setText(mMetrics);
+        ((TextView) holder.findViewById(R.id.integrity_card_action)).setText(mAction);
+        holder.setDividerAllowedAbove(false);
+        holder.setDividerAllowedBelow(false);
+    }
+}
