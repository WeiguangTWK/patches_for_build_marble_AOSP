diff --git a/src/org/lineageos/lineageparts/fas/FasAppPreference.java b/src/org/lineageos/lineageparts/fas/FasAppPreference.java
new file mode 100644
index 0000000..e4d0f7c
--- /dev/null
+++ b/src/org/lineageos/lineageparts/fas/FasAppPreference.java
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package org.lineageos.lineageparts.fas;
+
+import android.content.Context;
+import android.app.fas.FasManager;
+import android.view.View;
+import android.widget.PopupMenu;
+import android.widget.TextView;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+import org.lineageos.lineageparts.R;
+import java.util.function.IntConsumer;
+
+/** A single app row; persistence belongs to the caller, not the preference. */
+final class FasAppPreference extends Preference {
+    private static final int[] MODES = {FasManager.MODE_AUTO, FasManager.MODE_ENABLED,
+            120, 60, 30, FasManager.MODE_DISABLED};
+    private static final int[] LABELS = {R.string.fas_auto, R.string.fas_on,
+            R.string.fas_120, R.string.fas_60, R.string.fas_30, R.string.fas_off};
+    private final IntConsumer mOnSelected;
+    private int mMode;
+    private View mAnchor;
+
+    FasAppPreference(Context context, int mode, IntConsumer onSelected) {
+        super(context);
+        mMode = mode;
+        mOnSelected = onSelected;
+        setPersistent(false);
+        setWidgetLayoutResource(R.layout.fas_mode_widget);
+        setOnPreferenceClickListener(pref -> {
+            if (mAnchor == null) return false;
+            PopupMenu popup = new PopupMenu(getContext(), mAnchor);
+            for (int i = 0; i < MODES.length; i++) {
+                popup.getMenu().add(1, i + 1, i, LABELS[i]).setChecked(MODES[i] == mMode);
+            }
+            popup.getMenu().setGroupCheckable(1, true, true);
+            popup.setOnMenuItemClickListener(item -> {
+                mOnSelected.accept(MODES[item.getItemId() - 1]);
+                return true;
+            });
+            popup.show();
+            return true;
+        });
+    }
+
+    void setMode(int mode) { mMode = mode; notifyChanged(); }
+
+    @Override public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        mAnchor = holder.findViewById(R.id.fas_mode);
+        int label = LABELS[0];
+        for (int i = 0; i < MODES.length; i++) if (MODES[i] == mMode) label = LABELS[i];
+        String value = getContext().getString(label);
+        ((TextView) mAnchor).setText(value);
+        holder.itemView.setContentDescription(getContext().getString(
+                R.string.fas_app_mode_accessibility, getTitle(), value));
+    }
+}
diff --git a/src/org/lineageos/lineageparts/fas/FasSettings.java b/src/org/lineageos/lineageparts/fas/FasSettings.java
new file mode 100644
index 0000000..3ccc1e1
--- /dev/null
+++ b/src/org/lineageos/lineageparts/fas/FasSettings.java
@@ -0,0 +1,193 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package org.lineageos.lineageparts.fas;
+
+import android.app.fas.FasManager;
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.graphics.drawable.Drawable;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.view.Menu;
+import android.view.MenuInflater;
+import android.widget.SearchView;
+import android.widget.Toast;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.SwitchPreferenceCompat;
+import org.lineageos.lineageparts.R;
+import org.lineageos.lineageparts.SettingsPreferenceFragment;
+import java.text.Collator;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+public final class FasSettings extends SettingsPreferenceFragment {
+    private final FasManager mManager = new FasManager();
+    private final ExecutorService mWorker = Executors.newSingleThreadExecutor();
+    private final Handler mMain = new Handler(Looper.getMainLooper());
+    private final List<App> mApps = new ArrayList<>();
+    private Bundle mModes = new Bundle();
+    private SwitchPreferenceCompat mEnabled;
+    private PreferenceCategory mAppList;
+    private String mQuery = "";
+    private int mLoadVersion;
+    private boolean mLocated;
+
+    private static final class App {
+        final ApplicationInfo info;
+        final String label;
+        final Drawable icon;
+        App(ApplicationInfo info, PackageManager pm) {
+            this.info = info;
+            label = info.loadLabel(pm).toString();
+            icon = info.loadIcon(pm);
+        }
+    }
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        addPreferencesFromResource(R.xml.fas_settings);
+        setHasOptionsMenu(true);
+        mEnabled = findPreference("fas_enabled");
+        mAppList = findPreference("fas_apps");
+        mAppList.setOrderingAsAdded(true);
+        mEnabled.setEnabled(false);
+        mEnabled.setOnPreferenceChangeListener((pref, value) -> {
+            mEnabled.setEnabled(false);
+            mWorker.execute(() -> {
+                boolean saved;
+                try { saved = mManager.setEnabled((Boolean) value); }
+                catch (Exception e) { saved = false; }
+                final boolean success = saved;
+                mMain.post(() -> {
+                    if (!isAdded() || getView() == null) return;
+                    mEnabled.setEnabled(true);
+                    if (success) mEnabled.setChecked((Boolean) value); else showFailure();
+                });
+            });
+            return false;
+        });
+    }
+
+    @Override public void onResume() {
+        super.onResume();
+        final int version = ++mLoadVersion;
+        final Context context = requireContext().getApplicationContext();
+        final int user = UserHandle.myUserId();
+        mWorker.execute(() -> {
+            try {
+                Bundle config = mManager.getConfiguration(user);
+                PackageManager pm = context.getPackageManager();
+                List<App> apps = new ArrayList<>();
+                for (ApplicationInfo info : pm.getInstalledApplications(0)) apps.add(new App(info, pm));
+                mMain.post(() -> {
+                    if (!isAdded() || getView() == null || version != mLoadVersion) return;
+                    mApps.clear();
+                    mApps.addAll(apps);
+                    mModes = config.getBundle(FasManager.KEY_MODES);
+                    if (mModes == null) mModes = new Bundle();
+                    mEnabled.setChecked(config.getBoolean(FasManager.KEY_ENABLED));
+                    mEnabled.setEnabled(true);
+                    render();
+                });
+            } catch (Exception e) {
+                mMain.post(() -> {
+                    if (!isAdded() || getView() == null || version != mLoadVersion) return;
+                    mEnabled.setEnabled(false);
+                    mAppList.removeAll();
+                    showFailure();
+                });
+            }
+        });
+    }
+
+    @Override public void onPause() { ++mLoadVersion; super.onPause(); }
+    @Override public void onDestroy() { mWorker.shutdown(); super.onDestroy(); }
+
+    private boolean priority(App app) {
+        return app.info.category == ApplicationInfo.CATEGORY_GAME
+                || mModes.getInt(app.info.packageName, FasManager.MODE_AUTO) != FasManager.MODE_AUTO;
+    }
+
+    private void render() {
+        Collator collator = Collator.getInstance();
+        mApps.sort((a, b) -> {
+            int group = Boolean.compare(priority(b), priority(a));
+            if (group != 0) return group;
+            int label = collator.compare(a.label, b.label);
+            return label != 0 ? label : a.info.packageName.compareTo(b.info.packageName);
+        });
+        mAppList.removeAll();
+        String query = mQuery.toLowerCase(Locale.ROOT);
+        for (App app : mApps) {
+            String pkg = app.info.packageName;
+            if (!app.label.toLowerCase(Locale.ROOT).contains(query)
+                    && !pkg.toLowerCase(Locale.ROOT).contains(query)) continue;
+            FasAppPreference row = new FasAppPreference(requireContext(),
+                    mModes.getInt(pkg, FasManager.MODE_AUTO), mode -> saveMode(pkg, mode));
+            row.setKey(pkg);
+            row.setTitle(app.label);
+            row.setSummary(pkg);
+            row.setIcon(app.icon);
+            mAppList.addPreference(row);
+        }
+        Bundle args = getArguments();
+        String target = args == null ? null : args.getString("package");
+        if (!mLocated && target != null && findPreference(target) != null) {
+            mLocated = true;
+            scrollToPreference(target);
+            highlightPreferenceIfNeeded();
+        }
+    }
+
+    private void saveMode(String pkg, int mode) {
+        FasAppPreference row = findPreference(pkg);
+        if (row == null) return;
+        row.setEnabled(false);
+        final int user = UserHandle.myUserId();
+        mWorker.execute(() -> {
+            boolean saved;
+            try { saved = mManager.setAppMode(pkg, user, mode); }
+            catch (Exception e) { saved = false; }
+            final boolean success = saved;
+            mMain.post(() -> {
+                if (!isAdded() || getView() == null) return;
+                if (success) mModes.putInt(pkg, mode); else showFailure();
+                FasAppPreference current = findPreference(pkg);
+                if (current != null) {
+                    current.setEnabled(true);
+                    if (success) current.setMode(mode);
+                }
+                // Do not sort here: changing the mode must not move the row under the user.
+            });
+        });
+    }
+
+    private void showFailure() {
+        Toast.makeText(requireContext(), R.string.fas_save_failed, Toast.LENGTH_LONG).show();
+    }
+
+    @Override public void onCreateOptionsMenu(Menu menu, MenuInflater inflater) {
+        super.onCreateOptionsMenu(menu, inflater);
+        SearchView search = new SearchView(requireContext());
+        search.setQueryHint(getString(R.string.fas_search));
+        search.setOnQueryTextListener(new SearchView.OnQueryTextListener() {
+            @Override public boolean onQueryTextSubmit(String query) { return true; }
+            @Override public boolean onQueryTextChange(String query) {
+                mQuery = query;
+                render();
+                return true;
+            }
+        });
+        menu.add(R.string.fas_search)
+                .setIcon(com.android.settingslib.search.widget.R.drawable.ic_search_24dp)
+                .setContentDescription(getString(R.string.fas_search))
+                .setActionView(search)
+                .setShowAsAction(android.view.MenuItem.SHOW_AS_ACTION_ALWAYS
+                        | android.view.MenuItem.SHOW_AS_ACTION_COLLAPSE_ACTION_VIEW);
+    }
+}
