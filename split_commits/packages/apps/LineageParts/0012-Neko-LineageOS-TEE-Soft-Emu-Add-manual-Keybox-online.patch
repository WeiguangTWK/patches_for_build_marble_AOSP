+++ b/src/org/lineageos/lineageparts/teedebug/TeeSoftAdvancedSettings.java
@@ -0,0 +1,161 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.lineageos.lineageparts.teedebug;
+
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.InputType;
+import android.text.format.DateFormat;
+import android.widget.Toast;
+
+import androidx.preference.EditTextPreference;
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import org.lineageos.lineageparts.R;
+import org.lineageos.lineageparts.SettingsPreferenceFragment;
+
+import java.io.IOException;
+import java.util.Date;
+import java.util.Map;
+
+public class TeeSoftAdvancedSettings extends SettingsPreferenceFragment {
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private EditTextPreference mUrl;
+    private ListPreference mFormat;
+    private Preference mUpdate;
+    private Preference mResult;
+    private String mSource = "";
+    private String mEncoding = KeyboxUpdater.RAW;
+    private final Runnable mRefresh = new Runnable() {
+        @Override
+        public void run() {
+            if (!isResumed()) return;
+            boolean wasBusy = KeyboxUpdater.busy();
+            refresh();
+            // One final refresh also covers completion between reading config and busy state.
+            if (wasBusy || KeyboxUpdater.busy()) mHandler.postDelayed(this, 500);
+        }
+    };
+
+    @Override
+    public void onActivityCreated(Bundle state) {
+        super.onActivityCreated(state);
+        addPreferencesFromResource(R.xml.tee_soft_advanced_settings);
+        if (requireActivity().getActionBar() != null) {
+            requireActivity().getActionBar().setTitle(R.string.tee_soft_advanced_title);
+        }
+        mUrl = findPreference("tee_soft_update_url");
+        mFormat = findPreference("tee_soft_update_format");
+        mUpdate = findPreference("tee_soft_update_now");
+        mResult = findPreference("tee_soft_update_result");
+        mUrl.setOnBindEditTextListener(edit -> {
+            edit.setSingleLine(true);
+            edit.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI);
+        });
+        mUrl.setOnPreferenceChangeListener((preference, value) -> {
+            String source = value.toString().trim();
+            if (!source.isEmpty() && !KeyboxUpdater.validUrl(source)) {
+                Toast.makeText(requireContext(), R.string.tee_soft_update_invalid_url,
+                        Toast.LENGTH_LONG).show();
+                return false;
+            }
+            return save(KeyboxUpdater.URL_KEY, source);
+        });
+        mFormat.setOnPreferenceChangeListener((preference, value) -> {
+            String encoding = value.toString();
+            if (!(KeyboxUpdater.RAW.equals(encoding) || KeyboxUpdater.BASE64.equals(encoding))) {
+                return false;
+            }
+            return save(KeyboxUpdater.FORMAT_KEY, encoding);
+        });
+        mUpdate.setOnPreferenceClickListener(preference -> {
+            // Capture the source and format for this job; later page edits cannot change it.
+            boolean started = KeyboxUpdater.startUpdate(mSource, mEncoding, error -> {
+                if (!isResumed()) return;
+                refresh();
+                Toast.makeText(requireContext(), error == 0
+                        ? R.string.tee_soft_update_success : error, Toast.LENGTH_LONG).show();
+            });
+            if (started) {
+                mHandler.removeCallbacks(mRefresh);
+                mRefresh.run();
+            }
+            return true;
+        });
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        mHandler.removeCallbacks(mRefresh);
+        mRefresh.run();
+    }
+
+    @Override
+    public void onPause() {
+        mHandler.removeCallbacks(mRefresh);
+        super.onPause();
+    }
+
+    private boolean save(String key, String value) {
+        try {
+            TeeSoftDebugConfig.update(Map.of(key, value));
+            refresh();
+            return true;
+        } catch (IOException e) {
+            Toast.makeText(requireContext(), R.string.tee_soft_update_error_save,
+                    Toast.LENGTH_LONG).show();
+            return false;
+        }
+    }
+
+    private void refresh() {
+        final Map<String, String> config;
+        try {
+            config = TeeSoftDebugConfig.read();
+        } catch (IOException e) {
+            mUrl.setEnabled(false);
+            mFormat.setEnabled(false);
+            mUpdate.setEnabled(false);
+            mResult.setVisible(true);
+            mResult.setSummary(R.string.tee_soft_update_error_config);
+            return;
+        }
+        boolean busy = KeyboxUpdater.busy();
+        mSource = config.getOrDefault(KeyboxUpdater.URL_KEY, "");
+        mEncoding = KeyboxUpdater.BASE64.equals(config.get(KeyboxUpdater.FORMAT_KEY))
+                ? KeyboxUpdater.BASE64 : KeyboxUpdater.RAW;
+        mUrl.setText(mSource);
+        if (mSource.isEmpty()) mUrl.setSummary(R.string.tee_soft_update_url_unset);
+        else mUrl.setSummary(mSource);
+        mFormat.setValue(mEncoding);
+        mFormat.setSummary(mFormat.getEntry());
+        mUrl.setEnabled(!busy);
+        mFormat.setEnabled(!busy);
+        mUpdate.setEnabled(!busy && KeyboxUpdater.validUrl(mSource));
+        mUpdate.setSummary(busy ? getString(R.string.tee_soft_update_busy) : null);
+        String result = KeyboxUpdater.lastResult();
+        if (result == null) result = config.getOrDefault(KeyboxUpdater.RESULT_KEY, "");
+        mResult.setVisible(!result.isEmpty());
+        if ("success".equals(result)) {
+            try {
+                long timestamp = Long.parseLong(config.getOrDefault(KeyboxUpdater.TIME_KEY, "0"));
+                if (timestamp <= 0) {
+                    mResult.setSummary(R.string.tee_soft_update_success);
+                    return;
+                }
+                String time = DateFormat.getMediumDateFormat(requireContext()).format(new Date(timestamp))
+                        + " " + DateFormat.getTimeFormat(requireContext()).format(new Date(timestamp));
+                mResult.setSummary(getString(R.string.tee_soft_update_success_at, time));
+            } catch (NumberFormatException e) {
+                mResult.setSummary(R.string.tee_soft_update_success);
+            }
+        } else if (!result.isEmpty()) {
+            mResult.setSummary(KeyboxUpdater.errorResource(result));
+        }
+    }
+}
diff --git a/src/org/lineageos/lineageparts/teedebug/TeeSoftDebugConfig.java b/src/org/lineageos/lineageparts/teedebug/TeeSoftDebugConfig.java
new file mode 100644
index 0000000..e2cfcdb
--- /dev/null
+++ b/src/org/lineageos/lineageparts/teedebug/TeeSoftDebugConfig.java
@@ -0,0 +1,91 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.lineageos.lineageparts.teedebug;
+
+import android.system.ErrnoException;
+import android.system.Os;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Shared read/merge/write lock for both settings pages and Keybox installation. */
+final class TeeSoftDebugConfig {
+    static final File DIRECTORY = new File("/data/adbroot/tee_soft_debug");
+    static final File KEYBOX = new File(DIRECTORY, "keybox.xml");
+    private static final File CONFIG = new File(DIRECTORY, "config.conf");
+
+    private TeeSoftDebugConfig() {}
+
+    static synchronized Map<String, String> read() throws IOException {
+        Map<String, String> values = new LinkedHashMap<>();
+        if (!CONFIG.exists()) return values;
+        try (FileInputStream in = new FileInputStream(CONFIG)) {
+            if (in.getChannel().size() > 1024 * 1024) {
+                throw new IOException("Configuration is too large");
+            }
+            String content = new String(in.readAllBytes(), StandardCharsets.UTF_8);
+            for (String line : content.split("\\R")) {
+                int separator = line.indexOf('=');
+                if (separator <= 0) continue;
+                values.put(line.substring(0, separator).trim(),
+                        line.substring(separator + 1).trim());
+            }
+        }
+        return values;
+    }
+
+    static synchronized void update(Map<String, String> changes) throws IOException {
+        // Re-read under the lock: a page must not overwrite another page's newer fields.
+        Map<String, String> values = read();
+        values.putAll(changes);
+        StringBuilder content = new StringBuilder();
+        for (Map.Entry<String, String> entry : values.entrySet()) {
+            if (entry.getKey().contains("=") || entry.getKey().contains("\n")
+                    || entry.getKey().contains("\r") || entry.getValue().contains("\n")
+                    || entry.getValue().contains("\r")) {
+                throw new IOException("Invalid configuration field");
+            }
+            content.append(entry.getKey()).append('=').append(entry.getValue()).append('\n');
+        }
+        replace(CONFIG, content.toString().getBytes(StandardCharsets.UTF_8));
+    }
+
+    static boolean enabled(Map<String, String> values, String key) {
+        return "1".equals(values.get(key)) || "true".equalsIgnoreCase(values.get(key));
+    }
+
+    static void prepareDirectory() throws IOException {
+        try {
+            if (!DIRECTORY.isDirectory() && !DIRECTORY.mkdirs()) {
+                throw new IOException("Cannot create Keybox directory");
+            }
+            Os.chmod(DIRECTORY.getAbsolutePath(), 0755);
+        } catch (ErrnoException e) {
+            throw new IOException("Cannot prepare Keybox directory", e);
+        }
+    }
+
+    static void replace(File target, byte[] data) throws IOException {
+        prepareDirectory();
+        File temporary = File.createTempFile(".tee-soft-", ".tmp", DIRECTORY);
+        try {
+            try (FileOutputStream out = new FileOutputStream(temporary)) {
+                out.write(data);
+                Os.fchmod(out.getFD(), 0644);
+                out.getFD().sync();
+            }
+            Os.rename(temporary.getAbsolutePath(), target.getAbsolutePath());
+        } catch (ErrnoException e) {
+            throw new IOException("Cannot replace Keybox data", e);
+        } finally {
+            temporary.delete();
+        }
+    }
+}
