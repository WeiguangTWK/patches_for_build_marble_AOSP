diff --git a/src/org/lineageos/lineageparts/teedebug/KeyboxUpdater.java b/src/org/lineageos/lineageparts/teedebug/KeyboxUpdater.java
new file mode 100644
index 0000000..d225058
--- /dev/null
+++ b/src/org/lineageos/lineageparts/teedebug/KeyboxUpdater.java
@@ -0,0 +1,248 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.lineageos.lineageparts.teedebug;
+
+import android.content.ContentResolver;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.system.ErrnoException;
+import android.system.Os;
+
+import org.lineageos.lineageparts.R;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URI;
+import java.net.URISyntaxException;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.function.Consumer;
+
+/** One process-wide job shared by local imports and network updates, independent of fragments. */
+final class KeyboxUpdater {
+    static final String URL_KEY = "update_url";
+    static final String FORMAT_KEY = "update_format";
+    static final String RESULT_KEY = "update_result";
+    static final String TIME_KEY = "update_time";
+    static final String RAW = "raw";
+    static final String BASE64 = "base64";
+    static final int MAX_BYTES = 1024 * 1024;
+    private static final long TIMEOUT_MS = 60000;
+    private static final AtomicBoolean BUSY = new AtomicBoolean();
+    private static final ExecutorService WORKER = Executors.newSingleThreadExecutor();
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+    // Resource IDs are never persisted: persisted result codes remain stable across ROM updates.
+    private static volatile String sLastResult;
+
+    private KeyboxUpdater() {}
+
+    static boolean busy() { return BUSY.get(); }
+    static String lastResult() { return sLastResult; }
+
+    static boolean validUrl(String value) {
+        if (value.isEmpty() || value.length() > 8192) return false;
+        try {
+            URI uri = new URI(value);
+            return ("https".equalsIgnoreCase(uri.getScheme())
+                    || "http".equalsIgnoreCase(uri.getScheme()))
+                    && uri.getHost() != null && uri.getRawUserInfo() == null
+                    && uri.getRawFragment() == null;
+        } catch (URISyntaxException e) {
+            return false;
+        }
+    }
+
+    static int errorResource(String result) {
+        if ("download".equals(result)) return R.string.tee_soft_update_error_download;
+        if ("decode".equals(result)) return R.string.tee_soft_update_error_decode;
+        if ("xml".equals(result)) return R.string.tee_soft_update_error_xml;
+        return R.string.tee_soft_update_error_save;
+    }
+
+    static boolean startUpdate(String source, String format, Consumer<Integer> callback) {
+        if (!validUrl(source) || !(RAW.equals(format) || BASE64.equals(format))
+                || !BUSY.compareAndSet(false, true)) return false;
+        WORKER.execute(() -> {
+            String result = "download";
+            int error = 0;
+            try {
+                byte[] data = download(source);
+                result = "decode";
+                if (BASE64.equals(format)) {
+                    // BASIC decoding rejects non-alphabet content; tolerate whitespace only.
+                    String encoded = new String(data, StandardCharsets.US_ASCII)
+                            .replaceAll("[ \\t\\r\\n]", "");
+                    data = Base64.getDecoder().decode(encoded);
+                }
+                result = "xml";
+                validate(data);
+                result = "save";
+                install(data, true);
+                result = "success";
+            } catch (IOException | IllegalArgumentException | SecurityException e) {
+                // Never log a user URL, response body or private key.
+                error = errorResource(result);
+                try {
+                    TeeSoftDebugConfig.update(Map.of(RESULT_KEY, result));
+                } catch (IOException | SecurityException ignored) {
+                    // Report the current outcome in this process even when storage is unavailable.
+                }
+            } finally {
+                sLastResult = result;
+                BUSY.set(false);
+                final int outcome = error;
+                MAIN.post(() -> callback.accept(outcome));
+            }
+        });
+        return true;
+    }
+
+    static boolean startImport(ContentResolver resolver, Uri uri, Consumer<Integer> callback) {
+        if (!BUSY.compareAndSet(false, true)) return false;
+        WORKER.execute(() -> {
+            int error = 0;
+            try {
+                final byte[] data;
+                try (InputStream in = resolver.openInputStream(uri)) {
+                    if (in == null) throw new IOException("Cannot open selected document");
+                    data = readLimited(in, 0);
+                }
+                validate(data);
+                install(data, false);
+            } catch (IOException | SecurityException e) {
+                error = R.string.tee_soft_debug_keybox_pick_failed;
+            } finally {
+                BUSY.set(false);
+                final int outcome = error;
+                MAIN.post(() -> callback.accept(outcome));
+            }
+        });
+        return true;
+    }
+
+    private static void validate(byte[] data) throws IOException {
+        if (data.length == 0 || data.length > MAX_BYTES) {
+            throw new IOException("Keybox size is invalid");
+        }
+        KeyboxXmlValidator.validate(data);
+    }
+
+    private static byte[] download(String source) throws IOException {
+        URL url = new URL(source);
+        long deadline = SystemClock.elapsedRealtime() + TIMEOUT_MS;
+        for (int redirects = 0; redirects <= 5; redirects++) {
+            checkDeadline(deadline);
+            HttpURLConnection connection = (HttpURLConnection) url.openConnection();
+            try {
+                connection.setInstanceFollowRedirects(false);
+                connection.setConnectTimeout(15000);
+                connection.setReadTimeout(15000);
+                connection.setUseCaches(false);
+                connection.setRequestProperty("Accept-Encoding", "identity");
+                int status = connection.getResponseCode();
+                checkDeadline(deadline);
+                if (status == 301 || status == 302 || status == 303
+                        || status == 307 || status == 308) {
+                    String location = connection.getHeaderField("Location");
+                    if (location == null) throw new IOException("Missing redirect location");
+                    URL next = new URL(url, location);
+                    if (!validUrl(next.toString()) || ("https".equalsIgnoreCase(url.getProtocol())
+                            && !"https".equalsIgnoreCase(next.getProtocol()))) {
+                        throw new IOException("Unsupported redirect");
+                    }
+                    url = next;
+                    continue;
+                }
+                if (status != HttpURLConnection.HTTP_OK
+                        || connection.getContentLengthLong() > MAX_BYTES) {
+                    throw new IOException("Unexpected HTTP response");
+                }
+                try (InputStream in = connection.getInputStream()) {
+                    return readLimited(in, deadline);
+                }
+            } finally {
+                connection.disconnect();
+            }
+        }
+        throw new IOException("Too many redirects");
+    }
+
+    private static byte[] readLimited(InputStream in, long deadline) throws IOException {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        byte[] buffer = new byte[8192];
+        int count;
+        while ((count = in.read(buffer)) != -1) {
+            if (deadline != 0) checkDeadline(deadline);
+            if (out.size() + count > MAX_BYTES) throw new IOException("Response is too large");
+            out.write(buffer, 0, count);
+        }
+        if (deadline != 0) checkDeadline(deadline);
+        return out.toByteArray();
+    }
+
+    private static void checkDeadline(long deadline) throws IOException {
+        if (SystemClock.elapsedRealtime() >= deadline) throw new IOException("Download timed out");
+    }
+
+    private static void install(byte[] data, boolean network) throws IOException {
+        synchronized (TeeSoftDebugConfig.class) {
+            // Read first so an unreadable config cannot be replaced with defaults.
+            TeeSoftDebugConfig.read();
+            TeeSoftDebugConfig.prepareDirectory();
+            File target = TeeSoftDebugConfig.KEYBOX;
+            File backup = null;
+            boolean replaced = false;
+            try {
+                if (target.exists()) {
+                    backup = File.createTempFile(".keybox-backup-", ".tmp",
+                            TeeSoftDebugConfig.DIRECTORY);
+                    try (FileInputStream in = new FileInputStream(target);
+                            FileOutputStream out = new FileOutputStream(backup)) {
+                        in.transferTo(out);
+                        Os.fchmod(out.getFD(), 0644);
+                        out.getFD().sync();
+                    }
+                }
+                TeeSoftDebugConfig.replace(target, data);
+                replaced = true;
+                Map<String, String> changes = new HashMap<>();
+                changes.put("keybox_path", target.getAbsolutePath());
+                if (network) {
+                    changes.put(RESULT_KEY, "success");
+                    changes.put(TIME_KEY, Long.toString(System.currentTimeMillis()));
+                }
+                TeeSoftDebugConfig.update(changes);
+            } catch (IOException | ErrnoException | SecurityException e) {
+                IOException failure = new IOException("Cannot install Keybox", e);
+                if (replaced) {
+                    try {
+                        if (backup != null) Os.rename(backup.getAbsolutePath(), target.getAbsolutePath());
+                        else Os.unlink(target.getAbsolutePath());
+                    } catch (ErrnoException restoreError) {
+                        failure.addSuppressed(restoreError);
+                        // Preserve the backup for recovery if restoring the old file failed.
+                        backup = null;
+                    }
+                }
+                throw failure;
+            } finally {
+                if (backup != null) backup.delete();
+            }
+        }
+    }
+}
diff --git a/src/org/lineageos/lineageparts/teedebug/KeyboxXmlValidator.java b/src/org/lineageos/lineageparts/teedebug/KeyboxXmlValidator.java
new file mode 100644
index 0000000..4517098
--- /dev/null
+++ b/src/org/lineageos/lineageparts/teedebug/KeyboxXmlValidator.java
@@ -0,0 +1,107 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.lineageos.lineageparts.teedebug;
+
+import android.util.Xml;
+
+import org.xmlpull.v1.XmlPullParser;
+import org.xmlpull.v1.XmlPullParserException;
+
+import java.io.IOException;
+import java.io.StringReader;
+import java.nio.ByteBuffer;
+import java.nio.charset.CharacterCodingException;
+import java.nio.charset.CodingErrorAction;
+import java.nio.charset.StandardCharsets;
+
+/** Installation-time structure check only; Keystore2 still validates actual signing material. */
+final class KeyboxXmlValidator {
+    private static final int MAX_DEPTH = 64;
+    private static final int MAX_TOKENS = 100000;
+
+    private KeyboxXmlValidator() {}
+
+    static void validate(byte[] data) throws IOException {
+        final String xml;
+        try {
+            // Keystore2 reads this file as UTF-8, regardless of an XML encoding declaration.
+            xml = StandardCharsets.UTF_8.newDecoder()
+                    .onMalformedInput(CodingErrorAction.REPORT)
+                    .onUnmappableCharacter(CodingErrorAction.REPORT)
+                    .decode(ByteBuffer.wrap(data)).toString();
+        } catch (CharacterCodingException e) {
+            throw new IOException("Keybox must be UTF-8", e);
+        }
+        XmlPullParser parser = Xml.newPullParser();
+        try {
+            parser.setFeature(XmlPullParser.FEATURE_PROCESS_NAMESPACES, false);
+            parser.setFeature(XmlPullParser.FEATURE_PROCESS_DOCDECL, false);
+            parser.setInput(new StringReader(xml));
+            int roots = 0;
+            int tokens = 0;
+            int keyDepth = 0;
+            boolean hasKeys = false;
+            boolean validKey = false;
+            boolean privateKey = false;
+            boolean certificate = false;
+            boolean legacyPrivateKey = false;
+            boolean legacyCertificate = false;
+            String field = null;
+            int fieldDepth = 0;
+            boolean fieldHasText = false;
+            int event;
+            while ((event = parser.nextToken()) != XmlPullParser.END_DOCUMENT) {
+                if (++tokens > MAX_TOKENS || parser.getDepth() > MAX_DEPTH) {
+                    throw new IOException("Keybox XML exceeds structural limits");
+                }
+                if (event == XmlPullParser.DOCDECL) {
+                    throw new IOException("Keybox XML must not contain a DTD");
+                }
+                if (event == XmlPullParser.START_TAG) {
+                    if (parser.getDepth() == 1) roots++;
+                    if (field != null) throw new IOException("Nested Keybox field");
+                    String name = parser.getName();
+                    if ("Key".equals(name)) {
+                        if (keyDepth != 0) throw new IOException("Nested Key entry");
+                        hasKeys = true;
+                        keyDepth = parser.getDepth();
+                        privateKey = false;
+                        certificate = false;
+                    } else if ("PrivateKey".equals(name) || "Certificate".equals(name)) {
+                        field = name;
+                        fieldDepth = parser.getDepth();
+                        fieldHasText = false;
+                    }
+                } else if (event == XmlPullParser.TEXT && field != null) {
+                    fieldHasText |= !parser.getText().trim().isEmpty();
+                } else if (field != null && (event == XmlPullParser.CDSECT
+                        || event == XmlPullParser.ENTITY_REF)) {
+                    // The consumer extracts literal tag contents; it does not expand these.
+                    throw new IOException("Unsupported encoded Keybox field");
+                } else if (event == XmlPullParser.END_TAG) {
+                    if (field != null && parser.getDepth() == fieldDepth) {
+                        if (keyDepth != 0) {
+                            if ("PrivateKey".equals(field)) privateKey |= fieldHasText;
+                            else certificate |= fieldHasText;
+                        } else {
+                            if ("PrivateKey".equals(field)) legacyPrivateKey |= fieldHasText;
+                            else legacyCertificate |= fieldHasText;
+                        }
+                        field = null;
+                    }
+                    if ("Key".equals(parser.getName()) && parser.getDepth() == keyDepth) {
+                        validKey |= privateKey && certificate;
+                        keyDepth = 0;
+                    }
+                }
+            }
+            if (roots != 1 || !(hasKeys ? validKey : legacyPrivateKey && legacyCertificate)) {
+                throw new IOException("Keybox needs a private key and certificate in one entry");
+            }
+        } catch (XmlPullParserException e) {
+            throw new IOException("Malformed Keybox XML", e);
+        }
+    }
+}
diff --git a/src/org/lineageos/lineageparts/teedebug/TeeSoftAdvancedSettings.java b/src/org/lineageos/lineageparts/teedebug/TeeSoftAdvancedSettings.java
new file mode 100644
