+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.lineageos.lineageparts.teedebug;
+
+import android.net.LocalSocket;
+import android.net.LocalSocketAddress;
+import android.os.SystemClock;
+import android.os.SystemProperties;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.lineageos.lineageparts.R;
+
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.function.Consumer;
+
+/** Fixed, versioned protocol. Never forwards arbitrary HAL commands or logs key material. */
+final class RkpIssuerClient {
+    private static final String SERVICE = "tee_soft_rkp_issuer";
+    private static final int MAX_FRAME = 128 * 1024;
+
+    static final class Failure extends IOException {
+        final String stage;
+        final int code;
+        Failure(String stage, int code) {
+            super("RKP issuance failed");
+            this.stage = stage;
+            this.code = code;
+        }
+    }
+
+    private RkpIssuerClient() {}
+
+    static byte[] issue(String job, boolean resume, Consumer<String> progress) throws IOException {
+        if (!resume) {
+            try {
+                SystemProperties.set("ctl.start", SERVICE);
+            } catch (RuntimeException e) {
+                throw new Failure("starting", -1);
+            }
+        }
+        long deadline = SystemClock.elapsedRealtime() + 150000;
+        long readyDeadline = SystemClock.elapsedRealtime() + 5000;
+        String stage = "starting";
+        boolean received = false;
+        while (SystemClock.elapsedRealtime() < deadline) {
+            JSONObject reply;
+            try {
+                // Repeated start with the same job ID is idempotent. Resume never starts issuance.
+                reply = exchange(job, !resume && !received ? "start" : "query");
+            } catch (IOException e) {
+                if (SystemClock.elapsedRealtime() >= readyDeadline) throw new Failure(stage, -1);
+                pause();
+                continue;
+            }
+            received = true;
+            try {
+                stage = reply.getString("stage");
+                progress.accept(stage);
+                String status = reply.getString("status");
+                if ("error".equals(status)) throw new Failure(stage, reply.getInt("code"));
+                if ("success".equals(status)) {
+                    byte[] xml = reply.getString("xml").getBytes(StandardCharsets.UTF_8);
+                    if (xml.length == 0 || xml.length > MAX_FRAME / 2) throw new Failure("verify", -1);
+                    return xml;
+                }
+                if (!"running".equals(status)) throw new Failure(stage, -1);
+            } catch (JSONException e) {
+                throw new Failure(stage, -1);
+            }
+            // Allow brief transport failures when reconnecting to an existing task.
+            readyDeadline = SystemClock.elapsedRealtime() + 5000;
+            pause();
+        }
+        throw new Failure(stage, -2);
+    }
+
+    static void acknowledge(String job) {
+        try {
+            exchange(job, "ack");
+        } catch (IOException ignored) {
+            // Helper also discards unclaimed results and exits after its idle timeout.
+        }
+    }
+
+    private static JSONObject exchange(String job, String action) throws IOException {
+        try (LocalSocket socket = new LocalSocket()) {
+            socket.connect(new LocalSocketAddress(SERVICE, LocalSocketAddress.Namespace.RESERVED));
+            // connect() creates the underlying FD; setOption() cannot run before that.
+            socket.setSoTimeout(3000);
+            if (socket.getPeerCredentials().getUid() != 1000) throw new IOException("Invalid issuer peer");
+            JSONObject request = new JSONObject();
+            request.put("version", 1);
+            request.put("action", action);
+            request.put("job", job);
+            byte[] data = request.toString().getBytes(StandardCharsets.UTF_8);
+            DataOutputStream out = new DataOutputStream(socket.getOutputStream());
+            out.writeInt(data.length);
+            out.write(data);
+            out.flush();
+            DataInputStream in = new DataInputStream(socket.getInputStream());
+            int length = in.readInt();
+            if (length <= 0 || length > MAX_FRAME) throw new IOException("Invalid issuer frame");
+            byte[] response = new byte[length];
+            in.readFully(response);
+            JSONObject reply = new JSONObject(new String(response, StandardCharsets.UTF_8));
+            if (reply.getInt("version") != 1 || !job.equals(reply.getString("job"))) {
+                throw new IOException("Invalid issuer reply");
+            }
+            return reply;
+        } catch (JSONException e) {
+            throw new IOException("Invalid issuer protocol", e);
+        }
+    }
+
+    private static void pause() throws IOException {
+        try {
+            Thread.sleep(500);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new IOException("Issuer wait interrupted", e);
+        }
+    }
+
+    static int stageResource(String stage) {
+        switch (stage) {
+            case "generate": return R.string.tee_soft_rkp_stage_generate;
+            case "hardware": return R.string.tee_soft_rkp_stage_hardware;
+            case "challenge": return R.string.tee_soft_rkp_stage_challenge;
+            case "csr": return R.string.tee_soft_rkp_stage_csr;
+            case "submit": return R.string.tee_soft_rkp_stage_submit;
+            case "verify": return R.string.tee_soft_rkp_stage_verify;
+            case "ready": return R.string.tee_soft_rkp_stage_receive;
+            case "install": return R.string.tee_soft_rkp_stage_install;
+            case "complete": return R.string.tee_soft_rkp_success;
+            default: return R.string.tee_soft_rkp_stage_starting;
+        }
+    }
+}
