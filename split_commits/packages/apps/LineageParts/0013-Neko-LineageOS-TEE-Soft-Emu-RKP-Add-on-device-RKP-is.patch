diff --git a/native/rkp_issuer/issuer.cpp b/native/rkp_issuer/issuer.cpp
new file mode 100644
index 0000000..58957dd
--- /dev/null
+++ b/native/rkp_issuer/issuer.cpp
@@ -0,0 +1,489 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ * V1 zero-HBK request/CSR assembly adapted from Duck-ToolBox db43a2d and
+ * LazyBonesLZY/rkp-v1-oracle b28480c (MIT). See NOTICE for the upstream licenses.
+ */
+#include <aidl/android/hardware/security/keymint/DeviceInfo.h>
+#include <aidl/android/hardware/security/keymint/IRemotelyProvisionedComponent.h>
+#include <aidl/android/hardware/security/keymint/MacedPublicKey.h>
+#include <aidl/android/hardware/security/keymint/ProtectedData.h>
+#include <aidl/android/hardware/security/keymint/RpcHardwareInfo.h>
+#include <android-base/properties.h>
+#include <android-base/unique_fd.h>
+#include <android/binder_manager.h>
+#include <cppbor.h>
+#include <cppbor_parse.h>
+#include <curl/curl.h>
+#include <cutils/sockets.h>
+#include <json/json.h>
+#include <openssl/bio.h>
+#include <openssl/bn.h>
+#include <openssl/crypto.h>
+#include <openssl/ec.h>
+#include <openssl/evp.h>
+#include <openssl/hkdf.h>
+#include <openssl/hmac.h>
+#include <openssl/pem.h>
+#include <openssl/x509.h>
+#include <arpa/inet.h>
+#include <poll.h>
+#include <signal.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cerrno>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+using Bytes = std::vector<uint8_t>;
+using Clock = std::chrono::steady_clock;
+namespace km = aidl::android::hardware::security::keymint;
+constexpr size_t kMaxFrame = 128 * 1024;
+constexpr size_t kMaxCbor = 64 * 1024;
+constexpr const char* kService =
+        "android.hardware.security.keymint.IRemotelyProvisionedComponent/default";
+constexpr const char* kServer = "https://remoteprovisioning.googleapis.com/v1";
+
+struct Failure : std::exception {
+    explicit Failure(int value) : code(value) {}
+    int code;
+};
+void require(bool ok, int code = -1) { if (!ok) throw Failure(code); }
+
+struct State {
+    std::mutex mutex;
+    std::string job;
+    std::string status = "idle";
+    std::string stage = "waiting";
+    std::string xml;
+    int code = 0;
+    bool acknowledged = false;
+    Clock::time_point finished;
+} state;
+
+void setStage(const char* stage) {
+    std::lock_guard lock(state.mutex);
+    state.stage = stage;
+}
+void clearSecret(std::string& value) {
+    if (!value.empty()) OPENSSL_cleanse(value.data(), value.size());
+    value.clear();
+}
+
+// Bound recursion/container sizes BEFORE handing untrusted CBOR to cppbor.
+void scanCbor(const Bytes& data, size_t& pos, unsigned depth) {
+    require(depth <= 16 && pos < data.size());
+    uint8_t head = data[pos++];
+    unsigned major = head >> 5;
+    unsigned additional = head & 31;
+    require(additional < 28);
+    uint64_t count = additional;
+    if (additional >= 24) {
+        unsigned width = 1u << (additional - 24);
+        require(width <= data.size() - pos);
+        count = 0;
+        for (unsigned i = 0; i < width; ++i) count = (count << 8) | data[pos++];
+    }
+    if (major == 2 || major == 3) {
+        require(count <= data.size() - pos);
+        pos += count;
+    } else if (major == 4 || major == 5) {
+        require(count <= 128);
+        if (major == 5) count *= 2;
+        for (uint64_t i = 0; i < count; ++i) scanCbor(data, pos, depth + 1);
+    } else if (major == 6) {
+        scanCbor(data, pos, depth + 1);
+    }
+}
+std::unique_ptr<cppbor::Item> parse(const Bytes& data) {
+    require(!data.empty() && data.size() <= kMaxCbor);
+    size_t position = 0;
+    scanCbor(data, position, 0);
+    require(position == data.size());
+    auto [item, end, error] = cppbor::parse(data);
+    require(item && end == data.data() + data.size() && error.empty());
+    return std::move(item);
+}
+const cppbor::Array& array(const cppbor::Item& value, size_t minimum) {
+    auto* result = value.asArray();
+    require(result && result->size() >= minimum);
+    return *result;
+}
+Bytes bytes(const cppbor::Item& value) {
+    auto* result = value.asBstr();
+    require(result != nullptr);
+    return result->value();
+}
+
+std::string base64(const uint8_t* data, size_t size, bool url = false) {
+    require(size < kMaxFrame);
+    std::string result(4 * ((size + 2) / 3) + 1, '\0');
+    int length = EVP_EncodeBlock(reinterpret_cast<uint8_t*>(result.data()), data, size);
+    require(length >= 0);
+    result.resize(length);
+    if (url) {
+        std::replace(result.begin(), result.end(), '+', '-');
+        std::replace(result.begin(), result.end(), '/', '_');
+        // Duck uses padded Base64Url for the challenge query parameter.
+    }
+    return result;
+}
+size_t receiveBody(char* data, size_t size, size_t count, void* context) {
+    auto& out = *static_cast<Bytes*>(context);
+    if (size && count > std::numeric_limits<size_t>::max() / size) return 0;
+    size_t length = size * count;
+    if (length > kMaxCbor - out.size()) return 0;
+    out.insert(out.end(), data, data + length);
+    return length;
+}
+Bytes post(const std::string& endpoint, const Bytes& body) {
+    std::unique_ptr<CURL, decltype(&curl_easy_cleanup)> curl(curl_easy_init(), curl_easy_cleanup);
+    require(curl != nullptr);
+    curl_slist* rawHeaders = curl_slist_append(nullptr, "Content-Type: application/cbor");
+    require(rawHeaders != nullptr);
+    std::unique_ptr<curl_slist, decltype(&curl_slist_free_all)> headers(rawHeaders, curl_slist_free_all);
+    // Google RPC methods are colon-suffixed on /v1, not child paths.
+    std::string url = std::string(kServer) + ":" + endpoint;
+    Bytes response;
+    curl_easy_setopt(curl.get(), CURLOPT_URL, url.c_str());
+    curl_easy_setopt(curl.get(), CURLOPT_HTTPHEADER, headers.get());
+    curl_easy_setopt(curl.get(), CURLOPT_POSTFIELDS, body.data());
+    curl_easy_setopt(curl.get(), CURLOPT_POSTFIELDSIZE_LARGE, static_cast<curl_off_t>(body.size()));
+    curl_easy_setopt(curl.get(), CURLOPT_CONNECTTIMEOUT, 15L);
+    curl_easy_setopt(curl.get(), CURLOPT_TIMEOUT, 40L);
+    curl_easy_setopt(curl.get(), CURLOPT_NOSIGNAL, 1L);
+    curl_easy_setopt(curl.get(), CURLOPT_FOLLOWLOCATION, 0L);
+    curl_easy_setopt(curl.get(), CURLOPT_PROXY, "");
+    curl_easy_setopt(curl.get(), CURLOPT_SSL_VERIFYPEER, 1L);
+    curl_easy_setopt(curl.get(), CURLOPT_SSL_VERIFYHOST, 2L);
+    curl_easy_setopt(curl.get(), CURLOPT_CAPATH, "/system/etc/security/cacerts");
+    curl_easy_setopt(curl.get(), CURLOPT_WRITEFUNCTION, receiveBody);
+    curl_easy_setopt(curl.get(), CURLOPT_WRITEDATA, &response);
+    CURLcode status = curl_easy_perform(curl.get());
+    require(status == CURLE_OK, -1000 - static_cast<int>(status));
+    long http = 0;
+    curl_easy_getinfo(curl.get(), CURLINFO_RESPONSE_CODE, &http);
+    require(http == 200, static_cast<int>(http));
+    return response;
+}
+
+Bytes macedPublicKey(const Bytes& publicKey) {
+    std::array<uint8_t, 32> hbk{}, key{}, tag{};
+    constexpr char context[] = "Key to MAC public keys";
+    require(HKDF(key.data(), key.size(), EVP_sha256(), hbk.data(), hbk.size(), nullptr, 0,
+                 reinterpret_cast<const uint8_t*>(context), sizeof(context) - 1) == 1);
+    Bytes protectedHeaders = cppbor::Map().add(1, 5).encode();
+    Bytes structure = cppbor::Array().add("MAC0").add(protectedHeaders).add(Bytes{})
+            .add(publicKey).encode();
+    unsigned length = 0;
+    require(HMAC(EVP_sha256(), key.data(), key.size(), structure.data(), structure.size(),
+                 tag.data(), &length) != nullptr && length == tag.size());
+    OPENSSL_cleanse(key.data(), key.size());
+    return cppbor::Array().add(protectedHeaders).add(cppbor::Map()).add(publicKey)
+            .add(Bytes(tag.begin(), tag.end())).encode();
+}
+
+// These two opaque byte sequences must not be decoded/re-encoded for CSR construction.
+Bytes assembleCsr(const Bytes& device, const Bytes& protectedData, const Bytes& challenge,
+                  const cppbor::Map& publicKey, const Bytes& tag) {
+    auto deviceValue = parse(device);
+    auto protectedValue = parse(protectedData);
+    require(deviceValue->asMap() && deviceValue->asMap()->size() != 0 && tag.size() == 32);
+    const auto& encryption = array(*protectedValue, 4);
+    require(encryption.size() == 4);
+    auto headers = parse(bytes(*encryption[0]));
+    require(headers->asMap() != nullptr);
+    const auto& algorithm = headers->asMap()->get(1);
+    require(algorithm && algorithm->asInt() && algorithm->asInt()->value() == 3);
+    require(encryption[1]->asMap() != nullptr);
+    const auto& iv = encryption[1]->asMap()->get(5);
+    require(iv && bytes(*iv).size() == 12 && bytes(*encryption[2]).size() >= 16);
+    const auto& recipients = array(*encryption[3], 1);
+    require(recipients.size() == 1);
+    const auto& recipient = array(*recipients[0], 3);
+    require(recipient.size() == 3 && recipient[1]->asMap() && recipient[2]->asNull());
+    Bytes recipientHeaders = bytes(*recipient[0]);
+    if (!recipientHeaders.empty()) require(parse(recipientHeaders)->asMap() != nullptr);
+    Bytes macedKeys = cppbor::Array().add(cppbor::Map().add(1, 5).encode())
+            .add(cppbor::Map()).add(cppbor::Array().add(publicKey.clone()).encode()).add(tag).encode();
+    return cppbor::Array()
+            .add(cppbor::Array().add(cppbor::EncodedItem(device)).add(cppbor::Map()))
+            .add(challenge).add(cppbor::EncodedItem(protectedData))
+            .add(cppbor::EncodedItem(macedKeys)).encode();
+}
+
+std::string pem(BIO* bio) {
+    char* data = nullptr;
+    long length = BIO_get_mem_data(bio, &data);
+    require(length > 0 && length < static_cast<long>(kMaxFrame));
+    return std::string(data, length);
+}
+std::string makeKeybox(const Bytes& der, EVP_PKEY* privateKey) {
+    require(!der.empty() && der.size() <= 16384);
+    std::vector<bssl::UniquePtr<X509>> certificates;
+    const uint8_t* position = der.data();
+    const uint8_t* end = position + der.size();
+    size_t leaf = 0;
+    size_t matches = 0;
+    while (position < end) {
+        bssl::UniquePtr<X509> certificate(d2i_X509(nullptr, &position, end - position));
+        require(certificate != nullptr && certificates.size() < 16);
+        bssl::UniquePtr<EVP_PKEY> pub(X509_get_pubkey(certificate.get()));
+        require(pub != nullptr);
+        if (EVP_PKEY_cmp(pub.get(), privateKey) == 1) {
+            leaf = certificates.size();
+            matches++;
+        }
+        certificates.push_back(std::move(certificate));
+    }
+    require(matches == 1);
+    std::vector<size_t> order;
+    size_t current = leaf;
+    while (true) {
+        require(std::find(order.begin(), order.end(), current) == order.end());
+        order.push_back(current);
+        X509* child = certificates[current].get();
+        if (X509_NAME_cmp(X509_get_subject_name(child), X509_get_issuer_name(child)) == 0) {
+            bssl::UniquePtr<EVP_PKEY> root(X509_get_pubkey(child));
+            require(root && X509_verify(child, root.get()) == 1);
+            break;
+        }
+        size_t parent = 0, parents = 0;
+        for (size_t i = 0; i < certificates.size(); ++i) {
+            if (X509_NAME_cmp(X509_get_issuer_name(child),
+                              X509_get_subject_name(certificates[i].get())) == 0) {
+                parent = i;
+                parents++;
+            }
+        }
+        require(parents == 1);
+        bssl::UniquePtr<EVP_PKEY> issuer(X509_get_pubkey(certificates[parent].get()));
+        require(issuer && X509_verify(child, issuer.get()) == 1);
+        current = parent;
+    }
+    require(order.size() == certificates.size());
+    bssl::UniquePtr<BIO> privatePem(BIO_new(BIO_s_mem()));
+    require(privatePem && PEM_write_bio_PrivateKey(privatePem.get(), privateKey, nullptr, nullptr,
+                                                  0, nullptr, nullptr) == 1);
+    std::string key = pem(privatePem.get());
+    std::string xml = "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n"
+            "<AndroidAttestation><NumberOfKeyboxes>1</NumberOfKeyboxes>"
+            "<Keybox DeviceID=\"tee-soft-rkp\"><Key algorithm=\"ecdsa\">"
+            "<PrivateKey format=\"pem\">\n" + key + "</PrivateKey><CertificateChain>"
+            "<NumberOfCertificates>" + std::to_string(order.size()) + "</NumberOfCertificates>";
+    clearSecret(key);
+    char* buffer = nullptr;
+    long privateLength = BIO_get_mem_data(privatePem.get(), &buffer);
+    if (privateLength > 0) OPENSSL_cleanse(buffer, privateLength);
+    for (size_t index : order) {
+        bssl::UniquePtr<BIO> output(BIO_new(BIO_s_mem()));
+        require(output && PEM_write_bio_X509(output.get(), certificates[index].get()) == 1);
+        xml += "<Certificate format=\"pem\">\n" + pem(output.get()) + "</Certificate>";
+    }
+    xml += "</CertificateChain></Key></Keybox></AndroidAttestation>\n";
+    require(xml.size() < kMaxFrame / 2);
+    return xml;
+}
+
+void issue() {
+    try {
+        setStage("generate");
+        bssl::UniquePtr<EC_KEY> ec(EC_KEY_new_by_curve_name(NID_X9_62_prime256v1));
+        require(ec && EC_KEY_generate_key(ec.get()) == 1);
+        bssl::UniquePtr<EVP_PKEY> key(EVP_PKEY_new());
+        require(key && EVP_PKEY_set1_EC_KEY(key.get(), ec.get()) == 1);
+        std::array<uint8_t, 65> point{};
+        require(EC_POINT_point2oct(EC_KEY_get0_group(ec.get()), EC_KEY_get0_public_key(ec.get()),
+                POINT_CONVERSION_UNCOMPRESSED, point.data(), point.size(), nullptr) == point.size());
+        cppbor::Map publicKey;
+        publicKey.add(1, 2).add(3, -7).add(-1, 1)
+                .add(-2, Bytes(point.begin() + 1, point.begin() + 33))
+                .add(-3, Bytes(point.begin() + 33, point.end()));
+        setStage("hardware");
+        auto binder = ndk::SpAIBinder(AServiceManager_checkService(kService));
+        require(binder.get() != nullptr, -2);
+        auto hal = km::IRemotelyProvisionedComponent::fromBinder(binder);
+        require(hal != nullptr, -2);
+        km::RpcHardwareInfo info;
+        auto status = hal->getHardwareInfo(&info);
+        require(status.isOk(), status.getServiceSpecificError() != 0
+                ? status.getServiceSpecificError() : -2000 + status.getExceptionCode());
+        require(info.supportedEekCurve == 1 || info.supportedEekCurve == 2, -3);
+        setStage("challenge");
+        std::string fingerprint = android::base::GetProperty("ro.build.fingerprint", "");
+        require(!fingerprint.empty() && fingerprint.size() <= 4096, -4);
+        Bytes request = cppbor::Map().add("fingerprint", fingerprint).add("id", 42).encode();
+        auto eekResponse = parse(post("fetchEekChain", request));
+        const auto& eekTop = array(*eekResponse, 2);
+        Bytes challenge = bytes(*eekTop[1]);
+        require(!challenge.empty() && challenge.size() <= 64);
+        Bytes eek;
+        for (const auto& entry : array(*eekTop[0], 1)) {
+            const auto& pair = array(*entry, 2);
+            if (pair[0]->asInt() && pair[0]->asInt()->value() == info.supportedEekCurve) {
+                require(array(*pair[1], 1).size() <= 16);
+                eek = pair[1]->encode();
+                break;
+            }
+        }
+        require(!eek.empty(), -3);
+        setStage("csr");
+        km::MacedPublicKey maced;
+        maced.macedKey = macedPublicKey(publicKey.encode());
+        km::DeviceInfo device;
+        km::ProtectedData protectedData;
+        Bytes tag;
+        status = hal->generateCertificateRequest(false, {maced}, eek, challenge,
+                                                  &device, &protectedData, &tag);
+        require(status.isOk(), status.getServiceSpecificError() != 0
+                ? status.getServiceSpecificError() : -2000 + status.getExceptionCode());
+        Bytes csr = assembleCsr(device.deviceInfo, protectedData.protectedData, challenge, publicKey, tag);
+        require(csr.size() <= 0xa000);
+        setStage("submit");
+        std::string encoded = base64(challenge.data(), challenge.size(), true);
+        // Percent-encode Base64 padding as part of the query value.
+        for (size_t pos = 0; (pos = encoded.find('=', pos)) != std::string::npos; pos += 3) {
+            encoded.replace(pos, 1, "%3D");
+        }
+        auto certificates = parse(post("signCertificates?challenge=" + encoded, csr));
+        const cppbor::Array* chainTop = &array(*certificates, 1);
+        if ((*chainTop)[0]->asArray()) chainTop = (*chainTop)[0]->asArray();
+        require(chainTop->size() >= 2);
+        Bytes chain = bytes(*(*chainTop)[0]);
+        const auto& unique = array(*(*chainTop)[1], 1);
+        require(unique.size() == 1);
+        Bytes tail = bytes(*unique[0]);
+        chain.insert(chain.end(), tail.begin(), tail.end());
+        setStage("verify");
+        std::string xml = makeKeybox(chain, key.get());
+        std::lock_guard lock(state.mutex);
+        state.xml = std::move(xml);
+        state.stage = "ready";
+        state.status = "success";
+        state.finished = Clock::now();
+    } catch (const Failure& failure) {
+        std::lock_guard lock(state.mutex);
+        state.code = failure.code;
+        state.status = "error";
+        state.finished = Clock::now();
+    } catch (...) {
+        std::lock_guard lock(state.mutex);
+        state.code = -1;
+        state.status = "error";
+        state.finished = Clock::now();
+    }
+}
+
+bool transfer(int fd, void* data, size_t size, bool writing) {
+    auto* position = static_cast<uint8_t*>(data);
+    while (size != 0) {
+        ssize_t count = writing ? send(fd, position, size, MSG_NOSIGNAL) : recv(fd, position, size, 0);
+        if (count < 0 && errno == EINTR) continue;
+        if (count <= 0) return false;
+        position += count;
+        size -= count;
+    }
+    return true;
+}
+Json::Value exchange(const Json::Value& request) {
+    require(request.isObject() && request["version"].isInt() && request["version"].asInt() == 1);
+    require(request["job"].isString() && request["action"].isString());
+    std::string job = request["job"].asString();
+    std::string action = request["action"].asString();
+    require(job.size() == 32 && job.find_first_not_of("0123456789abcdef") == std::string::npos);
+    require(action == "start" || action == "query" || action == "ack");
+    std::lock_guard lock(state.mutex);
+    if (state.status == "idle") {
+        require(action == "start");
+        state.job = job;
+        state.status = "running";
+        std::thread(issue).detach();
+    }
+    require(state.job == job, -5);
+    Json::Value reply(Json::objectValue);
+    reply["version"] = 1;
+    reply["job"] = job;
+    reply["status"] = state.status;
+    reply["stage"] = state.stage;
+    reply["code"] = state.code;
+    if (action == "ack") {
+        require(state.status == "success" || state.status == "error");
+        state.acknowledged = true;
+        clearSecret(state.xml);
+    } else if (state.status == "success") {
+        reply["xml"] = state.xml;
+    }
+    return reply;
+}
+void serve(int fd) {
+    ucred peer{};
+    socklen_t size = sizeof(peer);
+    require(getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &peer, &size) == 0 && peer.uid == 1000);
+    timeval timeout{2, 0};
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+    uint32_t length;
+    require(transfer(fd, &length, sizeof(length), false));
+    length = ntohl(length);
+    require(length > 0 && length <= 1024);
+    std::string body(length, '\0');
+    require(transfer(fd, body.data(), body.size(), false));
+    Json::CharReaderBuilder reader;
+    reader["collectComments"] = false;
+    reader["stackLimit"] = 8;
+    reader["rejectDupKeys"] = true;
+    reader["failIfExtra"] = true;
+    std::unique_ptr<Json::CharReader> parser(reader.newCharReader());
+    Json::Value request;
+    std::string error;
+    require(parser->parse(body.data(), body.data() + body.size(), &request, &error));
+    Json::StreamWriterBuilder writer;
+    writer["indentation"] = "";
+    std::string response = Json::writeString(writer, exchange(request));
+    require(response.size() <= kMaxFrame);
+    length = htonl(response.size());
+    transfer(fd, &length, sizeof(length), true);
+    transfer(fd, response.data(), response.size(), true);
+    clearSecret(response);
+}
+}  // namespace
+
+int main() {
+    // Covers blocked HAL calls as well as idle clients; no daemon restart is requested.
+    std::thread([] {
+        std::this_thread::sleep_for(std::chrono::seconds(180));
+        _exit(124);
+    }).detach();
+    if (curl_global_init(CURL_GLOBAL_DEFAULT) != CURLE_OK) return 1;
+    android::base::unique_fd socket(android_get_control_socket("tee_soft_rkp_issuer"));
+    if (socket.get() < 0 || listen(socket.get(), 4) != 0) return 1;
+    auto started = Clock::now();
+    while (true) {
+        {
+            std::lock_guard lock(state.mutex);
+            if (state.acknowledged) break;
+            if (state.status == "idle" && Clock::now() - started > std::chrono::seconds(15)) break;
+            if ((state.status == "success" || state.status == "error")
+                    && Clock::now() - state.finished > std::chrono::seconds(30)) break;
+        }
+        pollfd listener{socket.get(), POLLIN, 0};
+        if (poll(&listener, 1, 500) <= 0) continue;
+        android::base::unique_fd client(accept4(socket.get(), nullptr, nullptr, SOCK_CLOEXEC));
+        if (client.get() < 0) continue;
+        try { serve(client.get()); } catch (...) { /* No request/response material is logged. */ }
+    }
+    std::lock_guard lock(state.mutex);
+    clearSecret(state.xml);
+    return 0;
+}
