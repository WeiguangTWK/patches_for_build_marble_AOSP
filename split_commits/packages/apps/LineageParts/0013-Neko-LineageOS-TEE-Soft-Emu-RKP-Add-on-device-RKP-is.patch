+/* SPDX-License-Identifier: Apache-2.0 */
+package org.lineageos.lineageparts.teedebug;
+
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageInstaller;
+import android.content.pm.PackageManager;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemProperties;
+import android.os.UserHandle;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+import android.util.Xml;
+import android.util.proto.ProtoInputStream;
+import android.util.proto.ProtoStream;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.Enumeration;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.function.Consumer;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+
+import org.xmlpull.v1.XmlPullParser;
+import org.xmlpull.v1.XmlPullParserException;
+
+/** One fixed APEX, system-verified signatures, no shell or direct apexd access. */
+final class RkpApexUpdater {
+    static final String PACKAGE = "org.system.tee.soft.rkp";
+    private static final String ACTION = PACKAGE + ".INSTALL_RESULT";
+    private static final String SESSION = "session";
+    private static final String VERSION = "version";
+    private static final long MAX_BYTES = 64L * 1024 * 1024;
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+    private static final ExecutorService WORKER = Executors.newSingleThreadExecutor();
+    private static Context sContext;
+    private static SharedPreferences sPrefs;
+    private static File sFile;
+    private static volatile String sPhase = "";
+    private static volatile boolean sPending;
+    private static volatile long sCandidate;
+    private static volatile long sActiveVersion = -1;
+    private static volatile boolean sRefreshing;
+    // Only this coordinator's worker changes ownership; never release another job's lock.
+    private static boolean sOwnsLock;
+
+    private static final class UpdateFailure extends IOException {
+        UpdateFailure(String message) { super(message); }
+    }
+
+    private RkpApexUpdater() {}
+
+    static void initialize(Context context) {
+        sContext = context.getApplicationContext();
+        sPrefs = sContext.getSharedPreferences("tee_soft_rkp_component", Context.MODE_PRIVATE);
+        sFile = new File(sContext.getFilesDir(), "rkp-component.apex");
+        sPending = sPrefs.contains(SESSION);
+        if (sPending) {
+            sPhase = "installing";
+            sCandidate = sPrefs.getLong(VERSION, 0);
+        }
+        WORKER.execute(() -> {
+            sActiveVersion = readActiveVersion();
+            if (sPrefs.contains(SESSION)) reconcile();
+            else {
+                // A crash can occur between createSession and persisting its ID.
+                // Clean only this installer's unsealed drafts for this exact package.
+                try {
+                    for (PackageInstaller.SessionInfo info : installer().getMySessions()) {
+                        if (PACKAGE.equals(info.getAppPackageName())
+                                && sContext.getPackageName().equals(info.getInstallerPackageName())
+                                && !info.isCommitted() && !info.isSealed()) {
+                            abandon(info.getSessionId());
+                        }
+                    }
+                } catch (RuntimeException ignored) {
+                    // These drafts were never committed and cannot install by themselves.
+                }
+                sFile.delete(); // Never resume a draft install after process death.
+            }
+        });
+    }
+
+    private static PackageInstaller installer() {
+        return sContext.getPackageManager().getPackageInstaller();
+    }
+
+    static boolean pending() { return sPending; }
+    static String phase() { return sPhase; }
+    static String result() { return sPrefs.getString("result", ""); }
+    static int resultCode() { return sPrefs.getInt("code", 0); }
+    static String resultMessage() { return sPrefs.getString("message", ""); }
+
+    static long activeVersion() { return sActiveVersion; }
+    static boolean refreshing() { return sRefreshing; }
+    static boolean allowedUser() { return UserHandle.myUserId() == UserHandle.USER_SYSTEM; }
+
+    static void refreshVersion() {
+        sRefreshing = true;
+        WORKER.execute(() -> {
+            sActiveVersion = readActiveVersion();
+            sRefreshing = false;
+        });
+    }
+
+    private static long readActiveVersion() {
+        try (InputStream in = new FileInputStream("/apex/apex-info-list.xml")) {
+            ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+            copy(in, bytes, 1024 * 1024);
+            XmlPullParser parser = Xml.newPullParser();
+            parser.setFeature(XmlPullParser.FEATURE_PROCESS_NAMESPACES, false);
+            parser.setInput(new ByteArrayInputStream(bytes.toByteArray()), "UTF-8");
+            long version = -1;
+            int event;
+            while ((event = parser.nextToken()) != XmlPullParser.END_DOCUMENT) {
+                if (event == XmlPullParser.DOCDECL) return -1;
+                if (event != XmlPullParser.START_TAG || !"apex-info".equals(parser.getName())
+                        || !PACKAGE.equals(parser.getAttributeValue(null, "moduleName"))
+                        || !"true".equals(parser.getAttributeValue(null, "isActive"))) continue;
+                if (version != -1) return -1;
+                version = Long.parseLong(parser.getAttributeValue(null, "versionCode"));
+                if (version < 1) return -1;
+            }
+            return version;
+        } catch (IOException | XmlPullParserException | RuntimeException e) {
+            return -1;
+        }
+    }
+
+    static boolean prepare(Uri uri, Consumer<Long> callback) {
+        if (!allowedUser() || sPending || !KeyboxUpdater.acquireForApex()) return false;
+        sPending = true;
+        sPhase = "checking";
+        WORKER.execute(() -> {
+            sOwnsLock = true;
+            long version = -1;
+            try {
+                requireIdle();
+                try (InputStream in = sContext.getContentResolver().openInputStream(uri);
+                        FileOutputStream out = new FileOutputStream(sFile)) {
+                    if (in == null) throw new UpdateFailure("Cannot open selected document");
+                    copy(in, out, MAX_BYTES);
+                    out.getFD().sync();
+                }
+                sCandidate = inspect();
+                sPhase = "confirm";
+                version = sCandidate;
+            } catch (IOException | RuntimeException e) {
+                finish("failed", -1, e instanceof UpdateFailure ? e.getMessage()
+                        : "Cannot read or validate selected update");
+            }
+            final long candidate = version;
+            MAIN.post(() -> callback.accept(candidate));
+        });
+        return true;
+    }
+
+    static void cancelPrepared() {
+        WORKER.execute(() -> {
+            if ("confirm".equals(sPhase)) {
+                sFile.delete();
+                release();
+            }
+        });
+    }
+
+    static void installPrepared() {
+        WORKER.execute(() -> {
+            if (!"confirm".equals(sPhase)) return;
+            int id = -1;
+            boolean commitAttempted = false;
+            try {
+                requireIdle();
+                if (inspect() != sCandidate) throw new UpdateFailure("Candidate changed");
+                PackageInstaller.SessionParams params = new PackageInstaller.SessionParams(
+                        PackageInstaller.SessionParams.MODE_FULL_INSTALL);
+                params.setInstallAsApex();
+                params.setAppPackageName(PACKAGE);
+                params.isStaged = false;
+                params.setRequireUserAction(PackageInstaller.SessionParams.USER_ACTION_NOT_REQUIRED);
+                params.setSize(sFile.length());
+                id = installer().createSession(params);
+                // Persist before writing/committing so process recovery can find this exact session.
+                if (!sPrefs.edit().putInt(SESSION, id).putLong(VERSION, sCandidate)
+                        .remove("result").remove("message").commit()) {
+                    throw new UpdateFailure("Cannot save installation session");
+                }
+                sPhase = "installing";
+                try (PackageInstaller.Session session = installer().openSession(id);
+                        InputStream in = new FileInputStream(sFile);
+                        OutputStream out = session.openWrite("update.apex", 0, sFile.length())) {
+                    copy(in, out, MAX_BYTES);
+                    session.fsync(out);
+                }
+                Intent result = new Intent(sContext, RkpApexInstallReceiver.class)
+                        .setAction(ACTION);
+                PendingIntent pending = PendingIntent.getBroadcast(sContext, id, result,
+                        PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_MUTABLE);
+                try (PackageInstaller.Session session = installer().openSession(id)) {
+                    commitAttempted = true;
+                    session.commit(pending.getIntentSender());
+                }
+                sFile.delete();
+                scheduleReconcile();
+            } catch (IOException | RuntimeException e) {
+                if (commitAttempted) {
+                    // A lost commit reply must not trigger a second installation.
+                    scheduleReconcile();
+                } else if (abandon(id)) {
+                    finish("failed", -1, e.getMessage());
+                } else {
+                    // Keep persisted exclusion until the system state can be read again.
+                    scheduleReconcile();
+                }
+            }
+        });
+    }
+
+    static void receive(Intent intent, Runnable completion) {
+        WORKER.execute(() -> {
+            try {
+                int id = intent.getIntExtra(PackageInstaller.EXTRA_SESSION_ID, -1);
+                if (!ACTION.equals(intent.getAction()) || id < 0
+                        || id != sPrefs.getInt(SESSION, -1)) return;
+                int status = intent.getIntExtra(PackageInstaller.EXTRA_STATUS,
+                        PackageInstaller.STATUS_FAILURE);
+                if (status == PackageInstaller.STATUS_PENDING_USER_ACTION) {
+                    // Privileged update should not request another installer UI.
+                    if (abandon(id)) finish("failed", status, "Unexpected user action request");
+                    else scheduleReconcile();
+                } else if (status == PackageInstaller.STATUS_SUCCESS) {
+                    confirmActivation();
+                } else {
+                    finish("failed", status,
+                            intent.getStringExtra(PackageInstaller.EXTRA_STATUS_MESSAGE));
+                }
+            } catch (RuntimeException e) {
+                scheduleReconcile();
+            } finally {
+                completion.run();
+            }
+        });
+    }
+
+    private static void scheduleReconcile() {
+        MAIN.removeCallbacks(RECONCILE);
+        MAIN.postDelayed(RECONCILE, 2000);
+    }
+
+    private static final Runnable RECONCILE = () -> WORKER.execute(() -> {
+        if (sPrefs.contains(SESSION)) reconcile();
+    });
+
+    private static void reconcile() {
+        try {
+            if (!sOwnsLock) sOwnsLock = KeyboxUpdater.acquireForApex();
+            if (!sOwnsLock) {
+                scheduleReconcile();
+                return;
+            }
+            int id = sPrefs.getInt(SESSION, -1);
+            PackageInstaller.SessionInfo info = installer().getSessionInfo(id);
+            if (info == null) {
+                // The status broadcast may have been lost; never recommit or reissue.
+                confirmActivation();
+            } else if (!info.isCommitted() && !info.isSealed()) {
+                if (abandon(id)) finish("interrupted", -1, "Uncommitted session interrupted");
+                else scheduleReconcile();
+            } else {
+                scheduleReconcile();
+            }
+        } catch (RuntimeException e) {
+            scheduleReconcile();
+        }
+    }
+
+    private static void confirmActivation() {
+        long active = readActiveVersion();
+        sActiveVersion = active;
+        long expected = sPrefs.getLong(VERSION, -1);
+        if (active > 0 && active == expected) finish("success", 0, "");
+        else finish("unconfirmed", -1, "Active version could not confirm this update");
+    }
+
+    private static boolean abandon(int id) {
+        if (id < 0) return true;
+        try {
+            if (installer().getSessionInfo(id) != null) installer().abandonSession(id);
+            return true;
+        } catch (RuntimeException e) {
+            return false;
+        }
+    }
+
+    private static void finish(String result, int code, String message) {
+        sActiveVersion = readActiveVersion();
+        // System diagnostic only: do not persist the selected URI or package contents.
+        String detail = message == null ? "" : message.replaceAll("[\\p{Cntrl}]", " ");
+        if (detail.length() > 512) detail = detail.substring(0, 512);
+        if (!sPrefs.edit().putString("result", result).putInt("code", code)
+                .putString("message", detail).remove(SESSION).remove(VERSION).commit()) {
+            sPhase = "state_error";
+            return; // Keep exclusion; do not hide a possibly unresolved session.
+        }
+        sFile.delete();
+        release();
+    }
+
+    private static void release() {
+        sPhase = "";
+        sPending = false;
+        if (sOwnsLock) {
+            sOwnsLock = false;
+            KeyboxUpdater.releaseForApex();
+        }
+    }
+
+    private static void requireIdle() throws IOException {
+        if (!TeeSoftDebugConfig.read().getOrDefault(KeyboxUpdater.RKP_JOB, "").isEmpty()) {
+            throw new UpdateFailure("An issuance result is still pending");
+        }
+        String status = SystemProperties.get("init.svc.tee_soft_rkp_issuer", "");
+        if ("stopped".equals(status)) return;
+        if (status.isEmpty()
+                && SystemProperties.get("ro.boottime.tee_soft_rkp_issuer", "").isEmpty()) {
+            try {
+                Os.lstat("/dev/socket/tee_soft_rkp_issuer");
+            } catch (ErrnoException e) {
+                if (e.errno == OsConstants.ENOENT) return; // Never started this boot.
+            }
+        }
+        throw new UpdateFailure("Issuer is running or its state is unavailable");
+    }
+
+    private static void copy(InputStream in, OutputStream out, long limit) throws IOException {
+        byte[] buffer = new byte[32768];
+        long total = 0;
+        int count;
+        while ((count = in.read(buffer)) != -1) {
+            total += count;
+            if (total > limit) throw new UpdateFailure("Package exceeds the size limit");
+            out.write(buffer, 0, count);
+        }
+        if (total == 0) throw new UpdateFailure("Empty package");
+    }
+
+    private static long inspect() throws IOException {
+        long active = readActiveVersion();
+        sActiveVersion = active;
+        if (active < 1) throw new UpdateFailure("Active component version is unavailable");
