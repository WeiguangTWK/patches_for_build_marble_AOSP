+        PackageInfo outer = sContext.getPackageManager().getPackageArchiveInfo(
+                sFile.getAbsolutePath(), PackageManager.PackageInfoFlags.of(0));
+        if (outer == null || !PACKAGE.equals(outer.packageName)
+                || outer.getLongVersionCode() <= active) {
+            throw new UpdateFailure("Wrong package or version is not newer");
+        }
+        try (ZipFile zip = new ZipFile(sFile)) {
+            Set<String> names = new HashSet<>();
+            Enumeration<? extends ZipEntry> entries = zip.entries();
+            while (entries.hasMoreElements()) {
+                if (!names.add(entries.nextElement().getName()) || names.size() > 1024) {
+                    throw new UpdateFailure("Invalid package entries");
+                }
+            }
+            if (!names.contains("apex_payload.img") || !names.contains("apex_pubkey")
+                    || !names.contains("apex_manifest.pb")) {
+                throw new UpdateFailure("An uncompressed APEX is required");
+            }
+            ByteArrayOutputStream manifest = new ByteArrayOutputStream();
+            try (InputStream in = zip.getInputStream(zip.getEntry("apex_manifest.pb"))) {
+                copy(in, manifest, 65536);
+            }
+            ProtoInputStream proto = new ProtoInputStream(
+                    new ByteArrayInputStream(manifest.toByteArray()));
+            String name = null;
+            long version = -1;
+            while (proto.nextField() != ProtoInputStream.NO_MORE_FIELDS) {
+                if (proto.getFieldNumber() == 1) {
+                    if (name != null) throw new UpdateFailure("Duplicate manifest name");
+                    name = proto.readString(ProtoStream.FIELD_COUNT_SINGLE
+                            | ProtoStream.FIELD_TYPE_STRING | 1);
+                } else if (proto.getFieldNumber() == 2) {
+                    if (version != -1) throw new UpdateFailure("Duplicate manifest version");
+                    version = proto.readLong(ProtoStream.FIELD_COUNT_SINGLE
+                            | ProtoStream.FIELD_TYPE_INT64 | 2);
+                }
+            }
+            if (!PACKAGE.equals(name) || version != outer.getLongVersionCode()) {
+                throw new UpdateFailure("Inconsistent APEX identity or version");
+            }
+            return version;
+        }
+    }
+}
