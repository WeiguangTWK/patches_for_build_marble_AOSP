+    certificate: ":org.system.tee.soft.rkp.certificate",
+    updatable: true,
+    min_sdk_version: "35",
+    // Keep the installation artifact as an ordinary .apex for independent updates.
+    compressible: false,
+    compile_multilib: "first",
+    binaries: ["tee_soft_rkp_issuer"],
+    prebuilts: ["org.system.tee.soft.rkp.init.rc"],
+}
+
+prebuilt_etc {
+    name: "org.system.tee.soft.rkp.init.rc",
+    licenses: ["Android-Apache-2.0"],
+    src: "tee_soft_rkp_issuer.rc",
+    filename: "init.rc",
+    installable: false,
+}
+
+// These checked-in keys are development keys, never production trust anchors.
+// A release must replace BOTH signatures; see docs/tee-soft-rkp-apex.md.
+apex_key {
+    name: "org.system.tee.soft.rkp.key",
+    public_key: "org.system.tee.soft.rkp.avbpubkey",
+    private_key: "org.system.tee.soft.rkp.pem",
+}
+
+android_app_certificate {
+    name: "org.system.tee.soft.rkp.certificate",
+    certificate: "org.system.tee.soft.rkp",
+}
+
+// AOSP requires the file_contexts provider to live under system/sepolicy.
+filegroup {
+    name: "tee_soft_rkp_apex_file_contexts_source",
+    srcs: ["file_contexts"],
+    visibility: ["//system/sepolicy/apex:__pkg__"],
+}
