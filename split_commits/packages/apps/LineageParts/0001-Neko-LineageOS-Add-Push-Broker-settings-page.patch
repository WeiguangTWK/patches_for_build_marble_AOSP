+import org.lineageos.lineageparts.search.Searchable;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import lineageos.push.PushBrokerConstants;
+import lineageos.push.PushBrokerManager;
+import lineageos.push.PushProviderInfo;
+import lineageos.push.PushProviderState;
+
+public class PushBrokerSettings extends SettingsPreferenceFragment implements Searchable {
+    private static final String KEY_ACTIVE_PROVIDER = "push_provider_active";
+    private static final String KEY_DISABLE_PROVIDER = "push_provider_disable";
+    private static final String KEY_AVOID_DUPLICATE_PUSH = "push_provider_avoid_duplicate_push";
+    private static final String KEY_PROVIDER_LIST = "push_provider_list";
+    private static final String KEY_COMPATIBILITY_STATUS = "push_provider_compatibility_status";
+    private static final String KEY_COMPATIBILITY_APPS = "push_provider_compatibility_apps";
+    private static final String KEY_COMPATIBILITY_SUMMARY = "push_provider_compatibility_summary";
+    private static final String KEY_COMPATIBILITY_APP_PREFIX = "push_provider_compatibility_app_";
+    private static final String KEY_PROVIDER_PREFIX = "push_provider_item_";
+    private static final long PROVIDER_ENABLE_STATE_CHECK_DELAY_MILLIS = 1_000L;
+
+    static final String EXTRA_PROVIDER_ID = "extra_provider_id";
+    static final String EXTRA_PACKAGE_NAME = "extra_package_name";
+    static final String EXTRA_USER_ID = "extra_user_id";
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private PushBrokerManager mPushBrokerManager;
+    private String mPendingSetupProviderId;
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        addPreferencesFromResource(R.xml.push_broker_settings);
+    }
+
+    @Override
+    public void onActivityCreated(Bundle savedInstanceState) {
+        super.onActivityCreated(savedInstanceState);
+        requireActivity().getActionBar().setTitle(
+                R.string.third_party_notification_push_provider_title);
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        refreshProviders();
+        retryPendingSetupProviderIfNeeded();
+    }
+
+    @Override
+    public boolean onPreferenceTreeClick(Preference preference) {
+        final String key = preference.getKey();
+        if (KEY_DISABLE_PROVIDER.equals(key)) {
+            final boolean result = mPushBrokerManager != null
+                    && mPushBrokerManager.disableActiveProvider();
+            Toast.makeText(getContext(), result
+                    ? R.string.notification_push_provider_disabled
+                    : R.string.notification_push_provider_disable_failed, Toast.LENGTH_SHORT)
+                    .show();
+            refreshProviders();
+            return true;
+        }
+
+        if (key != null && key.startsWith(KEY_PROVIDER_PREFIX)) {
+            final String providerId = key.substring(KEY_PROVIDER_PREFIX.length());
+            final PushProviderInfo provider = findProvider(
+                    mPushBrokerManager.getInstalledProviders(), providerId);
+            final PushProviderState state = provider == null ? null
+                    : mPushBrokerManager.getProviderState(providerId);
+            if (provider != null && state != null && state.requiresUserAction) {
+                if (launchProviderActivity(provider, firstNonEmpty(
+                        provider.setupActivity, provider.settingsActivity))) {
+                    return true;
+                }
+                Toast.makeText(getContext(),
+                        R.string.notification_push_provider_setup_required, Toast.LENGTH_SHORT)
+                        .show();
+                return true;
+            }
+
+            final boolean result = mPushBrokerManager != null
+                    && mPushBrokerManager.setActiveProvider(providerId);
+            Toast.makeText(getContext(), result
+                    ? R.string.notification_push_provider_enabled
+                    : R.string.notification_push_provider_enable_failed, Toast.LENGTH_SHORT)
+                    .show();
+            refreshProviders();
+            if (result) {
+                scheduleProviderEnableStateCheck(providerId);
+            }
+            return true;
+        }
+
+        return super.onPreferenceTreeClick(preference);
+    }
+
+    private void refreshProviders() {
+        final Preference activePreference = requirePreference(KEY_ACTIVE_PROVIDER);
+        final Preference disablePreference = requirePreference(KEY_DISABLE_PROVIDER);
+        final SwitchPreferenceCompat avoidDuplicatePushPreference =
+                requirePreference(KEY_AVOID_DUPLICATE_PUSH);
+        final PreferenceCategory providerCategory = requirePreference(KEY_PROVIDER_LIST);
+        final PreferenceCategory compatibilityStatusCategory =
+                requirePreference(KEY_COMPATIBILITY_STATUS);
+        final PreferenceCategory compatibilityAppsCategory =
+                requirePreference(KEY_COMPATIBILITY_APPS);
+
+        providerCategory.removeAll();
+        compatibilityStatusCategory.removeAll();
+        compatibilityAppsCategory.removeAll();
+        compatibilityStatusCategory.setVisible(false);
+        compatibilityAppsCategory.setVisible(false);
+        refreshAvoidDuplicatePushPreference(avoidDuplicatePushPreference);
+
+        try {
+            mPushBrokerManager = PushBrokerManager.getInstance(getContext());
+        } catch (RuntimeException e) {
+            activePreference.setSummary(R.string.notification_push_provider_unavailable);
+            disablePreference.setEnabled(false);
+            addEmptyPreference(providerCategory,
+                    getString(R.string.notification_push_provider_unavailable));
+            addEmptyPreference(compatibilityStatusCategory,
+                    getString(R.string.notification_push_provider_unavailable));
+            return;
+        }
+
+        final List<PushProviderInfo> providers = mPushBrokerManager.getInstalledProviders();
+        final String activeProviderId = mPushBrokerManager.getActiveProviderId();
+        final PushProviderInfo activeProvider = findProvider(providers, activeProviderId);
+        final PushProviderState activeProviderState = activeProvider == null
+                ? null : mPushBrokerManager.getProviderState(activeProvider.providerId);
+
+        if (TextUtils.isEmpty(activeProviderId)) {
+            activePreference.setSummary(R.string.no_notification_push_provider_active);
+        } else {
+            activePreference.setSummary(activeProvider != null
+                    ? activeProvider.displayName
+                    : activeProviderId);
+        }
+        disablePreference.setEnabled(!TextUtils.isEmpty(activeProviderId));
+        refreshCompatibilityPreferences(compatibilityStatusCategory, compatibilityAppsCategory,
+                activeProvider, activeProviderState);
+
+        if (providers.isEmpty()) {
+            addEmptyPreference(providerCategory,
+                    getString(R.string.no_notification_push_provider_installed));
+            return;
+        }
+
+        for (PushProviderInfo provider : providers) {
+            final PushProviderState state = mPushBrokerManager.getProviderState(provider.providerId);
+            final Preference pref = new Preference(getPrefContext());
+            pref.setKey(KEY_PROVIDER_PREFIX + provider.providerId);
+            pref.setTitle(provider.displayName);
+            pref.setSummary(buildProviderSummary(provider, state));
+            providerCategory.addPreference(pref);
+        }
+    }
+
+    private void refreshCompatibilityPreferences(PreferenceCategory statusCategory,
+            PreferenceCategory appsCategory, PushProviderInfo activeProvider,
+            PushProviderState activeProviderState) {
+        if (activeProvider == null || activeProviderState == null
+                || !PushProviderInfo.PROVIDER_TYPE_COMPATIBILITY.equals(activeProvider.providerType)) {
+            return;
+        }
+
+        statusCategory.setVisible(true);
+        appsCategory.setVisible(true);
+
+        final Bundle compatibilityState =
+                mPushBrokerManager.getCompatibilityState(activeProvider.providerId);
+        final int authorizedCount = compatibilityState.getInt(
+                PushBrokerConstants.DIAG_COMPAT_AUTHORIZED_APP_COUNT, 0);
+        final int supportedCount = compatibilityState.getInt(
+                PushBrokerConstants.DIAG_COMPAT_SUPPORTED_APP_COUNT, 0);
+
+        final Preference summaryPreference = new Preference(getPrefContext());
+        summaryPreference.setKey(KEY_COMPATIBILITY_SUMMARY);
+        summaryPreference.setTitle(activeProvider.displayName);
+        summaryPreference.setSummary(getString(
+                R.string.notification_push_compatibility_summary,
+                authorizedCount, supportedCount));
+        summaryPreference.setSelectable(false);
+        statusCategory.addPreference(summaryPreference);
+
+        final String[] profiles = activeProvider.compatibilityProfiles == null
+                ? new String[0] : activeProvider.compatibilityProfiles;
+        final Preference profilesPreference = new Preference(getPrefContext());
+        profilesPreference.setTitle(R.string.notification_push_compatibility_supported);
+        profilesPreference.setSummary(getString(
+                R.string.notification_push_compatibility_profiles_summary,
+                profiles.length == 0 ? getString(
+                        R.string.notification_push_compatibility_unknown_result)
+                        : TextUtils.join(", ", Arrays.asList(profiles))));
+        profilesPreference.setSelectable(false);
+        statusCategory.addPreference(profilesPreference);
+
+        if (profiles.length == 1) {
+            final Preference notePreference = new Preference(getPrefContext());
+            notePreference.setSummary(
+                    R.string.notification_push_compatibility_single_profile_summary);
+            notePreference.setSelectable(false);
+            statusCategory.addPreference(notePreference);
+        }
+
+        final List<Bundle> authorizedApps = mPushBrokerManager.getCompatibilityAuthorizedApps(
+                activeProvider.providerId, UserHandle.USER_SYSTEM);
+        final Set<String> authorizedPackages = new HashSet<>();
+        for (Bundle appState : authorizedApps) {
+            if (appState == null) {
+                continue;
+            }
+            final String packageName = appState.getString(
+                    PushBrokerConstants.COMPAT_APP_PACKAGE_NAME);
+            if (!TextUtils.isEmpty(packageName)) {
+                authorizedPackages.add(packageName);
+            }
+        }
+
+        final List<String> candidatePackages = collectCompatibilityCandidatePackages();
+        for (String authorizedPackage : authorizedPackages) {
+            if (!candidatePackages.contains(authorizedPackage)) {
+                candidatePackages.add(authorizedPackage);
+            }
+        }
+        candidatePackages.sort(Comparator.comparing(packageName -> {
+            final CharSequence label = getApplicationLabel(requireContext(), packageName);
+            return label == null ? packageName : label.toString().toLowerCase();
+        }));
+        for (String packageName : candidatePackages) {
+            final Bundle appState = mPushBrokerManager.getCompatibilityAppState(
+                    activeProvider.providerId, packageName, UserHandle.USER_SYSTEM);
+            if (appState == null || !appState.getBoolean(
+                    PushBrokerConstants.COMPAT_APP_SUPPORTED, false)) {
+                continue;
+            }
+            appsCategory.addPreference(buildCompatibilityAppPreference(activeProvider,
+                    packageName, appState));
+        }
+
+        if (appsCategory.getPreferenceCount() == 0 && authorizedPackages.isEmpty()) {
+            addEmptyPreference(appsCategory,
+                    getString(R.string.notification_push_compatibility_not_available));
+        }
+    }
+
+    private Preference buildCompatibilityAppPreference(PushProviderInfo provider,
+            String packageName, Bundle appState) {
+        final Preference preference = new Preference(getPrefContext());
+        preference.setKey(KEY_COMPATIBILITY_APP_PREFIX + packageName);
+        final CharSequence label = getApplicationLabel(requireContext(), packageName);
+        preference.setTitle(TextUtils.isEmpty(label) ? packageName : label);
+        preference.setSummary(buildCompatibilityAppSummary(appState));
+        preference.setFragment(PushBrokerCompatibilityAppSettings.class.getName());
+        final Bundle extras = preference.getExtras();
+        extras.putString(EXTRA_PROVIDER_ID, provider.providerId);
+        extras.putString(EXTRA_PACKAGE_NAME, packageName);
+        extras.putInt(EXTRA_USER_ID, UserHandle.USER_SYSTEM);
+        return preference;
+    }
+
+    private String buildCompatibilityAppSummary(Bundle appState) {
+        final ArrayList<String> parts = new ArrayList<>();
+        if (appState.getBoolean(PushBrokerConstants.COMPAT_APP_AUTHORIZED, false)) {
+            parts.add(getString(R.string.notification_push_compatibility_authorized));
+        }
+        if (appState.getBoolean(PushBrokerConstants.COMPAT_APP_SUPPORTED, false)) {
+            parts.add(getString(R.string.notification_push_compatibility_supported));
+        }
+        final String[] profiles = appState.getStringArray(
+                PushBrokerConstants.COMPAT_APP_ENABLED_PROFILE_IDS);
+        if (profiles != null && profiles.length > 0) {
+            parts.add(getString(R.string.notification_push_compatibility_profiles_summary,
+                    TextUtils.join(", ", Arrays.asList(profiles))));
+        }
+        final String[] effectiveCapabilities = appState.getStringArray(
+                PushBrokerConstants.COMPAT_APP_EFFECTIVE_CAPABILITY_IDS);
+        if (effectiveCapabilities != null && effectiveCapabilities.length > 0) {
+            parts.add(getString(R.string.notification_push_compatibility_capabilities_summary,
+                    TextUtils.join(", ", Arrays.asList(effectiveCapabilities))));
+        }
+        parts.add(getString(R.string.notification_push_compatibility_result_summary,
+                formatResultCode(appState, "lastPrepareResult"),
+                formatResultCode(appState, "lastSyncResult"),
+                formatResultCode(appState, "lastTokenResult")));
+        return TextUtils.join(", ", parts);
+    }
+
+    private String formatResultCode(Bundle appState, String key) {
+        return appState.containsKey(key)
+                ? String.valueOf(appState.getInt(key))
+                : getString(R.string.notification_push_compatibility_unknown_result);
+    }
+
+    private List<String> collectCompatibilityCandidatePackages() {
+        final Intent launcherIntent = new Intent(Intent.ACTION_MAIN);
+        launcherIntent.addCategory(Intent.CATEGORY_LAUNCHER);
+        final List<ResolveInfo> resolveInfos = requireContext().getPackageManager()
+                .queryIntentActivities(launcherIntent, PackageManager.ResolveInfoFlags.of(0));
+        final Set<String> packageNames = new HashSet<>();
+        for (ResolveInfo resolveInfo : resolveInfos) {
+            if (resolveInfo == null || resolveInfo.activityInfo == null
+                    || TextUtils.isEmpty(resolveInfo.activityInfo.packageName)) {
+                continue;
+            }
+            packageNames.add(resolveInfo.activityInfo.packageName);
+        }
+        return new ArrayList<>(packageNames);
+    }
+
+    private void refreshAvoidDuplicatePushPreference(SwitchPreferenceCompat preference) {
+        final boolean checked = Settings.Global.getInt(requireContext().getContentResolver(),
+                PushBrokerConstants.SETTING_AVOID_DUPLICATE_PUSH, 0) == 1;
+        preference.setChecked(checked);
+        preference.setOnPreferenceChangeListener((pref, newValue) -> Settings.Global.putInt(
+                requireContext().getContentResolver(),
+                PushBrokerConstants.SETTING_AVOID_DUPLICATE_PUSH,
+                Boolean.TRUE.equals(newValue) ? 1 : 0));
+    }
+
+    private void scheduleProviderEnableStateCheck(String providerId) {
+        if (TextUtils.isEmpty(providerId)) {
+            return;
+        }
+        mPendingSetupProviderId = providerId;
+        mHandler.removeCallbacksAndMessages(providerId);
+        final Runnable task = this::retryPendingSetupProviderIfNeeded;
+        mHandler.postAtTime(task, providerId,
+                System.currentTimeMillis() + PROVIDER_ENABLE_STATE_CHECK_DELAY_MILLIS);
+    }
+
+    private void retryPendingSetupProviderIfNeeded() {
+        if (mPushBrokerManager == null || TextUtils.isEmpty(mPendingSetupProviderId)) {
+            return;
+        }
+        final String providerId = mPendingSetupProviderId;
+        final PushProviderInfo provider = findProvider(mPushBrokerManager.getInstalledProviders(),
+                providerId);
+        final PushProviderState state = mPushBrokerManager.getProviderState(providerId);
+        if (provider == null || state == null || !state.requiresUserAction) {
+            mPendingSetupProviderId = null;
+            return;
+        }
+        if (launchProviderActivity(provider, firstNonEmpty(
+                provider.setupActivity, provider.settingsActivity))) {
+            return;
+        }
+        Toast.makeText(getContext(), R.string.notification_push_provider_setup_required,
+                Toast.LENGTH_SHORT).show();
+        mPendingSetupProviderId = null;
+    }
+
+    private boolean launchProviderActivity(PushProviderInfo provider, String activityName) {
+        if (provider == null || TextUtils.isEmpty(activityName)) {
+            return false;
+        }
+        try {
+            final ComponentName component = ComponentName.unflattenFromString(activityName) != null
+                    ? ComponentName.unflattenFromString(activityName)
+                    : new ComponentName(provider.packageName, activityName);
+            final Intent intent = new Intent().setComponent(component)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            startActivity(intent);
+            return true;
+        } catch (RuntimeException e) {
+            return false;
+        }
+    }
+
+    private PushProviderInfo findProvider(List<PushProviderInfo> providers, String providerId) {
+        if (providers == null || TextUtils.isEmpty(providerId)) {
+            return null;
+        }
+        for (PushProviderInfo provider : providers) {
+            if (TextUtils.equals(provider.providerId, providerId)) {
+                return provider;
+            }
+        }
+        return null;
+    }
+
+    private CharSequence getApplicationLabel(Context context, String packageName) {
+        try {
+            return context.getPackageManager().getApplicationLabel(
+                    context.getPackageManager().getApplicationInfo(packageName, 0));
+        } catch (PackageManager.NameNotFoundException e) {
+            return packageName;
+        }
+    }
+
+    private void addEmptyPreference(PreferenceCategory category, CharSequence summary) {
+        final Preference preference = new Preference(getPrefContext());
+        preference.setSummary(summary);
+        preference.setSelectable(false);
+        category.addPreference(preference);
+    }
+
+    private String buildProviderSummary(PushProviderInfo provider, PushProviderState state) {
+        final ArrayList<String> parts = new ArrayList<>();
+        parts.add(provider.providerId);
+        parts.add(getProviderTypeLabel(provider.providerType));
+        parts.add(getProviderTrustLabel(provider.trustLevel));
+        if (state.selected) {
+            parts.add(getString(R.string.notification_push_provider_state_selected));
+        }
+        if (state.enabled) {
+            parts.add(getString(R.string.notification_push_provider_state_enabled));
+        }
+        if (state.degraded) {
+            parts.add(getString(R.string.notification_push_provider_state_degraded));
+        }
+        if (state.requiresUserAction) {
+            parts.add(getString(R.string.notification_push_provider_state_requires_action));
+        }
+        if (!TextUtils.isEmpty(state.lastErrorMessage)) {
+            parts.add(state.lastErrorMessage);
+        }
+        return TextUtils.join(", ", parts);
+    }
+
+    private String getProviderTypeLabel(String providerType) {
+        if (PushProviderInfo.PROVIDER_TYPE_NATIVE.equals(providerType)) {
+            return getString(R.string.notification_push_provider_type_native);
+        }
+        if (PushProviderInfo.PROVIDER_TYPE_COMPATIBILITY.equals(providerType)) {
+            return getString(R.string.notification_push_provider_type_compatibility);
+        }
+        return getString(R.string.notification_push_provider_type_unknown);
+    }
+
+    private String getProviderTrustLabel(int trustLevel) {
+        switch (trustLevel) {
+            case PushProviderInfo.TRUST_SYSTEM:
+                return getString(R.string.notification_push_provider_trust_system);
+            case PushProviderInfo.TRUST_USER_INSTALLED:
+                return getString(R.string.notification_push_provider_trust_user);
+            case PushProviderInfo.TRUST_REJECTED:
+                return getString(R.string.notification_push_provider_trust_rejected);
+            default:
+                return getString(R.string.notification_push_provider_trust_unknown);
+        }
+    }
+
+    private String firstNonEmpty(String... values) {
+        if (values == null) {
+            return null;
+        }
+        for (String value : values) {
+            if (!TextUtils.isEmpty(value)) {
+                return value;
+            }
+        }
+        return null;
+    }
+
+    @SuppressWarnings("unchecked")
+    private <T extends Preference> T requirePreference(String key) {
+        final Preference preference = findPreference(key);
+        if (preference == null) {
+            throw new IllegalStateException("Missing preference: " + key);
+        }
+        return (T) preference;
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider();
