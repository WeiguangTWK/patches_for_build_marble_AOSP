+package org.lineageos.lineageparts.push;
+
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.os.Bundle;
+import android.os.UserHandle;
+import android.text.TextUtils;
+import android.widget.Toast;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.SwitchPreferenceCompat;
+
+import org.lineageos.lineageparts.R;
+import org.lineageos.lineageparts.SettingsPreferenceFragment;
+import org.lineageos.lineageparts.search.BaseSearchIndexProvider;
+import org.lineageos.lineageparts.search.Searchable;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import lineageos.push.PushBrokerConstants;
+import lineageos.push.PushBrokerManager;
+import lineageos.push.PushProviderInfo;
+
+public class PushBrokerCompatibilityAppSettings extends SettingsPreferenceFragment
+        implements Searchable {
+    private static final String KEY_APP_SWITCH = "push_provider_compatibility_app_switch";
+    private static final String KEY_STATUS_CATEGORY = "push_provider_compatibility_app_status";
+    private static final String KEY_CAPABILITIES_CATEGORY =
+            "push_provider_compatibility_app_capabilities";
+    private static final String KEY_CAPABILITY_PREFIX =
+            "push_provider_compatibility_app_capability_";
+
+    private PushBrokerManager mPushBrokerManager;
+    private String mProviderId;
+    private String mPackageName;
+    private int mUserId;
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        addPreferencesFromResource(R.xml.push_broker_compatibility_app_settings);
+    }
+
+    @Override
+    public void onAttach(Context context) {
+        super.onAttach(context);
+        final Bundle arguments = getArguments();
+        mProviderId = arguments == null
+                ? null : arguments.getString(PushBrokerSettings.EXTRA_PROVIDER_ID);
+        mPackageName = arguments == null
+                ? null : arguments.getString(PushBrokerSettings.EXTRA_PACKAGE_NAME);
+        mUserId = arguments == null
+                ? UserHandle.USER_SYSTEM
+                : arguments.getInt(PushBrokerSettings.EXTRA_USER_ID, UserHandle.USER_SYSTEM);
+    }
+
+    @Override
+    public void onActivityCreated(Bundle savedInstanceState) {
+        super.onActivityCreated(savedInstanceState);
+        requireActivity().getActionBar().setTitle(getCompatibilityAppLabel());
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        refreshState();
+    }
+
+    private void refreshState() {
+        final SwitchPreferenceCompat appSwitch = requirePreference(KEY_APP_SWITCH);
+        final PreferenceCategory statusCategory = requirePreference(KEY_STATUS_CATEGORY);
+        final PreferenceCategory capabilitiesCategory = requirePreference(KEY_CAPABILITIES_CATEGORY);
+
+        statusCategory.removeAll();
+        capabilitiesCategory.removeAll();
+        statusCategory.setVisible(false);
+        capabilitiesCategory.setVisible(false);
+
+        if (TextUtils.isEmpty(mProviderId) || TextUtils.isEmpty(mPackageName)) {
+            appSwitch.setEnabled(false);
+            appSwitch.setSummary(R.string.notification_push_provider_unavailable);
+            return;
+        }
+
+        try {
+            mPushBrokerManager = PushBrokerManager.getInstance(getContext());
+        } catch (RuntimeException e) {
+            appSwitch.setEnabled(false);
+            appSwitch.setSummary(R.string.notification_push_provider_unavailable);
+            return;
+        }
+
+        final Bundle appState = mPushBrokerManager.getCompatibilityAppState(
+                mProviderId, mPackageName, mUserId);
+        if (appState == null || !appState.getBoolean(PushBrokerConstants.COMPAT_APP_SUPPORTED,
+                false)) {
+            appSwitch.setEnabled(false);
+            appSwitch.setSummary(R.string.notification_push_compatibility_not_available);
+            return;
+        }
+
+        final String[] providerProfiles = getProviderProfiles();
+        final boolean authorized = appState.getBoolean(PushBrokerConstants.COMPAT_APP_AUTHORIZED,
+                false);
+        final boolean switchEnabled = providerProfiles.length == 1;
+        appSwitch.setTitle(getCompatibilityAppLabel());
+        appSwitch.setChecked(authorized);
+        appSwitch.setEnabled(switchEnabled);
+        appSwitch.setSummary(buildCompatibilityAppSummary(appState));
+        if (switchEnabled) {
+            appSwitch.setOnPreferenceChangeListener((pref, newValue) -> {
+                final boolean enabled = Boolean.TRUE.equals(newValue);
+                final boolean changed = enabled
+                        ? mPushBrokerManager.setCompatibilityProfiles(mProviderId, mPackageName,
+                                mUserId, new String[] {providerProfiles[0]})
+                        : mPushBrokerManager.clearCompatibilityProfiles(mProviderId,
+                                mPackageName, mUserId);
+                if (!changed) {
+                    Toast.makeText(getContext(),
+                            R.string.notification_push_provider_enable_failed,
+                            Toast.LENGTH_SHORT).show();
+                    return false;
+                }
+                refreshState();
+                return true;
+            });
+        } else {
+            appSwitch.setOnPreferenceChangeListener(null);
+        }
+
+        statusCategory.setVisible(true);
+        addStatusPreference(statusCategory,
+                getString(R.string.notification_push_compatibility_profiles_label),
+                getString(R.string.notification_push_compatibility_profiles_summary,
+                        providerProfiles.length == 0
+                                ? getString(R.string.notification_push_compatibility_unknown_result)
+                                : TextUtils.join(", ", Arrays.asList(providerProfiles))));
+        addStatusPreference(statusCategory,
+                getString(R.string.notification_push_compatibility_effective),
+                getCapabilityListSummary(appState.getStringArray(
+                        PushBrokerConstants.COMPAT_APP_EFFECTIVE_CAPABILITY_IDS)));
+        addStatusPreference(statusCategory,
+                getString(R.string.notification_push_compatibility_results),
+                getString(R.string.notification_push_compatibility_result_summary,
+                        formatResultCode(appState, "lastPrepareResult"),
+                        formatResultCode(appState, "lastSyncResult"),
+                        formatResultCode(appState, "lastTokenResult")));
+
+        addCapabilityPreferences(capabilitiesCategory, appState, authorized);
+    }
+
+    private void addCapabilityPreferences(PreferenceCategory category, Bundle appState,
+            boolean authorized) {
+        final String[] requestedCapabilities = appState.getStringArray(
+                PushBrokerConstants.COMPAT_APP_REQUESTED_CAPABILITY_IDS);
+        if (requestedCapabilities == null || requestedCapabilities.length == 0) {
+            return;
+        }
+
+        final Set<String> enabledCapabilities = new HashSet<>(Arrays.asList(
+                safeArray(appState.getStringArray(
+                        PushBrokerConstants.COMPAT_APP_ENABLED_CAPABILITY_IDS))));
+        final Set<String> availableCapabilities = new HashSet<>(Arrays.asList(
+                safeArray(appState.getStringArray(
+                        PushBrokerConstants.COMPAT_APP_AVAILABLE_CAPABILITY_IDS))));
+        final ArrayList<String> visibleCapabilities = new ArrayList<>();
+        for (String capabilityId : requestedCapabilities) {
+            if (!TextUtils.isEmpty(capabilityId) && availableCapabilities.contains(capabilityId)) {
+                visibleCapabilities.add(capabilityId);
+            }
+        }
+        if (visibleCapabilities.isEmpty()) {
+            return;
+        }
+
+        category.setVisible(true);
+        for (String capabilityId : visibleCapabilities) {
+            final SwitchPreferenceCompat capabilityPreference =
+                    new SwitchPreferenceCompat(getPrefContext());
+            capabilityPreference.setKey(KEY_CAPABILITY_PREFIX + capabilityId);
+            capabilityPreference.setTitle(getCapabilityLabel(capabilityId));
+            capabilityPreference.setSummary(
+                    R.string.notification_push_compatibility_capability_available);
+            capabilityPreference.setChecked(enabledCapabilities.contains(capabilityId));
+            capabilityPreference.setEnabled(authorized);
+            capabilityPreference.setOnPreferenceChangeListener((pref, newValue) -> {
+                final Set<String> nextEnabled = new HashSet<>(enabledCapabilities);
+                if (Boolean.TRUE.equals(newValue)) {
+                    nextEnabled.add(capabilityId);
+                } else {
+                    nextEnabled.remove(capabilityId);
+                }
+                final boolean changed = mPushBrokerManager.setCompatibilityCapabilities(
+                        mProviderId, mPackageName, mUserId, nextEnabled.toArray(new String[0]));
+                if (!changed) {
+                    Toast.makeText(getContext(),
+                            R.string.notification_push_provider_enable_failed,
+                            Toast.LENGTH_SHORT).show();
+                    return false;
+                }
+                refreshState();
+                return true;
+            });
+            category.addPreference(capabilityPreference);
+        }
+    }
+
+    private void addStatusPreference(PreferenceCategory category, CharSequence title,
+            CharSequence summary) {
+        final Preference preference = new Preference(getPrefContext());
+        preference.setTitle(title);
+        preference.setSummary(summary);
+        preference.setSelectable(false);
+        category.addPreference(preference);
+    }
+
+    private CharSequence getCompatibilityAppLabel() {
+        try {
+            return requireContext().getPackageManager().getApplicationLabel(
+                    requireContext().getPackageManager().getApplicationInfo(mPackageName, 0));
+        } catch (PackageManager.NameNotFoundException e) {
+            return mPackageName;
+        }
+    }
+
+    private String[] getProviderProfiles() {
+        final List<PushProviderInfo> providers = mPushBrokerManager.getInstalledProviders();
+        for (PushProviderInfo provider : providers) {
+            if (TextUtils.equals(provider.providerId, mProviderId)) {
+                return provider.compatibilityProfiles == null
+                        ? new String[0] : provider.compatibilityProfiles;
+            }
+        }
+        return new String[0];
+    }
+
+    private String buildCompatibilityAppSummary(Bundle appState) {
+        final ArrayList<String> parts = new ArrayList<>();
+        if (appState.getBoolean(PushBrokerConstants.COMPAT_APP_AUTHORIZED, false)) {
+            parts.add(getString(R.string.notification_push_compatibility_authorized));
+        }
+        if (appState.getBoolean(PushBrokerConstants.COMPAT_APP_SUPPORTED, false)) {
+            parts.add(getString(R.string.notification_push_compatibility_supported));
+        }
+        final String[] profiles = appState.getStringArray(
+                PushBrokerConstants.COMPAT_APP_ENABLED_PROFILE_IDS);
+        if (profiles != null && profiles.length > 0) {
+            parts.add(getString(R.string.notification_push_compatibility_profiles_summary,
+                    TextUtils.join(", ", Arrays.asList(profiles))));
+        }
+        final String[] effectiveCapabilities = appState.getStringArray(
+                PushBrokerConstants.COMPAT_APP_EFFECTIVE_CAPABILITY_IDS);
+        if (effectiveCapabilities != null && effectiveCapabilities.length > 0) {
+            parts.add(getString(R.string.notification_push_compatibility_capabilities_summary,
+                    TextUtils.join(", ", Arrays.asList(effectiveCapabilities))));
+        }
+        parts.add(getString(R.string.notification_push_compatibility_result_summary,
+                formatResultCode(appState, "lastPrepareResult"),
+                formatResultCode(appState, "lastSyncResult"),
+                formatResultCode(appState, "lastTokenResult")));
+        return TextUtils.join(", ", parts);
+    }
+
+    private String formatResultCode(Bundle appState, String key) {
+        return appState.containsKey(key)
+                ? String.valueOf(appState.getInt(key))
+                : getString(R.string.notification_push_compatibility_unknown_result);
+    }
+
+    private String getCapabilityListSummary(String[] capabilityIds) {
+        if (capabilityIds == null || capabilityIds.length == 0) {
+            return getString(R.string.notification_push_compatibility_unknown_result);
+        }
+        final ArrayList<String> labels = new ArrayList<>();
+        for (String capabilityId : capabilityIds) {
+            labels.add(getCapabilityLabel(capabilityId));
+        }
+        return TextUtils.join(", ", labels);
+    }
+
+    private String getCapabilityLabel(String capabilityId) {
+        if (PushBrokerConstants.COMPAT_CAP_PACKAGE_SIGNATURE_SPOOF.equals(capabilityId)) {
+            return getString(R.string.notification_push_compatibility_capability_signature_spoof);
+        }
+        if (PushBrokerConstants.COMPAT_CAP_PACKAGE_STATE_SYNC.equals(capabilityId)) {
+            return getString(R.string.notification_push_compatibility_capability_package_sync);
+        }
+        if (PushBrokerConstants.COMPAT_CAP_SERVICE_KEEPALIVE.equals(capabilityId)) {
+            return getString(R.string.notification_push_compatibility_capability_keepalive);
+        }
+        return capabilityId;
+    }
+
+    private String[] safeArray(String[] values) {
+        return values == null ? new String[0] : values;
+    }
+
+    @SuppressWarnings("unchecked")
+    private <T extends Preference> T requirePreference(String key) {
+        final Preference preference = findPreference(key);
+        if (preference == null) {
+            throw new IllegalStateException("Missing preference: " + key);
+        }
+        return (T) preference;
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider();
+}
