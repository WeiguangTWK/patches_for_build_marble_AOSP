+package com.android.settings.fuelgauge;
+
+import android.content.Context;
+
+import androidx.annotation.NonNull;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+import lineageos.health.HealthInterface;
+
+public class ChargingLimitRelaxationPreferenceController extends TogglePreferenceController {
+    private static final int MODE_NONE = 1;
+
+    public ChargingLimitRelaxationPreferenceController(@NonNull Context context,
+            @NonNull String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    private HealthInterface getHealthInterface() {
+        try {
+            return HealthInterface.getInstance(mContext);
+        } catch (RuntimeException e) {
+            return null;
+        }
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        final HealthInterface healthInterface = getHealthInterface();
+        return healthInterface != null && healthInterface.isFastChargeSupported()
+                && healthInterface.getSupportedFastChargeModes().length == 1
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        final HealthInterface healthInterface = getHealthInterface();
+        return healthInterface != null
+                && healthInterface.getSessionFastChargeMode() != MODE_NONE;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        final HealthInterface healthInterface = getHealthInterface();
+        if (healthInterface == null) {
+            return false;
+        }
+
+        if (!isChecked) {
+            return healthInterface.resetSessionFastChargeMode();
+        }
+
+        final int[] supportedModes = healthInterface.getSupportedFastChargeModes();
+        for (int mode : supportedModes) {
+            if (mode != MODE_NONE) {
+                return healthInterface.setSessionFastChargeMode(mode);
+            }
+        }
+
+        return false;
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_battery;
+    }
+}
