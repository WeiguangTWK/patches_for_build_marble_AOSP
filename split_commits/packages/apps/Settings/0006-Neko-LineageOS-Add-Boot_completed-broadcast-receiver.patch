+package com.android.settings.fuelgauge;
+
+import android.app.AppGlobals;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.IPackageManager;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.os.RemoteException;
+import android.os.UserHandle;
+import android.util.ArraySet;
+import android.util.Log;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.core.PreferenceControllerMixin;
+import com.android.settingslib.PrimarySwitchPreference;
+import com.android.settingslib.applications.ApplicationsState;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Controls whether a third-party app can receive boot completion broadcasts. */
+public class BootBroadcastAllowabilityPreferenceController extends BasePreferenceController
+        implements PreferenceControllerMixin {
+
+    private static final String TAG = "BootBroadcastCtrl";
+    private static final String KEY_BOOT_BROADCAST_ALLOWABILITY_SWITCH =
+            "boot_broadcast_allowability_switch";
+    private static final int QUERY_FLAGS =
+            PackageManager.MATCH_DISABLED_COMPONENTS
+                    | PackageManager.MATCH_DIRECT_BOOT_AWARE
+                    | PackageManager.MATCH_DIRECT_BOOT_UNAWARE;
+
+    private final String mPackageName;
+    private final int mUserId;
+    @Nullable private final ApplicationInfo mApplicationInfo;
+    private final IPackageManager mIPackageManager;
+
+    @Nullable private PrimarySwitchPreference mPreference;
+    @Nullable private List<ResolveInfo> mBootReceivers;
+
+    public BootBroadcastAllowabilityPreferenceController(
+            @NonNull Context context,
+            @Nullable ApplicationsState.AppEntry appEntry,
+            @Nullable String packageName,
+            int uid) {
+        super(context, KEY_BOOT_BROADCAST_ALLOWABILITY_SWITCH);
+        mPackageName = packageName;
+        mUserId = UserHandle.getUserId(uid);
+        mApplicationInfo = appEntry == null ? null : appEntry.info;
+        mIPackageManager = AppGlobals.getPackageManager();
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        if (!isThirdPartyApp()) {
+            return CONDITIONALLY_UNAVAILABLE;
+        }
+        return getBootReceivers().isEmpty() ? CONDITIONALLY_UNAVAILABLE : AVAILABLE;
+    }
+
+    @Override
+    public void displayPreference(@NonNull PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mPreference = screen.findPreference(KEY_BOOT_BROADCAST_ALLOWABILITY_SWITCH);
+        updatePreference();
+    }
+
+    @Override
+    public void updateState(@NonNull Preference preference) {
+        updatePreference();
+    }
+
+    private void updatePreference() {
+        if (mPreference == null) {
+            return;
+        }
+        mPreference.setChecked(isChecked());
+        mPreference.setSwitchEnabled(true);
+        mPreference.setOnPreferenceChangeListener(
+                (preference, newValue) -> setBootBroadcastAllowed((boolean) newValue));
+    }
+
+    private boolean setBootBroadcastAllowed(boolean allowed) {
+        boolean success = true;
+        for (ResolveInfo receiver : getBootReceivers()) {
+            final ComponentName componentName = receiver.getComponentInfo().getComponentName();
+            final int newState = allowed
+                    ? PackageManager.COMPONENT_ENABLED_STATE_DEFAULT
+                    : PackageManager.COMPONENT_ENABLED_STATE_DISABLED;
+            try {
+                mIPackageManager.setComponentEnabledSetting(
+                        componentName,
+                        newState,
+                        PackageManager.DONT_KILL_APP,
+                        mUserId,
+                        mContext.getOpPackageName());
+            } catch (RemoteException e) {
+                Log.e(TAG, "Failed updating boot receiver state for "
+                        + componentName.flattenToShortString(), e);
+                success = false;
+            }
+        }
+        if (success && mPreference != null) {
+            mPreference.setChecked(allowed);
+        }
+        return success;
+    }
+
+    private boolean isChecked() {
+        for (ResolveInfo receiver : getBootReceivers()) {
+            if (isReceiverEnabled(receiver)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private boolean isReceiverEnabled(@NonNull ResolveInfo receiver) {
+        final ComponentName componentName = receiver.getComponentInfo().getComponentName();
+        try {
+            final int state = mIPackageManager.getComponentEnabledSetting(componentName, mUserId);
+            switch (state) {
+                case PackageManager.COMPONENT_ENABLED_STATE_DISABLED:
+                case PackageManager.COMPONENT_ENABLED_STATE_DISABLED_USER:
+                case PackageManager.COMPONENT_ENABLED_STATE_DISABLED_UNTIL_USED:
+                    return false;
+                case PackageManager.COMPONENT_ENABLED_STATE_ENABLED:
+                    return true;
+                case PackageManager.COMPONENT_ENABLED_STATE_DEFAULT:
+                default:
+                    return receiver.getComponentInfo().isEnabled();
+            }
+        } catch (RemoteException e) {
+            Log.e(TAG, "Failed reading boot receiver state for "
+                    + componentName.flattenToShortString(), e);
+            return receiver.getComponentInfo().isEnabled();
+        }
+    }
+
+    private boolean isThirdPartyApp() {
+        if (mApplicationInfo == null || mPackageName == null) {
+            return false;
+        }
+        return !mApplicationInfo.isSystemApp() && !mApplicationInfo.isUpdatedSystemApp();
+    }
+
+    @NonNull
+    private List<ResolveInfo> getBootReceivers() {
+        if (mBootReceivers != null) {
+            return mBootReceivers;
+        }
+        mBootReceivers = new ArrayList<>();
+        if (mPackageName == null) {
+            return mBootReceivers;
+        }
+
+        final ArraySet<ComponentName> seen = new ArraySet<>();
+        collectReceivers(Intent.ACTION_BOOT_COMPLETED, seen, mBootReceivers);
+        collectReceivers(Intent.ACTION_LOCKED_BOOT_COMPLETED, seen, mBootReceivers);
+        return mBootReceivers;
+    }
+
+    private void collectReceivers(
+            @NonNull String action,
+            @NonNull ArraySet<ComponentName> seen,
+            @NonNull List<ResolveInfo> outReceivers) {
+        final Intent intent = new Intent(action).setPackage(mPackageName);
+        final List<ResolveInfo> receivers = mContext.getPackageManager()
+                .queryBroadcastReceiversAsUser(intent, QUERY_FLAGS, mUserId);
+        for (ResolveInfo receiver : receivers) {
+            final ComponentName componentName = receiver.getComponentInfo().getComponentName();
+            if (seen.add(componentName)) {
+                outReceivers.add(receiver);
+            }
+        }
+    }
+}
