+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.settings.spa.app.appinfo
+
+import android.content.ComponentName
+import android.content.Intent
+import android.content.pm.ApplicationInfo
+import android.os.Bundle
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import com.android.settings.R
+import com.android.settingslib.spa.widget.preference.Preference
+import com.android.settingslib.spa.widget.preference.PreferenceModel
+import com.android.settingslib.spaprivileged.model.app.userHandle
+
+@Composable
+fun FasPreference(app: ApplicationInfo) {
+    val context = LocalContext.current
+    if (!context.resources.getBoolean(com.android.internal.R.bool.config_enableFas)) return
+    val intent = Intent().apply {
+        component = ComponentName("org.lineageos.lineageparts",
+            "org.lineageos.lineageparts.fas.FasSettings")
+        putExtra(":settings:show_fragment_args", Bundle().apply {
+            putString("package", app.packageName)
+        })
+        putExtra(":settings:fragment_args_key", app.packageName)
+    }
+    if (context.packageManager.resolveActivity(intent, 0) == null) return
+    Preference(object : PreferenceModel {
+        override val title = stringResource(R.string.fas_settings_title)
+        override val onClick = { context.startActivityAsUser(intent, app.userHandle) }
+    })
+}
