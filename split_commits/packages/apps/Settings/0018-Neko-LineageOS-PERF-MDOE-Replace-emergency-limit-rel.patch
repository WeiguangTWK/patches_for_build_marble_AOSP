new file mode 100644
index 0000000..d68fb46
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/PerformanceModePreferenceController.java
@@ -0,0 +1,123 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Neko-LineageOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.fuelgauge;
+
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_APPLYING;
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_ERROR;
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_OFF;
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_RESTORING;
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_STATE;
+
+import android.content.Context;
+import android.database.ContentObserver;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+import android.widget.Toast;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+import com.android.settingslib.core.lifecycle.LifecycleObserver;
+import com.android.settingslib.core.lifecycle.events.OnStart;
+import com.android.settingslib.core.lifecycle.events.OnStop;
+
+import lineageos.health.HealthInterface;
+
+public final class PerformanceModePreferenceController extends TogglePreferenceController
+        implements LifecycleObserver, OnStart, OnStop {
+    private Preference mPreference;
+    private final ContentObserver mObserver = new ContentObserver(new Handler(Looper.getMainLooper())) {
+        @Override
+        public void onChange(boolean selfChange) {
+            if (mPreference != null) updateState(mPreference);
+        }
+    };
+
+    public PerformanceModePreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    private HealthInterface health() {
+        try {
+            return HealthInterface.getInstance(mContext);
+        } catch (RuntimeException e) {
+            return null;
+        }
+    }
+
+    private int state() {
+        return Settings.Global.getInt(mContext.getContentResolver(),
+                PERFORMANCE_MODE_STATE, PERFORMANCE_MODE_OFF);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        HealthInterface health = health();
+        return health != null && health.isPerformanceModeSupported()
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        // An uncertain/failed disable must remain visible and allow another off attempt.
+        return state() != PERFORMANCE_MODE_OFF;
+    }
+
+    @Override
+    public boolean setChecked(boolean checked) {
+        HealthInterface health = health();
+        boolean accepted = health != null && health.setPerformanceModeEnabled(checked);
+        if (!accepted) {
+            Toast.makeText(mContext, R.string.performance_mode_error, Toast.LENGTH_LONG).show();
+        }
+        return accepted;
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        return mContext.getText(switch (state()) {
+            case PERFORMANCE_MODE_APPLYING -> R.string.performance_mode_applying;
+            case PERFORMANCE_MODE_RESTORING -> R.string.performance_mode_restoring;
+            case PERFORMANCE_MODE_ERROR -> R.string.performance_mode_error_content;
+            default -> R.string.performance_mode_summary;
+        });
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mPreference = screen.findPreference(getPreferenceKey());
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        preference.setSummary(getSummary());
+        int state = state();
+        preference.setEnabled(state != PERFORMANCE_MODE_APPLYING
+                && state != PERFORMANCE_MODE_RESTORING);
+    }
+
+    @Override
+    public void onStart() {
+        mContext.getContentResolver().registerContentObserver(
+                Settings.Global.getUriFor(PERFORMANCE_MODE_STATE), false, mObserver);
+        if (mPreference != null) updateState(mPreference);
+    }
+
+    @Override
+    public void onStop() {
+        mContext.getContentResolver().unregisterContentObserver(mObserver);
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_battery;
+    }
+}
