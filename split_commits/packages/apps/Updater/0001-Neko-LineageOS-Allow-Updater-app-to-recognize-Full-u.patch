diff --git a/app/src/main/java/org/lineageos/updater/data/UpdatesRepository.kt b/app/src/main/java/org/lineageos/updater/data/UpdatesRepository.kt
index c659394..1b279fa 100644
--- a/app/src/main/java/org/lineageos/updater/data/UpdatesRepository.kt
+++ b/app/src/main/java/org/lineageos/updater/data/UpdatesRepository.kt
@@ -103,6 +103,17 @@ class UpdatesRepository(
             Log.d(TAG, "${update.name} has type ${update.type}")
             return false
         }
+
+        if (update.minBaseTimestamp > 0 &&
+            DeviceInfoUtils.buildDateTimestamp < update.minBaseTimestamp
+        ) {
+            Log.d(
+                TAG,
+                "${update.name} requires base ${update.minBaseTimestamp}, current build is " +
+                    DeviceInfoUtils.buildDateTimestamp
+            )
+            return false
+        }
         return true
     }
 }
