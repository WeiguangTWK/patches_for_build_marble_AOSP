@@ -106,6 +106,17 @@ class UpdatesRepository(
             Log.d(TAG, "${update.name} has type ${update.type}")
             return false
         }
+
+        if (update.minBaseTimestamp > 0 &&
+            DeviceInfoUtils.buildDateTimestamp < update.minBaseTimestamp
+        ) {
+            Log.d(
+                TAG,
+                "${update.name} requires base ${update.minBaseTimestamp}, current build is " +
+                    DeviceInfoUtils.buildDateTimestamp
+            )
+            return false
+        }
         return true
     }
 }
