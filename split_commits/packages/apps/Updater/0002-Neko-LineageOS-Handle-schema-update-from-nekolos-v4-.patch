--- a/app/src/main/java/org/lineageos/updater/data/source/local/UpdatesDatabase.kt
+++ b/app/src/main/java/org/lineageos/updater/data/source/local/UpdatesDatabase.kt
@@ -78,12 +78,46 @@ abstract class UpdatesDatabase : RoomDatabase() {
 
         private val MIGRATION_4_5 = object : Migration(4, 5) {
             override fun migrate(db: SupportSQLiteDatabase) {
-                db.execSQL(
-                    "ALTER TABLE `updates` ADD COLUMN `min_base_timestamp` INTEGER NOT NULL DEFAULT 0"
+                // Version 4 existed in two forms: upstream added payload metadata columns,
+                // while older Neko builds added min_base_timestamp. Converge both to v5.
+                addColumnIfMissing(db, "payload_metadata_offset", "INTEGER")
+                addColumnIfMissing(db, "payload_metadata_size", "INTEGER")
+                addColumnIfMissing(db, "payload_offset", "INTEGER")
+                addColumnIfMissing(db, "payload_size", "INTEGER")
+                addColumnIfMissing(db, "payload_properties_offset", "INTEGER")
+                addColumnIfMissing(db, "payload_properties_size", "INTEGER")
+                addColumnIfMissing(
+                    db,
+                    "min_base_timestamp",
+                    "INTEGER NOT NULL DEFAULT 0"
                 )
             }
         }
 
+        private fun addColumnIfMissing(
+            db: SupportSQLiteDatabase,
+            column: String,
+            definition: String
+        ) {
+            if (!hasColumn(db, "updates", column)) {
+                db.execSQL("ALTER TABLE `updates` ADD COLUMN `$column` $definition")
+            }
+        }
+
+        private fun hasColumn(
+            db: SupportSQLiteDatabase,
+            table: String,
+            column: String
+        ): Boolean = db.query("PRAGMA table_info(`$table`)").use { cursor ->
+            val nameIndex = cursor.getColumnIndexOrThrow("name")
+            while (cursor.moveToNext()) {
+                if (cursor.getString(nameIndex) == column) {
+                    return@use true
+                }
+            }
+            false
+        }
+
         @JvmStatic
         fun getInstance(context: Context): UpdatesDatabase = instance ?: synchronized(this) {
             instance ?: Room.databaseBuilder(
