diff --git a/compatibility_matrices/compatibility_matrix.system.xml b/compatibility_matrices/compatibility_matrix.system.xml
index 2bf3be2..73fd76e 100644
--- a/compatibility_matrices/compatibility_matrix.system.xml
+++ b/compatibility_matrices/compatibility_matrix.system.xml
@@ -37,6 +37,15 @@
             <instance>default</instance>
         </interface>
     </hal>
+    <!-- Frame-aware scheduling -->
+    <hal format="aidl" optional="true">
+        <name>vendor.performance.fas</name>
+        <version>1</version>
+        <interface>
+            <name>IFasBackend</name>
+            <instance>default</instance>
+        </interface>
+    </hal>
     <!-- Display -->
     <hal format="aidl" optional="true">
         <name>vendor.lineage.livedisplay</name>
diff --git a/fas/aidl/Android.bp b/fas/aidl/Android.bp
new file mode 100644
index 0000000..cfd164b
--- /dev/null
+++ b/fas/aidl/Android.bp
@@ -0,0 +1,31 @@
+//
+// Copyright (C) 2026 The LineageOS Project
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+
+aidl_interface {
+    name: "vendor.performance.fas",
+    srcs: ["vendor/performance/fas/*.aidl"],
+    stability: "vintf",
+    vendor_available: true,
+
+    backend: {
+        java: {
+            enabled: false,
+        },
+        ndk: {
+            enabled: true,
+        },
+        cpp: {
+            enabled: false,
+        },
+    },
+    frozen: true,
+    versions_with_info: [
+        {
+            version: "1",
+            imports: [],
+        },
+    ],
+}
diff --git a/fas/aidl/aidl_api/vendor.performance.fas/1/.hash b/fas/aidl/aidl_api/vendor.performance.fas/1/.hash
