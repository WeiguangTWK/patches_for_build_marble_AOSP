 create mode 100644 fas/aidl/Android.bp
 create mode 100644 fas/aidl/aidl_api/vendor.performance.fas/1/.hash
 create mode 100644 fas/aidl/aidl_api/vendor.performance.fas/1/vendor/performance/fas/CpuPolicyVote.aidl
 create mode 100644 fas/aidl/aidl_api/vendor.performance.fas/1/vendor/performance/fas/IFasBackend.aidl
 create mode 100644 fas/aidl/aidl_api/vendor.performance.fas/current/vendor/performance/fas/CpuPolicyVote.aidl
 create mode 100644 fas/aidl/aidl_api/vendor.performance.fas/current/vendor/performance/fas/IFasBackend.aidl
 create mode 100644 fas/aidl/vendor/performance/fas/CpuPolicyVote.aidl
