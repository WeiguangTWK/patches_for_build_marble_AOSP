From c3306cab53a675befec0e1b5e7beb9c30019ac30 Mon Sep 17 00:00:00 2001
From: WeiguangTWK <weiguangtwk@outlook.com>
Date: Thu, 9 Jul 2026 10:58:05 +0800
Subject: [PATCH] Neko LineageOS: Fix PAL config error flooding and defensive
 validation

Once it handles routing but upstream fixed it

Change-Id: Ie11e6b6bdda8e07cf523a09617448425e6c137e1
---
 resource_manager/src/ResourceManager.cpp | 55 +++++++++++++++++++-----
 1 file changed, 44 insertions(+), 11 deletions(-)

diff --git a/resource_manager/src/ResourceManager.cpp b/resource_manager/src/ResourceManager.cpp
index 57f1939..adb61c3 100644
--- a/resource_manager/src/ResourceManager.cpp
+++ b/resource_manager/src/ResourceManager.cpp
@@ -5863,8 +5863,9 @@ int ResourceManager::checkAndUpdateGroupDevConfig(struct pal_device *deviceattr,
             if (it != groupDevConfigMap.end()) {
                 ResourceManager::activeGroupDevConfig = it->second;
             } else {
-                PAL_ERR(LOG_TAG, "group config for %d is missing", group_cfg_idx);
-                return -EINVAL;
+                PAL_INFO(LOG_TAG, "group config for %d is missing, skip group update", group_cfg_idx);
+                ResourceManager::activeGroupDevConfig = nullptr;
+                return 0;
             }
         /* check for streams on speaker or handset comming/goes away */
         } else if (deviceattr->id == PAL_DEVICE_OUT_SPEAKER ||
@@ -5949,8 +5950,9 @@ int ResourceManager::checkAndUpdateGroupDevConfig(struct pal_device *deviceattr,
             if (it != groupDevConfigMap.end()) {
                 ResourceManager::activeGroupDevConfig = it->second;
             } else {
-                PAL_ERR(LOG_TAG, "group config for %d is missing", group_cfg_idx);
-                return -EINVAL;
+                PAL_INFO(LOG_TAG, "group config for %d is missing, skip group update", group_cfg_idx);
+                ResourceManager::activeGroupDevConfig = nullptr;
+                return 0;
             }
         }
 
@@ -5966,13 +5968,19 @@ int ResourceManager::checkAndUpdateGroupDevConfig(struct pal_device *deviceattr,
                 }
             }
             // then update current active device name
-            dev = Device::getInstance(streamDevAttr, rm);
-            if (dev) {
-                if (!ResourceManager::activeGroupDevConfig->snd_dev_name.empty()) {
-                    dev->setSndName(ResourceManager::activeGroupDevConfig->snd_dev_name);
-                } else {
-                    dev->clearSndName();
+            if (streamDevAttr &&
+                streamDevAttr->id > PAL_DEVICE_OUT_MIN &&
+                streamDevAttr->id < PAL_DEVICE_IN_MAX) {
+                dev = Device::getInstance(streamDevAttr, rm);
+                if (dev) {
+                    if (!ResourceManager::activeGroupDevConfig->snd_dev_name.empty()) {
+                        dev->setSndName(ResourceManager::activeGroupDevConfig->snd_dev_name);
+                    } else {
+                        dev->clearSndName();
+                    }
                 }
+            } else {
+                PAL_DBG(LOG_TAG, "skip updating current active group device name, invalid streamDevAttr");
             }
         }
     }
@@ -6694,8 +6702,27 @@ bool ResourceManager::compareSharedBEStreamDevAttr(std::vector <std::tuple<Strea
     uint32_t curDevPrio, newDevPrio;
     bool switchStreams = false;
 
+    if (!newDevAttr) {
+        PAL_ERR(LOG_TAG, "Invalid newDevAttr");
+        return switchStreams;
+    }
+
+    if (sharedBEStreamDev.empty()) {
+        PAL_ERR(LOG_TAG, "sharedBEStreamDev is empty");
+        return switchStreams;
+    }
+
+    if (newDevAttr->id <= PAL_DEVICE_OUT_MIN || newDevAttr->id >= PAL_DEVICE_IN_MAX) {
+        PAL_ERR(LOG_TAG, "invalid newDevAttr id %d", newDevAttr->id);
+        return switchStreams;
+    }
+
     /* get current active device for shared BE streams */
     curDevAttr.id = (pal_device_id_t)std::get<1>(sharedBEStreamDev[0]);
+    if (curDevAttr.id <= PAL_DEVICE_OUT_MIN || curDevAttr.id >= PAL_DEVICE_IN_MAX) {
+        PAL_ERR(LOG_TAG, "invalid shared backend device id %d", curDevAttr.id);
+        return switchStreams;
+    }
     curDev = Device::getInstance(&curDevAttr, rm);
     if (!curDev) {
         PAL_ERR(LOG_TAG, "Getting Device instance failed");
@@ -7380,7 +7407,7 @@ bool ResourceManager::updateDeviceConfig(std::shared_ptr<Device> *inDev,
     struct pal_device_info inDeviceInfo;
     std::vector <Stream *> streamsToSwitch;
     std::vector <Stream*>::iterator sIter;
-    struct pal_device streamDevAttr;
+    struct pal_device streamDevAttr = {};
     struct pal_device spkr_devAttr;
     struct pal_device *temp_devAttr = nullptr;
     int stream_idx = 0;
@@ -7394,6 +7421,12 @@ bool ResourceManager::updateDeviceConfig(std::shared_ptr<Device> *inDev,
         goto error;
     }
 
+    if (inDevAttr->id <= PAL_DEVICE_OUT_MIN || inDevAttr->id >= PAL_DEVICE_IN_MAX) {
+        PAL_ERR(LOG_TAG, "invalid incoming device id %d for stream type %d",
+                inDevAttr->id, inStrAttr->type);
+        goto error;
+    }
+
     /* Soundtrigger stream device attributes is updated via capture profile */
     if (inStrAttr->type == PAL_STREAM_ACD ||
         inStrAttr->type == PAL_STREAM_VOICE_UI ||
-- 
