From 21008c55b5a3e5a42ff5bacf82b8c99ade786034 Mon Sep 17 00:00:00 2001
From: WeiguangTWK <weiguangtwk@outlook.com>
Date: Thu, 9 Jul 2026 11:10:26 +0800
Subject: [PATCH] Neko LineageOS: Audio primary HAL device mapping fix

Change-Id: I182d184c24fe49cd10dcafed04a304a92f4ef1a4
---
 hal/AudioDevice.cpp | 33 ++++++++++++++++++---------------
 hal/AudioStream.cpp | 35 ++++++++++++++++++++++++++++++++++-
 2 files changed, 52 insertions(+), 16 deletions(-)

diff --git a/hal/AudioDevice.cpp b/hal/AudioDevice.cpp
index bd322a3..5288320 100644
--- a/hal/AudioDevice.cpp
+++ b/hal/AudioDevice.cpp
@@ -2276,24 +2276,27 @@ int AudioDevice::GetPalDeviceIds(const std::set<audio_devices_t>& hal_device_ids
     // pal device ids is supposed to have to space for the new ids
     AHAL_DBG("haldeviceIds: %zu", hal_device_ids.size());
 
-    for(auto hal_device_id : hal_device_ids) {
+    for (auto hal_device_id : hal_device_ids) {
         auto it = android_device_map_.find(hal_device_id);
-        if (it != android_device_map_.end() &&
-                audio_is_input_device(it->first) == audio_is_input_device(hal_device_id)) {
-            AHAL_DBG("Found haldeviceId: %x and PAL Device ID %d",
-                    it->first, it->second);
-            if (it->second == PAL_DEVICE_OUT_AUX_DIGITAL ||
-                    it->second == PAL_DEVICE_OUT_HDMI) {
-               AHAL_DBG("dp_controller: %d dp_stream: %d",
-                       dp_controller, dp_stream);
-               if (dp_controller * MAX_STREAMS_PER_CONTROLLER + dp_stream) {
-                  pal_device_id[device_count] = PAL_DEVICE_OUT_AUX_DIGITAL_1;
-               } else {
-                  pal_device_id[device_count] = it->second;
-               }
+        if (it == android_device_map_.end() ||
+            audio_is_input_device(it->first) != audio_is_input_device(hal_device_id)) {
+            AHAL_ERR("No PAL mapping for HAL device 0x%x", hal_device_id);
+            continue;
+        }
+
+        AHAL_DBG("Found haldeviceId: %x and PAL Device ID %d",
+                 it->first, it->second);
+        if (it->second == PAL_DEVICE_OUT_AUX_DIGITAL ||
+            it->second == PAL_DEVICE_OUT_HDMI) {
+            AHAL_DBG("dp_controller: %d dp_stream: %d",
+                     dp_controller, dp_stream);
+            if (dp_controller * MAX_STREAMS_PER_CONTROLLER + dp_stream) {
+                pal_device_id[device_count] = PAL_DEVICE_OUT_AUX_DIGITAL_1;
             } else {
-               pal_device_id[device_count] = it->second;
+                pal_device_id[device_count] = it->second;
             }
+        } else {
+            pal_device_id[device_count] = it->second;
         }
         ++device_count;
     }
diff --git a/hal/AudioStream.cpp b/hal/AudioStream.cpp
index 9eaf61a..fa325bb 100755
--- a/hal/AudioStream.cpp
+++ b/hal/AudioStream.cpp
@@ -78,6 +78,26 @@ static bool is_pcm_format(audio_format_t format)
     return false;
 }
 
+static int validatePalDeviceIds(const char *ctx,
+                                const std::set<audio_devices_t> &hal_devices,
+                                const pal_device_id_t *pal_device_ids,
+                                int num_pal_devices) {
+    if (!pal_device_ids || num_pal_devices <= 0) {
+        return 0;
+    }
+
+    for (int i = 0; i < num_pal_devices; ++i) {
+        if (pal_device_ids[i] == PAL_DEVICE_OUT_MIN) {
+            AHAL_ERR("%s: invalid PAL device id %d at index %d (hal_devices=0x%x, num_hal=%zu, num_pal=%d)",
+                     ctx, pal_device_ids[i], i, AudioExtn::get_device_types(hal_devices),
+                     hal_devices.size(), num_pal_devices);
+            return -EINVAL;
+        }
+    }
+
+    return 0;
+}
+
 static bool is_hdr_mode_enabled() {
     if (!property_get_bool("vendor.audio.hdr.record.enable", false)) {
         AHAL_INFO("HDR feature is disabled");
@@ -2334,6 +2354,10 @@ int StreamOutPrimary::RouteStream(const std::set<audio_devices_t>& new_devices_t
             ret = -EINVAL;
             goto done;
         }
+        ret = validatePalDeviceIds(__func__, new_devices, mPalOutDeviceIds, noPalDevices);
+        if (ret) {
+            goto done;
+        }
 
         device_cap_query = (pal_param_device_capability_t *)
                 malloc(sizeof(pal_param_device_capability_t));
@@ -3766,6 +3790,9 @@ StreamOutPrimary::StreamOutPrimary(
         AHAL_ERR("mismatched pal no of devices %d and hal devices %zu", noPalDevices, mAndroidOutDevices.size());
         goto error;
     }
+    if (validatePalDeviceIds(__func__, mAndroidOutDevices, mPalOutDeviceIds, noPalDevices)) {
+        goto error;
+    }
 
     mPalOutDevice = (struct pal_device*) calloc(mAndroidOutDevices.size(), sizeof(struct pal_device));
     if (!mPalOutDevice) {
@@ -4359,6 +4386,10 @@ int StreamInPrimary::RouteStream(const std::set<audio_devices_t>& new_devices, b
             ret = -EINVAL;
             goto done;
         }
+        ret = validatePalDeviceIds(__func__, new_devices, mPalInDeviceIds, noPalDevices);
+        if (ret) {
+            goto done;
+        }
 
         device_cap_query = (pal_param_device_capability_t *)
                 malloc(sizeof(pal_param_device_capability_t));
@@ -5213,6 +5244,9 @@ StreamInPrimary::StreamInPrimary(audio_io_handle_t handle,
         AHAL_ERR("mismatched pal %d and hal devices %zu", noPalDevices, mAndroidInDevices.size());
         goto error;
     }
+    if (validatePalDeviceIds(__func__, mAndroidInDevices, mPalInDeviceIds, noPalDevices)) {
+        goto error;
+    }
     mPalInDevice = (struct pal_device*) calloc(mAndroidInDevices.size(), sizeof(struct pal_device));
     if (!mPalInDevice) {
         goto error;
@@ -5359,4 +5393,3 @@ StreamPrimary::~StreamPrimary(void)
         device_cap_query_ = NULL;
     }
 }
-
-- 
2.43.0

