diff --git a/sdk/src/java/lineageos/health/HealthInterface.java b/sdk/src/java/lineageos/health/HealthInterface.java
index 06eae35..38a6288 100644
--- a/sdk/src/java/lineageos/health/HealthInterface.java
+++ b/sdk/src/java/lineageos/health/HealthInterface.java
@@ -344,4 +344,50 @@ public class HealthInterface {
 
         return false;
     }
+
+    /**
+     * Gets the current session-only fast charge mode.
+     *
+     * @return current session fast charge mode
+     */
+    public int getSessionFastChargeMode() {
+        try {
+            return checkService() ? sService.getSessionFastChargeMode() : 0;
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+
+        return 0;
+    }
+
+    /**
+     * Sets the current session-only fast charge mode.
+     *
+     * @param mode the fast charge mode override for the current charge session
+     * @return true if the session fast charge mode was set
+     */
+    public boolean setSessionFastChargeMode(int mode) {
+        try {
+            return checkService() && sService.setSessionFastChargeMode(mode);
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+
+        return false;
+    }
+
+    /**
+     * Clears the current session-only fast charge mode.
+     *
+     * @return true if the session fast charge mode was reset
+     */
+    public boolean resetSessionFastChargeMode() {
+        try {
+            return checkService() && sService.resetSessionFastChargeMode();
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+
+        return false;
+    }
 }
