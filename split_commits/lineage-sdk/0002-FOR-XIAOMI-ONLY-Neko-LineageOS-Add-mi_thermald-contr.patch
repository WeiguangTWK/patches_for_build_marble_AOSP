@@ -122,11 +140,118 @@ public class FastChargeController extends LineageHealthFeature {
         handleSettingChange();
     }
 
+    private void registerBatteryReceiver() {
+        if (mBatteryReceiver != null) {
+            mContext.unregisterReceiver(mBatteryReceiver);
+        }
+
+        mBatteryReceiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                handleBatteryStateChanged(intent);
+            }
+        };
+
+        IntentFilter filter = new IntentFilter(Intent.ACTION_BATTERY_CHANGED);
+        Intent stickyIntent = mContext.registerReceiver(mBatteryReceiver, filter);
+        if (stickyIntent != null) {
+            handleBatteryStateChanged(stickyIntent);
+        }
+    }
+
+    private void handleBatteryStateChanged(Intent intent) {
+        final int status = intent.getIntExtra(BatteryManager.EXTRA_STATUS,
+                BatteryManager.BATTERY_STATUS_UNKNOWN);
+
+        if (status == BatteryManager.BATTERY_STATUS_CHARGING
+                || status == BatteryManager.BATTERY_STATUS_FULL) {
+            return;
+        }
+
+        if (getSessionFastChargeMode() != FastChargeMode.NONE) {
+            Log.i(TAG, "Charge session ended, clearing fast charge session override");
+            resetSessionFastChargeMode();
+        } else {
+            handleSettingChange();
+        }
+    }
+
+    private int getEffectiveFastChargeMode() {
+        final int sessionMode = getSessionFastChargeMode();
+        return sessionMode != FastChargeMode.NONE ? sessionMode : getFastChargeMode();
+    }
+
+    private int readPersistentFastChargeMode() {
+        if (!supportsPersistentFastChargeMode()) {
+            return FastChargeMode.NONE;
+        }
+
+        final int[] supportedFastChargeModes = getSupportedFastChargeModes();
+        if (supportedFastChargeModes.length == 0) {
+            return FastChargeMode.NONE;
+        }
+
+        final int defaultMode = supportedFastChargeModes[supportedFastChargeModes.length - 1];
+        final int mode = LineageSettings.System.getInt(mContentResolver,
+                LineageSettings.System.FAST_CHARGE_MODE, defaultMode);
+        if (mode != defaultMode && !ArrayUtils.contains(supportedFastChargeModes, mode)) {
+            return defaultMode;
+        }
+
+        return mode;
+    }
+
+    private boolean supportsPersistentFastChargeMode() {
+        return getSupportedFastChargeModes().length > 1;
+    }
+
+    private int sanitizePersistentMode(int mode) {
+        if (!supportsPersistentFastChargeMode()) {
+            return FastChargeMode.NONE;
+        }
+
+        if (mode == FastChargeMode.NONE) {
+            return mode;
+        }
+
+        final int[] supportedFastChargeModes = getSupportedFastChargeModes();
+        if (supportedFastChargeModes.length == 0) {
+            return FastChargeMode.NONE;
+        }
+
+        if (ArrayUtils.contains(supportedFastChargeModes, mode)) {
+            return mode;
+        }
+
+        return supportedFastChargeModes[supportedFastChargeModes.length - 1];
+    }
+
+    private int sanitizeSessionMode(int mode) {
+        if (mode == FastChargeMode.NONE) {
+            return mode;
+        }
+
+        final int[] supportedFastChargeModes = getSupportedFastChargeModes();
+        if (supportedFastChargeModes.length == 0) {
+            return FastChargeMode.NONE;
+        }
+
+        if (ArrayUtils.contains(supportedFastChargeModes, mode)) {
+            return mode;
+        }
+
+        return supportedFastChargeModes[0];
+    }
+
     @Override
     public void dump(PrintWriter pw) {
         pw.println();
         pw.println("FastChargeController Configuration:");
-        pw.println("  Mode: " + getFastChargeMode());
+        pw.println("  Supported Modes: " + Arrays.toString(getSupportedFastChargeModes()));
+        pw.println("  Persistent Mode Supported: " + supportsPersistentFastChargeMode());
+        pw.println("  Persistent Mode: " + getFastChargeMode());
+        pw.println("  Session Mode: " + getSessionFastChargeMode());
+        pw.println("  Effective Mode: " + getEffectiveFastChargeMode());
         pw.println();
     }
 }
