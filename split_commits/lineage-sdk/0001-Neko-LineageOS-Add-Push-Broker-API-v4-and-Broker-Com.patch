@@ -0,0 +1,444 @@
+/*
+ * SPDX-FileCopyrightText: Neko-LineageOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.platform.internal.push;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.ServiceConnection;
+import android.os.Binder;
+import android.os.Bundle;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.util.Log;
+
+import java.util.NoSuchElementException;
+
+import lineageos.push.IPushBrokerHost;
+import lineageos.push.IPushProviderService;
+import lineageos.push.PushBrokerConstants;
+import lineageos.push.PushProviderInfo;
+import lineageos.push.compat.ICompatibilityPolicyCallback;
+import lineageos.push.compat.ICompatibilityProviderHost;
+
+final class PushProviderConnection implements ServiceConnection {
+    private static final String TAG = "PushProviderConnection";
+
+    interface Listener {
+        void onProviderConnected(String providerId);
+        void onProviderDisconnected(String providerId);
+        void onProviderFailed(String providerId, String message);
+        void onProviderRequiresUserAction(String providerId, String reason);
+        void onProviderEvent(String providerId, Bundle event);
+    }
+
+    interface CompatibilityPolicySource {
+        Bundle getCompatibilityAppPolicy(String providerId, String packageName, int userId);
+        java.util.List<Bundle> getCompatibilityAuthorizedApps(String providerId, int userId);
+        void registerPolicyCallback(String providerId, ICompatibilityPolicyCallback callback);
+        void unregisterPolicyCallback(ICompatibilityPolicyCallback callback);
+    }
+
+    private final Context mContext;
+    private final PushProviderInfo mProviderInfo;
+    private final Listener mListener;
+    private final CompatibilityPolicySource mCompatibilityPolicySource;
+    private final IPushBrokerHost mHost = new PushBrokerHostStub();
+    private final ICompatibilityProviderHost mCompatibilityHost =
+            new CompatibilityProviderHostStub();
+    private final IBinder.DeathRecipient mDeathRecipient = this::handleBinderDied;
+
+    private IPushProviderService mService;
+    private IBinder mBinder;
+
+    PushProviderConnection(Context context, PushProviderInfo providerInfo, Listener listener,
+            CompatibilityPolicySource compatibilityPolicySource) {
+        mContext = context;
+        mProviderInfo = providerInfo;
+        mListener = listener;
+        mCompatibilityPolicySource = compatibilityPolicySource;
+    }
+
+    @Override
+    public void onServiceConnected(ComponentName name, IBinder service) {
+        unlinkToDeath();
+        mBinder = service;
+        mService = IPushProviderService.Stub.asInterface(service);
+        if (mService == null) {
+            mBinder = null;
+            mListener.onProviderFailed(mProviderInfo.providerId, "provider binder unavailable");
+            return;
+        }
+
+        try {
+            service.linkToDeath(mDeathRecipient, 0);
+            final Bundle brokerContext = new Bundle();
+            brokerContext.putInt("broker_api_version", mProviderInfo.apiVersion);
+            brokerContext.putString("provider_id", mProviderInfo.providerId);
+            brokerContext.putBinder("host_binder", mHost.asBinder());
+            brokerContext.putBinder(PushBrokerConstants.CONTEXT_COMPATIBILITY_HOST_BINDER,
+                    mCompatibilityHost.asBinder());
+
+            final int initResult = mService.initialize(brokerContext);
+            if (initResult != PushBrokerConstants.RESULT_OK) {
+                clearBinder();
+                mListener.onProviderFailed(mProviderInfo.providerId,
+                        "initialize failed: " + initResult);
+                return;
+            }
+
+            final Bundle health = getHealth();
+            if (health.getBoolean(PushBrokerConstants.HEALTH_REQUIRES_USER_ACTION, false)) {
+                final String reason = health.getString(
+                        PushBrokerConstants.HEALTH_USER_ACTION_REASON,
+                        PushBrokerConstants.HEALTH_DEGRADED_REASON_UNKNOWN);
+                clearBinder();
+                mListener.onProviderRequiresUserAction(mProviderInfo.providerId, reason);
+                return;
+            }
+
+            final int enableResult = mService.enable();
+            if (enableResult != PushBrokerConstants.RESULT_OK) {
+                clearBinder();
+                mListener.onProviderFailed(mProviderInfo.providerId,
+                        "enable failed: " + enableResult);
+                return;
+            }
+
+            mListener.onProviderConnected(mProviderInfo.providerId);
+        } catch (RemoteException | RuntimeException e) {
+            Log.e(TAG, "Failed to initialize provider " + mProviderInfo.providerId, e);
+            unlinkToDeath();
+            mService = null;
+            mListener.onProviderFailed(mProviderInfo.providerId, e.getMessage());
+        }
+    }
+
+    @Override
+    public void onServiceDisconnected(ComponentName name) {
+        unlinkToDeath();
+        mService = null;
+        mListener.onProviderDisconnected(mProviderInfo.providerId);
+    }
+
+    @Override
+    public void onBindingDied(ComponentName name) {
+        unlinkToDeath();
+        mService = null;
+        mListener.onProviderFailed(mProviderInfo.providerId, "binding died");
+    }
+
+    @Override
+    public void onNullBinding(ComponentName name) {
+        unlinkToDeath();
+        mService = null;
+        mListener.onProviderFailed(mProviderInfo.providerId, "null binding");
+    }
+
+    void disable() {
+        if (mService == null) {
+            unlinkToDeath();
+            return;
+        }
+        try {
+            mService.disable();
+        } catch (RemoteException e) {
+            Log.w(TAG, "Failed to disable provider " + mProviderInfo.providerId, e);
+        }
+        unlinkToDeath();
+    }
+
+    void close() {
+        clearBinder();
+    }
+
+    void onBootPhase(int phase) {
+        if (mService == null) {
+            return;
+        }
+        try {
+            mService.onBootPhase(phase);
+        } catch (RemoteException e) {
+            Log.w(TAG, "Failed to forward boot phase to provider " + mProviderInfo.providerId, e);
+        }
+    }
+
+    void onSystemEvent(Bundle event) {
+        if (mService == null || mProviderInfo.apiVersion < PushBrokerConstants.API_VERSION_3) {
+            return;
+        }
+        try {
+            mService.onSystemEvent(event);
+        } catch (RemoteException e) {
+            Log.w(TAG, "Failed to forward system event to provider " + mProviderInfo.providerId,
+                    e);
+        }
+    }
+
+    Bundle getHealth() {
+        if (mService == null) {
+            return Bundle.EMPTY;
+        }
+        try {
+            final Bundle health = mService.getHealth();
+            return health == null ? Bundle.EMPTY : health;
+        } catch (RemoteException e) {
+            Log.w(TAG, "Failed to query provider health " + mProviderInfo.providerId, e);
+        }
+        return Bundle.EMPTY;
+    }
+
+    Bundle dumpState() {
+        if (mService == null) {
+            return Bundle.EMPTY;
+        }
+        try {
+            final Bundle dumpState = mService.dumpState();
+            return dumpState == null ? Bundle.EMPTY : dumpState;
+        } catch (RemoteException e) {
+            Log.w(TAG, "Failed to dump provider state " + mProviderInfo.providerId, e);
+        }
+        return Bundle.EMPTY;
+    }
+
+    boolean isConnected() {
+        return mService != null;
+    }
+
+    private boolean isCallerAuthorizedProvider() {
+        final String[] packages = mContext.getPackageManager().getPackagesForUid(
+                android.os.Binder.getCallingUid());
+        if (packages == null) {
+            return false;
+        }
+        for (String packageName : packages) {
+            if (mProviderInfo.packageName.equals(packageName)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private void handleBinderDied() {
+        Log.w(TAG, "Provider binder died " + mProviderInfo.providerId);
+        clearBinder();
+        mContext.getMainExecutor().execute(
+                () -> mListener.onProviderFailed(mProviderInfo.providerId, "binder died"));
+    }
+
+    private void clearBinder() {
+        unlinkToDeath();
+        mService = null;
+    }
+
+    private void unlinkToDeath() {
+        if (mBinder == null) {
+            return;
+        }
+        try {
+            mBinder.unlinkToDeath(mDeathRecipient, 0);
+        } catch (NoSuchElementException e) {
+            Log.d(TAG, "Provider death recipient already unlinked " + mProviderInfo.providerId);
+        }
+        mBinder = null;
+    }
+
+    boolean supportsApp(Bundle appIdentity) {
+        return supportsAppResult(appIdentity) == PushBrokerConstants.RESULT_OK;
+    }
+
+    private final class CompatibilityProviderHostStub
+            extends ICompatibilityProviderHost.Stub {
+        @Override
+        public Bundle getCompatibilityAppPolicy(String providerId, String packageName, int userId) {
+            if (!isCallerAuthorizedProvider()
+                    || !mProviderInfo.providerId.equals(providerId)
+                    || packageName == null || packageName.isBlank()) {
+                return Bundle.EMPTY;
+            }
+            final long token = Binder.clearCallingIdentity();
+            try {
+                return mCompatibilityPolicySource.getCompatibilityAppPolicy(providerId,
+                        packageName, userId);
+            } finally {
+                Binder.restoreCallingIdentity(token);
+            }
+        }
+
+        @Override
+        public java.util.List<Bundle> getCompatibilityAuthorizedApps(String providerId, int userId) {
+            if (!isCallerAuthorizedProvider() || !mProviderInfo.providerId.equals(providerId)) {
+                return java.util.Collections.emptyList();
+            }
+            final long token = Binder.clearCallingIdentity();
+            try {
+                return mCompatibilityPolicySource.getCompatibilityAuthorizedApps(providerId,
+                        userId);
+            } finally {
+                Binder.restoreCallingIdentity(token);
+            }
+        }
+
+        @Override
+        public void registerPolicyCallback(String providerId, ICompatibilityPolicyCallback callback) {
+            if (!isCallerAuthorizedProvider() || !mProviderInfo.providerId.equals(providerId)
+                    || callback == null) {
+                return;
+            }
+            final long token = Binder.clearCallingIdentity();
+            try {
+                mCompatibilityPolicySource.registerPolicyCallback(providerId, callback);
+            } finally {
+                Binder.restoreCallingIdentity(token);
+            }
+        }
+
+        @Override
+        public void unregisterPolicyCallback(ICompatibilityPolicyCallback callback) {
+            if (!isCallerAuthorizedProvider() || callback == null) {
+                return;
+            }
+            final long token = Binder.clearCallingIdentity();
+            try {
+                mCompatibilityPolicySource.unregisterPolicyCallback(callback);
+            } finally {
+                Binder.restoreCallingIdentity(token);
+            }
+        }
+    }
+
+    int supportsAppResult(Bundle appIdentity) {
+        if (mService == null) {
+            return PushBrokerConstants.RESULT_NOT_READY;
+        }
+        if (mProviderInfo.apiVersion < PushBrokerConstants.API_VERSION_2) {
+            return PushBrokerConstants.RESULT_UNSUPPORTED;
+        }
+        try {
+            return mService.supportsApp(appIdentity);
+        } catch (RemoteException e) {
+            Log.w(TAG, "Failed to query app support for provider " + mProviderInfo.providerId, e);
+        }
+        return PushBrokerConstants.RESULT_INTERNAL_ERROR;
+    }
+
+    boolean canSyncApp(Bundle appIdentity, Bundle extras) {
+        return canSyncAppResult(appIdentity, extras) == PushBrokerConstants.RESULT_OK;
+    }
+
+    int canSyncAppResult(Bundle appIdentity, Bundle extras) {
+        if (mService == null) {
+            return PushBrokerConstants.RESULT_NOT_READY;
+        }
+        if (mProviderInfo.apiVersion < PushBrokerConstants.API_VERSION_4) {
+            return PushBrokerConstants.RESULT_UNSUPPORTED;
+        }
+        try {
+            return mService.canSyncApp(appIdentity, extras);
+        } catch (RemoteException e) {
+            Log.w(TAG, "Failed to query app sync capability for provider "
+                    + mProviderInfo.providerId, e);
+        }
+        return PushBrokerConstants.RESULT_INTERNAL_ERROR;
+    }
+
+    boolean prepareApp(Bundle appIdentity) {
+        return prepareAppResult(appIdentity) == PushBrokerConstants.RESULT_OK;
+    }
+
+    int prepareAppResult(Bundle appIdentity) {
+        if (mService == null) {
+            return PushBrokerConstants.RESULT_NOT_READY;
+        }
+        try {
+            return mService.prepareApp(appIdentity);
+        } catch (RemoteException e) {
+            Log.w(TAG, "Failed to prepare app for provider " + mProviderInfo.providerId, e);
+        }
+        return PushBrokerConstants.RESULT_INTERNAL_ERROR;
+    }
+
+    boolean revokeApp(Bundle appIdentity) {
+        return revokeAppResult(appIdentity) == PushBrokerConstants.RESULT_OK;
+    }
+
+    int revokeAppResult(Bundle appIdentity) {
+        if (mService == null) {
+            return PushBrokerConstants.RESULT_NOT_READY;
+        }
+        try {
+            return mService.revokeApp(appIdentity);
+        } catch (RemoteException e) {
+            Log.w(TAG, "Failed to revoke app for provider " + mProviderInfo.providerId, e);
+        }
+        return PushBrokerConstants.RESULT_INTERNAL_ERROR;
+    }
+
+    boolean requestToken(Bundle appIdentity, Bundle extras) {
+        return requestTokenResult(appIdentity, extras) == PushBrokerConstants.RESULT_OK;
+    }
+
+    int requestTokenResult(Bundle appIdentity, Bundle extras) {
+        if (mService == null) {
+            return PushBrokerConstants.RESULT_NOT_READY;
+        }
+        try {
+            return mService.requestToken(appIdentity, extras);
+        } catch (RemoteException e) {
+            Log.w(TAG, "Failed to request token from provider " + mProviderInfo.providerId, e);
+        }
+        return PushBrokerConstants.RESULT_INTERNAL_ERROR;
+    }
+
+    boolean syncApp(Bundle appIdentity, Bundle extras) {
+        return syncAppResult(appIdentity, extras) == PushBrokerConstants.RESULT_OK;
+    }
+
+    int syncAppResult(Bundle appIdentity, Bundle extras) {
+        if (mService == null) {
+            return PushBrokerConstants.RESULT_NOT_READY;
+        }
+        if (mProviderInfo.apiVersion < PushBrokerConstants.API_VERSION_4) {
+            return PushBrokerConstants.RESULT_UNSUPPORTED;
+        }
+        try {
+            return mService.syncApp(appIdentity, extras);
+        } catch (RemoteException e) {
+            Log.w(TAG, "Failed to sync app state via provider " + mProviderInfo.providerId, e);
+        }
+        return PushBrokerConstants.RESULT_INTERNAL_ERROR;
+    }
+
+    private final class PushBrokerHostStub extends IPushBrokerHost.Stub {
+        @Override
+        public int postNotification(Bundle notification) {
+            return PushBrokerConstants.RESULT_OK;
+        }
+
+        @Override
+        public int cancelNotification(String packageName, String tag, int id) {
+            return PushBrokerConstants.RESULT_OK;
+        }
+
+        @Override
+        public int reportEvent(Bundle event) {
+            if (event == null) {
+                return PushBrokerConstants.RESULT_OK;
+            }
+            final long token = Binder.clearCallingIdentity();
+            try {
+                mListener.onProviderEvent(mProviderInfo.providerId, new Bundle(event));
+            } finally {
+                Binder.restoreCallingIdentity(token);
+            }
+            return PushBrokerConstants.RESULT_OK;
+        }
+
+        @Override
+        public int requestUserAction(Bundle action) {
+            return PushBrokerConstants.RESULT_OK;
+        }
+    }
+}
