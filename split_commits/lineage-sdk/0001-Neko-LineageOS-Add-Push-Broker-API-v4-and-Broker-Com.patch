new file mode 100644
index 0000000..d609183
--- /dev/null
+++ b/sdk/src/java/lineageos/push/BrokerStatus.java
@@ -0,0 +1,58 @@
+/*
+ * SPDX-FileCopyrightText: Neko-LineageOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package lineageos.push;
+
+import android.os.Parcel;
+import android.os.Parcelable;
+
+/** @hide */
+public final class BrokerStatus implements Parcelable {
+    public final String activeProviderId;
+    public final boolean brokerReady;
+    public final int providerCount;
+    public final String lastErrorMessage;
+
+    public BrokerStatus(String activeProviderId, boolean brokerReady, int providerCount,
+            String lastErrorMessage) {
+        this.activeProviderId = activeProviderId;
+        this.brokerReady = brokerReady;
+        this.providerCount = providerCount;
+        this.lastErrorMessage = lastErrorMessage;
+    }
+
+    private BrokerStatus(Parcel in) {
+        activeProviderId = in.readString();
+        brokerReady = in.readBoolean();
+        providerCount = in.readInt();
+        lastErrorMessage = in.readString();
+    }
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public void writeToParcel(Parcel dest, int flags) {
+        dest.writeString(activeProviderId);
+        dest.writeBoolean(brokerReady);
+        dest.writeInt(providerCount);
+        dest.writeString(lastErrorMessage);
+    }
+
+    public static final Parcelable.Creator<BrokerStatus> CREATOR =
+            new Parcelable.Creator<BrokerStatus>() {
+                @Override
+                public BrokerStatus createFromParcel(Parcel source) {
+                    return new BrokerStatus(source);
+                }
+
+                @Override
+                public BrokerStatus[] newArray(int size) {
+                    return new BrokerStatus[size];
+                }
+            };
+}
