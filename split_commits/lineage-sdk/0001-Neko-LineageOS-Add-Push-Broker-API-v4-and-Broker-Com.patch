+    private final BroadcastReceiver mPackageReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            if (intent == null || intent.getData() == null) {
+                return;
+            }
+
+            if (Intent.ACTION_PACKAGE_ADDED.equals(intent.getAction())
+                    || Intent.ACTION_PACKAGE_CHANGED.equals(intent.getAction())
+                    || Intent.ACTION_PACKAGE_REPLACED.equals(intent.getAction())
+                    || Intent.ACTION_PACKAGE_REMOVED.equals(intent.getAction())
+                    || Intent.ACTION_PACKAGE_DATA_CLEARED.equals(intent.getAction())) {
+                final String previousActiveProviderId = mRegistry.getActiveProviderId();
+                final PushProviderInfo previousActiveProvider =
+                        previousActiveProviderId == null
+                                ? null
+                                : mRegistry.getProviderInfo(previousActiveProviderId);
+                mRegistry.refresh();
+                final String packageName = intent.getData().getSchemeSpecificPart();
+                final Bundle appIdentity = buildAppIdentityFromIntent(intent, packageName);
+                final boolean replacing = intent.getBooleanExtra(Intent.EXTRA_REPLACING, false);
+                final String refreshedActiveProviderId = mRegistry.getActiveProviderId();
+                if (previousActiveProviderId != null
+                        && !previousActiveProviderId.equals(refreshedActiveProviderId)) {
+                    disconnectActiveProvider();
+                }
+                final boolean activeProviderPackageReplaced =
+                        Intent.ACTION_PACKAGE_REPLACED.equals(intent.getAction())
+                                && packageName != null
+                                && previousActiveProvider != null
+                                && packageName.equals(previousActiveProvider.packageName)
+                                && previousActiveProviderId.equals(refreshedActiveProviderId);
+                if (activeProviderPackageReplaced) {
+                    Log.i(TAG, "Active provider package replaced, rebinding provider "
+                            + refreshedActiveProviderId + " package=" + packageName);
+                    disconnectActiveProvider();
+                    bindActiveProviderWhenUserUnlocked(refreshedActiveProviderId,
+                            "active provider package replaced");
+                }
+                maybeQueuePackageLifecycleSync(intent, appIdentity, refreshedActiveProviderId);
+                if (Intent.ACTION_PACKAGE_REMOVED.equals(intent.getAction()) && !replacing) {
+                    forgetKnownPackage(packageName);
+                } else {
+                    clearPackageResultState(packageName);
+                    if (Intent.ACTION_PACKAGE_DATA_CLEARED.equals(intent.getAction())) {
+                        clearCompatibilityTokenState(packageName, UserHandle.USER_SYSTEM);
+                    }
+                }
+                if (!Intent.ACTION_PACKAGE_REMOVED.equals(intent.getAction())
+                        && !Intent.ACTION_PACKAGE_DATA_CLEARED.equals(intent.getAction())
+                        && refreshedActiveProviderId != null) {
+                    if (appIdentity != null && shouldPrepareApp(appIdentity)) {
+                        rememberKnownPackage(packageName);
+                        enqueuePrepareApp(appIdentity, "package " + intent.getAction());
+                    }
+                }
+                notifyRegistryChanged();
+            }
+        }
+    };
+
+    private final BroadcastReceiver mPolicyReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            if (intent == null) {
+                return;
+            }
+
+            final String action = intent.getAction();
+            final boolean immediateRecovery;
+            if (Intent.ACTION_SCREEN_ON.equals(action)) {
+                mInteractive = true;
+                immediateRecovery = true;
+            } else if (Intent.ACTION_USER_PRESENT.equals(action)) {
+                mInteractive = true;
+                immediateRecovery = true;
+            } else if (Intent.ACTION_SCREEN_OFF.equals(action)) {
+                mInteractive = false;
+                immediateRecovery = false;
+            } else if (NotificationManager.ACTION_INTERRUPTION_FILTER_CHANGED.equals(action)) {
+                immediateRecovery = false;
+            } else {
+                return;
+            }
+
+            mDndEnabled = isDndEnabled();
+            updatePolicyState(action, immediateRecovery);
+        }
+    };
+
+    private boolean bindActiveProvider(String providerId) {
+        return bindActiveProviderInternal(providerId, true);
+    }
+
+    private boolean bindActiveProviderInternal(String providerId, boolean cancelPendingRebind) {
+        Log.i(TAG, "Binding provider " + providerId);
+        if (cancelPendingRebind) {
+            cancelActiveProviderRebind();
+        }
+        final PushProviderInfo providerInfo = mRegistry.getProviderInfo(providerId);
+        if (providerInfo == null) {
+            Log.w(TAG, "Provider info missing for " + providerId);
+            return false;
+        }
+
+        if (providerId.equals(mBoundProviderId) && mActiveConnection != null) {
+            return true;
+        }
+
+        disconnectActiveProvider(cancelPendingRebind);
+
+        final ComponentName componentName =
+                ComponentName.unflattenFromString(providerInfo.serviceName);
+        if (componentName == null) {
+            mRegistry.markProviderFailed(providerId, "invalid service component");
+            return false;
+        }
+
+        final Intent intent = new Intent();
+        intent.setComponent(componentName);
+
+        final PushProviderConnection connection = new PushProviderConnection(
+                mContext, providerInfo, mConnectionListener, mCompatibilityPolicySource);
+        final boolean bound = mContext.bindServiceAsUser(intent, connection,
+                Context.BIND_AUTO_CREATE, UserHandle.SYSTEM);
+        if (!bound) {
+            mRegistry.markProviderFailed(providerId, "bindServiceAsUser failed");
+            Log.w(TAG, "bindServiceAsUser failed for " + providerId);
+            return false;
+        }
+
+        mActiveConnection = connection;
+        mBoundProviderId = providerId;
+        mRegistry.setActiveProvider(providerId);
+        Log.i(TAG, "Bind requested for provider " + providerId);
+        return true;
+    }
+
+    private void scheduleActiveProviderRebind(String providerId, String reason) {
+        if (providerId == null || !providerId.equals(mRegistry.getActiveProviderId())) {
+            return;
+        }
+        mPendingRebindProviderId = providerId;
+        mPendingRebindReason = reason;
+        final long delayMillis = Math.min(PROVIDER_REBIND_INITIAL_DELAY_MILLIS
+                * (1L << Math.min(mProviderRebindAttempts, 5)), PROVIDER_REBIND_MAX_DELAY_MILLIS);
+        Log.i(TAG, "Scheduling provider rebind provider=" + providerId
+                + " reason=" + reason
+                + " attempts=" + mProviderRebindAttempts
+                + " delayMillis=" + delayMillis);
+        mHandler.removeCallbacks(mProviderRebind);
+        mHandler.postDelayed(mProviderRebind, delayMillis);
+    }
+
+    private void cancelActiveProviderRebind() {
+        mHandler.removeCallbacks(mProviderRebind);
+        mPendingRebindProviderId = null;
+        mPendingRebindReason = null;
+        mProviderRebindAttempts = 0;
+    }
+
+    private final Runnable mProviderRebind = new Runnable() {
+        @Override
+        public void run() {
+            final String providerId = mPendingRebindProviderId;
+            final String reason = mPendingRebindReason;
+            if (providerId == null || !providerId.equals(mRegistry.getActiveProviderId())) {
+                cancelActiveProviderRebind();
+                return;
+            }
+            if (!isSystemUserUnlocked()) {
+                scheduleActiveProviderRebind(providerId, "system user locked");
+                return;
+            }
+            if (providerId.equals(mBoundProviderId) && mActiveConnection != null) {
+                cancelActiveProviderRebind();
+                return;
+            }
+            mProviderRebindAttempts++;
+            Log.i(TAG, "Rebinding active provider provider=" + providerId
+                    + " reason=" + reason
+                    + " attempt=" + mProviderRebindAttempts);
+            if (!bindActiveProviderInternal(providerId, false)) {
+                scheduleActiveProviderRebind(providerId, reason);
+            }
+        }
+    };
+
+    private boolean bindActiveProviderWhenUserUnlocked(String providerId, String reason) {
+        if (providerId == null) {
+            return false;
+        }
+        if (!isSystemUserUnlocked()) {
+            mPendingBindProviderId = providerId;
+            Log.i(TAG, "Deferring provider bind until system user unlock provider="
+                    + providerId + " reason=" + reason);
+            return false;
+        }
+        mPendingBindProviderId = null;
+        return bindActiveProvider(providerId);
+    }
+
+    private void disconnectActiveProvider() {
+        disconnectActiveProvider(true);
+    }
+
+    private void disconnectActiveProvider(boolean cancelPendingRebind) {
+        if (cancelPendingRebind) {
+            cancelActiveProviderRebind();
+        }
+        clearPrepareQueue();
+        clearAppSyncQueue();
+        stopRecoveryMonitoring();
+        mColdStartDiscoveryRunning = false;
+        mRecoveryAttemptCount = 0;
+        mHasCompletedInitialAppSyncRound = false;
+        mLastRecoverAppSyncRoundAt = 0L;
+        mAppSyncContractErrorCount = 0;
+        mUnsupportedAppPackages.clear();
+        mUnsupportedAppSyncPackages.clear();
+        mAppSyncSuppressedUntil.clear();
+        mAppSyncSuppressionResultCodes.clear();
+        mNotificationConvergenceStore.clear();
+        if (mActiveConnection == null) {
+            mBoundProviderId = null;
+            return;
+        }
+
+        try {
+            mActiveConnection.disable();
+            mActiveConnection.close();
+            mContext.unbindService(mActiveConnection);
+        } catch (IllegalArgumentException e) {
+            Log.w(TAG, "Provider connection already unbound", e);
+        }
+
+        if (mBoundProviderId != null) {
+            mRegistry.markProviderDisconnected(mBoundProviderId);
+            clearCompatibilitySignatureSpoofDataForProvider(mBoundProviderId);
+        }
+        mStore.clearCompatibilitySignatureSpoofPolicy();
+        mActiveConnection = null;
+        mBoundProviderId = null;
+    }
+
+    private boolean isSystemUserUnlocked() {
+        return mUserManager != null && mUserManager.isUserUnlocked(UserHandle.SYSTEM);
+    }
+
+    private boolean isDeviceInteractive() {
+        return mPowerManager != null && mPowerManager.isInteractive();
+    }
+
+    private boolean isDndEnabled() {
+        if (mNotificationManager == null) {
+            return false;
+        }
+        final int interruptionFilter = mNotificationManager.getCurrentInterruptionFilter();
+        return interruptionFilter == NotificationManager.INTERRUPTION_FILTER_PRIORITY
+                || interruptionFilter == NotificationManager.INTERRUPTION_FILTER_NONE
+                || interruptionFilter == NotificationManager.INTERRUPTION_FILTER_ALARMS;
+    }
+
+    private int computePolicyState() {
+        if (mInteractive) {
+            return POLICY_ACTIVE;
+        }
+        if (mDndEnabled && !ALLOW_DND_OVERRIDE) {
+            return POLICY_DORMANT;
+        }
+        return POLICY_STANDBY;
+    }
+
+    private String policyStateToString(int state) {
+        switch (state) {
+            case POLICY_ACTIVE:
+                return "ACTIVE";
+            case POLICY_DORMANT:
+                return "DORMANT";
+            case POLICY_STANDBY:
+            default:
+                return "STANDBY";
+        }
+    }
+
+    private long getWatchdogIntervalForState(int state) {
+        switch (state) {
+            case POLICY_ACTIVE:
+                return ACTIVE_WATCHDOG_INTERVAL_MILLIS;
+            case POLICY_DORMANT:
+                return DORMANT_WATCHDOG_INTERVAL_MILLIS;
+            case POLICY_STANDBY:
+            default:
+                return STANDBY_WATCHDOG_INTERVAL_MILLIS;
+        }
+    }
+
+    private void updatePolicyState(String reason, boolean triggerImmediateRecovery) {
+        final int previousState = mPolicyState;
+        mDndEnabled = isDndEnabled();
+        mPolicyState = computePolicyState();
+        mWatchdogIntervalMillis = getWatchdogIntervalForState(mPolicyState);
+
+        if (previousState != mPolicyState) {
+            Log.i(TAG, "Policy state changed " + policyStateToString(previousState)
+                    + " -> " + policyStateToString(mPolicyState) + " reason=" + reason);
+        }
+
+        if (mBoundProviderId == null || mActiveConnection == null || !mActiveConnection.isConnected()) {
+            return;
+        }
+
+        if (mPolicyState == POLICY_ACTIVE) {
+            scheduleWatchdogLocked(mWatchdogIntervalMillis);
+            requestImmediateHealthCheck(reason, triggerImmediateRecovery);
+            if (triggerImmediateRecovery) {
+                Log.i(TAG, "ACTIVE entry scheduling delayed recovery recheck provider="
+                        + mBoundProviderId + " delayMillis="
+                        + ACTIVE_RECOVERY_RECHECK_DELAY_MILLIS + " reason=" + reason);
+                scheduleRecoveryHealthCheck(ACTIVE_RECOVERY_RECHECK_DELAY_MILLIS, reason);
+            }
+            return;
+        }
+
+        cancelShortRecoveryChecks();
+        scheduleWatchdogLocked(mWatchdogIntervalMillis);
+        if (mPolicyState == POLICY_STANDBY
+                && previousState == POLICY_DORMANT
+                && mConnectivityManager != null
+                && mConnectivityManager.getActiveNetwork() != null) {
+            requestImmediateHealthCheck(reason, true);
+        }
+    }
+
+    private void requestImmediateHealthCheck(String reason, boolean recoverIfDisconnected) {
+        mHandler.post(() -> runImmediateHealthCheck(reason, recoverIfDisconnected));
+    }
+
+    private void runImmediateHealthCheck(String reason, boolean recoverIfDisconnected) {
+        if (mBoundProviderId == null || mActiveConnection == null || !mActiveConnection.isConnected()) {
+            return;
+        }
+
+        final Bundle health = mActiveConnection.getHealth();
+        mLastHealthCheckAt = System.currentTimeMillis();
+        final String connectionStatus = health.getString(PushBrokerConstants.HEALTH_CONNECTION_STATUS, "");
+        final boolean activeEntry = Intent.ACTION_SCREEN_ON.equals(reason)
+                || Intent.ACTION_USER_PRESENT.equals(reason);
+        if (activeEntry) {
+            Log.i(TAG, "ACTIVE entry immediate health status=" + connectionStatus
+                    + " provider=" + mBoundProviderId + " reason=" + reason);
+        } else {
+            Log.i(TAG, "Immediate health check provider=" + mBoundProviderId
+                    + " status=" + connectionStatus + " reason=" + reason
+                    + " recoverIfDisconnected=" + recoverIfDisconnected);
+        }
+        evaluateProviderHealth(reason, health, HEALTH_TRIGGER_IMMEDIATE,
+                recoverIfDisconnected, true);
+    }
+
+    private boolean forwardPrepareApp(Bundle appIdentity) {
+        if (mActiveConnection == null || mBoundProviderId == null) {
+            Log.w(TAG, "Ignoring prepareApp without active provider");
+            return false;
+        }
+        final String packageName = appIdentity == null ? null
+                : appIdentity.getString(lineageos.push.PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        Log.i(TAG, "Preparing app " + packageName + " via provider " + mBoundProviderId);
+        final int result = mActiveConnection.prepareAppResult(appIdentity);
+        final boolean prepared = result == PushBrokerConstants.RESULT_OK;
+        rememberCompatibilityResult(mLastCompatibilityPrepareResults, appIdentity, result);
+        rememberCompatibilityTrace(appIdentity, "prepare", null, null, result);
+        Log.i(TAG, "prepareApp result package=" + packageName + " provider=" + mBoundProviderId
+                + " resultCode=" + result);
+        if (prepared) {
+            rememberKnownPackage(packageName);
+            rememberSyncCandidate(packageName);
+            maybeRequestCompatibilityToken(appIdentity,
+                    PushBrokerConstants.COMPAT_TOKEN_REASON_INITIAL_BOOTSTRAP, false);
+        }
+        return prepared;
+    }
+
+    private Bundle buildAppIdentityFromIntent(Intent intent, String packageName) {
+        if (packageName == null || packageName.isBlank()) {
+            return null;
+        }
+
+        final int uid = intent.getIntExtra(Intent.EXTRA_UID, -1);
+        final int userId = uid >= 0 ? UserHandle.getUserId(uid) : UserHandle.USER_SYSTEM;
+        return buildAppIdentity(packageName, uid, userId);
+    }
+
+    private Bundle buildAppIdentity(String packageName, int uid, int userId) {
+        if (packageName == null || packageName.isBlank()) {
+            return null;
+        }
+
+        int resolvedUid = uid;
+        if (resolvedUid < 0) {
+            try {
+                resolvedUid = mPackageManager.getPackageUidAsUser(packageName, userId);
+            } catch (PackageManager.NameNotFoundException e) {
+                Log.w(TAG, "Unable to resolve uid for package " + packageName
+                        + " user=" + userId, e);
+                return null;
+            }
+        }
+
+        final Bundle appIdentity = new Bundle();
+        appIdentity.putString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME, packageName);
+        appIdentity.putInt(PushBrokerConstants.APP_IDENTITY_UID, resolvedUid);
+        appIdentity.putInt(PushBrokerConstants.APP_IDENTITY_USER_ID, userId);
+        return appIdentity;
+    }
+
+    private void enqueuePrepareApp(Bundle appIdentity, String reason) {
+        final String packageName = appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        if (shouldSkipAutomaticPrepare(packageName)) {
+            return;
+        }
+        final int userId = appIdentity.getInt(PushBrokerConstants.APP_IDENTITY_USER_ID,
+                UserHandle.USER_SYSTEM);
+        final String dedupeKey = packageName + "#" + userId;
+        if (!mPendingPrepareKeys.add(dedupeKey)) {
+            return;
+        }
+
+        mPendingPrepareApps.addLast(new Bundle(appIdentity));
+        Log.i(TAG, "Queued prepareApp for " + packageName + " user=" + userId
+                + " reason=" + reason);
+        schedulePrepareQueueDrain();
+    }
+
+    private void clearPrepareQueue() {
+        mHandler.removeCallbacks(mDrainPrepareQueue);
+        mPendingPrepareApps.clear();
+        mPendingPrepareKeys.clear();
+    }
+
+    private void schedulePrepareQueueDrain() {
+        mHandler.removeCallbacks(mDrainPrepareQueue);
+        mHandler.postDelayed(mDrainPrepareQueue, PREPARE_QUEUE_INTERVAL_MILLIS);
+    }
+
+    private void clearAppSyncQueue() {
+        mHandler.removeCallbacks(mDrainAppSyncQueue);
+        mPendingSyncApps.clear();
+        mPendingSyncKeys.clear();
+    }
+
+    private long getAppSyncDispatchIntervalMillis() {
+        return mPolicyState == POLICY_ACTIVE
+                ? ACTIVE_APP_SYNC_DISPATCH_INTERVAL_MILLIS
+                : STANDBY_APP_SYNC_DISPATCH_INTERVAL_MILLIS;
+    }
+
+    private void scheduleAppSyncQueueDrain() {
+        if (mPolicyState == POLICY_DORMANT) {
+            return;
+        }
+        mHandler.removeCallbacks(mDrainAppSyncQueue);
+        mHandler.postDelayed(mDrainAppSyncQueue, getAppSyncDispatchIntervalMillis());
+    }
+
+    private final Runnable mDrainPrepareQueue = new Runnable() {
+        @Override
+        public void run() {
+            if (mPendingPrepareApps.isEmpty()) {
+                mPendingPrepareKeys.clear();
+                return;
+            }
+
+            if (mBoundProviderId == null || mActiveConnection == null
+                    || !mActiveConnection.isConnected()) {
+                schedulePrepareQueueDrain();
+                return;
+            }
+
+            final Bundle appIdentity = mPendingPrepareApps.pollFirst();
+            if (appIdentity == null) {
+                return;
+            }
+
+            final String packageName =
+                    appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+            final int userId = appIdentity.getInt(PushBrokerConstants.APP_IDENTITY_USER_ID,
+                    UserHandle.USER_SYSTEM);
+            mPendingPrepareKeys.remove(packageName + "#" + userId);
+
+            final boolean prepared = forwardPrepareApp(appIdentity);
+            Log.i(TAG, "Automatic prepareApp for " + packageName + " user=" + userId
+                    + " result=" + prepared);
+
+            if (!mPendingPrepareApps.isEmpty()) {
+                schedulePrepareQueueDrain();
+            }
+        }
+    };
+
+    private void enqueueKnownAppsForActiveProvider(String providerId) {
+        final PushProviderInfo providerInfo = mRegistry.getProviderInfo(providerId);
+        if (providerInfo == null) {
+            return;
+        }
+
+        int queuedCount = 0;
+        for (int i = 0; i < mKnownPackages.size(); i++) {
+            final String packageName = mKnownPackages.valueAt(i);
+            if (providerInfo.packageName.equals(packageName)) {
+                continue;
+            }
+            final Bundle appIdentity = buildAppIdentity(packageName, -1, UserHandle.USER_SYSTEM);
+            if (appIdentity == null) {
+                continue;
+            }
+            if (!shouldPrepareApp(appIdentity)) {
+                continue;
+            }
+            enqueuePrepareApp(appIdentity, "provider connected");
+            queuedCount++;
+        }
+        Log.i(TAG, "Queued known-package prepare scan for provider " + providerId
+                + " packages=" + queuedCount);
+    }
+
+    private void enqueueCandidateAppsForSyncRound(String reason) {
+        int queuedCount = 0;
+        pruneExpiredAppSyncSuppressions();
+        for (int i = 0; i < mSyncCandidatePackages.size(); i++) {
+            final String packageName = mSyncCandidatePackages.valueAt(i);
+            final Bundle appIdentity = buildAppIdentity(packageName, -1, UserHandle.USER_SYSTEM);
+            if (appIdentity == null) {
+                continue;
+            }
+            if (!shouldPrepareApp(appIdentity)) {
+                continue;
+            }
+            if (enqueueAppSync(appIdentity,
+                    PushBrokerConstants.COMPAT_SYNC_EVENT_PACKAGE_CHANGED,
+                    reason, false, false)) {
+                queuedCount++;
+            }
+        }
+        Log.i(TAG, "Queued candidate app sync round reason=" + reason + " packages="
+                + queuedCount + " candidates=" + mSyncCandidatePackages.size());
+    }
+
+    private boolean shouldSkipAutomaticPrepare(String packageName) {
+        if (packageName == null || packageName.isBlank()) {
+            return true;
+        }
+        final PushProviderInfo activeProvider = mBoundProviderId == null
+                ? null
+                : mRegistry.getProviderInfo(mBoundProviderId);
+        return activeProvider != null && packageName.equals(activeProvider.packageName);
+    }
+
+    private boolean shouldPrepareApp(Bundle appIdentity) {
+        if (mActiveConnection == null || mBoundProviderId == null || appIdentity == null) {
+            return false;
+        }
+        final String packageName = appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        if (shouldSkipAutomaticPrepare(packageName)) {
+            return false;
+        }
+        final int userId = appIdentity.getInt(PushBrokerConstants.APP_IDENTITY_USER_ID,
+                UserHandle.USER_SYSTEM);
+        if (isCompatibilityModeActive()
+                && !hasAuthorizedCompatibilityProfiles(mBoundProviderId, packageName, userId)) {
+            Log.i(TAG, "Skipping supportsApp because package is not compatibility-authorized package="
+                    + packageName + " provider=" + mBoundProviderId);
+            return false;
+        }
+        final String key = packageName + "#" + userId;
+        if (mUnsupportedAppPackages.contains(key)) {
+            Log.i(TAG, "Skipping supportsApp because package is cached unsupported package="
+                    + packageName + " provider=" + mBoundProviderId);
+            return false;
+        }
+        final int result = mActiveConnection.supportsAppResult(appIdentity);
+        final boolean supported = result == PushBrokerConstants.RESULT_OK;
+        Log.i(TAG, "supportsApp package=" + packageName + " provider=" + mBoundProviderId
+                + " result=" + supported + " resultCode=" + result);
+        if (result == PushBrokerConstants.RESULT_UNSUPPORTED) {
+            mUnsupportedAppPackages.add(key);
+            Log.i(TAG, "Cached unsupported app package=" + packageName
+                    + " provider=" + mBoundProviderId);
+        } else if (result == PushBrokerConstants.RESULT_BAD_REQUEST) {
+            recordAppSyncContractError(appIdentity, "supportsApp", result);
+        }
+        return supported;
+    }
+
+    private void rememberKnownPackage(String packageName) {
+        if (packageName == null || packageName.isBlank()) {
+            return;
+        }
+        if (mKnownPackages.add(packageName)) {
+            mStore.setKnownPackages(mKnownPackages);
+        }
+    }
+
+    private void rememberSyncCandidate(String packageName) {
+        if (packageName == null || packageName.isBlank()) {
+            return;
+        }
+        mSyncCandidatePackages.add(packageName);
+    }
+
+    private void forgetKnownPackage(String packageName) {
+        if (packageName == null || packageName.isBlank()) {
+            return;
+        }
+        if (mKnownPackages.remove(packageName)) {
+            mStore.setKnownPackages(mKnownPackages);
+        }
+        mSyncCandidatePackages.remove(packageName);
+        mLastAppSyncRequestAt.remove(packageName + "#" + UserHandle.USER_SYSTEM);
+        clearPackageResultState(packageName);
+        clearCompatibilityTokenState(packageName, UserHandle.USER_SYSTEM);
+    }
+
+    private void clearPackageResultState(String packageName) {
+        if (packageName == null || packageName.isBlank()) {
+            return;
+        }
+        final String key = packageName + "#" + UserHandle.USER_SYSTEM;
+        mUnsupportedAppPackages.remove(key);
+        mUnsupportedAppSyncPackages.remove(key);
+        mAppSyncSuppressedUntil.remove(key);
+        mAppSyncSuppressionResultCodes.remove(key);
+    }
+
+    private void restoreKnownPackages() {
+        mKnownPackages.clear();
+        mKnownPackages.addAll(mStore.getKnownPackages());
+    }
+
+    private boolean shouldSyncApp(Bundle appIdentity, String reason) {
+        if (mPolicyState == POLICY_DORMANT || mActiveConnection == null || mBoundProviderId == null
+                || appIdentity == null) {
+            return false;
+        }
+
+        final String packageName = appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        if (shouldSkipAutomaticPrepare(packageName)) {
+            return false;
+        }
+
+        final int userId = appIdentity.getInt(PushBrokerConstants.APP_IDENTITY_USER_ID,
+                UserHandle.USER_SYSTEM);
+        if (isCompatibilityModeActive()
+                && !hasAuthorizedCompatibilityProfiles(mBoundProviderId, packageName, userId)) {
+            Log.i(TAG, "Skipping app sync because package is not compatibility-authorized package="
+                    + packageName + " user=" + userId + " reason=" + reason);
+            return false;
+        }
+        final String dedupeKey = packageName + "#" + userId;
+        if (mUnsupportedAppPackages.contains(dedupeKey)) {
+            Log.i(TAG, "Skipping app sync because package is cached unsupported package="
+                    + packageName + " user=" + userId + " reason=" + reason);
+            return false;
+        }
+        if (mUnsupportedAppSyncPackages.contains(dedupeKey)) {
+            Log.i(TAG, "Skipping app sync because app sync is cached unsupported package="
+                    + packageName + " user=" + userId + " reason=" + reason);
+            return false;
+        }
+        final long now = System.currentTimeMillis();
+        final Long lastRequestedAt = mLastAppSyncRequestAt.get(dedupeKey);
+        if (lastRequestedAt != null && now - lastRequestedAt < APP_SYNC_COOLDOWN_MILLIS) {
+            Log.i(TAG, "Skipping app sync because cooldown is active package=" + packageName
+                    + " user=" + userId + " reason=" + reason);
+            return false;
+        }
+        final Long suppressedUntil = mAppSyncSuppressedUntil.get(dedupeKey);
+        if (suppressedUntil != null) {
+            if (now < suppressedUntil) {
+                Log.i(TAG, "Skipping app sync because result backoff is active package="
+                        + packageName + " user=" + userId + " reason=" + reason
+                        + " remainingMillis=" + (suppressedUntil - now));
+                return false;
+            }
+            mAppSyncSuppressedUntil.remove(dedupeKey);
+        }
+        return true;
+    }
+
+    private void recordAppSyncFailure(Bundle appIdentity, int resultCode, String stage) {
+        if (appIdentity == null || resultCode == PushBrokerConstants.RESULT_OK) {
+            return;
+        }
+
+        if (resultCode == PushBrokerConstants.RESULT_UNSUPPORTED) {
+            cacheUnsupportedAppSync(appIdentity, stage, resultCode);
+            return;
+        }
+
+        if (resultCode == PushBrokerConstants.RESULT_BAD_REQUEST) {
+            cacheUnsupportedAppSync(appIdentity, stage, resultCode);
+            recordAppSyncContractError(appIdentity, stage, resultCode);
+            return;
+        }
+
+        if (resultCode == PushBrokerConstants.RESULT_DISABLED) {
+            handleProviderReturnedDisabled(appIdentity, stage);
+            return;
+        }
+
+        final long backoffMillis = getAppSyncBackoffMillis(resultCode);
+        if (backoffMillis <= 0L) {
+            return;
+        }
+
+        final String packageName = appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        if (packageName == null || packageName.isBlank()) {
+            return;
+        }
+
+        final int userId = appIdentity.getInt(PushBrokerConstants.APP_IDENTITY_USER_ID,
+                UserHandle.USER_SYSTEM);
+        backoffAppSync(packageName, userId, backoffMillis, resultCode);
+        Log.i(TAG, "Backed off app sync package=" + packageName + " user=" + userId
+                + " stage=" + stage + " resultCode=" + resultCode
+                + " backoffMillis=" + backoffMillis);
+    }
+
+    private void backoffAppSync(String packageName, int userId, long backoffMillis, int resultCode) {
+        if (packageName == null || packageName.isBlank() || backoffMillis <= 0L) {
+            return;
+        }
+        final String key = packageName + "#" + userId;
+        mAppSyncSuppressedUntil.put(key, System.currentTimeMillis() + backoffMillis);
+        mAppSyncSuppressionResultCodes.put(key, resultCode);
+    }
+
+    private void cacheUnsupportedAppSync(Bundle appIdentity, String stage, int resultCode) {
+        final String packageName = appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        if (packageName == null || packageName.isBlank()) {
+            return;
+        }
+        final int userId = appIdentity.getInt(PushBrokerConstants.APP_IDENTITY_USER_ID,
+                UserHandle.USER_SYSTEM);
+        mUnsupportedAppSyncPackages.add(packageName + "#" + userId);
+        Log.i(TAG, "Cached unsupported app sync package=" + packageName + " user=" + userId
+                + " stage=" + stage + " resultCode=" + resultCode);
+    }
+
+    private void recordAppSyncContractError(Bundle appIdentity, String stage, int resultCode) {
+        mAppSyncContractErrorCount++;
+        final String packageName = appIdentity == null ? null
+                : appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        Log.w(TAG, "App sync contract error package=" + packageName
+                + " stage=" + stage + " resultCode=" + resultCode
+                + " count=" + mAppSyncContractErrorCount);
+    }
+
+    private void handleProviderReturnedDisabled(Bundle appIdentity, String stage) {
+        clearAppSyncQueue();
+        final String packageName = appIdentity == null ? null
+                : appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        Log.w(TAG, "Provider returned DISABLED while active; cleared app sync queue provider="
+                + mBoundProviderId + " package=" + packageName + " stage=" + stage);
+    }
+
+    private long getAppSyncBackoffMillis(int resultCode) {
+        switch (resultCode) {
+            case PushBrokerConstants.RESULT_NOT_READY:
+                return APP_SYNC_NOT_READY_BACKOFF_MILLIS;
+            case PushBrokerConstants.RESULT_APP_NOT_REGISTERED:
+                return APP_SYNC_APP_NOT_REGISTERED_BACKOFF_MILLIS;
+            case PushBrokerConstants.RESULT_TEMPORARY_FAILURE:
+                return APP_SYNC_TEMPORARY_FAILURE_BACKOFF_MILLIS;
+            case PushBrokerConstants.RESULT_INTERNAL_ERROR:
+                return APP_SYNC_INTERNAL_ERROR_BACKOFF_MILLIS;
+            default:
+                return 0L;
+        }
+    }
+
+    private void pruneExpiredAppSyncSuppressions() {
+        if (mAppSyncSuppressedUntil.isEmpty()) {
+            return;
+        }
+        final long now = System.currentTimeMillis();
+        for (int i = mAppSyncSuppressedUntil.size() - 1; i >= 0; i--) {
+            final Long suppressedUntil = mAppSyncSuppressedUntil.valueAt(i);
+            if (suppressedUntil == null || now >= suppressedUntil) {
+                mAppSyncSuppressionResultCodes.remove(mAppSyncSuppressedUntil.keyAt(i));
+                mAppSyncSuppressedUntil.removeAt(i);
+            }
+        }
+    }
+
+    private void clearAppSyncBackoffsForResult(int resultCode) {
+        for (int i = mAppSyncSuppressedUntil.size() - 1; i >= 0; i--) {
+            final String key = mAppSyncSuppressedUntil.keyAt(i);
+            final Integer suppressedResultCode = mAppSyncSuppressionResultCodes.get(key);
+            if (suppressedResultCode != null && suppressedResultCode.intValue() == resultCode) {
+                mAppSyncSuppressedUntil.removeAt(i);
+                mAppSyncSuppressionResultCodes.remove(key);
+            }
+        }
+    }
+
+    private void clearAppSyncBackoffForResult(String packageName, int userId, int resultCode) {
+        if (packageName == null || packageName.isBlank()) {
+            return;
+        }
+        final String key = packageName + "#" + userId;
+        final Integer suppressedResultCode = mAppSyncSuppressionResultCodes.get(key);
+        if (suppressedResultCode != null && suppressedResultCode.intValue() == resultCode) {
+            mAppSyncSuppressedUntil.remove(key);
+            mAppSyncSuppressionResultCodes.remove(key);
+        }
+    }
+
+    private boolean enqueueAppSync(Bundle appIdentity, String event, String reason,
+            boolean replacing, boolean dataCleared) {
+        if (!shouldSyncApp(appIdentity, reason)) {
+            return false;
+        }
+
+        final String packageName = appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        final int userId = appIdentity.getInt(PushBrokerConstants.APP_IDENTITY_USER_ID,
+                UserHandle.USER_SYSTEM);
+        final String dedupeKey = packageName + "#" + userId;
+        if (!mPendingSyncKeys.add(dedupeKey)) {
+            return false;
+        }
+
+        final Bundle syncRequest = new Bundle(appIdentity);
+        syncRequest.putString(PushBrokerConstants.COMPAT_SYNC_EVENT, event);
+        syncRequest.putBoolean(PushBrokerConstants.COMPAT_SYNC_REPLACING, replacing);
+        syncRequest.putLong(PushBrokerConstants.COMPAT_SYNC_TIMESTAMP, System.currentTimeMillis());
+        syncRequest.putString(PushBrokerConstants.COMPAT_SYNC_REASON, reason);
+        if (dataCleared) {
+            syncRequest.putBoolean(PushBrokerConstants.COMPAT_SYNC_DATA_CLEARED, true);
+        }
+        mPendingSyncApps.addLast(syncRequest);
+        Log.i(TAG, "Queued app sync package=" + packageName + " user=" + userId
+                + " event=" + event + " reason=" + reason);
+        scheduleAppSyncQueueDrain();
+        return true;
+    }
+
+    private void maybeQueuePackageLifecycleSync(Intent intent, Bundle appIdentity, String providerId) {
+        if (intent == null || appIdentity == null || providerId == null || providerId.isBlank()) {
+            return;
+        }
+        if (!providerId.equals(mRegistry.getActiveProviderId())) {
+            return;
+        }
+        if (!isCompatibilityModeActive()) {
+            return;
+        }
+        final String event = deriveCompatSyncEvent(intent);
+        if (event == null) {
+            return;
+        }
+        final String packageName = appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        final int userId = appIdentity.getInt(PushBrokerConstants.APP_IDENTITY_USER_ID,
+                UserHandle.USER_SYSTEM);
+        if (!hasAuthorizedCompatibilityProfiles(providerId, packageName, userId)) {
+            return;
+        }
+        enqueueAppSync(appIdentity, event, "package " + intent.getAction(),
+                intent.getBooleanExtra(Intent.EXTRA_REPLACING, false),
+                Intent.ACTION_PACKAGE_DATA_CLEARED.equals(intent.getAction()));
+    }
