+    @Override
+    public void onBootPhase(int phase) {
+        mCurrentBootPhase = phase;
+
+        if (phase == PHASE_SYSTEM_SERVICES_READY) {
+            mRegistry.refresh(!isSystemUserUnlocked());
+            restoreKnownPackages();
+            registerPackageReceiver();
+            registerPolicyReceivers();
+            registerNetworkCallback();
+            registerNotificationListener();
+            updatePolicyState("system services ready", false);
+            final String activeProviderId = mRegistry.getActiveProviderId();
+            if (activeProviderId != null) {
+                bindActiveProviderWhenUserUnlocked(activeProviderId, "system services ready");
+            }
+            notifyRegistryChanged();
+            return;
+        }
+
+        if (mActiveConnection != null) {
+            mActiveConnection.onBootPhase(phase);
+        }
+    }
