+    private void notifyProviderNetworkAvailable() {
+        if (mBoundProviderId == null || mActiveConnection == null || !mActiveConnection.isConnected()) {
+            return;
+        }
+
+        if (mPolicyState == POLICY_DORMANT) {
+            Log.i(TAG, "Skipping network-available recovery in DORMANT policy state");
+            scheduleWatchdogLocked(mWatchdogIntervalMillis);
+            return;
+        }
+
+        mRecoveryAttemptCount = 0;
+        Log.i(TAG, "Network available observed for provider " + mBoundProviderId
+                + " policy=" + policyStateToString(mPolicyState));
+        if (mPolicyState == POLICY_ACTIVE) {
+            requestImmediateHealthCheck("network available", true);
+        }
+        scheduleRecoveryHealthCheck(NETWORK_RECOVERY_CHECK_DELAY_MILLIS, "network available");
+        scheduleWatchdogLocked(mWatchdogIntervalMillis);
+    }
+
+    private void notifyProviderNetworkLost() {
+        if (mBoundProviderId == null || mActiveConnection == null || !mActiveConnection.isConnected()) {
+            return;
+        }
+
+        final Bundle event = new Bundle();
+        event.putString(PushBrokerConstants.SYSTEM_EVENT_TYPE,
+                PushBrokerConstants.SYSTEM_EVENT_NETWORK_LOST);
+        Log.i(TAG, "Dispatching network lost event to provider " + mBoundProviderId);
+        mProviderRecoverInFlight = false;
+        mActiveConnection.onSystemEvent(event);
+        cancelShortRecoveryChecks();
+        clearAppSyncQueue();
+        scheduleWatchdogLocked(mWatchdogIntervalMillis);
+    }
+
+    private boolean dispatchRecoverConnectionEvent(String reason, boolean eventDriven) {
+        if (mBoundProviderId == null || mActiveConnection == null || !mActiveConnection.isConnected()) {
+            return false;
+        }
+
+        if (mPolicyState == POLICY_DORMANT) {
+            Log.i(TAG, "Skipping recoverConnection dispatch in DORMANT policy state provider="
+                    + mBoundProviderId + " reason=" + reason);
+            return false;
+        }
+
+        final boolean networkAvailable = mConnectivityManager != null
+                && mConnectivityManager.getActiveNetwork() != null;
+        if (!networkAvailable) {
+            Log.i(TAG, "Skipping recoverConnection dispatch because network is unavailable provider="
+                    + mBoundProviderId + " reason=" + reason);
+            return false;
+        }
+
+        if (mProviderRecoverInFlight) {
+            if (!clearTimedOutRecoverInFlight(reason)) {
+                final long inFlightMillis = System.currentTimeMillis() - mLastProviderRecoverStartedAt;
+                Log.i(TAG, "Skipping recoverConnection dispatch because provider recover is already in flight provider="
+                        + mBoundProviderId + " reason=" + reason
+                        + " inFlightMillis=" + inFlightMillis);
+                return false;
+            }
+        }
+
+        final Bundle event = new Bundle();
+        event.putString(PushBrokerConstants.SYSTEM_EVENT_TYPE,
+                PushBrokerConstants.SYSTEM_EVENT_RECOVER_CONNECTION);
+        Log.i(TAG, "Dispatching recover connection event to provider " + mBoundProviderId
+                + " attempt=" + (mRecoveryAttemptCount + 1)
+                + " reason=" + reason
+                + " eventDriven=" + eventDriven);
+        markRecoverDispatchLocked(eventDriven);
+        mActiveConnection.onSystemEvent(event);
+        return true;
+    }
+
+    private void markRecoverDispatchLocked(boolean eventDriven) {
+        final long now = System.currentTimeMillis();
+        mProviderRecoverInFlight = true;
+        mLastProviderRecoverStartedAt = now;
+        if (eventDriven) {
+            mLastEventDrivenRecoveryAt = now;
+        }
+    }
+
+    private void handleProviderEvent(String providerId, Bundle event) {
+        if (providerId == null || event == null || !providerId.equals(mBoundProviderId)) {
+            return;
+        }
+
+        final String eventName = event.getString(PushBrokerConstants.PROVIDER_EVENT_NAME, "");
+        if (PushBrokerConstants.EVENT_PROVIDER_HEALTH_CHANGED.equals(eventName)) {
+            handleProviderHealthChanged(providerId, eventName, event);
+            return;
+        }
+        if (PushBrokerConstants.EVENT_PROVIDER_RECOVER_STARTED.equals(eventName)) {
+            handleProviderRecoverStarted(providerId, event);
+            return;
+        }
+        if (PushBrokerConstants.EVENT_PROVIDER_RECOVER_SUCCEEDED.equals(eventName)) {
+            handleProviderRecoverSucceeded(providerId, event);
+            return;
+        }
+        if (PushBrokerConstants.EVENT_PROVIDER_RECOVER_FAILED.equals(eventName)) {
+            handleProviderRecoverFailed(providerId, event);
+            return;
+        }
+        if (PushBrokerConstants.EVENT_PROVIDER_NOTIFICATION_POSTED.equals(eventName)) {
+            handleProviderNotificationPosted(providerId, event);
+            return;
+        }
+        if (PushBrokerConstants.EVENT_PROVIDER_APP_REGISTERED.equals(eventName)) {
+            handleProviderAppRegistered(providerId, event);
+            return;
+        }
+        if (PushBrokerConstants.EVENT_PROVIDER_COMPATIBILITY_CAPABILITY_STATE_CHANGED.equals(
+                eventName)) {
+            handleProviderCompatibilityCapabilityStateChanged(providerId, event);
+            return;
+        }
+
+        Log.i(TAG, "Provider event provider=" + providerId + " event=" + eventName);
+    }
+
+    private void handleProviderAppRegistered(String providerId, Bundle event) {
+        final String packageName = event.getString(
+                PushBrokerConstants.PROVIDER_EVENT_PACKAGE_NAME);
+        final int userId = event.getInt(PushBrokerConstants.PROVIDER_EVENT_USER_ID,
+                UserHandle.USER_SYSTEM);
+        final Bundle appIdentity = buildAppIdentity(packageName, -1, userId);
+        if (appIdentity == null || shouldSkipAutomaticPrepare(packageName)) {
+            return;
+        }
+
+        rememberKnownPackage(packageName);
+        rememberSyncCandidate(packageName);
+        clearAppSyncBackoffForResult(packageName, userId,
+                PushBrokerConstants.RESULT_APP_NOT_REGISTERED);
+        enqueueAppSync(appIdentity, PushBrokerConstants.COMPAT_SYNC_EVENT_PACKAGE_CHANGED,
+                "provider app registered", false, false);
+        Log.i(TAG, "Provider reported app registered provider=" + providerId
+                + " package=" + packageName + " user=" + userId);
+    }
+
+    private void handleProviderCompatibilityCapabilityStateChanged(String providerId, Bundle event) {
+        final String capabilityId = event.getString(PushBrokerConstants.PROVIDER_EVENT_CAPABILITY_ID);
+        if (!PushBrokerConstants.COMPAT_CAP_PACKAGE_SIGNATURE_SPOOF.equals(capabilityId)) {
+            Log.i(TAG, "Ignoring unsupported compatibility capability event provider="
+                    + providerId + " capability=" + capabilityId);
+            return;
+        }
+        final String packageName = event.getString(PushBrokerConstants.PROVIDER_EVENT_PACKAGE_NAME);
+        final int userId = event.getInt(PushBrokerConstants.PROVIDER_EVENT_USER_ID,
+                UserHandle.USER_SYSTEM);
+        if (packageName == null || packageName.isBlank()) {
+            Log.w(TAG, "Ignoring compatibility capability event without package name");
+            return;
+        }
+        final Bundle capabilityData = event.getBundle(PushBrokerConstants.PROVIDER_EVENT_CAPABILITY_DATA);
+        if (capabilityData == null) {
+            removeCompatibilitySignatureSpoofData(providerId, packageName, userId);
+        } else {
+            final Bundle sanitized = sanitizeCompatibilitySignatureSpoofData(capabilityData);
+            if (sanitized.isEmpty()) {
+                removeCompatibilitySignatureSpoofData(providerId, packageName, userId);
+            } else {
+                putCompatibilitySignatureSpoofData(providerId, packageName, userId, sanitized);
+            }
+        }
+        notifyCompatibilityPolicyChanged(providerId, packageName, userId);
+    }
+
+    private void handleProviderNotificationPosted(String providerId, Bundle event) {
+        if (!mStore.isAvoidDuplicatePushEnabled()) {
+            Log.i(TAG, "Ignoring provider notification event because duplicate push avoidance is disabled");
+            return;
+        }
+
+        if (mPolicyState == POLICY_DORMANT) {
+            Log.i(TAG, "Ignoring provider notification event in DORMANT policy state");
+            return;
+        }
+
+        if (!providerId.equals(mRegistry.getActiveProviderId())) {
+            Log.i(TAG, "Ignoring provider notification event from non-active provider " + providerId);
+            return;
+        }
+
+        final String packageName = event.getString(PushBrokerConstants.PROVIDER_EVENT_PACKAGE_NAME);
+        if (packageName == null || packageName.isBlank()) {
+            Log.w(TAG, "Ignoring provider notification event without package name");
+            return;
+        }
+        rememberSyncCandidate(packageName);
+
+        final long now = System.currentTimeMillis();
+        mNotificationConvergenceStore.pruneExpired(now);
+        mNotificationConvergenceStore.addProviderNotificationPosted(providerId, event,
+                PushNotificationConvergenceStore.DEFAULT_TTL_MILLIS);
+        Log.i(TAG, "Tracked provider fallback notification provider=" + providerId
+                + " package=" + packageName
+                + " pendingCount=" + mNotificationConvergenceStore.getPendingCount());
+        scheduleConvergenceScans(providerId, packageName, now);
+    }
+
+    private void scheduleConvergenceScans(String providerId, String packageName, long postedAt) {
+        for (long delayMillis : CONVERGENCE_SCAN_DELAYS_MILLIS) {
+            mHandler.postDelayed(() -> runConvergenceScan(providerId, packageName, postedAt),
+                    delayMillis);
+        }
+    }
+
+    private void registerNotificationListener() {
+        if (mNotificationListenerRegistered) {
+            return;
+        }
+        try {
+            mNotificationListener.registerAsSystemService(mContext,
+                    new ComponentName(mContext, PushBrokerNotificationListener.class),
+                    UserHandle.USER_ALL);
+            mNotificationListenerRegistered = true;
+            Log.i(TAG, "Registered push broker notification listener for USER_ALL");
+        } catch (RemoteException e) {
+            Log.w(TAG, "Failed to register push broker notification listener", e);
+        }
+    }
+
+    private void runConvergenceScan(String providerId, String packageName, long postedAt) {
+        if (!mStore.isAvoidDuplicatePushEnabled()) {
+            return;
+        }
+        if (mPolicyState == POLICY_DORMANT) {
+            return;
+        }
+        if (!providerId.equals(mBoundProviderId) || mActiveConnection == null) {
+            return;
+        }
+
+        final long now = System.currentTimeMillis();
+        if (now - postedAt > PushNotificationConvergenceStore.DEFAULT_TTL_MILLIS) {
+            mNotificationConvergenceStore.pruneExpired(now);
+            return;
+        }
+
+        final StatusBarNotification[] notifications = getAllActiveNotifications();
+        if (notifications.length == 0) {
+            mNotificationConvergenceStore.pruneExpired(now);
+            return;
+        }
+
+        final List<PushNotificationConvergenceStore.MatchResult> matches =
+                mNotificationConvergenceStore.matchAndConsume(notifications, providerId, now);
+        if (matches.isEmpty()) {
+            return;
+        }
+
+        for (int i = 0; i < matches.size(); i++) {
+            final PushNotificationConvergenceStore.MatchResult match = matches.get(i);
+            if (!packageName.equals(match.appPackageName)) {
+                continue;
+            }
+            requestProviderNotificationCancel(match.appPackageName,
+                    match.providerNotificationTag, match.providerNotificationId);
+            Log.i(TAG, "Converged duplicate push provider=" + providerId
+                    + " targetPackage=" + match.appPackageName
+                    + " providerNotification=" + match.providerNotificationTag + "/"
+                    + match.providerNotificationId
+                    + " appNotification=" + match.appNotificationTag + "/" + match.appNotificationId
+                    + " key=" + match.appNotificationKey);
+        }
+    }
+
+    private void handleNotificationPosted(StatusBarNotification sbn) {
+        if (sbn == null || mBoundProviderId == null || mActiveConnection == null) {
+            return;
+        }
+        if (!mStore.isAvoidDuplicatePushEnabled() || mPolicyState == POLICY_DORMANT) {
+            return;
+        }
+
+        final String packageName = sbn.getPackageName();
+        final int userId = sbn.getUserId();
+        if (!mNotificationConvergenceStore.hasPendingRecordsFor(packageName, userId)) {
+            return;
+        }
+
+        final long now = System.currentTimeMillis();
+        final List<PushNotificationConvergenceStore.MatchResult> matches =
+                mNotificationConvergenceStore.matchAndConsume(new StatusBarNotification[]{sbn},
+                        mBoundProviderId, now);
+        if (matches.isEmpty()) {
+            return;
+        }
+
+        for (int i = 0; i < matches.size(); i++) {
+            final PushNotificationConvergenceStore.MatchResult match = matches.get(i);
+            requestProviderNotificationCancel(match.appPackageName,
+                    match.providerNotificationTag, match.providerNotificationId);
+            Log.i(TAG, "Converged duplicate push via listener provider=" + match.providerId
+                    + " targetPackage=" + match.appPackageName
+                    + " providerNotification=" + match.providerNotificationTag + "/"
+                    + match.providerNotificationId
+                    + " appNotification=" + match.appNotificationTag + "/" + match.appNotificationId
+                    + " key=" + match.appNotificationKey);
+        }
+    }
+
+    private StatusBarNotification[] getAllActiveNotifications() {
+        if (mNotificationManagerService == null) {
+            return new StatusBarNotification[0];
+        }
+        try {
+            return mNotificationManagerService.getActiveNotificationsWithAttribution("android",
+                    null);
+        } catch (RemoteException e) {
+            Log.w(TAG, "Failed to query active notifications for convergence", e);
+            return new StatusBarNotification[0];
+        }
+    }
