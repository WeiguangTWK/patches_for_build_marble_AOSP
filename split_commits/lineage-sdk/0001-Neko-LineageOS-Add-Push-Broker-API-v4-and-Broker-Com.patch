+    private boolean isSupportedCompatibilitySignatureSpoofSurface(String surface) {
+        return PushBrokerConstants.COMPAT_QUERY_SURFACE_PACKAGE_INFO_SIGNATURES.equals(surface)
+                || PushBrokerConstants.COMPAT_QUERY_SURFACE_PACKAGE_INFO_SIGNING_INFO.equals(surface)
+                || PushBrokerConstants.COMPAT_QUERY_SURFACE_CHECK_SIGNATURES.equals(surface);
+    }
