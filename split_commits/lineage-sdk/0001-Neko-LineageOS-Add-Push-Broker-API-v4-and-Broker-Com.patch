+    private void requestProviderNotificationCancel(String packageName, String tag, int id) {
+        if (mActiveConnection == null) {
+            return;
+        }
+
+        final Bundle event = new Bundle();
+        event.putString(PushBrokerConstants.SYSTEM_EVENT_TYPE,
+                PushBrokerConstants.SYSTEM_EVENT_CANCEL_PROVIDER_NOTIFICATION);
+        event.putString(PushBrokerConstants.SYSTEM_EVENT_NOTIFICATION_PACKAGE_NAME, packageName);
+        event.putString(PushBrokerConstants.SYSTEM_EVENT_NOTIFICATION_TAG, tag);
+        event.putInt(PushBrokerConstants.SYSTEM_EVENT_NOTIFICATION_ID, id);
+        try {
+            mActiveConnection.onSystemEvent(event);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Failed to request provider notification cancel package=" + packageName
+                    + " tag=" + tag + " id=" + id, e);
+        }
+    }
