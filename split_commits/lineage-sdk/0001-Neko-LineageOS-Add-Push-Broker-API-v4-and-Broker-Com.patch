+    private boolean setCompatibilityProfilesInternal(String providerId, String packageName, int userId,
+            String[] enabledProfileIds) {
+        if (providerId == null || providerId.isBlank()
+                || packageName == null || packageName.isBlank()) {
+            return false;
+        }
+        final PushProviderInfo providerInfo = mRegistry.getProviderInfo(providerId);
+        if (providerInfo == null) {
+            return false;
+        }
+        final ArraySet<String> profileSet = new ArraySet<>();
+        if (enabledProfileIds != null) {
+            for (String profileId : enabledProfileIds) {
+                if (profileId != null && !profileId.isBlank()) {
+                    profileSet.add(profileId);
+                }
+            }
+        }
+        mStore.setCompatibilityProfiles(providerId, userId, packageName, profileSet);
+        if (profileSet.isEmpty()) {
+            mStore.clearCompatibilityCapabilities(providerId, userId, packageName);
+        } else {
+            final ArraySet<String> existingCapabilities = mStore.getCompatibilityCapabilities(
+                    providerId, userId, packageName);
+            final ArraySet<String> sanitizedCapabilities = mCompatibilityCapabilityPolicy
+                    .sanitizeEnabledCapabilities(providerInfo, profileSet, existingCapabilities);
+            final ArraySet<String> requestedCapabilities = mCompatibilityCapabilityPolicy
+                    .getRequestedCapabilities(providerInfo, profileSet);
+            mStore.setCompatibilityCapabilities(providerId, userId, packageName,
+                    sanitizedCapabilities.isEmpty() ? requestedCapabilities : sanitizedCapabilities);
+        }
+        rememberKnownPackage(packageName);
+        final Bundle appIdentity = buildAppIdentity(packageName, -1, userId);
+        if (appIdentity != null && shouldApplyCompatibilityState(providerId)) {
+            if (profileSet.isEmpty()) {
+                clearCompatibilityTokenState(packageName, userId);
+                final boolean changed = forwardRevokeApp(appIdentity);
+                notifyCompatibilityPolicyChanged(providerId, packageName, userId);
+                return changed;
+            }
+            if (!shouldPrepareApp(appIdentity)) {
+                notifyCompatibilityPolicyChanged(providerId, packageName, userId);
+                return false;
+            }
+            rememberSyncCandidate(packageName);
+            final boolean changed = forwardPrepareApp(appIdentity);
+            notifyCompatibilityPolicyChanged(providerId, packageName, userId);
+            return changed;
+        }
+        notifyCompatibilityPolicyChanged(providerId, packageName, userId);
+        return true;
+    }
