+    private void markAppSyncDispatched(Bundle appIdentity) {
+        final String packageName = appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        final int userId = appIdentity.getInt(PushBrokerConstants.APP_IDENTITY_USER_ID,
+                UserHandle.USER_SYSTEM);
+        rememberSyncCandidate(packageName);
+        mLastAppSyncRequestAt.put(packageName + "#" + userId, System.currentTimeMillis());
+    }
+
+    private boolean dispatchSyncAppState(Bundle appIdentity) {
+        if (mBoundProviderId == null || mActiveConnection == null || !mActiveConnection.isConnected()
+                || appIdentity == null || mPolicyState == POLICY_DORMANT) {
+            return false;
+        }
+
+        final String packageName = appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        final String reason = appIdentity.getString(PushBrokerConstants.COMPAT_SYNC_REASON,
+                "unspecified");
+        final String event = appIdentity.getString(PushBrokerConstants.COMPAT_SYNC_EVENT);
+        if (!shouldSyncApp(appIdentity, reason)) {
+            return false;
+        }
+        if (event == null || event.isBlank()) {
+            recordAppSyncContractError(appIdentity, "missingCompatSyncEvent",
+                    PushBrokerConstants.RESULT_BAD_REQUEST);
+            return false;
+        }
+
+        final int userId = appIdentity.getInt(PushBrokerConstants.APP_IDENTITY_USER_ID,
+                UserHandle.USER_SYSTEM);
+        final boolean networkAvailable = mConnectivityManager != null
+                && mConnectivityManager.getActiveNetwork() != null;
+        if (!networkAvailable) {
+            backoffAppSync(packageName, userId, APP_SYNC_NOT_READY_BACKOFF_MILLIS,
+                    PushBrokerConstants.RESULT_NOT_READY);
+            Log.i(TAG, "Skipping app sync because network is unavailable package="
+                    + packageName + " user=" + userId + " reason=" + reason
+                    + " backoffMillis=" + APP_SYNC_NOT_READY_BACKOFF_MILLIS);
+            return false;
+        }
+
+        final Bundle health = mActiveConnection.getHealth();
+        final String connectionStatus = health.getString(
+                PushBrokerConstants.HEALTH_CONNECTION_STATUS,
+                PushBrokerConstants.HEALTH_STATUS_UNKNOWN);
+        final boolean businessHealthy = health.getBoolean(
+                PushBrokerConstants.HEALTH_BUSINESS_HEALTHY, true);
+        final String degradedReason = health.getString(
+                PushBrokerConstants.HEALTH_BUSINESS_DEGRADED_REASON,
+                PushBrokerConstants.HEALTH_DEGRADED_REASON_UNKNOWN);
+        if (!PushBrokerConstants.HEALTH_STATUS_CONNECTED.equals(connectionStatus)) {
+            backoffAppSync(packageName, userId, APP_SYNC_NOT_READY_BACKOFF_MILLIS,
+                    PushBrokerConstants.RESULT_NOT_READY);
+            Log.i(TAG, "Skipping app sync because provider health is not connected package="
+                    + packageName + " user=" + userId + " reason=" + reason
+                    + " status=" + connectionStatus
+                    + " backoffMillis=" + APP_SYNC_NOT_READY_BACKOFF_MILLIS);
+            return false;
+        }
+        if (!businessHealthy) {
+            backoffAppSync(packageName, userId, APP_SYNC_TEMPORARY_FAILURE_BACKOFF_MILLIS,
+                    PushBrokerConstants.RESULT_TEMPORARY_FAILURE);
+            Log.i(TAG, "Skipping app sync because provider business health is degraded package="
+                    + packageName + " user=" + userId + " reason=" + reason
+                    + " degradedReason=" + degradedReason
+                    + " backoffMillis=" + APP_SYNC_TEMPORARY_FAILURE_BACKOFF_MILLIS);
+            return false;
+        }
+
+        final Bundle extras = new Bundle();
+        extras.putString(PushBrokerConstants.COMPAT_SYNC_EVENT, event);
+        extras.putBoolean(PushBrokerConstants.COMPAT_SYNC_REPLACING,
+                appIdentity.getBoolean(PushBrokerConstants.COMPAT_SYNC_REPLACING, false));
+        extras.putLong(PushBrokerConstants.COMPAT_SYNC_TIMESTAMP,
+                appIdentity.getLong(PushBrokerConstants.COMPAT_SYNC_TIMESTAMP,
+                        System.currentTimeMillis()));
+        extras.putString(PushBrokerConstants.COMPAT_SYNC_REASON, reason);
+        if (appIdentity.containsKey(PushBrokerConstants.COMPAT_SYNC_DATA_CLEARED)) {
+            extras.putBoolean(PushBrokerConstants.COMPAT_SYNC_DATA_CLEARED,
+                    appIdentity.getBoolean(PushBrokerConstants.COMPAT_SYNC_DATA_CLEARED, false));
+        }
+        final int canSyncResult = mActiveConnection.canSyncAppResult(appIdentity, extras);
+        if (canSyncResult != PushBrokerConstants.RESULT_OK) {
+            Log.i(TAG, "Skipping app sync because provider rejected sync capability package="
+                    + packageName + " event=" + event + " reason=" + reason
+                    + " provider=" + mBoundProviderId
+                    + " resultCode=" + canSyncResult);
+            recordAppSyncFailure(appIdentity, canSyncResult, "canSyncApp");
+            return false;
+        }
+        try {
+            final int syncResult = mActiveConnection.syncAppResult(appIdentity, extras);
+            final boolean synced = syncResult == PushBrokerConstants.RESULT_OK;
+            rememberCompatibilityResult(mLastCompatibilitySyncResults, appIdentity, syncResult);
+            rememberCompatibilityTrace(appIdentity, "sync", event, reason, syncResult);
+            if (!synced) {
+                Log.i(TAG, "Provider declined app sync dispatch package=" + packageName
+                        + " event=" + event + " reason=" + reason + " provider=" + mBoundProviderId
+                        + " resultCode=" + syncResult);
+                recordAppSyncFailure(appIdentity, syncResult, "syncApp");
+                return false;
+            }
+            if (PushBrokerConstants.COMPAT_SYNC_EVENT_PACKAGE_REPLACED.equals(event)
+                    || (PushBrokerConstants.COMPAT_SYNC_EVENT_PACKAGE_REMOVED.equals(event)
+                    && appIdentity.getBoolean(PushBrokerConstants.COMPAT_SYNC_REPLACING, false))) {
+                maybeRequestCompatibilityToken(appIdentity,
+                        PushBrokerConstants.COMPAT_TOKEN_REASON_PACKAGE_REPLACED, true);
+            }
+            markAppSyncDispatched(appIdentity);
+            Log.i(TAG, "Dispatching app sync package=" + packageName
+                    + " event=" + event + " reason=" + reason + " provider=" + mBoundProviderId
+                    + " resultCode=" + syncResult);
+            return true;
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Failed to dispatch app sync package=" + packageName
+                    + " event=" + event + " reason=" + reason, e);
+            return false;
+        }
+    }
+
+    private final Runnable mDrainAppSyncQueue = new Runnable() {
+        @Override
+        public void run() {
+            if (mPendingSyncApps.isEmpty()) {
+                mPendingSyncKeys.clear();
+                return;
+            }
+
+            if (mPolicyState == POLICY_DORMANT || mBoundProviderId == null || mActiveConnection == null
+                    || !mActiveConnection.isConnected()) {
+                return;
+            }
+
+            final Bundle appIdentity = mPendingSyncApps.pollFirst();
+            if (appIdentity == null) {
+                return;
+            }
+
+            final String packageName = appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+            final int userId = appIdentity.getInt(PushBrokerConstants.APP_IDENTITY_USER_ID,
+                    UserHandle.USER_SYSTEM);
+            mPendingSyncKeys.remove(packageName + "#" + userId);
+
+            final boolean dispatched = dispatchSyncAppState(appIdentity);
+            Log.i(TAG, "App sync dispatch result package=" + packageName + " user=" + userId
+                    + " result=" + dispatched);
+
+            if (!mPendingSyncApps.isEmpty()) {
+                scheduleAppSyncQueueDrain();
+            }
+        }
+    };
