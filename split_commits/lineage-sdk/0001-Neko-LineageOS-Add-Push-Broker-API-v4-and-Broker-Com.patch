+++ b/sdk/src/java/lineageos/push/PushBrokerManager.java
@@ -0,0 +1,280 @@
+/*
+ * SPDX-FileCopyrightText: Neko-LineageOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package lineageos.push;
+
+import android.content.Context;
+import android.os.Bundle;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.os.UserHandle;
+import android.util.Log;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+import lineageos.app.LineageContextConstants;
+
+public final class PushBrokerManager {
+    private static final String TAG = "PushBrokerManager";
+
+    private static IPushBrokerService sService;
+    private static PushBrokerManager sInstance;
+
+    private final Context mContext;
+
+    private PushBrokerManager(Context context) {
+        final Context appContext = context.getApplicationContext();
+        mContext = appContext == null ? context : appContext;
+        sService = getService();
+
+        if (mContext.getPackageManager().hasSystemFeature(
+                LineageContextConstants.Features.PUSH_BROKER) && sService == null) {
+            throw new RuntimeException("Unable to get PushBrokerService. The service either "
+                    + "crashed, was not started, or the interface has been called too early "
+                    + "in SystemServer init");
+        }
+    }
+
+    public static synchronized PushBrokerManager getInstance(Context context) {
+        if (sInstance == null) {
+            sInstance = new PushBrokerManager(context);
+        }
+        return sInstance;
+    }
+
+    /** @hide */
+    public static IPushBrokerService getService() {
+        if (sService != null) {
+            return sService;
+        }
+        final IBinder binder = ServiceManager.getService(
+                LineageContextConstants.LINEAGE_PUSH_BROKER_SERVICE);
+        sService = IPushBrokerService.Stub.asInterface(binder);
+
+        if (sService == null) {
+            Log.e(TAG, "null push broker service");
+        }
+
+        return sService;
+    }
+
+    private boolean checkService() {
+        if (sService == null) {
+            Log.w(TAG, "not connected to PushBrokerService");
+            return false;
+        }
+        return true;
+    }
+
+    public List<PushProviderInfo> getInstalledProviders() {
+        try {
+            if (!checkService()) {
+                return Collections.emptyList();
+            }
+            return sService.getInstalledProviders();
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return Collections.emptyList();
+    }
+
+    public String getActiveProviderId() {
+        try {
+            return checkService() ? sService.getActiveProviderId() : null;
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return null;
+    }
+
+    public PushProviderState getProviderState(String providerId) {
+        try {
+            if (checkService()) {
+                return sService.getProviderState(providerId);
+            }
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return new PushProviderState(false, false, false, false, false, false, 0, null,
+                PushBrokerConstants.RUNTIME_MODE_UNKNOWN);
+    }
+
+    public BrokerStatus getBrokerStatus() {
+        try {
+            if (checkService()) {
+                return sService.getBrokerStatus();
+            }
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return new BrokerStatus(null, false, 0, null);
+    }
+
+    public boolean setActiveProvider(String providerId) {
+        try {
+            return checkService() && sService.setActiveProvider(providerId);
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return false;
+    }
+
+    public boolean disableActiveProvider() {
+        try {
+            return checkService() && sService.disableActiveProvider();
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return false;
+    }
+
+    public boolean prepareApp(Bundle appIdentity) {
+        try {
+            return checkService() && sService.prepareApp(appIdentity);
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return false;
+    }
+
+    public boolean prepareApp(String packageName, int uid) {
+        final Bundle appIdentity = new Bundle();
+        appIdentity.putString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME, packageName);
+        appIdentity.putInt(PushBrokerConstants.APP_IDENTITY_UID, uid);
+        appIdentity.putInt(PushBrokerConstants.APP_IDENTITY_USER_ID, UserHandle.getUserId(uid));
+        return prepareApp(appIdentity);
+    }
+
+    public boolean revokeApp(Bundle appIdentity) {
+        try {
+            return checkService() && sService.revokeApp(appIdentity);
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return false;
+    }
+
+    public boolean revokeApp(String packageName, int uid) {
+        final Bundle appIdentity = new Bundle();
+        appIdentity.putString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME, packageName);
+        appIdentity.putInt(PushBrokerConstants.APP_IDENTITY_UID, uid);
+        appIdentity.putInt(PushBrokerConstants.APP_IDENTITY_USER_ID, UserHandle.getUserId(uid));
+        return revokeApp(appIdentity);
+    }
+
+    public boolean requestToken(Bundle appIdentity, Bundle extras) {
+        try {
+            return checkService() && sService.requestToken(appIdentity, extras);
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return false;
+    }
+
+    public boolean requestToken(String packageName, int uid, String reason) {
+        final Bundle appIdentity = new Bundle();
+        appIdentity.putString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME, packageName);
+        appIdentity.putInt(PushBrokerConstants.APP_IDENTITY_UID, uid);
+        appIdentity.putInt(PushBrokerConstants.APP_IDENTITY_USER_ID, UserHandle.getUserId(uid));
+
+        final Bundle extras = new Bundle();
+        extras.putString(PushBrokerConstants.COMPAT_TOKEN_REASON, reason);
+        extras.putLong(PushBrokerConstants.COMPAT_TOKEN_TIMESTAMP, System.currentTimeMillis());
+        return requestToken(appIdentity, extras);
+    }
+
+    /** @hide */
+    public Bundle getCompatibilityState(String providerId) {
+        try {
+            return checkService() ? sService.getCompatibilityState(providerId) : Bundle.EMPTY;
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return Bundle.EMPTY;
+    }
+
+    /** @hide */
+    public Bundle getCompatibilityAppState(String providerId, String packageName, int userId) {
+        try {
+            if (checkService()) {
+                return sService.getCompatibilityAppState(providerId, packageName, userId);
+            }
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return Bundle.EMPTY;
+    }
+
+    /** @hide */
+    public List<Bundle> getCompatibilityAuthorizedApps(String providerId, int userId) {
+        try {
+            if (checkService()) {
+                return sService.getCompatibilityAuthorizedApps(providerId, userId);
+            }
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return new ArrayList<>();
+    }
+
+    /** @hide */
+    public boolean setCompatibilityProfiles(String providerId, String packageName, int userId,
+            String[] enabledProfileIds) {
+        try {
+            return checkService() && sService.setCompatibilityProfiles(providerId, packageName,
+                    userId, enabledProfileIds);
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return false;
+    }
+
+    /** @hide */
+    public boolean clearCompatibilityProfiles(String providerId, String packageName, int userId) {
+        try {
+            return checkService()
+                    && sService.clearCompatibilityProfiles(providerId, packageName, userId);
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return false;
+    }
+
+    /** @hide */
+    public boolean setCompatibilityCapabilities(String providerId, String packageName, int userId,
+            String[] enabledCapabilityIds) {
+        try {
+            return checkService() && sService.setCompatibilityCapabilities(providerId, packageName,
+                    userId, enabledCapabilityIds);
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return false;
+    }
+
+    /** @hide */
+    public boolean clearCompatibilityCapabilities(String providerId, String packageName,
+            int userId) {
+        try {
+            return checkService()
+                    && sService.clearCompatibilityCapabilities(providerId, packageName, userId);
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return false;
+    }
+
+    public Bundle runDiagnostics(String providerId) {
+        try {
+            return checkService() ? sService.runDiagnostics(providerId) : Bundle.EMPTY;
+        } catch (RemoteException e) {
+            Log.e(TAG, e.getLocalizedMessage(), e);
+        }
+        return Bundle.EMPTY;
+    }
+}
