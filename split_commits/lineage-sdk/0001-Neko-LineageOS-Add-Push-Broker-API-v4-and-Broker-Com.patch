+    private String deriveCompatSyncEvent(Intent intent) {
+        if (intent == null) {
+            return null;
+        }
+        final String action = intent.getAction();
+        if (Intent.ACTION_PACKAGE_ADDED.equals(action)) {
+            return PushBrokerConstants.COMPAT_SYNC_EVENT_PACKAGE_ADDED;
+        }
+        if (Intent.ACTION_PACKAGE_REMOVED.equals(action)) {
+            return PushBrokerConstants.COMPAT_SYNC_EVENT_PACKAGE_REMOVED;
+        }
+        if (Intent.ACTION_PACKAGE_REPLACED.equals(action)) {
+            return PushBrokerConstants.COMPAT_SYNC_EVENT_PACKAGE_REPLACED;
+        }
+        if (Intent.ACTION_PACKAGE_CHANGED.equals(action)) {
+            return PushBrokerConstants.COMPAT_SYNC_EVENT_PACKAGE_CHANGED;
+        }
+        if (Intent.ACTION_PACKAGE_DATA_CLEARED.equals(action)) {
+            return PushBrokerConstants.COMPAT_SYNC_EVENT_PACKAGE_DATA_CLEARED;
+        }
+        return null;
+    }
