+    private void notifyCompatibilityPolicyChanged(String providerId, String packageName,
+            int userId) {
+        if (providerId == null || providerId.isBlank()
+                || packageName == null || packageName.isBlank()) {
+            return;
+        }
+        enqueueCompatibilityPolicyChange(providerId, packageName, userId);
+        if (mCompatibilityPolicyBroadcastInProgress) {
+            return;
+        }
+        mCompatibilityPolicyBroadcastInProgress = true;
+        try {
+            while (!mPendingCompatibilityPolicyChanges.isEmpty()) {
+                final Bundle change = mPendingCompatibilityPolicyChanges.removeFirst();
+                final String changeProviderId = change.getString(
+                        PushBrokerConstants.PROVIDER_EVENT_PROVIDER_ID);
+                final String changePackageName = change.getString(
+                        PushBrokerConstants.PROVIDER_EVENT_PACKAGE_NAME);
+                final int changeUserId = change.getInt(
+                        PushBrokerConstants.PROVIDER_EVENT_USER_ID, UserHandle.USER_SYSTEM);
+                mPendingCompatibilityPolicyChangeKeys.remove(
+                        buildCompatibilityPolicyChangeKey(changeProviderId, changePackageName,
+                                changeUserId));
+                refreshPublishedCompatibilitySignatureSpoofPolicy();
+                final int count = mCompatibilityPolicyCallbacks.beginBroadcast();
+                try {
+                    for (int i = 0; i < count; i++) {
+                        final Object cookie = mCompatibilityPolicyCallbacks.getBroadcastCookie(i);
+                        if (cookie instanceof String && !changeProviderId.equals(cookie)) {
+                            continue;
+                        }
+                        try {
+                            mCompatibilityPolicyCallbacks.getBroadcastItem(i)
+                                    .onCompatibilityPolicyChanged(changeProviderId,
+                                            changePackageName, changeUserId);
+                        } catch (RemoteException ignored) {
+                        }
+                    }
+                } finally {
+                    mCompatibilityPolicyCallbacks.finishBroadcast();
+                }
+            }
+        } finally {
+            mCompatibilityPolicyBroadcastInProgress = false;
+        }
+    }
+
+    private void enqueueCompatibilityPolicyChange(String providerId, String packageName,
+            int userId) {
+        final String key = buildCompatibilityPolicyChangeKey(providerId, packageName, userId);
+        if (!mPendingCompatibilityPolicyChangeKeys.add(key)) {
+            return;
+        }
+        final Bundle change = new Bundle();
+        change.putString(PushBrokerConstants.PROVIDER_EVENT_PROVIDER_ID, providerId);
+        change.putString(PushBrokerConstants.PROVIDER_EVENT_PACKAGE_NAME, packageName);
+        change.putInt(PushBrokerConstants.PROVIDER_EVENT_USER_ID, userId);
+        mPendingCompatibilityPolicyChanges.addLast(change);
+    }
+
+    private String buildCompatibilityPolicyChangeKey(String providerId, String packageName,
+            int userId) {
+        return providerId + "#" + userId + "#" + packageName;
+    }
+
+    private boolean shouldApplyCompatibilityState(String providerId) {
+        if (providerId == null || providerId.isBlank()) {
+            return false;
+        }
+        if (!providerId.equals(mRegistry.getActiveProviderId())) {
+            return false;
+        }
+        final PushProviderState providerState = mRegistry.getProviderState(providerId);
+        return PushBrokerConstants.RUNTIME_MODE_COMPATIBILITY.equals(providerState.runtimeMode)
+                && mActiveConnection != null && mActiveConnection.isConnected();
+    }
+
+    private boolean isCompatibilityStateSupported(String providerId, Bundle appIdentity) {
+        if (!shouldApplyCompatibilityState(providerId) || appIdentity == null) {
+            return false;
+        }
+        final int result = mActiveConnection.supportsAppResult(appIdentity);
+        return result == PushBrokerConstants.RESULT_OK;
+    }
+
+    private int countAuthorizedApps(
+            ArrayMap<Integer, ArrayMap<String, ArraySet<String>>> providerProfiles) {
+        if (providerProfiles == null) {
+            return 0;
+        }
+        int count = 0;
+        for (int i = 0; i < providerProfiles.size(); i++) {
+            final ArrayMap<String, ArraySet<String>> perPackage = providerProfiles.valueAt(i);
+            for (int j = 0; j < perPackage.size(); j++) {
+                final ArraySet<String> profiles = perPackage.valueAt(j);
+                if (profiles != null && !profiles.isEmpty()) {
+                    count++;
+                }
+            }
+        }
+        return count;
+    }
+
+    private int countSupportedCompatibilityApps(List<Bundle> appStates) {
+        int count = 0;
+        if (appStates == null) {
+            return 0;
+        }
+        for (Bundle appState : appStates) {
+            if (appState != null && appState.getBoolean(PushBrokerConstants.COMPAT_APP_SUPPORTED,
+                    false)) {
+                count++;
+            }
+        }
+        return count;
+    }
+
+    private boolean isCompatibilityModeActive() {
+        if (mBoundProviderId == null) {
+            return false;
+        }
+        final PushProviderState providerState = mRegistry.getProviderState(mBoundProviderId);
+        return PushBrokerConstants.RUNTIME_MODE_COMPATIBILITY.equals(providerState.runtimeMode);
+    }
+
+    private boolean hasAuthorizedCompatibilityProfiles(String providerId, String packageName,
+            int userId) {
+        if (providerId == null || providerId.isBlank()
+                || packageName == null || packageName.isBlank()) {
+            return false;
+        }
+        return !mStore.getCompatibilityProfiles(providerId, userId, packageName).isEmpty();
+    }
+
+    private void rememberCompatibilityResult(ArrayMap<String, Integer> resultStore,
+            Bundle appIdentity, int result) {
+        if (appIdentity == null) {
+            return;
+        }
+        final String packageName = appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        final int userId = appIdentity.getInt(PushBrokerConstants.APP_IDENTITY_USER_ID,
+                UserHandle.USER_SYSTEM);
+        if (packageName == null || packageName.isBlank()) {
+            return;
+        }
+        resultStore.put(packageName + "#" + userId, result);
+    }
+
+    private void putCompatibilityLastResult(Bundle bundle, String key,
+            ArrayMap<String, Integer> resultStore, String packageName, int userId) {
+        final Integer result = resultStore.get(packageName + "#" + userId);
+        if (result != null) {
+            bundle.putInt(key, result);
+        }
+    }
+
+    private boolean maybeRequestCompatibilityToken(Bundle appIdentity, String reason,
+            boolean forceRefresh) {
+        if (appIdentity == null || reason == null || reason.isBlank()
+                || !isCompatibilityModeActive() || mPolicyState == POLICY_DORMANT) {
+            return false;
+        }
+        final String packageName = appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        final int userId = appIdentity.getInt(PushBrokerConstants.APP_IDENTITY_USER_ID,
+                UserHandle.USER_SYSTEM);
+        if (packageName == null || packageName.isBlank()
+                || !hasAuthorizedCompatibilityProfiles(mBoundProviderId, packageName, userId)) {
+            return false;
+        }
+
+        final String key = packageName + "#" + userId;
+        final long now = System.currentTimeMillis();
+        final Long suppressedUntil = mCompatibilityTokenSuppressedUntil.get(key);
+        if (suppressedUntil != null) {
+            if (now < suppressedUntil) {
+                Log.i(TAG, "Skipping requestToken because token backoff is active package="
+                        + packageName + " user=" + userId + " reason=" + reason
+                        + " remainingMillis=" + (suppressedUntil - now));
+                return false;
+            }
+            mCompatibilityTokenSuppressedUntil.remove(key);
+        }
+
+        if (PushBrokerConstants.COMPAT_TOKEN_REASON_INITIAL_BOOTSTRAP.equals(reason)
+                && mCompatibilityBootstrapTokenCompleted.contains(key)) {
+            Log.i(TAG, "Skipping requestToken because initial bootstrap already completed package="
+                    + packageName + " user=" + userId);
+            return false;
+        }
+        if (mUnsupportedCompatibilityTokenPackages.contains(key)) {
+            Log.i(TAG, "Skipping requestToken because provider cached token bootstrap as"
+                    + " unsupported package=" + packageName + " user=" + userId
+                    + " reason=" + reason);
+            return false;
+        }
+
+        final Bundle traceState = mCompatibilityTraceStates.get(key);
+        if (PushBrokerConstants.COMPAT_TOKEN_REASON_PACKAGE_REPLACED.equals(reason)
+                && traceState != null
+                && PushBrokerConstants.COMPAT_TOKEN_REASON_PACKAGE_REPLACED.equals(
+                        traceState.getString("lastTokenReason"))) {
+            final long lastTokenAt = traceState.getLong("lastTokenAt", 0L);
+            if (lastTokenAt > 0L
+                    && now - lastTokenAt < TOKEN_REQUEST_PACKAGE_REPLACED_DEDUPE_WINDOW_MILLIS) {
+                Log.i(TAG, "Skipping requestToken because package-replaced token request was"
+                        + " already sent recently package=" + packageName + " user=" + userId
+                        + " ageMillis=" + (now - lastTokenAt));
+                return false;
+            }
+        }
+
+        final ArraySet<String> enabledProfiles = mStore.getCompatibilityProfiles(
+                mBoundProviderId, userId, packageName);
+        final Bundle extras = new Bundle();
+        extras.putString(PushBrokerConstants.COMPAT_TOKEN_REASON, reason);
+        extras.putLong(PushBrokerConstants.COMPAT_TOKEN_TIMESTAMP, now);
+        extras.putBoolean(PushBrokerConstants.COMPAT_TOKEN_FORCE_REFRESH, forceRefresh);
+        if (!enabledProfiles.isEmpty()) {
+            extras.putStringArray(PushBrokerConstants.COMPAT_TOKEN_PROFILE_IDS,
+                    enabledProfiles.toArray(new String[0]));
+        }
+
+        final boolean requested = forwardRequestToken(appIdentity, extras);
+        final Integer resultCode = mLastCompatibilityTokenResults.get(key);
+        if (requested) {
+            mCompatibilityTokenSuppressedUntil.remove(key);
+            mUnsupportedCompatibilityTokenPackages.remove(key);
+            if (PushBrokerConstants.COMPAT_TOKEN_REASON_INITIAL_BOOTSTRAP.equals(reason)) {
+                mCompatibilityBootstrapTokenCompleted.add(key);
+            }
+            return true;
+        }
+
+        if (resultCode != null) {
+            if (resultCode == PushBrokerConstants.RESULT_UNSUPPORTED) {
+                mUnsupportedCompatibilityTokenPackages.add(key);
+                Log.i(TAG, "Caching unsupported token bootstrap package=" + packageName
+                        + " user=" + userId + " reason=" + reason);
+                return false;
+            }
+            final long backoffMillis = getAppSyncBackoffMillis(resultCode);
+            if (backoffMillis > 0L) {
+                mCompatibilityTokenSuppressedUntil.put(key, now + backoffMillis);
+                Log.i(TAG, "Backed off requestToken package=" + packageName + " user=" + userId
+                        + " reason=" + reason + " resultCode=" + resultCode
+                        + " backoffMillis=" + backoffMillis);
+            }
+        }
+        return false;
+    }
+
+    private void clearCompatibilityTokenState(String packageName, int userId) {
+        if (packageName == null || packageName.isBlank()) {
+            return;
+        }
+        final String key = packageName + "#" + userId;
+        mCompatibilityTokenSuppressedUntil.remove(key);
+        mCompatibilityBootstrapTokenCompleted.remove(key);
+        mUnsupportedCompatibilityTokenPackages.remove(key);
+    }
+
+    private void rememberCompatibilityTrace(Bundle appIdentity, String operation, String event,
+            String reason, int resultCode) {
+        if (appIdentity == null) {
+            return;
+        }
+        final String packageName = appIdentity.getString(PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        final int userId = appIdentity.getInt(PushBrokerConstants.APP_IDENTITY_USER_ID,
+                UserHandle.USER_SYSTEM);
+        if (packageName == null || packageName.isBlank()) {
+            return;
+        }
+        final String key = packageName + "#" + userId;
+        Bundle traceState = mCompatibilityTraceStates.get(key);
+        if (traceState == null) {
+            traceState = new Bundle();
+            mCompatibilityTraceStates.put(key, traceState);
+        }
+        final long now = System.currentTimeMillis();
+        switch (operation) {
+            case "prepare":
+                traceState.putLong("lastPrepareAt", now);
+                traceState.putInt("lastPrepareResult", resultCode);
+                break;
+            case "revoke":
+                traceState.putLong("lastRevokeAt", now);
+                traceState.putInt("lastRevokeResult", resultCode);
+                break;
+            case "sync":
+                traceState.putLong("lastSyncAt", now);
+                traceState.putInt("lastSyncResult", resultCode);
+                if (event != null && !event.isBlank()) {
+                    traceState.putString("lastSyncEvent", event);
+                }
+                if (reason != null && !reason.isBlank()) {
+                    traceState.putString("lastSyncReason", reason);
+                }
+                break;
+            case "token":
+                traceState.putLong("lastTokenAt", now);
+                traceState.putInt("lastTokenResult", resultCode);
+                if (reason != null && !reason.isBlank()) {
+                    traceState.putString("lastTokenReason", reason);
+                }
+                break;
+            default:
+                return;
+        }
+    }
+
+    private final PushProviderConnection.Listener mConnectionListener =
+            new PushProviderConnection.Listener() {
+                @Override
+                public void onProviderConnected(String providerId) {
+                    Log.i(TAG, "Provider connected: " + providerId);
+                    cancelActiveProviderRebind();
+                    mRegistry.markProviderEnabled(providerId);
+                    mRecoveryAttemptCount = 0;
+                    mHasCompletedInitialAppSyncRound = false;
+                    resetWatchdogState();
+                    if (providerId.equals(mBoundProviderId) && mActiveConnection != null) {
+                        mActiveConnection.onBootPhase(mCurrentBootPhase);
+                        if (mConnectivityManager != null
+                                && mConnectivityManager.getActiveNetwork() != null) {
+                            notifyProviderNetworkAvailable();
+                        }
+                        enqueueKnownAppsForActiveProvider(providerId);
+                        maybeScheduleColdStartDiscovery(providerId);
+                        startWatchdog();
+                        updatePolicyState("provider connected", mPolicyState == POLICY_ACTIVE);
+                    }
+                    notifyRegistryChanged();
+                }
+
+                @Override
+                public void onProviderDisconnected(String providerId) {
+                    Log.i(TAG, "Provider disconnected: " + providerId);
+                    mRegistry.markProviderDisconnected(providerId);
+                    final boolean wasBound = providerId.equals(mBoundProviderId);
+                    final boolean shouldRebind = wasBound
+                            && providerId.equals(mRegistry.getActiveProviderId());
+                    stopRecoveryMonitoring();
+                    mRecoveryAttemptCount = 0;
+                    mHasCompletedInitialAppSyncRound = false;
+                    clearAppSyncQueue();
+                    mNotificationConvergenceStore.clear();
+                    if (wasBound) {
+                        clearPrepareQueue();
+                        if (mActiveConnection != null) {
+                            mActiveConnection.close();
+                        }
+                        mActiveConnection = null;
+                        mBoundProviderId = null;
+                    }
+                    if (shouldRebind) {
+                        scheduleActiveProviderRebind(providerId, "provider disconnected");
+                    }
+                    notifyRegistryChanged();
+                }
+
+                @Override
+                public void onProviderFailed(String providerId, String message) {
+                    Log.w(TAG, "Provider failed: " + providerId + " reason=" + message);
+                    mRegistry.markProviderFailed(providerId, message);
+                    final boolean wasBound = providerId.equals(mBoundProviderId);
+                    final boolean shouldRebind = wasBound
+                            && providerId.equals(mRegistry.getActiveProviderId());
+                    stopRecoveryMonitoring();
+                    mRecoveryAttemptCount = 0;
+                    mHasCompletedInitialAppSyncRound = false;
+                    clearAppSyncQueue();
+                    mNotificationConvergenceStore.clear();
+                    if (wasBound) {
+                        clearPrepareQueue();
+                        if (mActiveConnection != null) {
+                            mActiveConnection.close();
+                        }
+                        mActiveConnection = null;
+                        mBoundProviderId = null;
+                    }
+                    if (shouldRebind) {
+                        scheduleActiveProviderRebind(providerId, message);
+                    }
+                    notifyRegistryChanged();
+                }
+
+                @Override
+                public void onProviderRequiresUserAction(String providerId, String reason) {
+                    Log.w(TAG, "Provider requires user action before enable: "
+                            + providerId + " reason=" + reason);
+                    final boolean wasBound = providerId.equals(mBoundProviderId);
+                    if (wasBound) {
+                        disconnectActiveProvider(false);
+                    }
+                    if (providerId.equals(mRegistry.getActiveProviderId())) {
+                        mRegistry.disableActiveProvider();
+                    }
+                    mRegistry.markProviderRequiresUserAction(providerId, reason);
+                    stopRecoveryMonitoring();
+                    clearPrepareQueue();
+                    clearAppSyncQueue();
+                    notifyRegistryChanged();
+                }
+
+                @Override
+                public void onProviderEvent(String providerId, Bundle event) {
+                    handleProviderEvent(providerId, event);
+                }
+            };
+}
