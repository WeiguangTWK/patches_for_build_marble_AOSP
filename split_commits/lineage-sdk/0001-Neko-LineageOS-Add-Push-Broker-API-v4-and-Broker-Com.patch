diff --git a/lineage/lib/main/java/org/lineageos/platform/internal/push/CompatibilityAuthorizationStore.java b/lineage/lib/main/java/org/lineageos/platform/internal/push/CompatibilityAuthorizationStore.java
new file mode 100644
index 0000000..c2d45f8
--- /dev/null
+++ b/lineage/lib/main/java/org/lineageos/platform/internal/push/CompatibilityAuthorizationStore.java
@@ -0,0 +1,200 @@
+/*
+ * SPDX-FileCopyrightText: Neko-LineageOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.platform.internal.push;
+
+import android.util.ArrayMap;
+import android.util.ArraySet;
+
+import java.util.ArrayList;
+
+final class CompatibilityAuthorizationStore {
+    private static final String VERSION_PREFIX = "v1";
+    private static final String ENTRY_DELIMITER = "\n";
+    private static final String FIELD_DELIMITER = "\t";
+    private static final String PROFILE_DELIMITER = ",";
+
+    ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> parse(String rawValue) {
+        final ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> result =
+                new ArrayMap<>();
+        if (rawValue == null || rawValue.isBlank()) {
+            return result;
+        }
+
+        final String[] entries = rawValue.split(ENTRY_DELIMITER);
+        int startIndex = 0;
+        if (entries.length > 0 && VERSION_PREFIX.equals(entries[0])) {
+            startIndex = 1;
+        }
+        for (int i = startIndex; i < entries.length; i++) {
+            final String entry = entries[i];
+            if (entry == null || entry.isBlank()) {
+                continue;
+            }
+            final String[] fields = entry.split(FIELD_DELIMITER, 4);
+            if (fields.length != 4) {
+                continue;
+            }
+            final String providerId = fields[0];
+            final Integer userId = tryParseInt(fields[1]);
+            final String packageName = fields[2];
+            if (providerId.isBlank() || userId == null || packageName.isBlank()) {
+                continue;
+            }
+            final ArraySet<String> valueIds = parseValueIds(fields[3]);
+            put(result, providerId, userId, packageName, valueIds);
+        }
+        return result;
+    }
+
+    String serialize(ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> state) {
+        final StringBuilder builder = new StringBuilder(VERSION_PREFIX);
+        if (state == null || state.isEmpty()) {
+            return builder.toString();
+        }
+
+        for (int providerIndex = 0; providerIndex < state.size(); providerIndex++) {
+            final String providerId = state.keyAt(providerIndex);
+            final ArrayMap<Integer, ArrayMap<String, ArraySet<String>>> perUser =
+                    state.valueAt(providerIndex);
+            if (providerId == null || providerId.isBlank() || perUser == null || perUser.isEmpty()) {
+                continue;
+            }
+            for (int userIndex = 0; userIndex < perUser.size(); userIndex++) {
+                final Integer userId = perUser.keyAt(userIndex);
+                final ArrayMap<String, ArraySet<String>> perPackage = perUser.valueAt(userIndex);
+                if (userId == null || perPackage == null || perPackage.isEmpty()) {
+                    continue;
+                }
+                for (int packageIndex = 0; packageIndex < perPackage.size(); packageIndex++) {
+                    final String packageName = perPackage.keyAt(packageIndex);
+                    if (packageName == null || packageName.isBlank()) {
+                        continue;
+                    }
+                    final ArraySet<String> valueIds = perPackage.valueAt(packageIndex);
+                    builder.append(ENTRY_DELIMITER)
+                            .append(providerId)
+                            .append(FIELD_DELIMITER)
+                            .append(userId)
+                            .append(FIELD_DELIMITER)
+                            .append(packageName)
+                            .append(FIELD_DELIMITER)
+                            .append(serializeValueIds(valueIds));
+                }
+            }
+        }
+
+        return builder.toString();
+    }
+
+    ArraySet<String> getProfiles(
+            ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> state,
+            String providerId, int userId, String packageName) {
+        return getValues(state, providerId, userId, packageName);
+    }
+
+    ArraySet<String> getValues(
+            ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> state,
+            String providerId, int userId, String packageName) {
+        final ArrayMap<Integer, ArrayMap<String, ArraySet<String>>> perUser = state.get(providerId);
+        if (perUser == null) {
+            return new ArraySet<>();
+        }
+        final ArrayMap<String, ArraySet<String>> perPackage = perUser.get(userId);
+        if (perPackage == null) {
+            return new ArraySet<>();
+        }
+        final ArraySet<String> profileIds = perPackage.get(packageName);
+        return profileIds == null ? new ArraySet<>() : new ArraySet<>(profileIds);
+    }
+
+    void setProfiles(ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> state,
+            String providerId, int userId, String packageName, ArraySet<String> profileIds) {
+        setValues(state, providerId, userId, packageName, profileIds);
+    }
+
+    void setValues(ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> state,
+            String providerId, int userId, String packageName, ArraySet<String> valueIds) {
+        put(state, providerId, userId, packageName,
+                valueIds == null ? new ArraySet<>() : new ArraySet<>(valueIds));
+    }
+
+    boolean clearProfiles(
+            ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> state,
+            String providerId, int userId, String packageName) {
+        return clearValues(state, providerId, userId, packageName);
+    }
+
+    boolean clearValues(
+            ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> state,
+            String providerId, int userId, String packageName) {
+        final ArrayMap<Integer, ArrayMap<String, ArraySet<String>>> perUser = state.get(providerId);
+        if (perUser == null) {
+            return false;
+        }
+        final ArrayMap<String, ArraySet<String>> perPackage = perUser.get(userId);
+        if (perPackage == null || perPackage.remove(packageName) == null) {
+            return false;
+        }
+        if (perPackage.isEmpty()) {
+            perUser.remove(userId);
+        }
+        if (perUser.isEmpty()) {
+            state.remove(providerId);
+        }
+        return true;
+    }
+
+    private void put(ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> state,
+            String providerId, int userId, String packageName, ArraySet<String> profileIds) {
+        ArrayMap<Integer, ArrayMap<String, ArraySet<String>>> perUser = state.get(providerId);
+        if (perUser == null) {
+            perUser = new ArrayMap<>();
+            state.put(providerId, perUser);
+        }
+        ArrayMap<String, ArraySet<String>> perPackage = perUser.get(userId);
+        if (perPackage == null) {
+            perPackage = new ArrayMap<>();
+            perUser.put(userId, perPackage);
+        }
+        perPackage.put(packageName, profileIds == null ? new ArraySet<>() : profileIds);
+    }
+
+    private ArraySet<String> parseValueIds(String rawValues) {
+        final ArraySet<String> result = new ArraySet<>();
+        if (rawValues == null || rawValues.isBlank()) {
+            return result;
+        }
+        final String[] parts = rawValues.split(PROFILE_DELIMITER);
+        for (String part : parts) {
+            if (part != null && !part.isBlank()) {
+                result.add(part);
+            }
+        }
+        return result;
+    }
+
+    private String serializeValueIds(ArraySet<String> valueIds) {
+        if (valueIds == null || valueIds.isEmpty()) {
+            return "";
+        }
+        final ArrayList<String> parts = new ArrayList<>(valueIds.size());
+        for (int i = 0; i < valueIds.size(); i++) {
+            final String valueId = valueIds.valueAt(i);
+            if (valueId != null && !valueId.isBlank()) {
+                parts.add(valueId);
+            }
+        }
+        return String.join(PROFILE_DELIMITER, parts);
+    }
+
+    private Integer tryParseInt(String rawValue) {
+        try {
+            return Integer.parseInt(rawValue);
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+}
