+/*
+ * SPDX-FileCopyrightText: Neko-LineageOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.platform.internal.push;
+
+import android.util.ArraySet;
+
+import lineageos.push.PushProviderInfo;
+
+final class CompatibilityCapabilityPolicy {
+    private final CompatibilityCapabilityRegistry mCapabilityRegistry;
+
+    CompatibilityCapabilityPolicy(CompatibilityCapabilityRegistry capabilityRegistry) {
+        mCapabilityRegistry = capabilityRegistry;
+    }
+
+    ArraySet<String> getRequestedCapabilities(PushProviderInfo providerInfo,
+            ArraySet<String> enabledProfiles) {
+        final ArraySet<String> requested = new ArraySet<>();
+        if (providerInfo == null || enabledProfiles == null || enabledProfiles.isEmpty()) {
+            return requested;
+        }
+        addAll(requested, providerInfo.mandatoryCompatibilityCapabilities);
+        addAll(requested, providerInfo.optionalCompatibilityCapabilities);
+        return requested;
+    }
+
+    ArraySet<String> sanitizeEnabledCapabilities(PushProviderInfo providerInfo,
+            ArraySet<String> enabledProfiles, ArraySet<String> enabledCapabilities) {
+        final ArraySet<String> sanitized = new ArraySet<>();
+        if (enabledCapabilities == null || enabledCapabilities.isEmpty()) {
+            return sanitized;
+        }
+        final ArraySet<String> requested = getRequestedCapabilities(providerInfo, enabledProfiles);
+        if (requested.isEmpty()) {
+            return sanitized;
+        }
+        for (int i = 0; i < enabledCapabilities.size(); i++) {
+            final String capabilityId = enabledCapabilities.valueAt(i);
+            if (capabilityId != null && requested.contains(capabilityId)) {
+                sanitized.add(capabilityId);
+            }
+        }
+        return sanitized;
+    }
+
+    ArraySet<String> getAvailableCapabilities(ArraySet<String> requestedCapabilities) {
+        final ArraySet<String> available = new ArraySet<>();
+        if (requestedCapabilities == null || requestedCapabilities.isEmpty()) {
+            return available;
+        }
+        for (int i = 0; i < requestedCapabilities.size(); i++) {
+            final String capabilityId = requestedCapabilities.valueAt(i);
+            if (mCapabilityRegistry.isCapabilityAvailable(capabilityId)) {
+                available.add(capabilityId);
+            }
+        }
+        return available;
+    }
+
+    ArraySet<String> getEffectiveCapabilities(PushProviderInfo providerInfo,
+            ArraySet<String> enabledProfiles, ArraySet<String> enabledCapabilities) {
+        final ArraySet<String> effective = new ArraySet<>();
+        if (enabledProfiles == null || enabledProfiles.isEmpty()) {
+            return effective;
+        }
+        final ArraySet<String> requested = getRequestedCapabilities(providerInfo, enabledProfiles);
+        final ArraySet<String> available = getAvailableCapabilities(requested);
+        final ArraySet<String> sanitizedEnabled = sanitizeEnabledCapabilities(providerInfo,
+                enabledProfiles, enabledCapabilities);
+        for (int i = 0; i < sanitizedEnabled.size(); i++) {
+            final String capabilityId = sanitizedEnabled.valueAt(i);
+            if (available.contains(capabilityId)) {
+                effective.add(capabilityId);
+            }
+        }
+        return effective;
+    }
+
+    private static void addAll(ArraySet<String> out, String[] values) {
+        if (out == null || values == null) {
+            return;
+        }
+        for (String value : values) {
+            if (value != null && !value.isBlank()) {
+                out.add(value);
+            }
+        }
+    }
+}
