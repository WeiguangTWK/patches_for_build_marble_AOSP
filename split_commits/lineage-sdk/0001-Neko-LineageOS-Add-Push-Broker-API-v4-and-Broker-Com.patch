+/*
+ * SPDX-FileCopyrightText: Neko-LineageOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.platform.internal.push;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.provider.Settings;
+import android.util.ArrayMap;
+import android.util.ArraySet;
+import android.util.Log;
+
+final class PushBrokerStore {
+    private static final String TAG = "PushBrokerStore";
+    private static final String KEY_ACTIVE_PROVIDER_ID =
+            "lineage_push_broker_active_provider_id";
+    private static final String KEY_KNOWN_PACKAGES =
+            "lineage_push_broker_known_packages";
+    private static final String KEY_DISCOVERY_PROVIDERS =
+            "lineage_push_broker_discovery_providers";
+    private static final String KEY_COMPATIBILITY_PROFILES =
+            "lineage_push_broker_compat_profiles";
+    private static final String KEY_COMPATIBILITY_CAPABILITIES =
+            "lineage_push_broker_compat_capabilities";
+    private static final String PACKAGE_DELIMITER = "\n";
+
+    private final ContentResolver mContentResolver;
+    private final CompatibilityAuthorizationStore mCompatibilityAuthorizationStore;
+
+    PushBrokerStore(Context context) {
+        mContentResolver = context.getContentResolver();
+        mCompatibilityAuthorizationStore = new CompatibilityAuthorizationStore();
+    }
+
+    synchronized String getActiveProviderId() {
+        final String providerId = Settings.Global.getString(
+                mContentResolver, KEY_ACTIVE_PROVIDER_ID);
+        Log.i(TAG, "Read active provider id: " + providerId);
+        return providerId;
+    }
+
+    synchronized void setActiveProviderId(String providerId) {
+        if (providerId == null || providerId.isBlank()) {
+            clearActiveProviderId();
+            return;
+        }
+
+        final boolean stored = Settings.Global.putString(
+                mContentResolver, KEY_ACTIVE_PROVIDER_ID, providerId);
+        if (stored) {
+            Log.i(TAG, "Persisted active provider id: " + providerId);
+        } else {
+            Log.w(TAG, "Failed to persist active provider id: " + providerId);
+        }
+    }
+
+    synchronized void clearActiveProviderId() {
+        final boolean cleared = Settings.Global.putString(
+                mContentResolver, KEY_ACTIVE_PROVIDER_ID, null);
+        if (cleared) {
+            Log.i(TAG, "Clearing active provider id");
+        } else {
+            Log.w(TAG, "Failed to clear active provider id");
+        }
+    }
+
+    synchronized ArraySet<String> getKnownPackages() {
+        final ArraySet<String> packages = new ArraySet<>();
+        final String rawValue = Settings.Global.getString(mContentResolver, KEY_KNOWN_PACKAGES);
+        if (rawValue == null || rawValue.isBlank()) {
+            Log.i(TAG, "Read known packages: 0");
+            return packages;
+        }
+
+        final String[] entries = rawValue.split(PACKAGE_DELIMITER);
+        for (String entry : entries) {
+            if (entry != null && !entry.isBlank()) {
+                packages.add(entry);
+            }
+        }
+        Log.i(TAG, "Read known packages: " + packages.size());
+        return packages;
+    }
+
+    synchronized void setKnownPackages(ArraySet<String> packages) {
+        final StringBuilder rawValue = new StringBuilder();
+        if (packages != null) {
+            for (int i = 0; i < packages.size(); i++) {
+                final String packageName = packages.valueAt(i);
+                if (packageName == null || packageName.isBlank()) {
+                    continue;
+                }
+                if (rawValue.length() > 0) {
+                    rawValue.append(PACKAGE_DELIMITER);
+                }
+                rawValue.append(packageName);
+            }
+        }
+
+        final boolean stored = Settings.Global.putString(mContentResolver, KEY_KNOWN_PACKAGES,
+                rawValue.length() == 0 ? null : rawValue.toString());
+        if (stored) {
+            Log.i(TAG, "Persisted known packages: " + (packages == null ? 0 : packages.size()));
+        } else {
+            Log.w(TAG, "Failed to persist known packages");
+        }
+    }
+
+    synchronized ArraySet<String> getDiscoveredProviders() {
+        return readStringSet(KEY_DISCOVERY_PROVIDERS);
+    }
+
+    synchronized boolean isAvoidDuplicatePushEnabled() {
+        return Settings.Global.getInt(mContentResolver,
+                lineageos.push.PushBrokerConstants.SETTING_AVOID_DUPLICATE_PUSH, 0) == 1;
+    }
+
+    synchronized String getCompatibilitySignatureSpoofPolicy() {
+        return Settings.Global.getString(mContentResolver,
+                lineageos.push.PushBrokerConstants.SETTING_COMPAT_SIGNATURE_SPOOF_POLICY);
+    }
+
+    synchronized void setCompatibilitySignatureSpoofPolicy(String rawPolicy) {
+        final boolean stored = Settings.Global.putString(mContentResolver,
+                lineageos.push.PushBrokerConstants.SETTING_COMPAT_SIGNATURE_SPOOF_POLICY,
+                rawPolicy == null || rawPolicy.isBlank() ? null : rawPolicy);
+        if (stored) {
+            Log.i(TAG, "Persisted compatibility signature spoof policy");
+        } else {
+            Log.w(TAG, "Failed to persist compatibility signature spoof policy");
+        }
+    }
+
+    synchronized void clearCompatibilitySignatureSpoofPolicy() {
+        final boolean cleared = Settings.Global.putString(mContentResolver,
+                lineageos.push.PushBrokerConstants.SETTING_COMPAT_SIGNATURE_SPOOF_POLICY, null);
+        if (cleared) {
+            Log.i(TAG, "Cleared compatibility signature spoof policy");
+        } else {
+            Log.w(TAG, "Failed to clear compatibility signature spoof policy");
+        }
+    }
+
+    synchronized boolean hasCompletedInitialDiscovery(String providerId) {
+        if (providerId == null || providerId.isBlank()) {
+            return false;
+        }
+        return getDiscoveredProviders().contains(providerId);
+    }
+
+    synchronized void markInitialDiscoveryComplete(String providerId) {
+        if (providerId == null || providerId.isBlank()) {
+            return;
+        }
+        final ArraySet<String> providers = getDiscoveredProviders();
+        if (providers.add(providerId)) {
+            writeStringSet(KEY_DISCOVERY_PROVIDERS, providers, "discovery providers");
+        }
+    }
+
+    synchronized ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>>
+            getAllCompatibilityProfiles() {
+        final String rawValue = Settings.Global.getString(mContentResolver,
+                KEY_COMPATIBILITY_PROFILES);
+        final ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> profiles =
+                mCompatibilityAuthorizationStore.parse(rawValue);
+        Log.i(TAG, "Read compatibility profile providers: " + profiles.size());
+        return profiles;
+    }
+
+    synchronized ArraySet<String> getCompatibilityProfiles(
+            String providerId, int userId, String packageName) {
+        if (providerId == null || providerId.isBlank()
+                || packageName == null || packageName.isBlank()) {
+            return new ArraySet<>();
+        }
+        return mCompatibilityAuthorizationStore.getProfiles(getAllCompatibilityProfiles(),
+                providerId, userId, packageName);
+    }
+
+    synchronized void setCompatibilityProfiles(String providerId, int userId, String packageName,
+            ArraySet<String> profileIds) {
+        if (providerId == null || providerId.isBlank()
+                || packageName == null || packageName.isBlank()) {
+            Log.w(TAG, "Ignoring invalid compatibility profile write");
+            return;
+        }
+        final ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> profiles =
+                getAllCompatibilityProfiles();
+        mCompatibilityAuthorizationStore.setProfiles(profiles, providerId, userId, packageName,
+                profileIds);
+        persistCompatibilityProfiles(profiles);
+    }
+
+    synchronized boolean clearCompatibilityProfiles(
+            String providerId, int userId, String packageName) {
+        if (providerId == null || providerId.isBlank()
+                || packageName == null || packageName.isBlank()) {
+            return false;
+        }
+        final ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> profiles =
+                getAllCompatibilityProfiles();
+        final boolean changed = mCompatibilityAuthorizationStore.clearProfiles(profiles,
+                providerId, userId, packageName);
+        if (changed) {
+            persistCompatibilityProfiles(profiles);
+        }
+        return changed;
+    }
+
+    synchronized ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>>
+            getAllCompatibilityCapabilities() {
+        final String rawValue = Settings.Global.getString(mContentResolver,
+                KEY_COMPATIBILITY_CAPABILITIES);
+        final ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> capabilities =
+                mCompatibilityAuthorizationStore.parse(rawValue);
+        Log.i(TAG, "Read compatibility capability providers: " + capabilities.size());
+        return capabilities;
+    }
+
+    synchronized ArraySet<String> getCompatibilityCapabilities(
+            String providerId, int userId, String packageName) {
+        if (providerId == null || providerId.isBlank()
+                || packageName == null || packageName.isBlank()) {
+            return new ArraySet<>();
+        }
+        return mCompatibilityAuthorizationStore.getValues(getAllCompatibilityCapabilities(),
+                providerId, userId, packageName);
+    }
+
+    synchronized void setCompatibilityCapabilities(String providerId, int userId,
+            String packageName, ArraySet<String> capabilityIds) {
+        if (providerId == null || providerId.isBlank()
+                || packageName == null || packageName.isBlank()) {
+            Log.w(TAG, "Ignoring invalid compatibility capability write");
+            return;
+        }
+        final ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> capabilities =
+                getAllCompatibilityCapabilities();
+        mCompatibilityAuthorizationStore.setValues(capabilities, providerId, userId, packageName,
+                capabilityIds);
+        persistCompatibilityCapabilities(capabilities);
+    }
+
+    synchronized boolean clearCompatibilityCapabilities(
+            String providerId, int userId, String packageName) {
+        if (providerId == null || providerId.isBlank()
+                || packageName == null || packageName.isBlank()) {
+            return false;
+        }
+        final ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> capabilities =
+                getAllCompatibilityCapabilities();
+        final boolean changed = mCompatibilityAuthorizationStore.clearValues(capabilities,
+                providerId, userId, packageName);
+        if (changed) {
+            persistCompatibilityCapabilities(capabilities);
+        }
+        return changed;
+    }
+
+    private ArraySet<String> readStringSet(String key) {
+        final ArraySet<String> values = new ArraySet<>();
+        final String rawValue = Settings.Global.getString(mContentResolver, key);
+        if (rawValue == null || rawValue.isBlank()) {
+            return values;
+        }
+
+        final String[] entries = rawValue.split(PACKAGE_DELIMITER);
+        for (String entry : entries) {
+            if (entry != null && !entry.isBlank()) {
+                values.add(entry);
+            }
+        }
+        return values;
+    }
+
+    private void writeStringSet(String key, ArraySet<String> values, String label) {
+        final StringBuilder rawValue = new StringBuilder();
+        if (values != null) {
+            for (int i = 0; i < values.size(); i++) {
+                final String value = values.valueAt(i);
+                if (value == null || value.isBlank()) {
+                    continue;
+                }
+                if (rawValue.length() > 0) {
+                    rawValue.append(PACKAGE_DELIMITER);
+                }
+                rawValue.append(value);
+            }
+        }
+
+        final boolean stored = Settings.Global.putString(mContentResolver, key,
+                rawValue.length() == 0 ? null : rawValue.toString());
+        if (stored) {
+            Log.i(TAG, "Persisted " + label + ": " + (values == null ? 0 : values.size()));
+        } else {
+            Log.w(TAG, "Failed to persist " + label);
+        }
+    }
+
+    private void persistCompatibilityProfiles(
+            ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> profiles) {
+        final String rawValue = mCompatibilityAuthorizationStore.serialize(profiles);
+        final boolean stored = Settings.Global.putString(mContentResolver,
+                KEY_COMPATIBILITY_PROFILES, rawValue);
+        if (stored) {
+            Log.i(TAG, "Persisted compatibility profile providers: "
+                    + (profiles == null ? 0 : profiles.size()));
+        } else {
+            Log.w(TAG, "Failed to persist compatibility profiles");
+        }
+    }
+
+    private void persistCompatibilityCapabilities(
+            ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> capabilities) {
+        final String rawValue = mCompatibilityAuthorizationStore.serialize(capabilities);
+        final boolean stored = Settings.Global.putString(mContentResolver,
+                KEY_COMPATIBILITY_CAPABILITIES, rawValue);
+        if (stored) {
+            Log.i(TAG, "Persisted compatibility capability providers: "
+                    + (capabilities == null ? 0 : capabilities.size()));
+        } else {
+            Log.w(TAG, "Failed to persist compatibility capabilities");
+        }
+    }
+}
