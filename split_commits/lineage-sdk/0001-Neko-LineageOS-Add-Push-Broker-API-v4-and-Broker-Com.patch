+    private boolean forwardRevokeApp(Bundle appIdentity) {
+        if (mActiveConnection == null || mBoundProviderId == null) {
+            Log.w(TAG, "Ignoring revokeApp without active provider");
+            return false;
+        }
+        final String packageName = appIdentity == null ? null
+                : appIdentity.getString(lineageos.push.PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        Log.i(TAG, "Revoking app " + packageName + " via provider " + mBoundProviderId);
+        final int result = mActiveConnection.revokeAppResult(appIdentity);
+        rememberCompatibilityResult(mLastCompatibilityRevokeResults, appIdentity, result);
+        rememberCompatibilityTrace(appIdentity, "revoke", null, null, result);
+        Log.i(TAG, "revokeApp result package=" + packageName + " provider=" + mBoundProviderId
+                + " resultCode=" + result);
+        return result == PushBrokerConstants.RESULT_OK;
+    }
+
+    private boolean forwardRequestToken(Bundle appIdentity, Bundle extras) {
+        if (mActiveConnection == null || mBoundProviderId == null) {
+            Log.w(TAG, "Ignoring requestToken without active provider");
+            return false;
+        }
+        final String packageName = appIdentity == null ? null
+                : appIdentity.getString(lineageos.push.PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+        Log.i(TAG, "Requesting token for app " + packageName + " via provider "
+                + mBoundProviderId);
+        rememberSyncCandidate(packageName);
+        final int result = mActiveConnection.requestTokenResult(appIdentity, extras);
+        rememberCompatibilityResult(mLastCompatibilityTokenResults, appIdentity, result);
+        rememberCompatibilityTrace(appIdentity, "token", null,
+                extras == null ? null
+                        : extras.getString(PushBrokerConstants.COMPAT_TOKEN_REASON), result);
+        Log.i(TAG, "requestToken result package=" + packageName + " provider=" + mBoundProviderId
+                + " resultCode=" + result);
+        return result == PushBrokerConstants.RESULT_OK;
+    }
+
+    private Bundle buildCompatibilityStateBundle(String providerId) {
+        final Bundle state = new Bundle();
+        final String resolvedProviderId = providerId == null || providerId.isBlank()
+                ? mRegistry.getActiveProviderId() : providerId;
+        state.putString("providerId", resolvedProviderId);
+        state.putString("activeProviderId", mRegistry.getActiveProviderId());
+        if (resolvedProviderId == null) {
+            state.putInt(PushBrokerConstants.DIAG_COMPAT_AUTHORIZED_APP_COUNT, 0);
+            return state;
+        }
+
+        final PushProviderState providerState = mRegistry.getProviderState(resolvedProviderId);
+        state.putString("runtimeMode", providerState.runtimeMode);
+        final ArrayMap<String, ArrayMap<Integer, ArrayMap<String, ArraySet<String>>>> allProfiles =
+                mStore.getAllCompatibilityProfiles();
+        final ArrayMap<Integer, ArrayMap<String, ArraySet<String>>> providerProfiles =
+                allProfiles.get(resolvedProviderId);
+        final List<Bundle> appStates = buildCompatibilityAuthorizedAppList(resolvedProviderId,
+                UserHandle.USER_ALL);
+        final int authorizedAppCount = countAuthorizedApps(providerProfiles);
+        state.putInt(PushBrokerConstants.DIAG_COMPAT_AUTHORIZED_APP_COUNT, authorizedAppCount);
+        state.putInt(PushBrokerConstants.DIAG_COMPAT_SUPPORTED_APP_COUNT,
+                countSupportedCompatibilityApps(appStates));
+        state.putStringArray(PushBrokerConstants.DIAG_COMPAT_CAPABILITY_STATES,
+                new CompatibilityCapabilityRegistry().getAvailableCapabilities()
+                        .toArray(new String[0]));
+        state.putParcelableArrayList(PushBrokerConstants.DIAG_COMPAT_APP_STATES,
+                new ArrayList<>(appStates));
+        return state;
+    }
+
+    private List<Bundle> buildCompatibilityAuthorizedAppList(String providerId, int userId) {
+        final ArrayList<Bundle> result = new ArrayList<>();
+        if (providerId == null || providerId.isBlank()) {
+            return result;
+        }
+        final ArrayMap<Integer, ArrayMap<String, ArraySet<String>>> perUser =
+                mStore.getAllCompatibilityProfiles().get(providerId);
+        if (perUser == null) {
+            return result;
+        }
+        for (int i = 0; i < perUser.size(); i++) {
+            final int entryUserId = perUser.keyAt(i);
+            if (userId != UserHandle.USER_ALL && entryUserId != userId) {
+                continue;
+            }
+            final ArrayMap<String, ArraySet<String>> perPackage = perUser.valueAt(i);
+            for (int j = 0; j < perPackage.size(); j++) {
+                result.add(buildCompatibilityAppState(providerId, perPackage.keyAt(j), entryUserId));
+            }
+        }
+        return result;
+    }
