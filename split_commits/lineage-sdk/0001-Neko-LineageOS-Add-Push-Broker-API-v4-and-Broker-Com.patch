+    private void handleProviderHealthChanged(String providerId, String eventName, Bundle event) {
+        if (mActiveConnection == null || !providerId.equals(mBoundProviderId)) {
+            return;
+        }
+
+        final String reportedStatus = event.getString(PushBrokerConstants.PROVIDER_EVENT_STATUS, "");
+        final long timestamp = event.getLong(PushBrokerConstants.PROVIDER_EVENT_TIMESTAMP, 0L);
+        final int reasonCode = event.getInt(PushBrokerConstants.PROVIDER_EVENT_REASON_CODE, -1);
+        final Bundle health = mActiveConnection.getHealth();
+        mLastHealthCheckAt = System.currentTimeMillis();
+        final String connectionStatus = health.getString(
+                PushBrokerConstants.HEALTH_CONNECTION_STATUS,
+                PushBrokerConstants.HEALTH_STATUS_UNKNOWN);
+        final boolean providerEnabled = health.getBoolean(
+                PushBrokerConstants.HEALTH_PROVIDER_ENABLED, true);
+        final boolean businessHealthy = health.getBoolean(
+                PushBrokerConstants.HEALTH_BUSINESS_HEALTHY, true);
+        final boolean requiresUserAction = health.getBoolean(
+                PushBrokerConstants.HEALTH_REQUIRES_USER_ACTION, false);
+        final String userActionReason = health.getString(
+                PushBrokerConstants.HEALTH_USER_ACTION_REASON, "");
+
+        Log.i(TAG, "Provider health event provider=" + providerId
+                + " event=" + eventName
+                + " reportedStatus=" + reportedStatus
+                + " healthStatus=" + connectionStatus
+                + " providerEnabled=" + providerEnabled
+                + " businessHealthy=" + businessHealthy
+                + " requiresUserAction=" + requiresUserAction
+                + " userActionReason=" + userActionReason
+                + " reasonCode=" + reasonCode
+                + " policy=" + policyStateToString(mPolicyState)
+                + " eventTimestamp=" + timestamp);
+
+        evaluateProviderHealth("provider health changed", health,
+                HEALTH_TRIGGER_PROVIDER_EVENT, true, true);
+    }
+
+    private void evaluateProviderHealth(String reason, Bundle health, int trigger,
+            boolean recoverIfDisconnected, boolean eventDriven) {
+        if (health == null || mBoundProviderId == null || mActiveConnection == null) {
+            return;
+        }
+
+        final long now = System.currentTimeMillis();
+        final String connectionStatus = health.getString(
+                PushBrokerConstants.HEALTH_CONNECTION_STATUS,
+                PushBrokerConstants.HEALTH_STATUS_UNKNOWN);
+        final boolean providerEnabled = health.getBoolean(
+                PushBrokerConstants.HEALTH_PROVIDER_ENABLED, true);
+        final boolean businessHealthy = health.getBoolean(
+                PushBrokerConstants.HEALTH_BUSINESS_HEALTHY, true);
+        final String degradedReason = health.getString(
+                PushBrokerConstants.HEALTH_BUSINESS_DEGRADED_REASON,
+                PushBrokerConstants.HEALTH_DEGRADED_REASON_UNKNOWN);
+        final boolean requiresUserAction = health.getBoolean(
+                PushBrokerConstants.HEALTH_REQUIRES_USER_ACTION, false);
+        final String userActionReason = health.getString(
+                PushBrokerConstants.HEALTH_USER_ACTION_REASON,
+                PushBrokerConstants.HEALTH_DEGRADED_REASON_UNKNOWN);
+
+        Log.i(TAG, "Health decision provider=" + mBoundProviderId
+                + " trigger=" + healthTriggerToString(trigger)
+                + " status=" + connectionStatus
+                + " providerEnabled=" + providerEnabled
+                + " businessHealthy=" + businessHealthy
+                + " degradedReason=" + degradedReason
+                + " requiresUserAction=" + requiresUserAction
+                + " userActionReason=" + userActionReason
+                + " recoverIfDisconnected=" + recoverIfDisconnected
+                + " policy=" + policyStateToString(mPolicyState)
+                + " reason=" + reason);
+
+        mRegistry.updateProviderHealth(mBoundProviderId, health);
+        if (requiresUserAction) {
+            mProviderRecoverInFlight = false;
+            clearAppSyncQueue();
+            stopRecoveryMonitoring();
+            Log.w(TAG, "Provider requires user action; skip recover provider="
+                    + mBoundProviderId + " userActionReason=" + userActionReason
+                    + " reason=" + reason);
+            notifyRegistryChanged();
+            return;
+        }
+
+        if (!providerEnabled) {
+            mProviderRecoverInFlight = false;
+            clearAppSyncQueue();
+            Log.w(TAG, "Provider health reports disabled while active provider="
+                    + mBoundProviderId + " reason=" + reason);
+            return;
+        }
+
+        if (PushBrokerConstants.HEALTH_STATUS_CONNECTED.equals(connectionStatus)) {
+            if (!businessHealthy) {
+                handleBusinessDegradedHealth(reason, degradedReason, trigger);
+                return;
+            }
+            mRecoveryAttemptCount = 0;
+            mProviderRecoverInFlight = false;
+            resetWatchdogState();
+            scheduleWatchdogLocked(mWatchdogIntervalMillis);
+            clearAppSyncBackoffsForResult(PushBrokerConstants.RESULT_NOT_READY);
+            if (!mHasCompletedInitialAppSyncRound) {
+                mHasCompletedInitialAppSyncRound = true;
+                enqueueCandidateAppsForSyncRound("provider connected");
+            }
+            return;
+        }
+
+        if (PushBrokerConstants.HEALTH_STATUS_CONNECTING.equals(connectionStatus)) {
+            Log.i(TAG, "Provider health is already connecting; skip extra recover provider="
+                    + mBoundProviderId + " recoverInFlight=" + mProviderRecoverInFlight
+                    + " trigger=" + healthTriggerToString(trigger));
+            if (trigger == HEALTH_TRIGGER_WATCHDOG) {
+                scheduleWatchdogLocked(mWatchdogIntervalMillis);
+            } else {
+                scheduleRecoveryHealthCheck(ACTIVE_RECOVERY_RECHECK_DELAY_MILLIS,
+                        "provider connecting");
+            }
+            return;
+        }
+
+        if (mPolicyState == POLICY_DORMANT) {
+            Log.i(TAG, "Ignoring provider health decision in DORMANT policy state provider="
+                    + mBoundProviderId + " status=" + connectionStatus);
+            if (trigger == HEALTH_TRIGGER_WATCHDOG) {
+                scheduleWatchdogLocked(mWatchdogIntervalMillis);
+            }
+            return;
+        }
+
+        final boolean networkAvailable = mConnectivityManager != null
+                && mConnectivityManager.getActiveNetwork() != null;
+        if (!networkAvailable) {
+            Log.i(TAG, "Provider health decision waiting for network provider=" + mBoundProviderId
+                    + " status=" + connectionStatus);
+            if (trigger == HEALTH_TRIGGER_WATCHDOG) {
+                scheduleWatchdogLocked(mWatchdogIntervalMillis);
+            }
+            return;
+        }
+
+        if (PushBrokerConstants.HEALTH_STATUS_UNKNOWN.equals(connectionStatus)) {
+            Log.i(TAG, "Provider health unknown; scheduling recheck provider="
+                    + mBoundProviderId + " trigger=" + healthTriggerToString(trigger)
+                    + " reason=" + reason);
+            if (trigger == HEALTH_TRIGGER_WATCHDOG) {
+                scheduleWatchdogLocked(mWatchdogIntervalMillis);
+            } else {
+                scheduleRecoveryHealthCheck(ACTIVE_RECOVERY_RECHECK_DELAY_MILLIS,
+                        "provider health unknown");
+            }
+            return;
+        }
+
+        if (trigger == HEALTH_TRIGGER_WATCHDOG) {
+            evaluateWatchdogDisconnectedHealth(reason, health, connectionStatus, now);
+            return;
+        }
+
+        if (trigger == HEALTH_TRIGGER_RECOVERY_CHECK) {
+            evaluateRecoveryCheckHealth(reason, connectionStatus);
+            return;
+        }
+
+        if (!recoverIfDisconnected) {
+            return;
+        }
+
+        if (mProviderRecoverInFlight) {
+            if (clearTimedOutRecoverInFlight("provider health decision")) {
+                if (mPolicyState == POLICY_ACTIVE) {
+                    if (dispatchRecoverConnectionEvent(reason, eventDriven)) {
+                        mRecoveryAttemptCount++;
+                        scheduleRecoveryHealthCheck(ACTIVE_RECOVERY_RECHECK_DELAY_MILLIS, reason);
+                    }
+                } else {
+                    scheduleRecoveryHealthCheck(STANDBY_EVENT_RECOVERY_DELAY_MILLIS,
+                            "standby provider disconnected");
+                }
+                return;
+            }
+            Log.i(TAG, "Provider health decision skipped because recover is already in flight provider="
+                    + mBoundProviderId + " status=" + connectionStatus);
+            scheduleRecoveryHealthCheck(ACTIVE_RECOVERY_RECHECK_DELAY_MILLIS,
+                    "provider disconnected while recover in flight");
+            return;
+        }
+
+        if (mPolicyState == POLICY_ACTIVE) {
+            Log.i(TAG, "ACTIVE provider health decision requesting recover provider="
+                    + mBoundProviderId + " status=" + connectionStatus);
+            if (dispatchRecoverConnectionEvent(reason, eventDriven)) {
+                mRecoveryAttemptCount++;
+                scheduleRecoveryHealthCheck(ACTIVE_RECOVERY_RECHECK_DELAY_MILLIS, reason);
+            }
+            return;
+        }
+
+        if (now - mLastEventDrivenRecoveryAt < STANDBY_EVENT_RECOVERY_MIN_INTERVAL_MILLIS) {
+            Log.i(TAG, "STANDBY provider health decision throttled provider=" + mBoundProviderId
+                    + " status=" + connectionStatus + " sinceLastRecoverMillis="
+                    + (now - mLastEventDrivenRecoveryAt));
+            return;
+        }
+
+        Log.i(TAG, "STANDBY provider health decision scheduling delayed recoverConnection provider="
+                + mBoundProviderId + " status=" + connectionStatus + " delayMillis="
+                + STANDBY_EVENT_RECOVERY_DELAY_MILLIS);
+        scheduleRecoveryHealthCheck(STANDBY_EVENT_RECOVERY_DELAY_MILLIS,
+                "standby provider disconnected");
+    }
+
+    private void handleBusinessDegradedHealth(String reason, String degradedReason, int trigger) {
+        mProviderRecoverInFlight = false;
+        clearAppSyncBackoffsForResult(PushBrokerConstants.RESULT_NOT_READY);
+        Log.i(TAG, "Provider business health degraded provider=" + mBoundProviderId
+                + " degradedReason=" + degradedReason
+                + " trigger=" + healthTriggerToString(trigger)
+                + " reason=" + reason);
+        if (mPolicyState != POLICY_DORMANT && trigger != HEALTH_TRIGGER_WATCHDOG) {
+            scheduleRecoveryHealthCheck(BUSINESS_DEGRADED_RECHECK_DELAY_MILLIS,
+                    "provider business degraded");
+        }
+        scheduleWatchdogLocked(mWatchdogIntervalMillis);
+    }
+
+    private boolean clearTimedOutRecoverInFlight(String reason) {
+        if (!mProviderRecoverInFlight) {
+            return false;
+        }
+        final long now = System.currentTimeMillis();
+        final long inFlightMillis = now - mLastProviderRecoverStartedAt;
+        if (inFlightMillis < PROVIDER_RECOVER_IN_FLIGHT_TIMEOUT_MILLIS) {
+            return false;
+        }
+        mProviderRecoverInFlight = false;
+        mRecoveryAttemptCount++;
+        Log.w(TAG, "Provider recover in-flight timed out provider=" + mBoundProviderId
+                + " reason=" + reason
+                + " inFlightMillis=" + inFlightMillis
+                + " attempts=" + mRecoveryAttemptCount);
+        return true;
+    }
+
+    private void evaluateRecoveryCheckHealth(String reason, String connectionStatus) {
+        Log.i(TAG, "Recovery health check provider=" + mBoundProviderId
+                + " status=" + connectionStatus
+                + " attempts=" + mRecoveryAttemptCount
+                + " reason=" + reason);
+
+        if (!PushBrokerConstants.HEALTH_STATUS_DISCONNECTED.equals(connectionStatus)) {
+            return;
+        }
+
+        if (mProviderRecoverInFlight) {
+            if (clearTimedOutRecoverInFlight(reason)) {
+                scheduleRecoveryHealthCheck(NETWORK_RECOVERY_RECHECK_DELAY_MILLIS, reason);
+                return;
+            }
+            Log.i(TAG, "Recovery health check waiting because provider recover is already in flight");
+            scheduleRecoveryHealthCheck(NETWORK_RECOVERY_RECHECK_DELAY_MILLIS, reason);
+            return;
+        }
+
+        if (dispatchRecoverConnectionEvent(reason, false)) {
+            mRecoveryAttemptCount++;
+
+            if (mRecoveryAttemptCount < 2) {
+                scheduleRecoveryHealthCheck(NETWORK_RECOVERY_RECHECK_DELAY_MILLIS, reason);
+            }
+        }
+    }
+
+    private void evaluateWatchdogDisconnectedHealth(String reason, Bundle health,
+            String connectionStatus, long now) {
+        Log.i(TAG, "Watchdog health check provider=" + mBoundProviderId
+                + " status=" + connectionStatus
+                + " disconnectedChecks=" + mConsecutiveDisconnectedChecks
+                + " intervalMillis=" + mWatchdogIntervalMillis);
+
+        if (!PushBrokerConstants.HEALTH_STATUS_DISCONNECTED.equals(connectionStatus)) {
+            scheduleWatchdogLocked(mWatchdogIntervalMillis);
+            return;
+        }
+
+        mConsecutiveDisconnectedChecks++;
+
+        final long lastDisconnectedAt = health.getLong(
+                PushBrokerConstants.HEALTH_LAST_DISCONNECTED_AT, 0L);
+        final long lastRecoverAttemptAt = health.getLong(
+                PushBrokerConstants.HEALTH_LAST_RECOVER_ATTEMPT_AT, 0L);
+        final boolean disconnectedLongEnough = lastDisconnectedAt > 0L
+                && now - lastDisconnectedAt >= DISCONNECTED_GRACE_PERIOD_MILLIS;
+        final boolean recoveredSinceDisconnect = lastRecoverAttemptAt > 0L
+                && lastRecoverAttemptAt >= lastDisconnectedAt;
+
+        if (!disconnectedLongEnough) {
+            scheduleWatchdogLocked(mWatchdogIntervalMillis);
+            return;
+        }
+
+        if (!recoveredSinceDisconnect) {
+            Log.i(TAG, "Watchdog issuing first recover request for provider "
+                    + mBoundProviderId);
+            dispatchRecoverConnectionEvent("watchdog first disconnected check", false);
+            scheduleWatchdogLocked(mWatchdogIntervalMillis);
+            return;
+        }
+
+        mWatchdogIntervalMillis = nextWatchdogBackoff(mWatchdogIntervalMillis);
+        Log.i(TAG, "Watchdog observed recover failure for provider " + mBoundProviderId
+                + " nextIntervalMillis=" + mWatchdogIntervalMillis);
+        dispatchRecoverConnectionEvent("watchdog backoff retry", false);
+        scheduleWatchdogLocked(mWatchdogIntervalMillis);
+    }
+
+    private String healthTriggerToString(int trigger) {
+        switch (trigger) {
+            case HEALTH_TRIGGER_IMMEDIATE:
+                return "immediate";
+            case HEALTH_TRIGGER_PROVIDER_EVENT:
+                return "provider_event";
+            case HEALTH_TRIGGER_RECOVERY_CHECK:
+                return "recovery_check";
+            case HEALTH_TRIGGER_WATCHDOG:
+                return "watchdog";
+            default:
+                return "unknown";
+        }
+    }
+
+    private void handleProviderRecoverStarted(String providerId, Bundle event) {
+        mProviderRecoverInFlight = true;
+        mLastProviderRecoverStartedAt = event.getLong(
+                PushBrokerConstants.PROVIDER_EVENT_TIMESTAMP, System.currentTimeMillis());
+        final String reasonName = event.getString(PushBrokerConstants.PROVIDER_EVENT_REASON_NAME, "");
+        Log.i(TAG, "Provider recover started provider=" + providerId
+                + " reason=" + reasonName
+                + " policy=" + policyStateToString(mPolicyState));
+        scheduleRecoveryHealthCheck(ACTIVE_RECOVERY_RECHECK_DELAY_MILLIS,
+                "provider recover started");
+    }
+
+    private void handleProviderRecoverSucceeded(String providerId, Bundle event) {
+        mProviderRecoverInFlight = false;
+        mRecoveryAttemptCount = 0;
+        mLastEventDrivenRecoveryAt = System.currentTimeMillis();
+        resetWatchdogState();
+        scheduleWatchdogLocked(mWatchdogIntervalMillis);
+        clearAppSyncBackoffsForResult(PushBrokerConstants.RESULT_NOT_READY);
+        maybeEnqueueRecoverAppSyncRound(providerId);
+        Log.i(TAG, "Provider recover succeeded provider=" + providerId
+                + " startedAt=" + mLastProviderRecoverStartedAt
+                + " eventTimestamp=" + event.getLong(PushBrokerConstants.PROVIDER_EVENT_TIMESTAMP, 0L));
+    }
+
+    private void maybeEnqueueRecoverAppSyncRound(String providerId) {
+        if (mPolicyState == POLICY_DORMANT) {
+            return;
+        }
+        final long minIntervalMillis = mPolicyState == POLICY_ACTIVE
+                ? ACTIVE_APP_SYNC_RECOVER_ROUND_MIN_INTERVAL_MILLIS
+                : STANDBY_APP_SYNC_RECOVER_ROUND_MIN_INTERVAL_MILLIS;
+        final long now = System.currentTimeMillis();
+        if (now - mLastRecoverAppSyncRoundAt >= minIntervalMillis) {
+            mLastRecoverAppSyncRoundAt = now;
+            enqueueCandidateAppsForSyncRound("provider recover succeeded");
+            return;
+        }
+        Log.i(TAG, "Skipping recover app sync round because minimum interval is active provider="
+                + providerId + " policy=" + policyStateToString(mPolicyState)
+                + " minIntervalMillis=" + minIntervalMillis
+                + " sinceLastRoundMillis=" + (now - mLastRecoverAppSyncRoundAt));
+    }
+
+    private void handleProviderRecoverFailed(String providerId, Bundle event) {
+        mProviderRecoverInFlight = false;
+        mRecoveryAttemptCount++;
+        final String reasonName = event.getString(PushBrokerConstants.PROVIDER_EVENT_REASON_NAME, "");
+        Log.i(TAG, "Provider recover failed provider=" + providerId
+                + " reason=" + reasonName
+                + " attempts=" + mRecoveryAttemptCount
+                + " policy=" + policyStateToString(mPolicyState));
+        if (mPolicyState == POLICY_ACTIVE) {
+            scheduleRecoveryHealthCheck(NETWORK_RECOVERY_RECHECK_DELAY_MILLIS,
+                    "provider recover failed");
+            return;
+        }
+        if (mPolicyState == POLICY_STANDBY) {
+            scheduleRecoveryHealthCheck(STANDBY_EVENT_RECOVERY_DELAY_MILLIS,
+                    "provider recover failed");
+        }
+    }
+
+    private void scheduleRecoveryHealthCheck(long delayMillis, String reason) {
+        mPendingRecoveryCheckReason = reason;
+        mHandler.removeCallbacks(mRecoveryHealthCheck);
+        mHandler.postDelayed(mRecoveryHealthCheck, delayMillis);
+    }
+
+    private void cancelShortRecoveryChecks() {
+        mHandler.removeCallbacks(mRecoveryHealthCheck);
+    }
+
+    private void stopRecoveryMonitoring() {
+        cancelShortRecoveryChecks();
+        mHandler.removeCallbacks(mWatchdogHealthCheck);
+        mLastHealthCheckAt = 0L;
+        mConsecutiveDisconnectedChecks = 0;
+        mWatchdogIntervalMillis = getWatchdogIntervalForState(mPolicyState);
+    }
+
+    private void startWatchdog() {
+        mConsecutiveDisconnectedChecks = 0;
+        mWatchdogIntervalMillis = getWatchdogIntervalForState(mPolicyState);
+        scheduleWatchdogLocked(mWatchdogIntervalMillis);
+    }
+
+    private void scheduleWatchdogLocked(long delayMillis) {
+        mHandler.removeCallbacks(mWatchdogHealthCheck);
+        mHandler.postDelayed(mWatchdogHealthCheck, delayMillis);
+    }
+
+    private void resetWatchdogState() {
+        mConsecutiveDisconnectedChecks = 0;
+        mWatchdogIntervalMillis = getWatchdogIntervalForState(mPolicyState);
+    }
+
+    private long nextWatchdogBackoff(long intervalMillis) {
+        final long baseInterval = getWatchdogIntervalForState(mPolicyState);
+        if (intervalMillis < baseInterval) {
+            return baseInterval;
+        }
+        return Math.min(intervalMillis * 2L, WATCHDOG_MAX_INTERVAL_MILLIS);
+    }
+
+    private final Runnable mRecoveryHealthCheck = new Runnable() {
+        @Override
+        public void run() {
+            if (mBoundProviderId == null || mActiveConnection == null || !mActiveConnection.isConnected()) {
+                return;
+            }
+
+            if (mPolicyState == POLICY_DORMANT) {
+                scheduleWatchdogLocked(mWatchdogIntervalMillis);
+                return;
+            }
+
+            final Bundle health = mActiveConnection.getHealth();
+            mLastHealthCheckAt = System.currentTimeMillis();
+            final String reason = mPendingRecoveryCheckReason;
+            evaluateProviderHealth(reason, health, HEALTH_TRIGGER_RECOVERY_CHECK, true, false);
+        }
+    };
+
+    private final Runnable mWatchdogHealthCheck = new Runnable() {
+        @Override
+        public void run() {
+            if (mBoundProviderId == null || mActiveConnection == null || !mActiveConnection.isConnected()) {
+                return;
+            }
+
+            if (mConnectivityManager == null || mConnectivityManager.getActiveNetwork() == null) {
+                scheduleWatchdogLocked(mWatchdogIntervalMillis);
+                return;
+            }
+
+            final long now = System.currentTimeMillis();
+            final Bundle health = mActiveConnection.getHealth();
+            mLastHealthCheckAt = now;
+            evaluateProviderHealth("watchdog", health, HEALTH_TRIGGER_WATCHDOG, true, false);
+        }
+    };
+
+    private boolean shouldRunColdStartDiscovery(String providerId) {
+        if (providerId == null || providerId.isBlank() || mActiveConnection == null) {
+            return false;
+        }
+
+        final PushProviderInfo providerInfo = mRegistry.getProviderInfo(providerId);
+        if (providerInfo == null || providerInfo.apiVersion < PushBrokerConstants.API_VERSION_2) {
+            return false;
+        }
+
+        return mKnownPackages.isEmpty() || !mStore.hasCompletedInitialDiscovery(providerId);
+    }
+
+    private void maybeScheduleColdStartDiscovery(String providerId) {
+        if (!shouldRunColdStartDiscovery(providerId) || mColdStartDiscoveryRunning) {
+            return;
+        }
+
+        mColdStartDiscoveryRunning = true;
+        final String boundProviderId = providerId;
+        mWorkerHandler.post(() -> runColdStartDiscovery(boundProviderId));
+    }
+
+    private void runColdStartDiscovery(String providerId) {
+        final List<ApplicationInfo> installedApps = mPackageManager.getInstalledApplicationsAsUser(
+                PackageManager.ApplicationInfoFlags.of(0), UserHandle.USER_SYSTEM);
+        final ArrayList<Bundle> supportedApps = new ArrayList<>();
+
+        for (ApplicationInfo applicationInfo : installedApps) {
+            if (applicationInfo == null || applicationInfo.packageName == null) {
+                continue;
+            }
+
+            final Bundle appIdentity = buildAppIdentity(applicationInfo.packageName,
+                    applicationInfo.uid, UserHandle.getUserId(applicationInfo.uid));
+            if (appIdentity == null) {
+                continue;
+            }
+
+            final boolean activeProviderStillBound = providerId.equals(mBoundProviderId)
+                    && mActiveConnection != null && mActiveConnection.isConnected();
+            if (!activeProviderStillBound) {
+                break;
+            }
+
+            if (shouldPrepareApp(appIdentity)) {
+                supportedApps.add(appIdentity);
+            }
+        }
+
+        mHandler.post(() -> finishColdStartDiscovery(providerId, supportedApps));
+    }
+
+    private void finishColdStartDiscovery(String providerId, List<Bundle> supportedApps) {
+        try {
+            if (!providerId.equals(mBoundProviderId) || mActiveConnection == null
+                    || !mActiveConnection.isConnected()) {
+                return;
+            }
+
+            int discoveredCount = 0;
+            for (Bundle appIdentity : supportedApps) {
+                final String packageName = appIdentity.getString(
+                        PushBrokerConstants.APP_IDENTITY_PACKAGE_NAME);
+                rememberKnownPackage(packageName);
+                enqueuePrepareApp(appIdentity, "cold start discovery");
+                discoveredCount++;
+            }
+
+            mStore.markInitialDiscoveryComplete(providerId);
+            Log.i(TAG, "Cold-start discovery complete provider=" + providerId
+                    + " supportedPackages=" + discoveredCount);
+        } finally {
+            mColdStartDiscoveryRunning = false;
+        }
+    }
