+                packageName, userId);
+        putCompatibilityLastResult(state, "lastSyncResult", mLastCompatibilitySyncResults,
+                packageName, userId);
+        putCompatibilityLastResult(state, "lastTokenResult", mLastCompatibilityTokenResults,
+                packageName, userId);
+        final Bundle traceState = mCompatibilityTraceStates.get(packageName + "#" + userId);
