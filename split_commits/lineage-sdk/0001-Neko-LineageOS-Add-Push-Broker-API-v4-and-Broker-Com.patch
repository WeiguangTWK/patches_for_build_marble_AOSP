+    private void refreshPublishedCompatibilitySignatureSpoofPolicy() {
+        final String providerId = mRegistry.getActiveProviderId();
+        if (!shouldApplyCompatibilityState(providerId)) {
+            mStore.clearCompatibilitySignatureSpoofPolicy();
+            return;
+        }
+        final ArrayMap<Integer, ArrayMap<String, ArraySet<String>>> providerProfiles =
+                mStore.getAllCompatibilityProfiles().get(providerId);
+        if (providerProfiles == null || providerProfiles.isEmpty()) {
+            mStore.clearCompatibilitySignatureSpoofPolicy();
+            return;
+        }
+        try {
+            final JSONObject root = new JSONObject();
+            root.put("version", 1);
+            final JSONArray apps = new JSONArray();
+            for (int userIndex = 0; userIndex < providerProfiles.size(); userIndex++) {
+                final int userId = providerProfiles.keyAt(userIndex);
+                final ArrayMap<String, ArraySet<String>> appProfiles = providerProfiles.valueAt(
+                        userIndex);
+                if (appProfiles == null || appProfiles.isEmpty()) {
+                    continue;
+                }
+                for (int appIndex = 0; appIndex < appProfiles.size(); appIndex++) {
+                    final String packageName = appProfiles.keyAt(appIndex);
+                    final Bundle appState = buildCompatibilityAppState(providerId, packageName,
+                            userId);
+                    if (!appState.getBoolean(PushBrokerConstants.COMPAT_APP_AUTHORIZED, false)) {
+                        continue;
+                    }
+                    final String[] effectiveCapabilities = appState.getStringArray(
+                            PushBrokerConstants.COMPAT_APP_EFFECTIVE_CAPABILITY_IDS);
+                    if (!containsCapability(effectiveCapabilities,
+                            PushBrokerConstants.COMPAT_CAP_PACKAGE_SIGNATURE_SPOOF)) {
+                        continue;
+                    }
+                    final Bundle capabilityData = mCompatibilitySignatureSpoofData.get(
+                            buildCompatibilityAppKey(providerId, packageName, userId));
+                    if (capabilityData == null || capabilityData.isEmpty()) {
+                        continue;
+                    }
+                    final JSONObject appObject = serializeCompatibilitySignatureSpoofAppPolicy(
+                            packageName, userId, capabilityData);
+                    if (appObject != null) {
+                        apps.put(appObject);
+                    }
+                }
+            }
+            if (apps.length() == 0) {
+                mStore.clearCompatibilitySignatureSpoofPolicy();
+                return;
+            }
+            root.put("apps", apps);
+            mStore.setCompatibilitySignatureSpoofPolicy(root.toString());
+        } catch (JSONException e) {
+            Log.w(TAG, "Failed to serialize compatibility signature spoof policy", e);
+            mStore.clearCompatibilitySignatureSpoofPolicy();
+        }
+    }
+
+    private JSONObject serializeCompatibilitySignatureSpoofAppPolicy(String packageName, int userId,
+            Bundle capabilityData) throws JSONException {
+        final Parcelable[] rawEntries = capabilityData.getParcelableArray(
+                PushBrokerConstants.COMPAT_SIG_SPOOF_ENTRIES);
+        final Parcelable[] rawIdentities = capabilityData.getParcelableArray(
+                PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITIES);
+        if (rawEntries == null || rawEntries.length == 0
+                || rawIdentities == null || rawIdentities.length == 0) {
+            return null;
+        }
+        final JSONArray entries = new JSONArray();
+        for (Parcelable rawEntry : rawEntries) {
+            if (!(rawEntry instanceof Bundle entryBundle)) {
+                continue;
+            }
+            final JSONObject entryObject = new JSONObject();
+            entryObject.put(PushBrokerConstants.COMPAT_SIG_SPOOF_QUERIED_PACKAGE,
+                    entryBundle.getString(PushBrokerConstants.COMPAT_SIG_SPOOF_QUERIED_PACKAGE));
+            entryObject.put(PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITY_ID,
+                    entryBundle.getString(PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITY_ID));
+            final JSONArray surfaces = new JSONArray();
+            final String[] allowedSurfaces = entryBundle.getStringArray(
+                    PushBrokerConstants.COMPAT_SIG_SPOOF_ALLOWED_QUERY_SURFACES);
+            if (allowedSurfaces != null) {
+                for (String surface : allowedSurfaces) {
+                    surfaces.put(surface);
+                }
+            }
+            entryObject.put(PushBrokerConstants.COMPAT_SIG_SPOOF_ALLOWED_QUERY_SURFACES, surfaces);
+            entries.put(entryObject);
+        }
+        final JSONArray identities = new JSONArray();
+        for (Parcelable rawIdentity : rawIdentities) {
+            if (!(rawIdentity instanceof Bundle identityBundle)) {
+                continue;
+            }
+            final JSONObject identityObject = new JSONObject();
+            identityObject.put(PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITY_ID,
+                    identityBundle.getString(PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITY_ID));
+            final JSONArray certificates = new JSONArray();
+            final String[] certificateBase64s = identityBundle.getStringArray(
+                    PushBrokerConstants.COMPAT_SIG_SPOOF_CERTIFICATE_BASE64S);
+            if (certificateBase64s != null) {
+                for (String certificateBase64 : certificateBase64s) {
+                    certificates.put(certificateBase64);
+                }
+            }
+            identityObject.put(PushBrokerConstants.COMPAT_SIG_SPOOF_CERTIFICATE_BASE64S,
+                    certificates);
+            identities.put(identityObject);
+        }
+        if (entries.length() == 0 || identities.length() == 0) {
+            return null;
+        }
+        final JSONObject appObject = new JSONObject();
+        appObject.put(PushBrokerConstants.COMPAT_APP_PACKAGE_NAME, packageName);
+        appObject.put(PushBrokerConstants.COMPAT_APP_USER_ID, userId);
+        appObject.put(PushBrokerConstants.COMPAT_SIG_SPOOF_ENTRIES, entries);
+        appObject.put(PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITIES, identities);
+        return appObject;
+    }
+
+    private boolean containsCapability(String[] capabilityIds, String capabilityId) {
+        if (capabilityIds == null || capabilityId == null || capabilityId.isBlank()) {
+            return false;
+        }
+        for (String candidate : capabilityIds) {
+            if (capabilityId.equals(candidate)) {
+                return true;
+            }
+        }
+        return false;
+    }
