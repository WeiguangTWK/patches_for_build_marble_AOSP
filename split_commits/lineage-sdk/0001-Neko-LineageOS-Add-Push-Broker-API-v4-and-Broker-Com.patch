+    @Override
+    public void onUserUnlocked(@android.annotation.NonNull TargetUser user) {
+        if (user.getUserIdentifier() != UserHandle.USER_SYSTEM) {
+            return;
+        }
+        final String pendingProviderId = mPendingBindProviderId;
+        final String previousActiveProviderId = pendingProviderId != null
+                ? pendingProviderId : mRegistry.getActiveProviderId();
+        mRegistry.refresh();
+        final String providerId = previousActiveProviderId != null
+                ? previousActiveProviderId : mRegistry.getActiveProviderId();
+        if (providerId == null) {
+            notifyRegistryChanged();
+            return;
+        }
+        Log.i(TAG, "System user unlocked; binding deferred provider " + providerId);
+        mPendingBindProviderId = null;
+        bindActiveProvider(providerId);
+        notifyRegistryChanged();
+    }
