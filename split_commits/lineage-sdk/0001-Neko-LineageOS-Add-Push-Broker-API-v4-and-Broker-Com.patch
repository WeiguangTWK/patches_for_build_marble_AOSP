+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.platform.internal.push;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.content.pm.ServiceInfo;
+import android.os.Build;
+import android.os.Bundle;
+import android.util.ArrayMap;
+import android.util.Log;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Objects;
+
+import lineageos.push.BrokerStatus;
+import lineageos.push.PushBrokerConstants;
+import lineageos.push.PushProviderInfo;
+import lineageos.push.PushProviderState;
+
+final class PushProviderRegistry {
+    private static final String TAG = "PushProviderRegistry";
+
+    private final PackageManager mPackageManager;
+    private final PushBrokerStore mStore;
+    private final CompatibilityCapabilityRegistry mCompatibilityCapabilityRegistry;
+
+    private final ArrayMap<String, PushProviderRecord> mProviders = new ArrayMap<>();
+    private String mActiveProviderId;
+
+    PushProviderRegistry(Context context, PushBrokerStore store) {
+        mPackageManager = context.getPackageManager();
+        mStore = store;
+        mCompatibilityCapabilityRegistry = new CompatibilityCapabilityRegistry();
+        mActiveProviderId = mStore.getActiveProviderId();
+    }
+
+    synchronized void refresh() {
+        refresh(false);
+    }
+
+    synchronized void refresh(boolean preserveMissingActiveProvider) {
+        final Intent intent = new Intent(PushBrokerConstants.ACTION_PUSH_PROVIDER_SERVICE);
+        final List<ResolveInfo> resolveInfos = mPackageManager.queryIntentServices(intent,
+                PackageManager.ResolveInfoFlags.of(PackageManager.GET_META_DATA));
+
+        mProviders.clear();
+
+        for (ResolveInfo resolveInfo : resolveInfos) {
+            final PushProviderRecord record = parseProvider(resolveInfo);
+            if (record == null || record.info == null || record.info.providerId == null) {
+                continue;
+            }
+
+            final PushProviderRecord existing = mProviders.get(record.info.providerId);
+            if (existing != null) {
+                Log.w(TAG, "Ignoring duplicate provider id " + record.info.providerId
+                        + " from " + record.info.packageName);
+                continue;
+            }
+            mProviders.put(record.info.providerId, record);
+        }
+
+        final String activeProviderId = mActiveProviderId;
+        if (activeProviderId != null && !mProviders.containsKey(activeProviderId)) {
+            if (preserveMissingActiveProvider) {
+                Log.i(TAG, "Active provider temporarily unavailable, preserving selection: "
+                        + activeProviderId);
+                return;
+            }
+            Log.w(TAG, "Active provider disappeared: " + activeProviderId);
+            mActiveProviderId = null;
+            mStore.clearActiveProviderId();
+        }
+    }
+
+    synchronized List<PushProviderInfo> getInstalledProviders() {
+        final ArrayList<PushProviderInfo> providers = new ArrayList<>(mProviders.size());
+        for (int i = 0; i < mProviders.size(); i++) {
+            providers.add(mProviders.valueAt(i).info);
+        }
+        return Collections.unmodifiableList(providers);
+    }
+
+    synchronized PushProviderState getProviderState(String providerId) {
+        final PushProviderRecord record = mProviders.get(providerId);
+        if (record == null) {
+            return new PushProviderState(false, false, false, false, false, false, 0, null,
+                    PushBrokerConstants.RUNTIME_MODE_UNKNOWN);
+        }
+
+        final boolean selected = Objects.equals(mActiveProviderId, providerId);
+        return new PushProviderState(true, selected, record.enabled, record.healthy,
+                record.degraded, record.requiresUserAction,
+                record.lastErrorCode, record.lastErrorMessage, record.runtimeMode);
+    }
+
+    synchronized BrokerStatus getBrokerStatus() {
+        return new BrokerStatus(mActiveProviderId, true, mProviders.size(),
+                null);
+    }
+
+    synchronized String getActiveProviderId() {
+        return mActiveProviderId;
+    }
+
+    synchronized boolean setActiveProvider(String providerId) {
+        final PushProviderRecord record = mProviders.get(providerId);
+        if (record == null) {
+            Log.w(TAG, "Rejecting unknown provider as active: " + providerId);
+            return false;
+        }
+        if (PushBrokerConstants.RUNTIME_MODE_UNSUPPORTED.equals(record.runtimeMode)) {
+            record.enabled = false;
+            record.healthy = false;
+            record.degraded = true;
+            record.lastErrorCode = PushBrokerConstants.RESULT_UNSUPPORTED;
+            record.lastErrorMessage = "missing mandatory compatibility capabilities";
+            Log.w(TAG, "Rejecting unsupported provider as active: " + providerId);
+            return false;
+        }
+        mActiveProviderId = providerId;
+        mStore.setActiveProviderId(providerId);
+        Log.i(TAG, "Active provider set to " + providerId);
+        return true;
+    }
+
+    synchronized boolean disableActiveProvider() {
+        final boolean hadProvider = mActiveProviderId != null;
+        mActiveProviderId = null;
+        mStore.clearActiveProviderId();
+        for (int i = 0; i < mProviders.size(); i++) {
+            mProviders.valueAt(i).clearRuntimeState();
+        }
+        Log.i(TAG, "Active provider disabled");
+        return hadProvider;
+    }
+
+    synchronized PushProviderInfo getProviderInfo(String providerId) {
+        final PushProviderRecord record = mProviders.get(providerId);
+        return record == null ? null : record.info;
+    }
+
+    synchronized void markProviderEnabled(String providerId) {
+        final PushProviderRecord record = mProviders.get(providerId);
+        if (record == null) {
+            return;
+        }
+        record.enabled = true;
+        record.healthy = true;
+        record.degraded = false;
+        record.requiresUserAction = false;
+        record.lastErrorCode = 0;
+        record.lastErrorMessage = null;
+    }
+
+    synchronized void markProviderDisconnected(String providerId) {
+        final PushProviderRecord record = mProviders.get(providerId);
+        if (record == null) {
+            return;
+        }
+        record.enabled = false;
+        record.healthy = false;
+        record.degraded = true;
+    }
+
+    synchronized void markProviderFailed(String providerId, String message) {
+        final PushProviderRecord record = mProviders.get(providerId);
+        if (record == null) {
+            return;
+        }
+        record.enabled = false;
+        record.healthy = false;
+        record.degraded = true;
+        record.requiresUserAction = false;
+        record.lastErrorCode = 1;
+        record.lastErrorMessage = message;
+    }
+
+    synchronized void markProviderRequiresUserAction(String providerId, String reason) {
+        final PushProviderRecord record = mProviders.get(providerId);
+        if (record == null) {
+            return;
+        }
+        record.enabled = false;
+        record.healthy = false;
+        record.degraded = true;
+        record.requiresUserAction = true;
+        record.lastErrorCode = PushBrokerConstants.RESULT_NOT_READY;
+        record.lastErrorMessage = reason;
+    }
+
+    synchronized void updateProviderHealth(String providerId, Bundle health) {
+        final PushProviderRecord record = mProviders.get(providerId);
+        if (record == null || health == null || health.isEmpty()) {
+            return;
+        }
+        final boolean requiresUserAction = health.getBoolean(
+                PushBrokerConstants.HEALTH_REQUIRES_USER_ACTION, false);
+        if (requiresUserAction) {
+            record.enabled = false;
+            record.healthy = false;
+            record.degraded = true;
+            record.requiresUserAction = true;
+            record.lastErrorCode = PushBrokerConstants.RESULT_NOT_READY;
+            record.lastErrorMessage = health.getString(
+                    PushBrokerConstants.HEALTH_USER_ACTION_REASON,
+                    PushBrokerConstants.HEALTH_DEGRADED_REASON_UNKNOWN);
+            return;
+        }
+
+        record.requiresUserAction = false;
+        if (record.lastErrorCode == PushBrokerConstants.RESULT_NOT_READY) {
+            record.lastErrorCode = 0;
+            record.lastErrorMessage = null;
+        }
+        final boolean providerEnabled = health.getBoolean(
+                PushBrokerConstants.HEALTH_PROVIDER_ENABLED, record.enabled);
+        final boolean businessHealthy = health.getBoolean(
+                PushBrokerConstants.HEALTH_BUSINESS_HEALTHY, true);
+        record.enabled = providerEnabled;
+        record.healthy = providerEnabled && businessHealthy;
+        record.degraded = providerEnabled && !businessHealthy;
+        if (record.degraded) {
+            record.lastErrorMessage = health.getString(
+                    PushBrokerConstants.HEALTH_BUSINESS_DEGRADED_REASON,
+                    PushBrokerConstants.HEALTH_DEGRADED_REASON_UNKNOWN);
+        } else if (record.healthy) {
+            record.lastErrorCode = 0;
+            record.lastErrorMessage = null;
+        }
+    }
+
+    synchronized Bundle runDiagnostics(String providerId) {
+        final Bundle bundle = new Bundle();
+        bundle.putString("activeProviderId", mActiveProviderId);
+        bundle.putInt("providerCount", mProviders.size());
+
+        if (providerId == null) {
+            return bundle;
+        }
+
+        final PushProviderRecord record = mProviders.get(providerId);
+        if (record == null) {
+            bundle.putBoolean("installed", false);
+            return bundle;
+        }
+
+        bundle.putBoolean("installed", true);
+        bundle.putString("providerId", record.info.providerId);
+        bundle.putString("packageName", record.info.packageName);
+        bundle.putString("serviceName", record.info.serviceName);
+        bundle.putString("providerType", record.info.providerType);
+        bundle.putInt("apiVersion", record.info.apiVersion);
+        bundle.putInt("trustLevel", record.info.trustLevel);
+        bundle.putString("versionName", record.info.versionName);
+        bundle.putLong("versionCode", record.info.versionCode);
+        bundle.putString("settingsActivity", record.info.settingsActivity);
+        bundle.putString("setupActivity", record.info.setupActivity);
+        bundle.putString("diagnosticsActivity", record.info.diagnosticsActivity);
+        bundle.putStringArray("declaredCapabilities", record.info.declaredCapabilities);
+        bundle.putString("providerBrand", record.info.providerBrand);
+        bundle.putStringArray("nativeBrandMatchers", record.info.nativeBrandMatchers);
+        bundle.putStringArray("mandatoryCompatibilityCapabilities",
+                record.info.mandatoryCompatibilityCapabilities);
+        bundle.putStringArray("optionalCompatibilityCapabilities",
+                record.info.optionalCompatibilityCapabilities);
+        bundle.putStringArray("compatibilityProfiles", record.info.compatibilityProfiles);
+        bundle.putString("runtimeMode", record.runtimeMode);
+        bundle.putStringArray("availableCompatibilityCapabilities",
+                mCompatibilityCapabilityRegistry.getAvailableCapabilities().toArray(new String[0]));
+        bundle.putStringArray("missingMandatoryCompatibilityCapabilities",
+                record.missingMandatoryCompatibilityCapabilities);
+        bundle.putBoolean("selected",
+                Objects.equals(mActiveProviderId, record.info.providerId));
+        bundle.putBoolean("enabled", record.enabled);
+        bundle.putBoolean("brokerEnabled", record.enabled);
+        bundle.putBoolean("healthy", record.healthy);
+        bundle.putBoolean("degraded", record.degraded);
+        bundle.putBoolean("requiresUserAction", record.requiresUserAction);
+        if (record.lastErrorMessage != null) {
+            bundle.putString("lastErrorMessage", record.lastErrorMessage);
+        }
+        if (record.lastErrorCode != 0) {
+            bundle.putInt("lastErrorCode", record.lastErrorCode);
+        }
+        return bundle;
+    }
+
+    private PushProviderRecord parseProvider(ResolveInfo resolveInfo) {
+        final ServiceInfo serviceInfo = resolveInfo.serviceInfo;
+        if (serviceInfo == null) {
+            return null;
+        }
+
+        final Bundle metaData = serviceInfo.metaData;
+        if (metaData == null) {
+            return errorRecord(serviceInfo, "missing metadata");
+        }
+
+        final String providerId = metaData.getString(PushBrokerConstants.META_PROVIDER_ID);
+        if (providerId == null || providerId.isBlank()) {
+            return errorRecord(serviceInfo, "missing provider id");
+        }
+
+        final int apiVersion = metaData.getInt(PushBrokerConstants.META_API_VERSION, 0);
+        if (apiVersion != PushBrokerConstants.API_VERSION_1
+                && apiVersion != PushBrokerConstants.API_VERSION_2
+                && apiVersion != PushBrokerConstants.API_VERSION_3
+                && apiVersion != PushBrokerConstants.API_VERSION_4) {
+            return errorRecord(serviceInfo, "unsupported api version " + apiVersion);
+        }
+
+        final String displayName = firstNonBlank(
+                metaData.getString(PushBrokerConstants.META_DISPLAY_NAME), providerId);
+        final String providerType = normalizeProviderType(
+                metaData.getString(PushBrokerConstants.META_PROVIDER_TYPE));
+        final String[] capabilities = splitCapabilities(
+                metaData.getString(PushBrokerConstants.META_CAPABILITIES));
+        final String providerBrand = normalizeBlankToNull(
+                metaData.getString(PushBrokerConstants.META_PROVIDER_BRAND));
+        final String[] nativeBrandMatchers = splitCapabilities(
+                metaData.getString(PushBrokerConstants.META_NATIVE_BRAND_MATCHERS));
+        final String[] mandatoryCompatibilityCapabilities = splitCapabilities(metaData.getString(
+                PushBrokerConstants.META_COMPATIBILITY_MANDATORY_CAPABILITIES));
+        final String[] optionalCompatibilityCapabilities = splitCapabilities(metaData.getString(
+                PushBrokerConstants.META_COMPATIBILITY_OPTIONAL_CAPABILITIES));
+        final String[] compatibilityProfiles = splitCapabilities(
+                metaData.getString(PushBrokerConstants.META_COMPATIBILITY_PROFILES));
+
+        long versionCode = 0;
+        String versionName = null;
+        try {
+            final PackageInfo packageInfo = mPackageManager.getPackageInfo(serviceInfo.packageName,
+                    PackageManager.PackageInfoFlags.of(0));
+            versionCode = packageInfo.getLongVersionCode();
+            versionName = packageInfo.versionName;
+        } catch (PackageManager.NameNotFoundException e) {
+            Log.w(TAG, "Package disappeared while parsing provider " + serviceInfo.packageName, e);
+        }
+
+        final int trustLevel = isSystemProvider(serviceInfo.applicationInfo)
+                ? PushProviderInfo.TRUST_SYSTEM
+                : PushProviderInfo.TRUST_USER_INSTALLED;
+
+        final PushProviderInfo info = new PushProviderInfo(
+                providerId,
+                displayName,
+                serviceInfo.packageName,
+                new ComponentName(serviceInfo.packageName, serviceInfo.name).flattenToShortString(),
+                providerType,
+                versionName,
+                versionCode,
+                apiVersion,
+                trustLevel,
+                metaData.getString(PushBrokerConstants.META_SETTINGS_ACTIVITY),
+                metaData.getString(PushBrokerConstants.META_SETUP_ACTIVITY),
+                metaData.getString(PushBrokerConstants.META_DIAGNOSTICS_ACTIVITY),
+                capabilities,
+                providerBrand,
+                nativeBrandMatchers,
+                mandatoryCompatibilityCapabilities,
+                optionalCompatibilityCapabilities,
+                compatibilityProfiles);
+
+        final PushProviderRecord record = new PushProviderRecord(info, 0, null);
+        deriveRuntimeMode(record);
+        return record;
+    }
+
+    private PushProviderRecord errorRecord(ServiceInfo serviceInfo, String errorMessage) {
+        Log.w(TAG, "Skipping provider service " + serviceInfo.packageName + "/" + serviceInfo.name
+                + ": " + errorMessage);
+        return null;
+    }
+
+    private void deriveRuntimeMode(PushProviderRecord record) {
+        final PushProviderInfo info = record.info;
+        record.missingMandatoryCompatibilityCapabilities = getMissingMandatoryCapabilities(info);
+        if (isExplicitNativeMode(info)) {
+            applyRuntimeMode(record, PushBrokerConstants.RUNTIME_MODE_NATIVE);
+            return;
+        }
+        if (isExplicitCompatibilityMode(info)) {
+            applyRuntimeMode(record, deriveCompatibilityMode(record));
+            return;
+        }
+        applyRuntimeMode(record, deriveModeFromEnvironment(info, record));
+    }
+
+    private String deriveModeFromEnvironment(PushProviderInfo info, PushProviderRecord record) {
+        if (matchesNativeEnvironment(info)) {
+            return PushBrokerConstants.RUNTIME_MODE_NATIVE;
+        }
+        if (!declaresCompatibility(info)) {
+            return PushBrokerConstants.RUNTIME_MODE_NATIVE;
+        }
+        return deriveCompatibilityMode(record);
+    }
+
+    private String deriveCompatibilityMode(PushProviderRecord record) {
+        return record.missingMandatoryCompatibilityCapabilities.length == 0
+                ? PushBrokerConstants.RUNTIME_MODE_COMPATIBILITY
+                : PushBrokerConstants.RUNTIME_MODE_UNSUPPORTED;
+    }
+
+    private void applyRuntimeMode(PushProviderRecord record, String runtimeMode) {
+        record.runtimeMode = runtimeMode;
+        if (!PushBrokerConstants.RUNTIME_MODE_UNSUPPORTED.equals(runtimeMode)) {
+            record.lastErrorCode = 0;
+            if ("missing mandatory compatibility capabilities".equals(record.lastErrorMessage)) {
+                record.lastErrorMessage = null;
+            }
+            return;
+        }
+        record.healthy = false;
+        record.degraded = true;
+        record.lastErrorCode = PushBrokerConstants.RESULT_UNSUPPORTED;
+        record.lastErrorMessage = "missing mandatory compatibility capabilities";
+    }
+
+    private boolean isExplicitNativeMode(PushProviderInfo info) {
+        return PushProviderInfo.PROVIDER_TYPE_NATIVE.equals(info.providerType);
+    }
+
+    private boolean isExplicitCompatibilityMode(PushProviderInfo info) {
+        return PushProviderInfo.PROVIDER_TYPE_COMPATIBILITY.equals(info.providerType);
+    }
+
+    private boolean declaresCompatibility(PushProviderInfo info) {
+        return hasAny(info.mandatoryCompatibilityCapabilities)
+                || hasAny(info.optionalCompatibilityCapabilities)
+                || hasAny(info.compatibilityProfiles)
+                || isExplicitCompatibilityMode(info);
+    }
+
+    private String[] getMissingMandatoryCapabilities(PushProviderInfo info) {
+        final ArrayList<String> missing = new ArrayList<>();
+        for (String capability : safeArray(info.mandatoryCompatibilityCapabilities)) {
+            if (!mCompatibilityCapabilityRegistry.isCapabilityAvailable(capability)) {
+                missing.add(capability);
+            }
+        }
+        return missing.toArray(new String[0]);
+    }
+
+    private boolean matchesNativeEnvironment(PushProviderInfo info) {
+        if (hasAny(info.nativeBrandMatchers)) {
+            for (String matcher : info.nativeBrandMatchers) {
+                if (matchesNativeBrandMatcher(matcher)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        if (info.providerBrand == null || info.providerBrand.isBlank()) {
+            return false;
+        }
+        return equalsIgnoreCase(Build.BRAND, info.providerBrand)
+                || equalsIgnoreCase(Build.MANUFACTURER, info.providerBrand);
+    }
+
+    private boolean matchesNativeBrandMatcher(String matcher) {
+        if (matcher == null || matcher.isBlank()) {
+            return false;
+        }
+        final String[] parts = matcher.split(":", 2);
+        if (parts.length != 2) {
+            return equalsIgnoreCase(Build.BRAND, matcher)
+                    || equalsIgnoreCase(Build.MANUFACTURER, matcher);
+        }
+        final String key = parts[0].trim();
+        final String value = parts[1].trim();
+        if ("brand".equalsIgnoreCase(key)) {
+            return equalsIgnoreCase(Build.BRAND, value);
+        }
+        if ("manufacturer".equalsIgnoreCase(key)) {
+            return equalsIgnoreCase(Build.MANUFACTURER, value);
+        }
+        if ("feature".equalsIgnoreCase(key)) {
+            return mPackageManager.hasSystemFeature(value);
+        }
+        if ("property".equalsIgnoreCase(key)) {
+            // Reserved for a future runtime-side property matcher.
+            return false;
+        }
+        return false;
+    }
+
+    private static boolean hasAny(String[] values) {
+        return values != null && values.length > 0;
+    }
+
+    private static String[] safeArray(String[] values) {
+        return values == null ? new String[0] : values;
+    }
+
+    private static boolean equalsIgnoreCase(String actual, String expected) {
+        return actual != null && expected != null && actual.equalsIgnoreCase(expected);
+    }
+
+    private static String normalizeBlankToNull(String value) {
+        return value == null || value.isBlank() ? null : value;
+    }
+
+    private static String normalizeProviderType(String providerType) {
+        if (PushProviderInfo.PROVIDER_TYPE_NATIVE.equals(providerType)) {
+            return PushProviderInfo.PROVIDER_TYPE_NATIVE;
+        }
+        if (PushProviderInfo.PROVIDER_TYPE_COMPATIBILITY.equals(providerType)) {
+            return PushProviderInfo.PROVIDER_TYPE_COMPATIBILITY;
+        }
+        return PushProviderInfo.PROVIDER_TYPE_UNKNOWN;
+    }
+
+    private static String[] splitCapabilities(String capabilityString) {
+        if (capabilityString == null || capabilityString.isBlank()) {
+            return new String[0];
+        }
+
+        final String[] rawParts = capabilityString.split(",");
+        final ArrayList<String> result = new ArrayList<>(rawParts.length);
+        for (String part : rawParts) {
+            final String trimmed = part.trim();
+            if (!trimmed.isEmpty()) {
+                result.add(trimmed);
+            }
+        }
+        return result.toArray(new String[0]);
+    }
+
+    private static String firstNonBlank(String value, String fallback) {
+        return value == null || value.isBlank() ? fallback : value;
+    }
+
+    private static boolean isSystemProvider(ApplicationInfo applicationInfo) {
+        if (applicationInfo == null) {
+            return false;
+        }
+        return applicationInfo.isSystemApp() || applicationInfo.isUpdatedSystemApp();
+    }
+
+    private static final class PushProviderRecord {
+        final PushProviderInfo info;
+        int lastErrorCode;
+        String lastErrorMessage;
+        boolean enabled;
+        boolean healthy;
+        boolean degraded;
+        boolean requiresUserAction;
+        String runtimeMode;
+        String[] missingMandatoryCompatibilityCapabilities;
+
+        PushProviderRecord(PushProviderInfo info, int lastErrorCode, String lastErrorMessage) {
+            this.info = info;
+            this.lastErrorCode = lastErrorCode;
+            this.lastErrorMessage = lastErrorMessage;
+            this.enabled = false;
+            this.healthy = true;
+            this.degraded = false;
+            this.requiresUserAction = false;
+            this.runtimeMode = PushBrokerConstants.RUNTIME_MODE_UNKNOWN;
+            this.missingMandatoryCompatibilityCapabilities = new String[0];
+        }
+
+        void clearRuntimeState() {
+            enabled = false;
+            healthy = true;
+            degraded = false;
+            requiresUserAction = false;
+            lastErrorCode = 0;
+            lastErrorMessage = null;
+        }
