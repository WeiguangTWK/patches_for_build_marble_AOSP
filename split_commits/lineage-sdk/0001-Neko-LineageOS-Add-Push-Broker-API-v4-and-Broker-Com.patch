+/*
+ * SPDX-FileCopyrightText: Neko-LineageOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package lineageos.push;
+
+import android.os.Parcel;
+import android.os.Parcelable;
+
+/** @hide */
+public final class PushProviderState implements Parcelable {
+    public final boolean installed;
+    public final boolean selected;
+    public final boolean enabled;
+    public final boolean healthy;
+    public final boolean degraded;
+    public final boolean requiresUserAction;
+    public final int lastErrorCode;
+    public final String lastErrorMessage;
+    public final String runtimeMode;
+
+    public PushProviderState(boolean installed, boolean selected, boolean enabled, boolean healthy,
+            boolean degraded, boolean requiresUserAction, int lastErrorCode,
+            String lastErrorMessage) {
+        this(installed, selected, enabled, healthy, degraded, requiresUserAction, lastErrorCode,
+                lastErrorMessage, PushBrokerConstants.RUNTIME_MODE_UNKNOWN);
+    }
+
+    public PushProviderState(boolean installed, boolean selected, boolean enabled, boolean healthy,
+            boolean degraded, boolean requiresUserAction, int lastErrorCode,
+            String lastErrorMessage, String runtimeMode) {
+        this.installed = installed;
+        this.selected = selected;
+        this.enabled = enabled;
+        this.healthy = healthy;
+        this.degraded = degraded;
+        this.requiresUserAction = requiresUserAction;
+        this.lastErrorCode = lastErrorCode;
+        this.lastErrorMessage = lastErrorMessage;
+        this.runtimeMode = runtimeMode;
+    }
+
+    private PushProviderState(Parcel in) {
+        installed = in.readBoolean();
+        selected = in.readBoolean();
+        enabled = in.readBoolean();
+        healthy = in.readBoolean();
+        degraded = in.readBoolean();
+        requiresUserAction = in.readBoolean();
+        lastErrorCode = in.readInt();
+        lastErrorMessage = in.readString();
+        runtimeMode = in.readString();
+    }
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public void writeToParcel(Parcel dest, int flags) {
+        dest.writeBoolean(installed);
+        dest.writeBoolean(selected);
+        dest.writeBoolean(enabled);
+        dest.writeBoolean(healthy);
+        dest.writeBoolean(degraded);
+        dest.writeBoolean(requiresUserAction);
+        dest.writeInt(lastErrorCode);
+        dest.writeString(lastErrorMessage);
+        dest.writeString(runtimeMode);
+    }
+
+    @Override
+    public String toString() {
+        return "PushProviderState{"
+                + "installed=" + installed
+                + ", selected=" + selected
+                + ", enabled=" + enabled
+                + ", healthy=" + healthy
+                + ", degraded=" + degraded
+                + ", requiresUserAction=" + requiresUserAction
+                + ", lastErrorCode=" + lastErrorCode
+                + ", lastErrorMessage=" + lastErrorMessage
+                + ", runtimeMode=" + runtimeMode
+                + "}";
+    }
+
+    public static final Parcelable.Creator<PushProviderState> CREATOR =
+            new Parcelable.Creator<PushProviderState>() {
+                @Override
+                public PushProviderState createFromParcel(Parcel source) {
+                    return new PushProviderState(source);
+                }
+
+                @Override
+                public PushProviderState[] newArray(int size) {
+                    return new PushProviderState[size];
+                }
+            };
+}
