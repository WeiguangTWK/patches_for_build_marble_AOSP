+/*
+ * SPDX-FileCopyrightText: Neko-LineageOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.platform.internal.push;
+
+import android.os.Bundle;
+import android.util.ArraySet;
+
+import lineageos.push.PushBrokerConstants;
+
+final class CompatibilityCapabilityRegistry {
+    private final ArraySet<String> mAvailableCapabilities = new ArraySet<>();
+
+    CompatibilityCapabilityRegistry() {
+        mAvailableCapabilities.add(PushBrokerConstants.COMPAT_CAP_SERVICE_KEEPALIVE);
+        mAvailableCapabilities.add(PushBrokerConstants.COMPAT_CAP_PACKAGE_STATE_SYNC);
+        mAvailableCapabilities.add(PushBrokerConstants.COMPAT_CAP_PACKAGE_SIGNATURE_SPOOF);
+    }
+
+    ArraySet<String> getAvailableCapabilities() {
+        return new ArraySet<>(mAvailableCapabilities);
+    }
+
+    boolean isCapabilityAvailable(String capabilityId) {
+        return capabilityId != null && mAvailableCapabilities.contains(capabilityId);
+    }
+
+    Bundle dumpCapabilityStates() {
+        final Bundle bundle = new Bundle();
+        bundle.putStringArray(PushBrokerConstants.DIAG_COMPAT_CAPABILITY_STATES,
+                mAvailableCapabilities.toArray(new String[0]));
+        return bundle;
+    }
+}
