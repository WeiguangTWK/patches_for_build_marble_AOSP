+/*
+ * SPDX-FileCopyrightText: Neko-LineageOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.platform.internal.push;
+
+import android.os.Bundle;
+import android.service.notification.StatusBarNotification;
+import android.text.TextUtils;
+import android.util.ArrayMap;
+
+import java.util.Collections;
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+
+import lineageos.push.PushBrokerConstants;
+
+final class PushNotificationConvergenceStore {
+    static final long DEFAULT_TTL_MILLIS = 5 * 60_000L;
+
+    private final ArrayMap<String, ArrayList<PendingRecord>> mPendingByScope = new ArrayMap<>();
+
+    void clear() {
+        mPendingByScope.clear();
+    }
+
+    void addProviderNotificationPosted(String providerId, Bundle event, long ttlMillis) {
+        if (event == null) {
+            return;
+        }
+
+        final String packageName = event.getString(PushBrokerConstants.PROVIDER_EVENT_PACKAGE_NAME);
+        if (TextUtils.isEmpty(packageName)) {
+            return;
+        }
+
+        final int userId = event.getInt(PushBrokerConstants.PROVIDER_EVENT_USER_ID, 0);
+        final long postedAt = event.getLong(PushBrokerConstants.PROVIDER_EVENT_TIMESTAMP,
+                System.currentTimeMillis());
+        pruneExpired(postedAt);
+
+        final ArrayList<PendingRecord> records = getOrCreateScope(scopeKey(packageName, userId));
+        records.add(new PendingRecord(
+                providerId,
+                packageName,
+                userId,
+                event.getString(PushBrokerConstants.PROVIDER_EVENT_PROVIDER_NOTIFICATION_TAG),
+                event.getInt(PushBrokerConstants.PROVIDER_EVENT_PROVIDER_NOTIFICATION_ID, 0),
+                buildStrongKey(event),
+                event.getInt(PushBrokerConstants.PROVIDER_EVENT_NOTIFY_ID, 0),
+                event.getInt(PushBrokerConstants.PROVIDER_EVENT_TITLE_HASH, 0),
+                event.getInt(PushBrokerConstants.PROVIDER_EVENT_TEXT_HASH, 0),
+                postedAt,
+                postedAt + ttlMillis));
+    }
+
+    Bundle dumpState() {
+        final Bundle bundle = new Bundle();
+        bundle.putInt("pendingCount", getPendingCount());
+
+        final ArrayList<String> summaries = new ArrayList<>();
+        for (int i = 0; i < mPendingByScope.size(); i++) {
+            final ArrayList<PendingRecord> records = mPendingByScope.valueAt(i);
+            if (records == null) {
+                continue;
+            }
+            for (int j = 0; j < records.size(); j++) {
+                summaries.add(records.get(j).summary());
+            }
+        }
+        bundle.putStringArrayList("pendingRecords", summaries);
+        return bundle;
+    }
+
+    void pruneExpired(long now) {
+        for (int i = mPendingByScope.size() - 1; i >= 0; i--) {
+            final ArrayList<PendingRecord> records = mPendingByScope.valueAt(i);
+            if (records == null) {
+                mPendingByScope.removeAt(i);
+                continue;
+            }
+
+            final Iterator<PendingRecord> iterator = records.iterator();
+            while (iterator.hasNext()) {
+                if (iterator.next().expiresAt <= now) {
+                    iterator.remove();
+                }
+            }
+
+            if (records.isEmpty()) {
+                mPendingByScope.removeAt(i);
+            }
+        }
+    }
+
+    int getPendingCount() {
+        int count = 0;
+        for (int i = 0; i < mPendingByScope.size(); i++) {
+            final ArrayList<PendingRecord> records = mPendingByScope.valueAt(i);
+            count += records == null ? 0 : records.size();
+        }
+        return count;
+    }
+
+    boolean hasPendingRecordsFor(String packageName, int userId) {
+        final ArrayList<PendingRecord> records = mPendingByScope.get(scopeKey(packageName, userId));
+        return records != null && !records.isEmpty();
+    }
+
+    List<MatchResult> matchAndConsume(StatusBarNotification[] notifications, String providerId,
+            long now) {
+        if (notifications == null || notifications.length == 0) {
+            pruneExpired(now);
+            return Collections.emptyList();
+        }
+
+        pruneExpired(now);
+        final ArrayList<MatchResult> matches = new ArrayList<>();
+        for (StatusBarNotification sbn : notifications) {
+            if (sbn == null) {
+                continue;
+            }
+            final PendingRecord record = findBestMatch(providerId, sbn, now);
+            if (record == null) {
+                continue;
+            }
+            removeRecord(record);
+            matches.add(new MatchResult(record.providerId, record.packageName, record.userId,
+                    record.providerNotificationTag, record.providerNotificationId,
+                    sbn.getPackageName(), sbn.getTag(), sbn.getId(), sbn.getKey()));
+        }
+        return matches;
+    }
+
+    private ArrayList<PendingRecord> getOrCreateScope(String scopeKey) {
+        ArrayList<PendingRecord> records = mPendingByScope.get(scopeKey);
+        if (records == null) {
+            records = new ArrayList<>();
+            mPendingByScope.put(scopeKey, records);
+        }
+        return records;
+    }
+
+    private static String scopeKey(String packageName, int userId) {
+        return packageName + "#" + userId;
+    }
+
+    private static String buildStrongKey(Bundle event) {
+        final String jobKey = event.getString(PushBrokerConstants.PROVIDER_EVENT_JOB_KEY);
+        if (!TextUtils.isEmpty(jobKey)) {
+            return "job:" + jobKey;
+        }
+
+        final String messageId = event.getString(PushBrokerConstants.PROVIDER_EVENT_MESSAGE_ID);
+        if (!TextUtils.isEmpty(messageId)) {
+            return "msg:" + messageId;
+        }
+        return null;
+    }
+
+    private PendingRecord findBestMatch(String providerId, StatusBarNotification sbn, long now) {
+        final ArrayList<PendingRecord> records = mPendingByScope.get(
+                scopeKey(sbn.getPackageName(), sbn.getUserId()));
+        if (records == null || records.isEmpty()) {
+            return null;
+        }
+
+        final String strongKey = buildStrongKey(sbn);
+        if (!TextUtils.isEmpty(strongKey)) {
+            for (int i = 0; i < records.size(); i++) {
+                final PendingRecord record = records.get(i);
+                if (!TextUtils.equals(record.providerId, providerId)) {
+                    continue;
+                }
+                if (TextUtils.equals(record.strongKey, strongKey)) {
+                    return record;
+                }
+            }
+        }
+
+        final int titleHash = stableTextHash(extractCharSequence(sbn, android.app.Notification.EXTRA_TITLE));
+        final int textHash = stableTextHash(extractCharSequence(sbn, android.app.Notification.EXTRA_TEXT));
+        for (int i = 0; i < records.size(); i++) {
+            final PendingRecord record = records.get(i);
+            if (!TextUtils.equals(record.providerId, providerId)) {
+                continue;
+            }
+            if (record.expiresAt < now) {
+                continue;
+            }
+            if (sbn.getPostTime() > 0 && sbn.getPostTime() < record.postedAt) {
+                continue;
+            }
+            if (!contentHashesMatch(record, titleHash, textHash)) {
+                continue;
+            }
+            return record;
+        }
+
+        return null;
+    }
+
+    private static boolean contentHashesMatch(PendingRecord record, int titleHash, int textHash) {
+        final boolean hasRecordTitle = record.titleHash != 0;
+        final boolean hasRecordText = record.textHash != 0;
+        final boolean hasObservedTitle = titleHash != 0;
+        final boolean hasObservedText = textHash != 0;
+
+        if (hasRecordTitle && hasObservedTitle && record.titleHash != titleHash) {
+            return false;
+        }
+        if (hasRecordText && hasObservedText && record.textHash != textHash) {
+            return false;
+        }
+
+        if (hasRecordTitle && hasObservedTitle) {
+            return true;
+        }
+        if (hasRecordText && hasObservedText) {
+            return true;
+        }
+        return false;
+    }
+
+    private void removeRecord(PendingRecord record) {
+        final ArrayList<PendingRecord> records = mPendingByScope.get(
+                scopeKey(record.packageName, record.userId));
+        if (records == null) {
+            return;
+        }
+        records.remove(record);
+        if (records.isEmpty()) {
+            mPendingByScope.remove(scopeKey(record.packageName, record.userId));
+        }
+    }
+
+    private static String buildStrongKey(StatusBarNotification sbn) {
+        final CharSequence tag = sbn.getNotification().extras.getCharSequence("jobkey");
+        if (!TextUtils.isEmpty(tag)) {
+            return "job:" + tag;
+        }
+        final String shortcutId = sbn.getNotification().getShortcutId();
+        if (!TextUtils.isEmpty(shortcutId)) {
+            return "shortcut:" + shortcutId;
+        }
+        return null;
+    }
+
+    private static CharSequence extractCharSequence(StatusBarNotification sbn, String key) {
+        return sbn.getNotification() == null || sbn.getNotification().extras == null
+                ? null : sbn.getNotification().extras.getCharSequence(key);
+    }
+
+    private static int stableTextHash(CharSequence value) {
+        return TextUtils.isEmpty(value) ? 0 : value.toString().hashCode();
+    }
+
+    static final class MatchResult {
+        final String providerId;
+        final String providerPackageName;
+        final int providerUserId;
+        final String providerNotificationTag;
+        final int providerNotificationId;
+        final String appPackageName;
+        final String appNotificationTag;
+        final int appNotificationId;
+        final String appNotificationKey;
+
+        MatchResult(String providerId, String providerPackageName, int providerUserId,
+                String providerNotificationTag, int providerNotificationId,
+                String appPackageName, String appNotificationTag, int appNotificationId,
+                String appNotificationKey) {
+            this.providerId = providerId;
+            this.providerPackageName = providerPackageName;
+            this.providerUserId = providerUserId;
+            this.providerNotificationTag = providerNotificationTag;
+            this.providerNotificationId = providerNotificationId;
+            this.appPackageName = appPackageName;
+            this.appNotificationTag = appNotificationTag;
+            this.appNotificationId = appNotificationId;
+            this.appNotificationKey = appNotificationKey;
+        }
+    }
+
+    private static final class PendingRecord {
+        final String providerId;
+        final String packageName;
+        final int userId;
+        final String providerNotificationTag;
+        final int providerNotificationId;
+        final String strongKey;
+        final int notifyId;
+        final int titleHash;
+        final int textHash;
+        final long postedAt;
+        final long expiresAt;
+
+        PendingRecord(String providerId, String packageName, int userId,
+                String providerNotificationTag, int providerNotificationId, String strongKey,
+                int notifyId, int titleHash, int textHash, long postedAt, long expiresAt) {
+            this.providerId = providerId;
+            this.packageName = packageName;
+            this.userId = userId;
+            this.providerNotificationTag = providerNotificationTag;
+            this.providerNotificationId = providerNotificationId;
+            this.strongKey = strongKey;
+            this.notifyId = notifyId;
+            this.titleHash = titleHash;
+            this.textHash = textHash;
+            this.postedAt = postedAt;
+            this.expiresAt = expiresAt;
+        }
+
+        String summary() {
+            return packageName + " user=" + userId
+                    + " provider=" + providerId
+                    + " notif=" + providerNotificationTag + "/" + providerNotificationId
+                    + " key=" + strongKey
+                    + " notifyId=" + notifyId
+                    + " postedAt=" + postedAt
+                    + " expiresAt=" + expiresAt;
+        }
+    }
+}
diff --git a/lineage/lib/main/java/org/lineageos/platform/internal/push/PushProviderConnection.java b/lineage/lib/main/java/org/lineageos/platform/internal/push/PushProviderConnection.java
