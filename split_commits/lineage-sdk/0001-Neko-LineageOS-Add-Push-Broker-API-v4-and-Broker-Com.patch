+    private Bundle sanitizeCompatibilitySignatureSpoofData(Bundle rawData) {
+        final Bundle sanitized = new Bundle();
+        if (rawData == null || rawData.isEmpty()) {
+            return sanitized;
+        }
+        final ArraySet<String> knownIdentityIds = new ArraySet<>();
+        final ArrayList<Bundle> identityBundles = new ArrayList<>();
+        final Parcelable[] rawIdentities = rawData.getParcelableArray(
+                PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITIES);
+        if (rawIdentities != null) {
+            for (Parcelable rawIdentity : rawIdentities) {
+                if (!(rawIdentity instanceof Bundle identityBundle)) {
+                    continue;
+                }
+                final String identityId = identityBundle.getString(
+                        PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITY_ID);
+                final String[] certificateBase64s = identityBundle.getStringArray(
+                        PushBrokerConstants.COMPAT_SIG_SPOOF_CERTIFICATE_BASE64S);
+                if (identityId == null || identityId.isBlank()
+                        || certificateBase64s == null || certificateBase64s.length == 0) {
+                    continue;
+                }
+                final ArrayList<String> sanitizedCertificates = new ArrayList<>();
+                for (String certificateBase64 : certificateBase64s) {
+                    if (certificateBase64 != null && !certificateBase64.isBlank()) {
+                        sanitizedCertificates.add(certificateBase64);
+                    }
+                }
+                if (sanitizedCertificates.isEmpty() || knownIdentityIds.contains(identityId)) {
+                    continue;
+                }
+                final Bundle sanitizedIdentity = new Bundle();
+                sanitizedIdentity.putString(PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITY_ID,
+                        identityId);
+                sanitizedIdentity.putStringArray(
+                        PushBrokerConstants.COMPAT_SIG_SPOOF_CERTIFICATE_BASE64S,
+                        sanitizedCertificates.toArray(new String[0]));
+                identityBundles.add(sanitizedIdentity);
+                knownIdentityIds.add(identityId);
+            }
+        }
+
+        final ArrayList<Bundle> entryBundles = new ArrayList<>();
+        final Parcelable[] rawEntries = rawData.getParcelableArray(
+                PushBrokerConstants.COMPAT_SIG_SPOOF_ENTRIES);
+        if (rawEntries != null) {
+            for (Parcelable rawEntry : rawEntries) {
+                if (!(rawEntry instanceof Bundle entryBundle)) {
+                    continue;
+                }
+                final String queriedPackage = entryBundle.getString(
+                        PushBrokerConstants.COMPAT_SIG_SPOOF_QUERIED_PACKAGE);
+                final String identityId = entryBundle.getString(
+                        PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITY_ID);
+                final String[] allowedQuerySurfaces = entryBundle.getStringArray(
+                        PushBrokerConstants.COMPAT_SIG_SPOOF_ALLOWED_QUERY_SURFACES);
+                if (queriedPackage == null || queriedPackage.isBlank()
+                        || identityId == null || identityId.isBlank()
+                        || !knownIdentityIds.contains(identityId)) {
+                    continue;
+                }
+                final ArrayList<String> sanitizedSurfaces = new ArrayList<>();
+                if (allowedQuerySurfaces != null) {
+                    for (String surface : allowedQuerySurfaces) {
+                        if (isSupportedCompatibilitySignatureSpoofSurface(surface)
+                                && !sanitizedSurfaces.contains(surface)) {
+                            sanitizedSurfaces.add(surface);
+                        }
+                    }
+                }
+                if (sanitizedSurfaces.isEmpty()) {
+                    continue;
+                }
+                final Bundle sanitizedEntry = new Bundle();
+                sanitizedEntry.putString(PushBrokerConstants.COMPAT_SIG_SPOOF_QUERIED_PACKAGE,
+                        queriedPackage);
+                sanitizedEntry.putString(PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITY_ID,
+                        identityId);
+                sanitizedEntry.putStringArray(
+                        PushBrokerConstants.COMPAT_SIG_SPOOF_ALLOWED_QUERY_SURFACES,
+                        sanitizedSurfaces.toArray(new String[0]));
+                entryBundles.add(sanitizedEntry);
+            }
+        }
+
+        if (!entryBundles.isEmpty()) {
+            sanitized.putParcelableArray(PushBrokerConstants.COMPAT_SIG_SPOOF_ENTRIES,
+                    entryBundles.toArray(new Bundle[0]));
+        }
+        if (!identityBundles.isEmpty()) {
+            sanitized.putParcelableArray(PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITIES,
+                    identityBundles.toArray(new Bundle[0]));
+        }
+        return sanitized;
+    }
