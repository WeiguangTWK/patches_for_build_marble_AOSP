new file mode 100644
index 0000000..a750238
--- /dev/null
+++ b/packages/LineagePreferenceLib/java/lineageos/preference/LineageSystemSettingConfirmSwitchPreference.java
@@ -0,0 +1,80 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Neko LineageOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package lineageos.preference;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.content.res.TypedArray;
+import android.util.AttributeSet;
+
+/** A Lineage system setting switch that requires confirmation before it is enabled. */
+public class LineageSystemSettingConfirmSwitchPreference
+        extends LineageSystemSettingSwitchPreference {
+
+    private final CharSequence mConfirmationDialogTitle;
+    private final CharSequence mConfirmationDialogMessage;
+    private final CharSequence mConfirmationPositiveButtonText;
+
+    private AlertDialog mConfirmationDialog;
+
+    public LineageSystemSettingConfirmSwitchPreference(Context context, AttributeSet attrs,
+            int defStyle) {
+        super(context, attrs, defStyle);
+        TypedArray a = context.obtainStyledAttributes(attrs,
+                R.styleable.lineage_ConfirmSwitchPreference, defStyle, 0);
+        mConfirmationDialogTitle = a.getText(
+                R.styleable.lineage_ConfirmSwitchPreference_confirmationDialogTitle);
+        mConfirmationDialogMessage = a.getText(
+                R.styleable.lineage_ConfirmSwitchPreference_confirmationDialogMessage);
+        mConfirmationPositiveButtonText = a.getText(
+                R.styleable.lineage_ConfirmSwitchPreference_confirmationPositiveButtonText);
+        a.recycle();
+    }
+
+    public LineageSystemSettingConfirmSwitchPreference(Context context, AttributeSet attrs) {
+        this(context, attrs, androidx.preference.R.attr.switchPreferenceCompatStyle);
+    }
+
+    public LineageSystemSettingConfirmSwitchPreference(Context context) {
+        this(context, null);
+    }
+
+    @Override
+    protected void onClick() {
+        if (isChecked()) {
+            super.onClick();
+            return;
+        }
+
+        if (mConfirmationDialog != null && mConfirmationDialog.isShowing()) {
+            return;
+        }
+
+        final CharSequence positiveButtonText = mConfirmationPositiveButtonText != null
+                ? mConfirmationPositiveButtonText : getContext().getText(android.R.string.ok);
+        mConfirmationDialog = new AlertDialog.Builder(getContext())
+                .setTitle(mConfirmationDialogTitle)
+                .setMessage(mConfirmationDialogMessage)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(positiveButtonText, (dialog, which) -> {
+                    if (callChangeListener(true)) {
+                        setChecked(true);
+                    }
+                })
+                .create();
+        mConfirmationDialog.setOnDismissListener(dialog -> mConfirmationDialog = null);
+        mConfirmationDialog.show();
+    }
+
+    @Override
+    public void onDetached() {
+        if (mConfirmationDialog != null) {
+            mConfirmationDialog.dismiss();
+            mConfirmationDialog = null;
+        }
+        super.onDetached();
+    }
+}
