diff --git a/lineage/lib/main/java/org/lineageos/platform/internal/health/PerformanceModeController.java b/lineage/lib/main/java/org/lineageos/platform/internal/health/PerformanceModeController.java
new file mode 100644
index 0000000..16e48f1
--- /dev/null
+++ b/lineage/lib/main/java/org/lineageos/platform/internal/health/PerformanceModeController.java
@@ -0,0 +1,190 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Neko-LineageOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.platform.internal.health;
+
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_APPLYING;
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_ERROR;
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_OFF;
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_ON;
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_REQUESTED;
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_RESTORING;
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_STATE;
+
+import android.content.Context;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IBinder;
+import android.os.Process;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.provider.Settings;
+import android.util.Log;
+
+import org.lineageos.platform.internal.R;
+
+import vendor.lineage.health.FastChargeMode;
+import vendor.lineage.health.IFastCharge;
+
+import java.io.PrintWriter;
+
+/** Device-wide state. All HAL work and state writes are confined to a dedicated worker. */
+public final class PerformanceModeController extends LineageHealthFeature {
+    private static final String SERVICE = "vendor.system.health.IFastCharge/default";
+    private static final String BOOT = "performance_mode_boot_count";
+    private static final int MAX_RECONNECTS = 6;
+
+    private IFastCharge mHal;
+    private IBinder.DeathRecipient mDeathRecipient;
+    private PerformanceModeNotification mNotification;
+    private boolean mRequested;
+    private boolean mAlertPending;
+    private int mReconnects;
+    private volatile boolean mReady;
+    private volatile int mState = PERFORMANCE_MODE_OFF;
+    private final Runnable mRetry = () -> apply(false);
+
+    public PerformanceModeController(Context context) {
+        super(context, context.getResources().getBoolean(R.bool.config_performanceModeAvailable)
+                ? createWorker() : new Handler(context.getMainLooper()));
+    }
+
+    private static Handler createWorker() {
+        HandlerThread thread = new HandlerThread("PerformanceMode", Process.THREAD_PRIORITY_BACKGROUND);
+        thread.start();
+        return new Handler(thread.getLooper());
+    }
+
+    @Override
+    public boolean isSupported() {
+        return mContext.getResources().getBoolean(R.bool.config_performanceModeAvailable);
+    }
+
+    @Override
+    public void onStart() {
+        mHandler.post(() -> {
+            final int boot = Settings.Global.getInt(mContext.getContentResolver(),
+                    Settings.Global.BOOT_COUNT, -1);
+            final int previousBoot = Settings.Global.getInt(mContext.getContentResolver(), BOOT, -2);
+            final boolean sameBoot = boot >= 0 && previousBoot == boot;
+            mRequested = sameBoot && Settings.Global.getInt(mContext.getContentResolver(),
+                    PERFORMANCE_MODE_REQUESTED, 0) != 0;
+            if (!sameBoot) {
+                // Reset the request before the boot marker, so an interrupted reset is safe.
+                if (put(PERFORMANCE_MODE_REQUESTED, 0)) put(BOOT, boot);
+            }
+            mNotification = new PerformanceModeNotification(mContext, mHandler,
+                    () -> requestEnabled(false));
+            mReady = true;
+            apply(false);
+        });
+    }
+
+    /** Returns acceptance only; clients observe PERFORMANCE_MODE_STATE for the result. */
+    public boolean requestEnabled(boolean enabled) {
+        if (!isSupported() || !mReady) return false;
+        return mHandler.post(() -> {
+            final boolean explicitEnable = enabled && !mRequested;
+            if (!put(PERFORMANCE_MODE_REQUESTED, enabled ? 1 : 0)) {
+                publish(PERFORMANCE_MODE_ERROR, false);
+                return;
+            }
+            mRequested = enabled;
+            mAlertPending |= explicitEnable;
+            if (!enabled) mAlertPending = false;
+            mReconnects = 0;
+            mHandler.removeCallbacks(mRetry);
+            apply(true);
+        });
+    }
+
+    private boolean connect() throws RemoteException {
+        if (mHal != null) return true;
+        IBinder binder = ServiceManager.checkService(SERVICE);
+        if (binder == null) return false;
+        final IBinder.DeathRecipient recipient = () -> mHandler.post(() -> {
+            // Ignore a delayed death callback from a previously replaced connection.
+            if (mHal == null || mHal.asBinder() != binder) return;
+            mHal = null;
+            mDeathRecipient = null;
+            mReconnects = 0;
+            mHandler.removeCallbacks(mRetry);
+            apply(false);
+        });
+        binder.linkToDeath(recipient, 0);
+        mDeathRecipient = recipient;
+        mHal = IFastCharge.Stub.asInterface(binder);
+        return true;
+    }
+
+    private void apply(boolean userRequest) {
+        if (!userRequest) mAlertPending = false;
+        publish(mRequested ? PERFORMANCE_MODE_APPLYING : PERFORMANCE_MODE_RESTORING, false);
+        try {
+            if (!connect()) {
+                reconnectLater();
+                return;
+            }
+            final int expected = mRequested ? FastChargeMode.FAST_CHARGE : FastChargeMode.NONE;
+            if (mHal.setFastChargeMode(expected) != expected) {
+                publish(PERFORMANCE_MODE_ERROR, false);
+                return;
+            }
+            mReconnects = 0;
+            publish(mRequested ? PERFORMANCE_MODE_ON : PERFORMANCE_MODE_OFF, mAlertPending);
+            mAlertPending = false;
+        } catch (RemoteException e) {
+            Log.w(TAG, "Performance HAL unavailable", e);
+            disconnect();
+            reconnectLater();
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Failed to apply performance mode", e);
+            publish(PERFORMANCE_MODE_ERROR, false);
+        }
+    }
+
+    private void disconnect() {
+        if (mHal != null && mDeathRecipient != null) {
+            mHal.asBinder().unlinkToDeath(mDeathRecipient, 0);
+        }
+        mHal = null;
+        mDeathRecipient = null;
+    }
+
+    private void reconnectLater() {
+        publish(PERFORMANCE_MODE_ERROR, false);
+        if (mReconnects < MAX_RECONNECTS) {
+            long delay = Math.min(30_000L, 1_000L << mReconnects++);
+            mHandler.removeCallbacks(mRetry);
+            mHandler.postDelayed(mRetry, delay);
+        }
+    }
+
+    private void publish(int state, boolean alert) {
+        if (!put(PERFORMANCE_MODE_STATE, state)) {
+            Log.e(TAG, "Failed to publish performance mode state " + state);
+            mState = PERFORMANCE_MODE_ERROR;
+            mNotification.update(PERFORMANCE_MODE_ERROR, false);
+            return;
+        }
+        mState = state;
+        mNotification.update(state, alert);
+    }
+
+    private boolean put(String key, int value) {
+        return Settings.Global.putInt(mContext.getContentResolver(), key, value);
+    }
+
+    @Override
+    protected void onSettingsChanged(Uri uri) {
+        // The request is writable only through the permission-checked service API.
+    }
+
+    @Override
+    public void dump(PrintWriter pw) {
+        pw.println("Performance mode state: " + mState + ", ready=" + mReady);
+    }
+}
diff --git a/lineage/lib/main/java/org/lineageos/platform/internal/health/PerformanceModeNotification.java b/lineage/lib/main/java/org/lineageos/platform/internal/health/PerformanceModeNotification.java
new file mode 100644
index 0000000..9ecc52c
--- /dev/null
+++ b/lineage/lib/main/java/org/lineageos/platform/internal/health/PerformanceModeNotification.java
@@ -0,0 +1,87 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Neko-LineageOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.platform.internal.health;
+
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_ERROR;
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_OFF;
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_ON;
+import static lineageos.health.HealthInterface.PERFORMANCE_MODE_RESTORING;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.Handler;
+import android.os.UserHandle;
+
+import org.lineageos.platform.internal.R;
+
+final class PerformanceModeNotification {
+    private static final String CHANNEL = "PerformanceMode";
+    private static final String DISABLE = "org.system.platform.action.DISABLE_PERFORMANCE_MODE";
+    private static final int ID = 1001;
+    private final Context mContext;
+    private final NotificationManager mManager;
+
+    PerformanceModeNotification(Context context, Handler handler, Runnable disable) {
+        mContext = context;
+        mManager = context.getSystemService(NotificationManager.class);
+        NotificationChannel channel = new NotificationChannel(CHANNEL,
+                context.getString(R.string.performance_mode_title),
+                NotificationManager.IMPORTANCE_HIGH);
+        channel.setSound(null, null);
+        channel.enableVibration(false);
+        mManager.createNotificationChannel(channel);
+        context.registerReceiver(new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context receiverContext, Intent intent) {
+                if (DISABLE.equals(intent.getAction())) disable.run();
+            }
+        }, new IntentFilter(DISABLE), null, handler, Context.RECEIVER_NOT_EXPORTED);
+    }
+
+    void update(int state, boolean alert) {
+        if (state == PERFORMANCE_MODE_OFF) {
+            mManager.cancelAsUser(null, ID, UserHandle.ALL);
+            return;
+        }
+        int title = switch (state) {
+            case PERFORMANCE_MODE_ON -> R.string.performance_mode_notification_title;
+            case PERFORMANCE_MODE_ERROR -> R.string.performance_mode_error;
+            case PERFORMANCE_MODE_RESTORING -> R.string.performance_mode_restoring;
+            default -> R.string.performance_mode_applying;
+        };
+        String message = mContext.getString(R.string.performance_mode_notification_content);
+        if (state == PERFORMANCE_MODE_ERROR) {
+            message = mContext.getString(R.string.performance_mode_error_content) + " " + message;
+        }
+        PendingIntent settings = PendingIntent.getActivity(mContext, 0,
+                new Intent(Intent.ACTION_POWER_USAGE_SUMMARY)
+                        .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK), PendingIntent.FLAG_IMMUTABLE);
+        PendingIntent disable = PendingIntent.getBroadcast(mContext, 0,
+                new Intent(DISABLE).setPackage(mContext.getPackageName()),
+                PendingIntent.FLAG_IMMUTABLE);
+        Notification notification = new Notification.Builder(mContext, CHANNEL)
+                .setContentTitle(mContext.getString(title))
+                .setContentText(message)
+                .setStyle(new Notification.BigTextStyle().bigText(message))
+                .setSmallIcon(R.drawable.ic_performance_mode)
+                .setContentIntent(settings)
+                .setOngoing(true)
+                .setOnlyAlertOnce(!alert)
+                .setSilent(!alert)
+                .setVisibility(Notification.VISIBILITY_PUBLIC)
+                .addAction(new Notification.Action.Builder(null,
+                        mContext.getString(R.string.performance_mode_disable), disable).build())
+                .build();
+        notification.flags |= Notification.FLAG_NO_CLEAR;
+        mManager.notifyAsUser(null, ID, notification, UserHandle.ALL);
+    }
+}
