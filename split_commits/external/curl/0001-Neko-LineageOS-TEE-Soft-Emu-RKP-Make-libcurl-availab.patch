 Android.bp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Android.bp b/Android.bp
index 1f953ee..9511dd3 100644
--- a/Android.bp
+++ b/Android.bp
@@ -87,6 +87,11 @@ cc_defaults {
 
 cc_library {
     name: "libcurl",
