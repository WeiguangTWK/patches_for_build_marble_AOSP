@@ -94,6 +94,19 @@ open class ThemedBatteryDrawable(private val context: Context, frameColor: Int)
     open var criticalLevel: Int = context.resources.getInteger(
             com.android.internal.R.integer.config_criticalBatteryWarningLevel)
 
+    var performanceModeEnabled = false
+        set(value) {
+            field = value
+            postInvalidate()
+        }
+
+    private val performancePaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val performanceFlame by lazy {
+        context.getDrawable(R.drawable.ic_battery_performance)!!.mutate().apply {
+            setTint(Color.WHITE)
+        }
+    }
+
     var charging = false
         set(value) {
             field = value
@@ -178,6 +191,28 @@ open class ThemedBatteryDrawable(private val context: Context, frameColor: Int)
     }
 
     override fun draw(c: Canvas) {
+        if (performanceModeEnabled) {
+            // Keep the level visible while fixing both frame and fill to red in all themes.
+            performancePaint.color = Color.rgb(255, 14, 1)
+            c.drawPath(scaledPerimeter, performancePaint)
+            performancePaint.alpha = 80
+            c.drawPath(scaledFill, performancePaint)
+            performancePaint.alpha = 255
+            c.save()
+            c.clipRect(fillRect.left,
+                fillRect.bottom - fillRect.height() * batteryLevel / 100f,
+                fillRect.right, fillRect.bottom)
+            c.drawPath(scaledFill, performancePaint)
+            c.restore()
+            val size = minOf(fillRect.width() * 0.85f, fillRect.height() * 0.65f)
+            performanceFlame.setBounds(
+                (fillRect.centerX() - size / 2).toInt(),
+                (fillRect.centerY() - size / 2).toInt(),
+                (fillRect.centerX() + size / 2).toInt(),
+                (fillRect.centerY() + size / 2).toInt())
+            performanceFlame.draw(c)
+            return
+        }
         c.saveLayer(null, null)
         unifiedPath.reset()
         levelPath.reset()
