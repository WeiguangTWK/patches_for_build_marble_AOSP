+    val performanceModeState: Flow<Int>
+        get() = flowOf(HealthInterface.PERFORMANCE_MODE_OFF)
+
     /** Is power saver enabled */
     val isPowerSaveEnabled: Flow<Boolean>
 
@@ -186,6 +193,25 @@ constructor(
             .flowOn(bgDispatcher)
             .stateIn(scope, SharingStarted.Lazily, BatteryCallbackState())
 
+    override val performanceModeState: StateFlow<Int> =
+        conflatedCallbackFlow {
+            val resolver = context.contentResolver
+            fun sendState() {
+                trySend(Settings.Global.getInt(resolver, HealthInterface.PERFORMANCE_MODE_STATE,
+                    HealthInterface.PERFORMANCE_MODE_OFF))
+            }
+            val observer = object : ContentObserver(Handler(Looper.getMainLooper())) {
+                override fun onChange(selfChange: Boolean) { sendState() }
+            }
+            resolver.registerContentObserver(
+                Settings.Global.getUriFor(HealthInterface.PERFORMANCE_MODE_STATE), false, observer)
+            sendState()
+            awaitClose { resolver.unregisterContentObserver(observer) }
+        }
+            .distinctUntilChanged()
+            .flowOn(bgDispatcher)
+            .stateIn(scope, SharingStarted.WhileSubscribed(), HealthInterface.PERFORMANCE_MODE_OFF)
+
     override val isPluggedIn =
         batteryState
             .map { it.isPluggedIn }
