+    /** A wrapper may start system_server before ActivityManager is available. @hide */
+    public static void initializeSystemExtensionResources(boolean enabled, String[] idmapPaths) {
+        synchronized (sSync) {
+            sFreshRuntime = true;
+            sFreshIdmapPaths = idmapPaths == null ? null : idmapPaths.clone();
+            enableSystemExtensionResources(enabled);
