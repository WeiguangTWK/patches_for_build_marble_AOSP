+
+    /** Called after specializing a child, before application code or child-zygote preload. @hide */
+    public static void enableSystemExtensionResources(boolean enabled) {
+        synchronized (sSync) {
+            if (!enabled || sExtensionResourcesEnabled) {
+                return;
+            }
+            if (sSystem != null) {
+                try {
+                    final ArrayList<ApkAssets> assets = new ArrayList<>(
+                            Arrays.asList(sSystemApkAssets));
+                    appendSystemExtensionAssets(assets);
+                    // Preserve every inherited framework cookie by appending to the end.
+                    sSystemApkAssets = assets.toArray(new ApkAssets[0]);
+                    sSystemApkAssetsSet = new ArraySet<>(assets);
+                    sSystem.setApkAssets(sSystemApkAssets, true /* invalidateCaches */);
+                } catch (IOException e) {
+                    throw new IllegalStateException("Failed to append system resources", e);
+                }
+            }
+            sExtensionResourcesEnabled = true;
+        }
+    }
+
+    @GuardedBy("sSync")
+    private static void appendSystemExtensionAssets(ArrayList<ApkAssets> assets)
+            throws IOException {
+        final int flags = ApkAssets.PROPERTY_SYSTEM | ApkAssets.PROPERTY_LINEAGE_SYSTEM;
+        final int originalSize = assets.size();
+        try {
+            assets.add(ApkAssets.loadFromPath(getLineageApkPath(), flags));
+            for (String path : sExtensionIdmapPaths) {
+                assets.add(ApkAssets.loadOverlayFromPath(path, ApkAssets.PROPERTY_SYSTEM));
+            }
+        } catch (IOException e) {
+            for (int i = assets.size() - 1; i >= originalSize; i--) {
+                assets.remove(i).close();
+            }
+            throw e;
+        }
+    }
