+static jstring NativeGetOverlayTargetPath(JNIEnv* env, jclass, jstring path) {
+  ScopedUtfChars idmap_path(env, path);
+  if (idmap_path.c_str() == nullptr) return nullptr;
+  auto asset = AssetsProvider::CreateAssetFromFile(idmap_path.c_str());
+  if (asset == nullptr) {
+    jniThrowException(env, "java/io/IOException", "Unable to read overlay target");
+    return nullptr;
+  }
+  const auto* buffer = static_cast<const char*>(asset->getBuffer(true));
+  if (buffer == nullptr) {
+    jniThrowException(env, "java/io/IOException", "Unable to read idmap data");
+    return nullptr;
+  }
+  auto idmap = LoadedIdmap::Load(
+      idmap_path.c_str(), StringPiece(buffer, static_cast<size_t>(asset->getLength())));
+  if (idmap == nullptr) {
+    jniThrowException(env, "java/io/IOException", "Invalid overlay target metadata");
+    return nullptr;
+  }
+  // Copy before the metadata and its temporary mapping are destroyed.
+  const std::string target(idmap->TargetApkPath());
+  return env->NewStringUTF(target.c_str());
+}
+
