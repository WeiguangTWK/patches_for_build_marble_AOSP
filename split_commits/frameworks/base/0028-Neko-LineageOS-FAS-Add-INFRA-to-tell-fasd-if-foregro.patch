+        // The public TaskFpsCallback API intentionally exposes only aggregate FPS. FAS uses a
+        // separate native listener in its standalone daemon.
+        return binder::Status::ok();
+    }
+
 protected:
     virtual ~TaskFpsCallback() {
         JNIEnv* env = AndroidRuntime::getJNIEnv();
diff --git a/services/java/com/android/server/SystemServer.java b/services/java/com/android/server/SystemServer.java
index f3045dd50..97db090d3 100644
--- a/services/java/com/android/server/SystemServer.java
+++ b/services/java/com/android/server/SystemServer.java
@@ -177,6 +177,7 @@ import com.android.server.display.DisplayManagerService;
 import com.android.server.display.color.ColorDisplayService;
 import com.android.server.dreams.DreamManagerService;
 import com.android.server.emergency.EmergencyAffordanceService;
+import com.android.server.fas.FasManagerService;
 import com.android.server.flags.FeatureFlagsService;
 import com.android.server.gpu.GpuService;
 import com.android.server.grammaticalinflection.GrammaticalInflectionService;
@@ -3279,6 +3280,10 @@ public final class SystemServer implements Dumpable {
             t.traceBegin("GameManagerService");
             mSystemServiceManager.startService(GameManagerService.Lifecycle.class);
             t.traceEnd();
+
+            t.traceBegin("FasManagerService");
+            mSystemServiceManager.startService(FasManagerService.class);
