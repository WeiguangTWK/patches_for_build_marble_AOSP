+package com.android.server.pm;
+
+import android.os.Process;
+import android.os.UserHandle;
+import android.util.ArraySet;
+import android.util.Pair;
+
+import com.android.server.pm.pkg.PackageStateInternal;
+import com.android.server.pm.pkg.SharedUserApi;
+
+import java.util.Set;
+
+/** Caller policy for system extension features; internal capability checks remain unfiltered. */
+final class SystemExtensionFeatureVisibility {
+    private static final Set<String> FEATURES = Set.of(
+            "org.lineageos.android",
+            "org.lineageos.globalactions",
+            "org.lineageos.hardware",
+            "org.lineageos.health",
+            "org.lineageos.livedisplay",
+            "org.lineageos.profiles",
+            "org.lineageos.settings",
+            "org.lineageos.trust");
+
+    private SystemExtensionFeatureVisibility() {}
+
+    static boolean isExtensionFeature(String name) {
+        return name != null && FEATURES.contains(name);
+    }
+
+    static boolean canAccess(Computer snapshot, int callingUid) {
+        if (callingUid == Process.ROOT_UID || callingUid == Process.SYSTEM_UID
+                || callingUid == Process.SHELL_UID) {
+            return true;
+        }
+        // Do not resolve sandbox or isolated identities through their host application.
+        if (!UserHandle.isApp(callingUid) || Process.isIsolatedUid(callingUid)
+                || Process.isSdkSandboxUid(callingUid)) {
+            return false;
+        }
+
+        final int userId = UserHandle.getUserId(callingUid);
+        final Pair<PackageStateInternal, SharedUserApi> identity =
+                snapshot.getPackageOrSharedUser(UserHandle.getAppId(callingUid));
+        if (identity == null) {
+            return false;
+        }
+        if (identity.first != null) {
+            return identity.first.getUserStateOrDefault(userId).isInstalled()
+                    && isTrustedPackage(identity.first, userId);
+        }
+        if (identity.second == null) {
+            return false;
+        }
+
+        // Binder identifies a shared UID, not the individual package issuing the query.
+        // Require every installed member to qualify rather than using merged UID flags.
+        final ArraySet<? extends PackageStateInternal> packages =
+                identity.second.getPackageStates();
+        boolean hasInstalledPackage = false;
+        for (int i = 0; i < packages.size(); i++) {
+            final PackageStateInternal state = packages.valueAt(i);
+            if (!state.getUserStateOrDefault(userId).isInstalled()) {
+                continue;
+            }
+            hasInstalledPackage = true;
+            if (!isTrustedPackage(state, userId)) {
+                return false;
+            }
+        }
+        return hasInstalledPackage;
+    }
+
+    private static boolean isTrustedPackage(PackageStateInternal state, int userId) {
+        return !state.getUserStateOrDefault(userId).isInstantApp()
+                && (state.isSystem() || state.isUpdatedSystemApp())
+                && state.getPkg() != null && state.getPkg().isSignedWithPlatformKey();
+    }
+}
