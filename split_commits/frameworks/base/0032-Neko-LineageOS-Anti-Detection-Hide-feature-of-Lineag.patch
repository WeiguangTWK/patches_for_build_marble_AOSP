diff --git a/services/core/java/com/android/server/pm/PackageManagerService.java b/services/core/java/com/android/server/pm/PackageManagerService.java
index fb3e19f18..0a1232b92 100644
--- a/services/core/java/com/android/server/pm/PackageManagerService.java
+++ b/services/core/java/com/android/server/pm/PackageManagerService.java
@@ -1257,6 +1257,8 @@ public class PackageManagerService implements PackageSender, TestUtilityService
             Log.i(TAG, "snapshot: onChange(" + what + ")");
         }
         sSnapshotPendingVersion.incrementAndGet();
+        // Feature visibility also depends on package identity and per-user installation state.
+        ApplicationPackageManager.invalidateHasSystemFeatureCache();
     }
 
     /**
@@ -2979,6 +2981,14 @@ public class PackageManagerService implements PackageSender, TestUtilityService
         }
     }
 
+    boolean hasSystemFeatureForCaller(String name, int version) {
+        final int callingUid = Binder.getCallingUid();
+        return hasSystemFeature(name, version)
+                && (!SystemExtensionFeatureVisibility.isExtensionFeature(name)
+                        || SystemExtensionFeatureVisibility.canAccess(
+                                snapshotComputer(), callingUid));
+    }
+
     // NOTE: Can't remove due to unsupported app usage
     public int checkPermission(String permName, String pkgName, int userId) {
         return mPermissionManager.checkPermission(pkgName, permName,
@@ -5482,9 +5492,16 @@ public class PackageManagerService implements PackageSender, TestUtilityService
         @Override
         public @NonNull ParceledListSlice<FeatureInfo> getSystemAvailableFeatures() {
             // allow instant applications
-            ArrayList<FeatureInfo> res;
-            res = new ArrayList<>(mAvailableFeatures.size() + 1);
-            res.addAll(mAvailableFeatures.values());
+            final int callingUid = Binder.getCallingUid();
+            final boolean includeExtensions = SystemExtensionFeatureVisibility.canAccess(
+                    snapshotComputer(), callingUid);
+            final ArrayList<FeatureInfo> res = new ArrayList<>(mAvailableFeatures.size() + 1);
+            for (FeatureInfo feature : mAvailableFeatures.values()) {
+                if (includeExtensions
+                        || !SystemExtensionFeatureVisibility.isExtensionFeature(feature.name)) {
+                    res.add(feature);
+                }
+            }
             final FeatureInfo fi = new FeatureInfo();
             fi.reqGlEsVersion = SystemProperties.getInt("ro.opengles.version",
                     FeatureInfo.GL_ES_VERSION_UNDEFINED);
