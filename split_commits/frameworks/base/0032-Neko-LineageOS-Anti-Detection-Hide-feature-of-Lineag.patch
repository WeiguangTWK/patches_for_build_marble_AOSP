@@ -785,6 +786,9 @@ public class ApplicationPackageManager extends PackageManager {
     @Override
     @SuppressWarnings("unchecked")
     public FeatureInfo[] getSystemAvailableFeatures() {
+        // The system process uses a local service. Its capability query must not inherit
+        // the identity of an application whose Binder request it is handling.
+        final long identity = Binder.clearCallingIdentity();
         try {
             ParceledListSlice<FeatureInfo> parceledList =
                     mPM.getSystemAvailableFeatures();
@@ -799,6 +803,8 @@ public class ApplicationPackageManager extends PackageManager {
             return res;
         } catch (RemoteException e) {
             throw e.rethrowFromSystemServer();
+        } finally {
+            Binder.restoreCallingIdentity(identity);
         }
     }
 
@@ -828,11 +834,15 @@ public class ApplicationPackageManager extends PackageManager {
 
                 @Override
                 public Boolean recompute(HasSystemFeatureQuery query) {
+                    // This cache belongs to the process, not to its incoming Binder callers.
+                    final long identity = Binder.clearCallingIdentity();
                     try {
                         return ActivityThread.currentActivityThread().getPackageManager().
                             hasSystemFeature(query.name, query.version);
                     } catch (RemoteException e) {
                         throw e.rethrowFromSystemServer();
+                    } finally {
+                        Binder.restoreCallingIdentity(identity);
                     }
                 }
             };
