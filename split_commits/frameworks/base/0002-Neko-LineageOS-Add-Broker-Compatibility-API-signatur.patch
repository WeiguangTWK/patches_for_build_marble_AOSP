+    private void maybeApplyCompatibilitySignatureSpoofToPackageInfo(PackageInfo packageInfo,
+            String queriedPackage, int callingUid, int userId, long flags) {
+        if (packageInfo == null || queriedPackage == null || queriedPackage.isBlank()) {
+            return;
+        }
+        final int callingUserId = UserHandle.getUserId(callingUid);
+        final String[] callingPackages = getPackagesForUidInternal(callingUid, callingUid);
+        final boolean requestedDeprecatedSignatures =
+                (flags & PackageManager.GET_SIGNATURES) != 0;
+        final boolean requestedSigningInfo =
+                (flags & PackageManager.GET_SIGNING_CERTIFICATES) != 0;
+
+        if (requestedDeprecatedSignatures) {
+            final SigningDetails deprecatedSigningDetails =
+                    getLineageCompatibilitySigningPolicy().getSpoofedSigningDetails(callingPackages,
+                            callingUserId, queriedPackage,
+                            PushBrokerConstants.COMPAT_QUERY_SURFACE_PACKAGE_INFO_SIGNATURES);
+            if (deprecatedSigningDetails != null) {
+                packageInfo.signatures = getDeprecatedSignatures(deprecatedSigningDetails, flags);
+            }
+        }
+        if (requestedSigningInfo) {
+            final SigningDetails signingInfoSigningDetails =
+                    getLineageCompatibilitySigningPolicy().getSpoofedSigningDetails(callingPackages,
+                            callingUserId, queriedPackage,
+                            PushBrokerConstants.COMPAT_QUERY_SURFACE_PACKAGE_INFO_SIGNING_INFO);
+            if (signingInfoSigningDetails != null) {
+                packageInfo.signingInfo = new SigningInfo(signingInfoSigningDetails);
+            }
+        }
+    }
+
+    private SigningDetails maybeGetCompatibilitySpoofedSigningDetails(String[] callingPackages,
+            int callingUserId, String selfPackage, String queriedPackage,
+            SigningDetails originalSigningDetails, String querySurface) {
+        if (originalSigningDetails == null
+                || queriedPackage == null || queriedPackage.isBlank()
+                || isPackageOwnedByCaller(callingPackages, queriedPackage)
+                || !isPackageOwnedByCaller(callingPackages, selfPackage)) {
+            return originalSigningDetails;
+        }
+        final SigningDetails spoofedSigningDetails =
+                getLineageCompatibilitySigningPolicy().getSpoofedSigningDetails(callingPackages,
+                        callingUserId, queriedPackage, querySurface);
+        return spoofedSigningDetails != null ? spoofedSigningDetails : originalSigningDetails;
+    }
+
+    private SigningDetails maybeGetCompatibilitySpoofedSigningDetailsForUidComparison(
+            String[] callingPackages, int callingUserId, String[] selfPackages,
+            String[] queriedPackages, SigningDetails originalSigningDetails, String querySurface) {
+        if (originalSigningDetails == null
+                || queriedPackages == null || queriedPackages.length == 0
+                || !containsCallerOwnedPackage(callingPackages, selfPackages)) {
+            return originalSigningDetails;
+        }
+        for (String queriedPackage : queriedPackages) {
+            if (queriedPackage == null || queriedPackage.isBlank()
+                    || isPackageOwnedByCaller(callingPackages, queriedPackage)) {
+                continue;
+            }
+            final SigningDetails spoofedSigningDetails =
+                    getLineageCompatibilitySigningPolicy().getSpoofedSigningDetails(callingPackages,
+                            callingUserId, queriedPackage, querySurface);
+            if (spoofedSigningDetails != null) {
+                return spoofedSigningDetails;
+            }
+        }
+        return originalSigningDetails;
+    }
+
+    private LineageCompatibilitySigningPolicy getLineageCompatibilitySigningPolicy() {
+        LineageCompatibilitySigningPolicy policy = mLineageCompatibilitySigningPolicy;
+        if (policy == null) {
+            policy = LineageCompatibilitySigningPolicy.getInstance(mContext);
+            mLineageCompatibilitySigningPolicy = policy;
+        }
+        return policy;
+    }
+
+    private boolean containsCallerOwnedPackage(String[] callingPackages, String[] candidatePackages) {
+        if (candidatePackages == null || candidatePackages.length == 0) {
+            return false;
+        }
+        for (String candidatePackage : candidatePackages) {
+            if (isPackageOwnedByCaller(callingPackages, candidatePackage)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private boolean isPackageOwnedByCaller(String[] callingPackages, String packageName) {
+        if (callingPackages == null || packageName == null || packageName.isBlank()) {
+            return false;
+        }
+        for (String callingPackage : callingPackages) {
+            if (packageName.equals(callingPackage)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
