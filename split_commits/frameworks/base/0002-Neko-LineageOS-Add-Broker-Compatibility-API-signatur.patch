+package com.android.server.pm;
+
+import android.content.Context;
+import android.content.pm.Signature;
+import android.content.pm.SigningDetails;
+import android.database.ContentObserver;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.os.UserManager;
+import android.provider.Settings;
+import android.util.ArrayMap;
+import android.util.ArraySet;
+import android.util.Base64;
+import android.util.Slog;
+import android.util.SparseArray;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.security.cert.CertificateException;
+
+import lineageos.push.PushBrokerConstants;
+
+public final class LineageCompatibilitySigningPolicy {
+    private static final String TAG = "LineageCompatSign";
+
+    private static volatile LineageCompatibilitySigningPolicy sInstance;
+
+    private final Context mContext;
+    private final ContentObserver mObserver;
+    private final Object mInitLock = new Object();
+    private volatile boolean mObserverRegistered;
+    private volatile SparseArray<ArrayMap<String, AppPolicy>> mPoliciesByUser = new SparseArray<>();
+
+    static LineageCompatibilitySigningPolicy getInstance(Context context) {
+        if (sInstance == null) {
+            synchronized (LineageCompatibilitySigningPolicy.class) {
+                if (sInstance == null) {
+                    sInstance = new LineageCompatibilitySigningPolicy(
+                            context.getApplicationContext());
+                }
+            }
+        }
+        return sInstance;
+    }
+
+    private LineageCompatibilitySigningPolicy(Context context) {
+        mContext = context;
+        mObserver = new ContentObserver(new Handler(Looper.getMainLooper())) {
+            @Override
+            public void onChange(boolean selfChange) {
+                refreshFromSettings();
+            }
+        };
+    }
+
+    SigningDetails getSpoofedSigningDetails(String[] callingPackages, int callingUserId,
+            String queriedPackage, String querySurface) {
+        maybeInitialize();
+        if (!mObserverRegistered) {
+            return null;
+        }
+        if (callingPackages == null || callingPackages.length == 0
+                || queriedPackage == null || queriedPackage.isBlank()
+                || querySurface == null || querySurface.isBlank()) {
+            return null;
+        }
+        final SparseArray<ArrayMap<String, AppPolicy>> policiesByUser = mPoliciesByUser;
+        final ArrayMap<String, AppPolicy> userPolicies = policiesByUser.get(callingUserId);
+        if (userPolicies == null || userPolicies.isEmpty()) {
+            return null;
+        }
+        for (String callingPackage : callingPackages) {
+            if (callingPackage == null || callingPackage.isBlank()) {
+                continue;
+            }
+            final AppPolicy appPolicy = userPolicies.get(callingPackage);
+            if (appPolicy == null) {
+                continue;
+            }
+            final SigningRule rule = appPolicy.rulesByQueriedPackage.get(queriedPackage);
+            if (rule == null || !rule.allowedQuerySurfaces.contains(querySurface)) {
+                continue;
+            }
+            return new SigningDetails(rule.signingDetails);
+        }
+        return null;
+    }
+
+    private void maybeInitialize() {
+        if (mObserverRegistered || !isSystemUserUnlocked()) {
+            return;
+        }
+        initializeForSystemUserUnlocked();
+    }
+
+    private boolean isSystemUserUnlocked() {
+        final UserManager userManager = mContext.getSystemService(UserManager.class);
+        return userManager != null && userManager.isUserUnlocked(UserHandle.SYSTEM);
+    }
+
+    private void initializeForSystemUserUnlocked() {
+        if (mObserverRegistered) {
+            return;
+        }
+        synchronized (mInitLock) {
+            if (mObserverRegistered) {
+                return;
+            }
+            try {
+                mContext.getContentResolver().registerContentObserver(
+                        Settings.Global.getUriFor(
+                                PushBrokerConstants.SETTING_COMPAT_SIGNATURE_SPOOF_POLICY),
+                        false, mObserver, android.os.UserHandle.USER_SYSTEM);
+                mObserverRegistered = true;
+            } catch (NullPointerException | SecurityException e) {
+                Slog.i(TAG, "Compatibility signing policy observer unavailable", e);
+                return;
+            }
+            refreshFromSettings();
+        }
+    }
+
+    private void refreshFromSettings() {
+        try {
+            final String rawPolicy = Settings.Global.getString(mContext.getContentResolver(),
+                    PushBrokerConstants.SETTING_COMPAT_SIGNATURE_SPOOF_POLICY);
+            mPoliciesByUser = parse(rawPolicy);
+        } catch (NullPointerException | SecurityException e) {
+            Slog.i(TAG, "Compatibility signing policy unavailable", e);
+            mPoliciesByUser = new SparseArray<>();
+        }
+    }
+
+    private SparseArray<ArrayMap<String, AppPolicy>> parse(String rawPolicy) {
+        final SparseArray<ArrayMap<String, AppPolicy>> parsed = new SparseArray<>();
+        if (rawPolicy == null || rawPolicy.isBlank()) {
+            return parsed;
+        }
+        try {
+            final JSONObject root = new JSONObject(rawPolicy);
+            final JSONArray apps = root.optJSONArray("apps");
+            if (apps == null) {
+                return parsed;
+            }
+            for (int i = 0; i < apps.length(); i++) {
+                final JSONObject appObject = apps.optJSONObject(i);
+                if (appObject == null) {
+                    continue;
+                }
+                final String packageName = appObject.optString(
+                        PushBrokerConstants.COMPAT_APP_PACKAGE_NAME, null);
+                final int userId = appObject.optInt(PushBrokerConstants.COMPAT_APP_USER_ID, -1);
+                if (packageName == null || packageName.isBlank() || userId < 0) {
+                    continue;
+                }
+                final ArrayMap<String, SigningDetails> identities = parseIdentities(
+                        appObject.optJSONArray(PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITIES));
+                if (identities.isEmpty()) {
+                    continue;
+                }
+                final ArrayMap<String, SigningRule> rules = parseRules(
+                        appObject.optJSONArray(PushBrokerConstants.COMPAT_SIG_SPOOF_ENTRIES),
+                        identities);
+                if (rules.isEmpty()) {
+                    continue;
+                }
+                ArrayMap<String, AppPolicy> userPolicies = parsed.get(userId);
+                if (userPolicies == null) {
+                    userPolicies = new ArrayMap<>();
+                    parsed.put(userId, userPolicies);
+                }
+                userPolicies.put(packageName, new AppPolicy(rules));
+            }
+        } catch (JSONException e) {
+            Slog.w(TAG, "Failed to parse compatibility signing policy", e);
+        }
+        return parsed;
+    }
+
+    private ArrayMap<String, SigningDetails> parseIdentities(JSONArray identitiesArray) {
+        final ArrayMap<String, SigningDetails> identities = new ArrayMap<>();
+        if (identitiesArray == null) {
+            return identities;
+        }
+        for (int i = 0; i < identitiesArray.length(); i++) {
+            final JSONObject identityObject = identitiesArray.optJSONObject(i);
+            if (identityObject == null) {
+                continue;
+            }
+            final String identityId = identityObject.optString(
+                    PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITY_ID, null);
+            if (identityId == null || identityId.isBlank() || identities.containsKey(identityId)) {
+                continue;
+            }
+            final JSONArray certificatesArray = identityObject.optJSONArray(
+                    PushBrokerConstants.COMPAT_SIG_SPOOF_CERTIFICATE_BASE64S);
+            final SigningDetails signingDetails = parseSigningDetails(certificatesArray);
+            if (signingDetails == null) {
+                continue;
+            }
+            identities.put(identityId, signingDetails);
+        }
+        return identities;
+    }
+
+    private ArrayMap<String, SigningRule> parseRules(JSONArray entriesArray,
+            ArrayMap<String, SigningDetails> identities) {
+        final ArrayMap<String, SigningRule> rules = new ArrayMap<>();
+        if (entriesArray == null || identities == null || identities.isEmpty()) {
+            return rules;
+        }
+        for (int i = 0; i < entriesArray.length(); i++) {
+            final JSONObject entryObject = entriesArray.optJSONObject(i);
+            if (entryObject == null) {
+                continue;
+            }
+            final String queriedPackage = entryObject.optString(
+                    PushBrokerConstants.COMPAT_SIG_SPOOF_QUERIED_PACKAGE, null);
+            final String identityId = entryObject.optString(
+                    PushBrokerConstants.COMPAT_SIG_SPOOF_IDENTITY_ID, null);
+            if (queriedPackage == null || queriedPackage.isBlank()
+                    || identityId == null || identityId.isBlank()
+                    || rules.containsKey(queriedPackage)) {
+                continue;
+            }
+            final SigningDetails signingDetails = identities.get(identityId);
+            if (signingDetails == null) {
+                continue;
+            }
+            final JSONArray surfacesArray = entryObject.optJSONArray(
+                    PushBrokerConstants.COMPAT_SIG_SPOOF_ALLOWED_QUERY_SURFACES);
+            final ArraySet<String> allowedQuerySurfaces = parseAllowedQuerySurfaces(surfacesArray);
+            if (allowedQuerySurfaces.isEmpty()) {
+                continue;
+            }
+            rules.put(queriedPackage, new SigningRule(signingDetails, allowedQuerySurfaces));
+        }
+        return rules;
+    }
+
+    private ArraySet<String> parseAllowedQuerySurfaces(JSONArray surfacesArray) {
+        final ArraySet<String> surfaces = new ArraySet<>();
+        if (surfacesArray == null) {
+            return surfaces;
+        }
+        for (int i = 0; i < surfacesArray.length(); i++) {
+            final String surface = surfacesArray.optString(i, null);
+            if (PushBrokerConstants.COMPAT_QUERY_SURFACE_PACKAGE_INFO_SIGNATURES.equals(surface)
+                    || PushBrokerConstants.COMPAT_QUERY_SURFACE_PACKAGE_INFO_SIGNING_INFO.equals(
+                            surface)
+                    || PushBrokerConstants.COMPAT_QUERY_SURFACE_CHECK_SIGNATURES.equals(surface)) {
+                surfaces.add(surface);
+            }
+        }
+        return surfaces;
+    }
+
+    private SigningDetails parseSigningDetails(JSONArray certificatesArray) {
+        if (certificatesArray == null || certificatesArray.length() == 0) {
+            return null;
+        }
+        final Signature[] signatures = new Signature[certificatesArray.length()];
+        int signatureCount = 0;
+        for (int i = 0; i < certificatesArray.length(); i++) {
+            final String certificateBase64 = certificatesArray.optString(i, null);
+            if (certificateBase64 == null || certificateBase64.isBlank()) {
+                continue;
+            }
+            try {
+                signatures[signatureCount++] = new Signature(Base64.decode(certificateBase64,
+                        Base64.DEFAULT));
+            } catch (IllegalArgumentException e) {
+                Slog.w(TAG, "Ignoring invalid compatibility signing certificate", e);
+            }
+        }
+        if (signatureCount == 0) {
+            return null;
+        }
+        final Signature[] exactSignatures = signatureCount == signatures.length
+                ? signatures
+                : java.util.Arrays.copyOf(signatures, signatureCount);
+        try {
+            return new SigningDetails(exactSignatures, SigningDetails.SignatureSchemeVersion.UNKNOWN);
+        } catch (CertificateException e) {
+            Slog.w(TAG, "Failed to build compatibility signing details", e);
+            return null;
+        }
+    }
+
+    private static final class AppPolicy {
+        final ArrayMap<String, SigningRule> rulesByQueriedPackage;
+
+        AppPolicy(ArrayMap<String, SigningRule> rulesByQueriedPackage) {
+            this.rulesByQueriedPackage = rulesByQueriedPackage;
+        }
+    }
+
+    private static final class SigningRule {
+        final SigningDetails signingDetails;
+        final ArraySet<String> allowedQuerySurfaces;
+
+        SigningRule(SigningDetails signingDetails, ArraySet<String> allowedQuerySurfaces) {
+            this.signingDetails = signingDetails;
+            this.allowedQuerySurfaces = allowedQuerySurfaces;
+        }
+    }
+}
