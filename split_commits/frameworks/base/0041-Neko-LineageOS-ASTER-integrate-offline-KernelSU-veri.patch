+    private void readTsaLocalEffective(JSONObject value) throws Exception {
+        if (!text(value, "classification_token").matches("[0-9a-f]{64}")
+                || value.getJSONObject("classification").has("syscall_changed"))
+            throw new IOException("Invalid local classification binding");
+        JSONObject effective = value.getJSONObject("tsa").getJSONObject("effective");
+        integer(effective, "version", 2, 2);
+        expect(effective, "evidence_kind", "partial_resident");
+        if (integer(effective, "sequence", 1, Long.MAX_VALUE) != facts.getLong("sequence"))
+            throw new IOException("Stale local classification");
+        JSONArray proofs = effective.getJSONArray("proofs");
+        if (proofs.length() < 1 || proofs.length() > 8) throw new IOException("Local proof count");
+        TreeSet<String> proved = new TreeSet<>();
+        long now = android.os.SystemClock.elapsedRealtimeNanos(), until = Long.MAX_VALUE;
+        for (int i = 0; i < proofs.length(); ++i) {
+            JSONObject proof = proofs.getJSONObject(i);
+            expect(proof, "evidence_kind", "partial_resident");
+            if (proof.has("load_id") || proof.has("input_length") || proof.has("input_sha256"))
+                throw new IOException("Mixed local proof kinds");
+            String module = text(proof, "module_name"), repo = text(proof, "repository");
+            long id = integer(proof, "resident_id", 1, Long.MAX_VALUE);
+            if (!module.matches("[A-Za-z0-9_][A-Za-z0-9_.-]{0,54}") || !proved.add(module)
+                    || !repo.matches("[A-Za-z0-9_.-]{1,255}/[A-Za-z0-9_.-]{1,255}")
+                    || !validSourceRoot(proof, repo)
+                    || tsaResidentProofs.put(id, proof) != null) throw new IOException("Local proof identity");
+            for (String field : new String[]{"manager_certificate_sha256", "source_sha256", "plan_id"})
+                if (!text(proof, field).matches("[0-9a-f]{64}")) throw new IOException("Local proof digest");
+            integer(proof, "source_length", 64, 8 * 1024 * 1024);
+            integer(proof, "module_epoch", 1, Long.MAX_VALUE);
+            integer(proof, "pm_epoch", 0, Long.MAX_VALUE);
+            long length = integer(proof, "body_length", 32, 1024);
+            long compared = integer(proof, "body_compared", 32, length);
+            long entry = integer(proof, "entry_compared", 4, 8);
+            if (compared * 4 < length * 3 || (entry != 4 && entry != 8)) throw new IOException("Local proof coverage");
+            integer(proof, "native_slot", 0, 1023);
+            expect(proof, "transform_profile", "ksu-orig-undef-abs-v1");
+            expect(proof, "syscall_profile", "ksu-native-unused-dispatcher-v1");
+            long start = integer(proof, "started_ns", 1, Long.MAX_VALUE);
+            long end = integer(proof, "completed_ns", start, Long.MAX_VALUE);
+            long deadline = integer(proof, "valid_until_ns", end, Long.MAX_VALUE);
+            if (end - start >= 20_000_000L || now < end || deadline <= now
+                    || end / 1_000_000L > completed || deadline != Math.addExact(start, 10_000_000_000L))
+                throw new IOException("Local sample lifetime");
+            until = Math.min(until, deadline);
+        }
+        JSONArray resolved = boundedNames(new JSONObject().put("unknown_names", effective.getJSONArray("resolved_names")));
+        TreeSet<String> resolvedNames = new TreeSet<>();
+        for (int i = 0; i < resolved.length(); ++i) {
+            String name = resolved.getString(i);
+            if (!proved.contains(name)) throw new IOException("Unproved local resolution");
+            resolvedNames.add(name);
+        }
+        for (String scope : new String[]{"official", "community"}) {
+            JSONArray raw = boundedNames(new JSONObject().put("unknown_names", effective.getJSONObject("raw_unknown_names").getJSONArray(scope)));
+            TreeSet<String> remaining = new TreeSet<>();
+            for (int i = 0; i < raw.length(); ++i) if (!resolvedNames.contains(raw.getString(i))) remaining.add(raw.getString(i));
+            JSONObject classification = value.getJSONObject("classification").getJSONObject(scope);
+            JSONArray active = names(classification);
+            TreeSet<String> current = new TreeSet<>();
+            for (int i = 0; i < active.length(); ++i) current.add(active.getString(i));
+            if (!remaining.equals(current)) throw new IOException("Invalid local name reduction");
+            JSONArray reasons = effective.getJSONObject("resolved_reasons").getJSONArray(scope);
+            if (reasons.length() > 1) throw new IOException("Local reason count");
+            for (int i = 0; i < reasons.length(); ++i) {
+                if (!"UNKNOWN_MODULE".equals(reasons.getString(i)) || raw.length() == 0 || !current.isEmpty())
+                    throw new IOException("Invalid local reason reduction");
+                (scope.equals("community") ? tsaCommunityReasons : tsaOfficialReasons).add("UNKNOWN_MODULE");
+            }
+        }
+        tsaResolvedNames.addAll(resolvedNames); tsaLocalUntilNs = until;
+    }
