+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.fas;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import android.app.fas.FasManager;
+import java.io.File;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+public class FasConfigStoreTest {
+    @Rule public TemporaryFolder folder = new TemporaryFolder();
+
+    @Test public void defaultsAreOffAndAutomatic() {
+        FasConfigStore store = new FasConfigStore(new File(folder.getRoot(), "fas.json"));
+        assertFalse(store.enabled());
+        assertEquals(FasManager.MODE_AUTO, store.mode(0, "example.game"));
+    }
+
+    @Test public void modesPersistAndAreIsolatedByUser() {
+        File file = new File(folder.getRoot(), "fas.json");
+        FasConfigStore store = new FasConfigStore(file);
+        assertTrue(store.setEnabled(true));
+        for (int mode : new int[] {1, 120, 60, 30, -1}) {
+            assertTrue(store.setMode(0, "example.game", mode));
+            FasConfigStore loaded = new FasConfigStore(file);
+            assertTrue(loaded.enabled());
+            assertEquals(mode, loaded.mode(0, "example.game"));
+            assertEquals(FasManager.MODE_AUTO, loaded.mode(10, "example.game"));
+        }
+        assertTrue(store.setMode(0, "example.game", FasManager.MODE_AUTO));
+        assertFalse(store.snapshot(0).getBundle(FasManager.KEY_MODES).containsKey("example.game"));
+    }
+
+    @Test public void globalOffKeepsOverridesAndRemovedUserDoesNot() {
+        FasConfigStore store = new FasConfigStore(new File(folder.getRoot(), "fas.json"));
+        assertTrue(store.setMode(10, "example.game", 60));
+        assertTrue(store.setEnabled(false));
+        assertEquals(60, store.mode(10, "example.game"));
+        assertTrue(store.removeUser(10));
+        assertEquals(FasManager.MODE_AUTO, store.mode(10, "example.game"));
+    }
+
+    @Test public void failedWriteDoesNotChangeLiveConfiguration() throws Exception {
+        File blocker = folder.newFile("not-a-directory");
+        FasConfigStore store = new FasConfigStore(new File(blocker, "fas.json"));
+        assertFalse(store.setEnabled(true));
+        assertFalse(store.enabled());
+        assertFalse(store.setMode(0, "example.game", 120));
+        assertEquals(FasManager.MODE_AUTO, store.mode(0, "example.game"));
+    }
+
+    @Test(expected = IllegalArgumentException.class)
+    public void rejectsUnsupportedMode() {
+        new FasConfigStore(new File(folder.getRoot(), "fas.json")).setMode(0, "example.game", 90);
+    }
+}
