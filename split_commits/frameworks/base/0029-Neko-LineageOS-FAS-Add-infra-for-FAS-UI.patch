@@ -0,0 +1,93 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.fas;
+
+import android.app.fas.FasManager;
+import android.os.Bundle;
+import android.os.Environment;
+import android.util.AtomicFile;
+import android.util.Slog;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/** Owns the device-wide switch and per-user overrides; absent entries mean automatic. */
+final class FasConfigStore {
+    private final AtomicFile mFile;
+    private JSONObject mData = new JSONObject();
+
+    FasConfigStore() {
+        this(new File(Environment.getDataSystemDirectory(), "fas.json"));
+    }
+
+    FasConfigStore(File file) {
+        mFile = new AtomicFile(file);
+        try {
+            mData = new JSONObject(new String(mFile.readFully(), StandardCharsets.UTF_8));
+        } catch (IOException | JSONException e) {
+            if (mFile.getBaseFile().exists()) Slog.w("FasConfigStore", "Cannot load config", e);
+        }
+    }
+
+    synchronized boolean enabled() { return mData.optBoolean("enabled", false); }
+
+    synchronized int mode(int userId, String pkg) {
+        JSONObject user = mData.optJSONObject(Integer.toString(userId));
+        int mode = user == null ? FasManager.MODE_AUTO : user.optInt(pkg, FasManager.MODE_AUTO);
+        return FasManager.isValidMode(mode) ? mode : FasManager.MODE_AUTO;
+    }
+
+    synchronized Bundle snapshot(int userId) {
+        Bundle result = new Bundle();
+        result.putBoolean(FasManager.KEY_ENABLED, enabled());
+        Bundle modes = new Bundle();
+        JSONObject user = mData.optJSONObject(Integer.toString(userId));
+        if (user != null) {
+            user.keys().forEachRemaining(pkg -> modes.putInt(pkg, mode(userId, pkg)));
+        }
+        result.putBundle(FasManager.KEY_MODES, modes);
+        return result;
+    }
+
+    synchronized boolean setEnabled(boolean enabled) {
+        return mutate(data -> data.put("enabled", enabled));
+    }
+
+    synchronized boolean setMode(int userId, String pkg, int mode) {
+        if (userId < 0 || pkg == null || pkg.isEmpty() || !FasManager.isValidMode(mode)) {
+            throw new IllegalArgumentException("Invalid FAS application mode");
+        }
+        return mutate(data -> {
+            String key = Integer.toString(userId);
+            JSONObject user = data.optJSONObject(key);
+            if (user == null) user = new JSONObject();
+            if (mode == FasManager.MODE_AUTO) user.remove(pkg); else user.put(pkg, mode);
+            if (user.length() == 0) data.remove(key); else data.put(key, user);
+        });
+    }
+
+    synchronized boolean removeUser(int userId) {
+        return mutate(data -> data.remove(Integer.toString(userId)));
+    }
+
+    private interface Mutation { void apply(JSONObject data) throws JSONException; }
+
+    private boolean mutate(Mutation mutation) {
+        FileOutputStream out = null;
+        try {
+            JSONObject next = new JSONObject(mData.toString());
+            mutation.apply(next);
+            out = mFile.startWrite();
+            out.write(next.toString().getBytes(StandardCharsets.UTF_8));
+            mFile.finishWrite(out);
+            mData = next;
+            return true;
+        } catch (IOException | JSONException e) {
+            if (out != null) mFile.failWrite(out);
+            Slog.w("FasConfigStore", "Cannot save config", e);
+            return false;
+        }
+    }
+}
