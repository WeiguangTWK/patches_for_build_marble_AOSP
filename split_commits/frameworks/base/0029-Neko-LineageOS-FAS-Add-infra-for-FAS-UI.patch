+/* SPDX-License-Identifier: Apache-2.0 */
+package android.app.fas;
+
+import android.os.Bundle;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+
+/**
+ * Settings-only client for FAS configuration.
+ * @hide
+ */
+public final class FasManager {
+    public static final String SERVICE_NAME = "fas_manager";
+    public static final int MODE_AUTO = 0;
+    public static final int MODE_ENABLED = 1;
+    public static final int MODE_DISABLED = -1;
+    public static final String KEY_ENABLED = "enabled";
+    public static final String KEY_MODES = "modes";
+
+    public static boolean isValidMode(int mode) {
+        return mode == MODE_AUTO || mode == MODE_ENABLED || mode == MODE_DISABLED
+                || mode == 30 || mode == 60 || mode == 120;
+    }
+
+    private IFasManager service() {
+        final IFasManager service = IFasManager.Stub.asInterface(
+                ServiceManager.getService(SERVICE_NAME));
+        if (service == null) throw new IllegalStateException("FAS service unavailable");
+        return service;
+    }
+
+    public Bundle getConfiguration(int userId) throws RemoteException {
+        return service().getConfiguration(userId);
+    }
+
+    public boolean setEnabled(boolean enabled) throws RemoteException {
+        return service().setEnabled(enabled);
+    }
+
+    public boolean setAppMode(String packageName, int userId, int mode) throws RemoteException {
+        return service().setAppMode(packageName, userId, mode);
+    }
+}
