+        assertFalse(frame.matchesProof(proof));
+        assertTrue(frame.matchesProof(frame.proof())); // callers cannot mutate original
+    }
+
+    /** A real packet is held until the request is observed and the gate changes.
+     * Uses production transport and receipt validation, without changing the live
+     * daemon, service properties, modes or endpoint authorization.
+     */
+    private void delayedCoordination(int change, boolean wrongProof, boolean accepted)
+            throws Exception {
+        AsterNotification.Gate gate = new AsterNotification.Gate();
+        AsterNotification.Frame initial = parse(notice().toString(), null);
+        gate.notice(initial);
+        AsterNotification.Ticket ticket = gate.capture();
+        JSONObject proof = initial.proof();
+        if (wrongProof) proof.put("session", "f".repeat(32));
+        JSONObject reply = new JSONObject().put("kind", "aster.notified_coordination")
+                .put("version", 2).put("notification", proof)
+                .put("receipt", new JSONObject().put("accepted", true));
+        byte[] request = ("COORDINATE_NOTIFIED_V2\t" + new JSONObject()
+                .put("request", new JSONObject().put("action", "acknowledge"))
+                .put("notification", initial.proof())).getBytes(StandardCharsets.UTF_8);
+        FileDescriptor client = new FileDescriptor();
+        FileDescriptor peer = new FileDescriptor();
+        Os.socketpair(OsConstants.AF_UNIX, OsConstants.SOCK_SEQPACKET
+                | OsConstants.SOCK_NONBLOCK | OsConstants.SOCK_CLOEXEC, 0, client, peer);
+        FutureTask<Boolean> result = new FutureTask<>(() -> {
+            // A fresh deadline starts in the RPC thread, not before it is scheduled.
+            String raw = IntegritySocket.transact(client, request,
+                    SystemClock.elapsedRealtime() + 500);
+            try {
+                gate.coordinationReceipt(ticket, new JSONObject(raw));
+                return true;
+            } catch (AsterNotification.Stale expected) {
+                return false;
+            }
+        });
+        Thread rpc = new Thread(result, "AsterDelayedReceiptTest");
+        try {
+            rpc.start();
+            StructPollfd wait = new StructPollfd();
+            wait.fd = peer;
+            wait.events = (short) OsConstants.POLLIN;
+            assertEquals("RPC did not send request", 1, Os.poll(new StructPollfd[]{wait}, 1000));
+            byte[] received = new byte[4096];
+            int count = Os.recvfrom(peer, received, 0, received.length, OsConstants.MSG_TRUNC, null);
+            assertEquals(new String(request, StandardCharsets.UTF_8),
+                    new String(received, 0, count, StandardCharsets.UTF_8));
+            // These transitions happen after send and before the successful reply.
+            if (change == 1) {
+                gate.notice(parse(notice().put("state", "changed").put("serial", 2)
+                        .put("generation", 11).toString(), initial));
+            } else if (change == 2) {
+                gate.interrupted();
+                gate.notice(parse(notice().put("session", "f".repeat(32)).toString(), null));
+                assertTrue(gate.capture().broken);
+            }
+            byte[] packet = reply.toString().getBytes(StandardCharsets.UTF_8);
+            assertEquals(packet.length, Os.sendto(peer, packet, 0, packet.length, 0, null));
+            // Transport/parsing errors propagate through Future.get: only the
+            // production Stale rejection counts as the negative test passing.
+            assertEquals(accepted, result.get(2, TimeUnit.SECONDS).booleanValue());
+        } finally {
+            for (FileDescriptor fd : new FileDescriptor[]{client, peer}) {
+                try { Os.close(fd); } catch (ErrnoException ignored) { }
+            }
+            rpc.join(1000);
+            assertFalse("RPC test thread leaked", rpc.isAlive());
+        }
+    }
+
+    @Test(timeout = 5000) public void realPacketUnchangedTicketAcceptsReceipt() throws Exception {
+        delayedCoordination(0, false, true);
+    }
+
+    @Test(timeout = 5000) public void realPacketAfterHintCannotReuseSuccessfulReceipt() throws Exception {
+        delayedCoordination(1, false, false);
+    }
+
+    @Test(timeout = 5000) public void realPacketAfterReconnectCannotClearInterruption() throws Exception {
+        delayedCoordination(2, false, false);
+    }
+
+    @Test(timeout = 5000) public void realPacketWrongProofCannotConfirmCurrentTicket() throws Exception {
+        delayedCoordination(0, true, false);
+    }
+
+}
diff --git a/services/tests/servicestests/src/com/android/server/platformintegrity/EnvironmentSnapshotTest.java b/services/tests/servicestests/src/com/android/server/platformintegrity/EnvironmentSnapshotTest.java
new file mode 100644
index 000000000..244ba109a
--- /dev/null
+++ b/services/tests/servicestests/src/com/android/server/platformintegrity/EnvironmentSnapshotTest.java
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+import static org.junit.Assert.*;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.junit.Test;
+
+public class EnvironmentSnapshotTest {
+    private static final String BOOT = "ed12be49-1b58-45ca-8204-c27520f7727e";
+    private static final String COMPACT = BOOT.replace("-", "");
+
+    private JSONObject full() throws Exception {
+        return new JSONObject().put("kind", "aster.environment").put("version", 2).put("status", "observed")
+                .put("identity", new JSONObject().put("boot_id", BOOT).put("collector_instance", COMPACT)
+                        .put("collector_identity_kind", "boot_scope").put("classifier_instance", "a".repeat(32))
+                        .put("baseline_sha256", "b".repeat(64)))
+                .put("observation", new JSONObject().put("serial", 1).put("clock", "BOOTTIME")
+                        .put("started_ms", 100).put("completed_ms", 101))
+                .put("collection", new JSONObject().put("status", "consistent").put("backend", "full")
+                        .put("measurement_protocol", 1).put("evidence_sequence", 17)
+                        .put("pending_measurements", 0).put("evidence_lost", false).put("loss_count", 0))
+                .put("coverage", new JSONObject().put("status", "full_measurement").put("full_measurement", true)
+                        .put("raw_hashes_measured", true).put("syscall_measured", true).put("early_history_gap", false)
+                        .put("syscall_abis", 3).put("syscall_check_ns", 123).put("syscall_changed", 0))
+                .put("classification", new JSONObject().put("status", "classified").put("scope", "load_history_and_inventory")
+                        .put("official", new JSONObject().put("status", "classified").put("unknown_modules", 0)
+                                .put("unknown_names", new JSONArray()).put("unknown_overflow", false).put("unapproved_versions", 0)
+                                .put("unapproved_names", new JSONArray()).put("unapproved_names_overflow", false))
+                        .put("community", new JSONObject().put("status", "classified").put("unknown_modules", 0)
+                                .put("unknown_names", new JSONArray()).put("unknown_overflow", false).put("unapproved_versions", 0)
+                                .put("unapproved_names", new JSONArray()).put("unapproved_names_overflow", false)));
+    }
+
+    private JSONObject partial() throws Exception {
+        JSONObject value = full();
+        value.getJSONObject("identity").put("collector_instance", "c".repeat(32))
+                .put("collector_identity_kind", "collector_instance");
+        value.getJSONObject("collection").put("backend", "later_digest").put("measurement_protocol", 4)
+                .put("coverage_gap_mask", 0).put("loss_count", JSONObject.NULL);
+        value.getJSONObject("coverage").put("status", "partial_measurement").put("full_measurement", false)
+                .put("raw_hashes_measured", false).put("syscall_measured", false).put("early_history_gap", true)
+                .put("later_hashes_measured", true).put("early_versions_verified", false).put("early_name_only_rows", 104)
+                .put("syscall_abis", JSONObject.NULL).put("syscall_check_ns", JSONObject.NULL);
+        value.getJSONObject("classification").put("scope", "captured_inputs_and_name_inventory")
+                .put("community", new JSONObject().put("status", "classified").put("unknown_modules", 0)
+                        .put("unknown_names", new JSONArray()).put("unapproved_versions", 0).put("unknown_overflow", false)
+                        .put("unapproved_names", new JSONArray()).put("unapproved_names_overflow", false)
+                        .put("approved_candidate_rows", 2).put("unapproved_candidate_rows", 0));
+        return value;
+    }
+
+    private void rejects(JSONObject value) throws Exception {
+        try {
+            new EnvironmentSnapshot(value, COMPACT, 102);
+            fail("Invalid observation accepted");
+        } catch (Exception expected) { }
+    }
+
+    @Test public void fullAndPartialRemainDistinct() throws Exception {
+        EnvironmentSnapshot a = new EnvironmentSnapshot(full(), COMPACT, 102);
+        EnvironmentSnapshot b = new EnvironmentSnapshot(partial(), COMPACT, 102);
+        assertTrue(a.facts.getBoolean("healthy"));
+        assertFalse(b.facts.getBoolean("healthy"));
+        assertEquals(104, b.facts.getInt("early_name_only_rows"));
+        assertFalse(b.facts.getBoolean("early_versions_verified"));
+        assertTrue(b.facts.isNull("syscall_changed"));
+        assertFalse(b.facts.has("fas_ever_submitted"));
+    }
+
+    @Test public void nullUnsupportedAndCoercedNumbersReject() throws Exception {
+        JSONObject value = full();
+        value.getJSONObject("coverage").put("syscall_measured", JSONObject.NULL);
+        rejects(value);
+        value = full();
+        value.getJSONObject("coverage").put("full_measurement", "true");
+        rejects(value);
+        for (Object number : new Object[]{"17", 17.0, -1}) {
+            value = full();
+            value.getJSONObject("collection").put("evidence_sequence", number);
+            rejects(value);
+        }
+        value = partial();
+        value.getJSONObject("classification").getJSONObject("community").put("status", "unsupported");
+        rejects(value);
+    }
+
+    @Test public void versionIdentityAndFutureClockReject() throws Exception {
+        JSONObject value = full().put("version", 1);
+        rejects(value);
+        value = full();
+        value.getJSONObject("identity").put("collector_instance", "c".repeat(32));
+        rejects(value);
+        value = full();
+        value.getJSONObject("observation").put("completed_ms", 103);
+        rejects(value);
+        try {
+            new EnvironmentSnapshot(full(), COMPACT, 2101);
+            fail("Expired observation accepted");
+        } catch (Exception expected) { }
+        rejects(new JSONObject().put("protocol", 3).put("healthy", true));
+    }
+
+    @Test public void listsAndCoverageMustBeComplete() throws Exception {
+        JSONObject value = full();
+        value.getJSONObject("classification").getJSONObject("official").put("unknown_modules", 1);
+        rejects(value);
+        value = partial();
+        value.getJSONObject("coverage").put("early_versions_verified", true);
+        rejects(value);
+        value = full();
+        value.getJSONObject("collection").put("evidence_lost", true);
+        rejects(value);
+        value = full();
+        value.getJSONObject("collection").put("pending_measurements", 1);
+        rejects(value);
+    }
+
+    @Test public void receiptBindsObservationAndEchoesChallenge() throws Exception {
+        EnvironmentSnapshot sample = new EnvironmentSnapshot(partial(), COMPACT, 102);
+        JSONObject request = sample.request("acknowledge", "community", new JSONArray());
+        JSONObject receipt = new JSONObject(request.toString()).put("kind", "aster.coordination")
+                .put("version", 2).put("accepted", true).put("published", false).put("expires_ms", 2101);
+        sample.validateReceipt(request, receipt, 102);
+        receipt.put("observation_serial", 2);
+        try {
+            sample.validateReceipt(request, receipt, 102);
+            fail("Changed observation accepted");
+        } catch (Exception expected) { }
+        receipt.put("observation_serial", 1).put("challenge", "d".repeat(32));
+        try {
+            sample.validateReceipt(request, receipt, 102);
+            fail("Wrong challenge accepted");
+        } catch (Exception expected) { }
+    }
+
+    @Test public void unionFindingsAreIndependentOfOfficialFindings() throws Exception {
+        JSONObject value = full();
+        value.getJSONObject("classification").getJSONObject("official")
+                .put("unapproved_versions", 1).put("unapproved_names", new JSONArray().put("community_ko"));
+        EnvironmentSnapshot snapshot = new EnvironmentSnapshot(value, COMPACT, 102);
+        assertEquals(1, snapshot.facts.getInt("hash_mismatches"));
+        assertEquals(0, snapshot.facts.getInt("compromise_unapproved_versions"));
+        assertEquals(0, snapshot.facts.getJSONArray("compromise_unapproved_names").length());
+        value.getJSONObject("classification").getJSONObject("community").remove("unapproved_names");
+        rejects(value);
+    }
+
+    @Test public void receiptCannotChangeHostOrHistoryGeneration() throws Exception {
+        EnvironmentSnapshot snapshot = new EnvironmentSnapshot(full(), COMPACT, 102);
+        JSONObject request = snapshot.request("publish", "community", new JSONArray())
+                .put("host_revision", 8).put("history_generation", 3);
+        JSONObject valid = new JSONObject(request.toString()).put("kind", "aster.coordination")
+                .put("version", 2).put("accepted", true).put("published", true).put("expires_ms", 2101);
+        snapshot.validateReceipt(request, valid, 102);
+        for (String field : new String[]{"host_revision", "history_generation"}) {
+            JSONObject changed = new JSONObject(valid.toString()).put(field, 99);
+            try {
+                snapshot.validateReceipt(request, changed, 102);
+                fail("Changed host generation accepted");
+            } catch (java.io.IOException expected) { }
+        }
+    }
+}
