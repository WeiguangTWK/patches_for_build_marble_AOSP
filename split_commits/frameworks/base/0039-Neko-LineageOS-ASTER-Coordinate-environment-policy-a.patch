+    private void runSyscallRecheck() {
+        final int pending;
+        synchronized (mLock) {
+            mRecheckQueued = false;
+            if (mShutdown.closing()) { mRecheckPending = 0; return; }
+            mRecheckRunning = true;
+            pending = mRecheckPending; mRecheckPending = 0;
+            mRecheckStatus = "running"; mRecheckReply = "";
+        }
+        try {
+            EnvironmentSnapshot snapshot = readEnvironment();
+            JSONObject request;
+            synchronized (mLock) {
+                if (mShutdown.closing()) return;
+                String collector = snapshot.facts.getString("collector_instance");
+                String marker = mBoot + ":" + collector;
+                boolean full = "full".equals(snapshot.facts.getString("collector_backend"));
+                long minimum = full ? Math.addExact(snapshot.report.getJSONObject("coverage")
+                        .getLong("syscall_check_ns"), 1L) : 0;
+                mRecheckCollector = collector; mRecheckClassifier = snapshot.classifier;
+                mRecheckBaseline = snapshot.facts.getString("baseline_sha256");
+                int triggers = pending;
+                long previousMinimum = 0;
+                for (String key : new String[]{"boot", "ce"}) {
+                    int bit = key.equals("boot") ? RECHECK_BOOT : RECHECK_CE;
+                    JSONObject previous = mAutoRecheckAttempts.optJSONObject(key);
+                    if ((triggers & bit) != 0 && previous != null && marker.equals(previous.getString("identity"))) {
+                        triggers &= ~bit;
+                        previousMinimum = Math.max(previousMinimum, previous.getLong("minimum_ns"));
+                    }
+                }
+                if (triggers == 0) {
+                    mRecheckMinimumNs = full ? previousMinimum : 0;
+                    mRecheckBlocksFull = full && previousMinimum != 0;
+                    mRecheckStatus = full ? "waiting_report" : "unsupported";
+                    return;
+                }
+                if ((triggers & (RECHECK_BOOT | RECHECK_CE)) != 0) {
+                    // Claim before sending: an ambiguous reply/restart cannot repeat
+                    // an automatic kernel action. This adds no alarm/history reset.
+                    JSONObject claim = new JSONObject().put("identity", marker).put("minimum_ns", minimum);
+                    if ((triggers & RECHECK_BOOT) != 0) mAutoRecheckAttempts.put("boot", claim);
+                    if ((triggers & RECHECK_CE) != 0) mAutoRecheckAttempts.put("ce", claim);
+                    if (!mRecordValid || !saveLocked(mRequested, mRequestBoot))
+                        throw new IOException("Cannot claim automatic recheck");
+                }
+                mRecheckMinimumNs = minimum;
+                mRecheckBlocksFull = full;
+                request = new JSONObject().put("boot_id", snapshot.bootId)
+                        .put("collector_instance", collector).put("classifier_instance", snapshot.classifier)
+                        .put("baseline_sha256", mRecheckBaseline).put("triggers", triggers)
+                        .put("request_id", UUID.randomUUID().toString().replace("-", ""));
+            }
+            JSONObject reply = new JSONObject(exchange("platform_integrity", "RECHECK_V1\t" + request));
+            if (!"aster.syscall_recheck".equals(reply.getString("kind"))
+                    || EnvironmentSnapshot.integer(reply, "version", 1, 1) != 1)
+                throw new IOException("Invalid recheck reply");
+            JSONObject echoed = reply.getJSONObject("request");
+            if (echoed.length() != request.length()) throw new IOException("Recheck binding changed");
+            for (String field : new String[]{"boot_id", "collector_instance", "classifier_instance", "baseline_sha256", "request_id"})
+                if (!request.getString(field).equals(echoed.getString(field)))
+                    throw new IOException("Recheck identity changed");
+            if (EnvironmentSnapshot.integer(echoed, "triggers", 1, 7) != request.getInt("triggers"))
+                throw new IOException("Recheck triggers changed");
+            synchronized (mLock) {
+                mRecheckReply = reply.toString();
+                String status = reply.getString("status");
+                if (status.equals("unsupported") && "later_digest".equals(snapshot.facts.getString("collector_backend"))) {
+                    mRecheckStatus = "unsupported";
+                    mRecheckBlocksFull = false; mRecheckMinimumNs = 0;
+                } else if (status.equals("sampled") && "full".equals(snapshot.facts.getString("collector_backend"))) {
+                    long before = EnvironmentSnapshot.integer(reply, "before_check_ns", 0, Long.MAX_VALUE - 1);
+                    long after = EnvironmentSnapshot.integer(reply, "after_check_ns", before + 1, Long.MAX_VALUE);
+                    if (before < snapshot.report.getJSONObject("coverage").getLong("syscall_check_ns"))
+                        throw new IOException("Recheck timestamp moved backwards");
+                    mRecheckMinimumNs = after;
+                    mRecheckStatus = "waiting_report";
+                } else {
+                    mRecheckStatus = status.equals("throttled") ? "throttled" : "failed";
+                }
+            }
+        } catch (Exception e) {
+            synchronized (mLock) {
+                mRecheckStatus = "failed"; mRecheckReply = e.getClass().getSimpleName() + ": " + e.getMessage();
+            }
+        } finally {
+            synchronized (mLock) {
+                mRecheckRunning = false;
+                mRecheckNotBefore = SystemClock.elapsedRealtime() + 1000;
+                if (!mShutdown.closing()) {
+                    if (mRecheckPending != 0) {
+                        mRecheckQueued = true;
+                        mRecheckStatus = "queued";
+                        mRecheckBlocksFull = true; mRecheckMinimumNs = 0;
+                        mHandler.postDelayed(mRecheckWork, 1000);
+                    }
+                    mHandler.removeCallbacks(mPoll); mHandler.post(mPoll);
+                }
+            }
+        }
+    }
+
+    private void observeRecheckLocked(EnvironmentSnapshot snapshot) throws Exception {
+        if (mRecheckMinimumNs == 0) return;
+        if (!mRecheckCollector.equals(snapshot.facts.getString("collector_instance"))
+                || !mRecheckClassifier.equals(snapshot.classifier)
+                || !mRecheckBaseline.equals(snapshot.facts.getString("baseline_sha256"))) {
+            mRecheckStatus = "failed"; mRecheckMinimumNs = 0;
+            return;
+        }
+        if ("full".equals(snapshot.facts.getString("collector_backend"))
+                && snapshot.report.getJSONObject("coverage").getLong("syscall_check_ns") >= mRecheckMinimumNs) {
+            mRecheckStatus = "completed"; mRecheckMinimumNs = 0; mRecheckBlocksFull = false;
+        }
+    }
