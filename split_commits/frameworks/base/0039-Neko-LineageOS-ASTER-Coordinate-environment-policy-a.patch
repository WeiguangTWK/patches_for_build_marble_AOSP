+    private static final Object sVisibilityLeaseCacheLock = new Object();
+    private static volatile boolean sVisibilityLeaseAllowed = true;
+
+    /** Refresh local query results when a visibility lease expires without a property write.
+     * @hide */
+    public static void refreshLineageVisibilityCaches() {
+        if (!android.os.PlatformIntegrity.enabled()) return;
+        boolean allowed = android.os.PlatformIntegrity.allowed(android.os.PlatformIntegrity.VISIBILITY);
+        if (sVisibilityLeaseAllowed == allowed) return;
+        synchronized (sVisibilityLeaseCacheLock) {
+            if (sVisibilityLeaseAllowed == allowed) return;
+            sApplicationInfoCache.clear();
+            sPackageInfoCache.clear();
+            android.app.ApplicationPackageManager.sGetPackagesForUidCache.clear();
+            android.app.ApplicationPackageManager.sQueryIntentActivitiesCache.clear();
+            sVisibilityLeaseAllowed = allowed;
+        }
+    }
+
     /** @hide */
     public static ApplicationInfo getApplicationInfoAsUserCached(
             String packageName, @ApplicationInfoFlagsBits long flags, int userId) {
+        refreshLineageVisibilityCaches();
         return sApplicationInfoCache.query(
                 new ApplicationInfoQuery(packageName, flags, userId));
