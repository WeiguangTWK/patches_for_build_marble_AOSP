+            modulePublication = snapshot.request("publish", "community", publicationHistoryLocked());
+        }
+        // Report module findings even when a later FAS/TEE binding is unavailable.
+        // The final ACK below separately binds the feature authorization decision.
+        JSONObject moduleReceipt = coordinate(modulePublication, ticket);
+        snapshot.validateReceipt(modulePublication, moduleReceipt, SystemClock.elapsedRealtime());
+        synchronized (mLock) {
+            if (revision != mRevision || !identity.equals(identityLocked()) || mShutdown.closing()) return;
+            mNotificationGate.verify(ticket, snapshot, SystemClock.elapsedRealtime());
