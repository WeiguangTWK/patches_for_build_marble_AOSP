+    private static String exchange(String socketName, String request) throws IOException {
+        return IntegritySocket.exchange(socketName, request);
+    }
+
+    private boolean writePermitProperty(String value) {
+        boolean locked = false;
+        try {
+            String written;
+            if (mShutdown.closing()) {
+                long deadline = SystemClock.elapsedRealtime() + 500;
+                locked = mPermitWriteLock.tryLock(500, TimeUnit.MILLISECONDS);
+                if (!locked) throw new IOException("Permit writer busy during shutdown");
+                written = value == null
+                        ? ShutdownPermitWriter.zeroFor(SystemProperties.get(PlatformIntegrity.PROPERTY, ""), SystemClock.elapsedRealtime())
+                        : value.isEmpty() || value.endsWith(":0") ? value : "";
+                ShutdownPermitWriter.set(written, deadline);
+            } else {
+                mPermitWriteLock.lock();
+                locked = true;
+                // beginShutdown may have raced the lock acquisition.
+                if (mShutdown.closing()) {
+                    written = value.isEmpty() || value.endsWith(":0") ? value : "";
+                    ShutdownPermitWriter.set(written, SystemClock.elapsedRealtime() + 500);
+                } else {
+                    written = value;
+                    SystemProperties.set(PlatformIntegrity.PROPERTY, written);
+                }
+            }
+            if (!written.equals(SystemProperties.get(PlatformIntegrity.PROPERTY, "")))
+                throw new IOException("Permit publication readback mismatch");
+            mPermitRenewal.succeeded(written);
+            return true;
+        } catch (IOException | InterruptedException | RuntimeException e) {
+            if (e instanceof InterruptedException) Thread.currentThread().interrupt();
+            if (locked) mPermitRenewal.failed();
+            mShutdown.fail();
+            Slog.w("PlatformIntegrity", "Permit publication unconfirmed", e);
+            return false;
+        } finally {
+            if (locked) mPermitWriteLock.unlock();
+        }
+    }
