+        synchronized (mLock) {
+            if (revision != mRevision || !identity.equals(identityLocked()) || mShutdown.closing()) return;
+            mNotificationGate.verify(ticket, snapshot, SystemClock.elapsedRealtime());
+            if (SystemClock.elapsedRealtime() >= facts.getLong("resident_until_ms")) throw new EnvironmentSnapshot.Pending();
+            boolean changed = (!mCollector.isEmpty() && !mCollector.equals(collector))
+                    || (!mClassifier.isEmpty() && !mClassifier.equals(classifier))
+                    || (!mDaemon.isEmpty() && !mDaemon.equals(daemon))
+                    || (!mBackend.isEmpty() && !mBackend.equals(backend))
+                    || (!mTee.isEmpty() && !mTee.equals(tee));
+            if (changed) {
