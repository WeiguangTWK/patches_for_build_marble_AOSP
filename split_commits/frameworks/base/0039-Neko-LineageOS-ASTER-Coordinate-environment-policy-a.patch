diff --git a/services/core/java/com/android/server/platformintegrity/AsterNotification.java b/services/core/java/com/android/server/platformintegrity/AsterNotification.java
new file mode 100644
index 000000000..15a1ead9e
--- /dev/null
+++ b/services/core/java/com/android/server/platformintegrity/AsterNotification.java
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+import android.util.JsonReader;
+import android.util.JsonToken;
+import java.io.IOException;
+import java.io.StringReader;
+import java.util.HashSet;
+import java.util.concurrent.atomic.AtomicReference;
+import org.json.JSONObject;
+
+/** Strict user-space hint protocol and local validation tickets; no feature policy. */
+final class AsterNotification {
+    static final class Stale extends IOException {
+        private static final long serialVersionUID = 1L;
+        Stale(String message) { super(message); }
+    }
+    static final class Rejected extends IOException {
+        private static final long serialVersionUID = 1L;
+        Rejected(String reason) { super(reason); }
+    }
+    private static final String[] ID_FIELDS = {"boot_id", "collector_instance",
+            "classifier_instance", "baseline_sha256"};
+
+    private static JSONObject object(JsonReader reader, int depth) throws Exception {
+        if (depth > 1) throw new IOException("Nested notice object");
+        JSONObject result = new JSONObject();
+        HashSet<String> names = new HashSet<>();
+        reader.beginObject();
+        while (reader.hasNext()) {
+            String name = reader.nextName();
+            if (!names.add(name) || names.size() > 12) throw new IOException("Duplicate/oversized notice object");
+            JsonToken token = reader.peek();
+            if (token == JsonToken.STRING) result.put(name, reader.nextString());
+            else if (token == JsonToken.NUMBER) {
+                String literal = reader.nextString();
+                if (!literal.matches("0|[1-9][0-9]*")) throw new IOException("Non-integral notice field");
+                result.put(name, Long.parseLong(literal));
+            } else if (token == JsonToken.BEGIN_OBJECT && "identity".equals(name)) {
+                result.put(name, object(reader, depth + 1));
+            } else throw new IOException("Invalid notice value");
+        }
+        reader.endObject();
+        return result;
+    }
+
+    private static String text(JSONObject value, String key) throws Exception {
+        Object result = value.get(key);
+        if (!(result instanceof String)) throw new IOException("Invalid notice text");
+        return (String) result;
+    }
+
+    private static String token(JSONObject value, String key) throws Exception {
+        String result = text(value, key);
+        if (!result.matches("[0-9a-f]{32}") || result.matches("0{32}"))
+            throw new IOException("Invalid notice token");
+        return result;
+    }
+
+    static final class Frame {
+        final String session, challenge, stream, ack;
+        final String boot, collector, classifier, baseline;
+        final long serial, generation, sequence, pending;
+        final int protocol, mask;
+        private final JSONObject proof;
+
+        Frame(String raw, JSONObject expected, int expectedProtocol, String expectedChallenge,
+                Frame previous) throws Exception {
+            JSONObject value;
+            try (JsonReader reader = new JsonReader(new StringReader(raw))) {
+                reader.setLenient(false);
+                value = object(reader, 0);
+                if (reader.peek() != JsonToken.END_DOCUMENT) throw new IOException("Extra notice data");
+            }
+            if (value.length() != 12 || !"aster.notification".equals(text(value, "kind"))
+                    || EnvironmentSnapshot.integer(value, "version", 1, 1) != 1)
+                throw new IOException("Invalid notice envelope");
+            JSONObject id = value.getJSONObject("identity");
+            if (id.length() != 5) throw new IOException("Invalid notice identity fields");
+            for (String key : ID_FIELDS)
+                if (!text(id, key).equals(text(expected, key))) throw new IOException("Notice identity changed");
+            boot = text(id, "boot_id");
+            collector = text(id, "collector_instance");
+            classifier = text(id, "classifier_instance");
+            baseline = text(id, "baseline_sha256");
+            stream = token(id, "notification_stream");
+            session = token(value, "session");
+            challenge = token(value, "challenge");
+            if (!challenge.equals(expectedChallenge)) throw new IOException("Notice challenge mismatch");
+            serial = EnvironmentSnapshot.integer(value, "serial", 1, Long.MAX_VALUE);
+            generation = EnvironmentSnapshot.integer(value, "generation", 0, Long.MAX_VALUE);
+            sequence = EnvironmentSnapshot.integer(value, "evidence_sequence", 0, Long.MAX_VALUE);
+            pending = EnvironmentSnapshot.integer(value, "pending", 0, Long.MAX_VALUE);
+            protocol = (int) EnvironmentSnapshot.integer(value, "measurement_protocol", 1, 4);
+            mask = (int) EnvironmentSnapshot.integer(value, "change_mask", 0, 15);
+            if ((protocol != 1 && protocol != 4) || protocol != expectedProtocol
+                    || (protocol == 4 && !stream.equals(collector)))
+                throw new IOException("Notice measurement/stream mismatch");
+            if (previous == null) {
+                if (serial != 1 || !"initial".equals(text(value, "state")))
+                    throw new IOException("Missing initial notice");
+            } else if (!"changed".equals(text(value, "state"))
+                    || !session.equals(previous.session) || !stream.equals(previous.stream)
+                    || previous.serial == Long.MAX_VALUE || serial != previous.serial + 1
+                    || generation <= previous.generation || sequence < previous.sequence
+                    || (mask & previous.mask) != previous.mask) {
+                throw new IOException("Notice stream/serial regressed");
+            }
+            ack = "ACK_NOTIFY_V1\t" + value;
+            proof = value;
+        }
+
+        JSONObject proof() throws Exception { return new JSONObject(proof.toString()); }
+
+        boolean matchesProof(JSONObject received) throws Exception { return sameObject(proof, received); }
+
+        private static boolean sameObject(JSONObject expected, JSONObject actual) throws Exception {
+            if (actual == null || expected.length() != actual.length()) return false;
+            java.util.Iterator<String> keys = expected.keys();
+            while (keys.hasNext()) {
+                String key = keys.next();
+                Object left = expected.get(key), right = actual.get(key);
+                if (left instanceof JSONObject) {
+                    if (!(right instanceof JSONObject) || !sameObject((JSONObject) left, (JSONObject) right)) return false;
+                } else if (left instanceof Long || left instanceof Integer) {
+                    if (!(right instanceof Long) && !(right instanceof Integer)) return false;
+                    if (((Number) left).longValue() != ((Number) right).longValue()) return false;
+                } else if (!(right instanceof String) || !left.equals(right)) return false;
+            }
+            return true;
+        }
+
+        void verify(EnvironmentSnapshot snapshot) throws Exception {
+            JSONObject id = snapshot.report.getJSONObject("identity");
+            if (!boot.equals(snapshot.bootId) || !collector.equals(text(id, "collector_instance"))
+                    || !classifier.equals(snapshot.classifier) || !baseline.equals(text(id, "baseline_sha256"))
+                    || snapshot.facts.getLong("sequence") < sequence || pending != 0
+                    || snapshot.report.getJSONObject("collection").getInt("measurement_protocol") != protocol)
+                throw new IOException("Environment does not confirm latest notice");
+        }
+    }
+
+    static final class Ticket {
+        final long epoch;
+        final Frame frame;
+        final boolean broken;
+        final long interruptions;
+        final boolean sealed;
+        Ticket(long epoch, Frame frame, boolean broken, long interruptions) {
+            this(epoch, frame, broken, interruptions, false);
+        }
+        private Ticket(long epoch, Frame frame, boolean broken, long interruptions, boolean sealed) {
+            this.epoch = epoch; this.frame = frame; this.broken = broken;
+            this.interruptions = interruptions;
+            this.sealed = sealed;
+        }
+    }
+
+    static final class Gate {
+        private final AtomicReference<Ticket> current =
+                new AtomicReference<>(new Ticket(0, null, false, 0));
+        Ticket capture() { return current.get(); }
+        void notice(Frame frame) {
+            current.updateAndGet(old -> old.sealed ? old : new Ticket(old.epoch == Long.MAX_VALUE ? old.epoch : old.epoch + 1,
+                    frame, old.broken || old.epoch == Long.MAX_VALUE, old.interruptions));
+        }
+        // Only a fresh initial handshake may retire a broken transport ticket.
+        // Host mode latches and endpoint checks remain independent of this gate.
+        void rebound(Frame frame) {
+            current.updateAndGet(old -> {
+                if (old.sealed) return old;
+                boolean fresh = old.broken && old.frame != null && frame.serial == 1
+                        && !frame.challenge.equals(old.frame.challenge)
+                        && !frame.session.equals(old.frame.session);
+                return new Ticket(old.epoch == Long.MAX_VALUE ? old.epoch : old.epoch + 1,
+                        frame, (!fresh && old.broken) || old.epoch == Long.MAX_VALUE, old.interruptions);
+            });
+        }
+        void interrupted() {
+            current.updateAndGet(old -> old.sealed ? old : new Ticket(old.epoch == Long.MAX_VALUE ? old.epoch : old.epoch + 1,
+                    old.frame, true, old.interruptions == Long.MAX_VALUE ? old.interruptions : old.interruptions + 1));
+        }
+        boolean seal(Ticket ticket) {
+            return isCurrent(ticket) && current.compareAndSet(ticket,
+                    new Ticket(ticket.epoch == Long.MAX_VALUE ? ticket.epoch : ticket.epoch + 1,
+                            ticket.frame, true, ticket.interruptions, true));
+        }
+        boolean isCurrent(Ticket ticket) {
+            return current.get() == ticket && !ticket.broken && ticket.frame != null;
+        }
+        // Shared with the real RPC caller: successful I/O is not permission to
+        // reuse a reply after the notification ticket has changed.
+        JSONObject coordinationReceipt(Ticket ticket, JSONObject reply) throws Exception {
+            if (reply.length() != 4 || !"aster.notified_coordination".equals(reply.getString("kind"))
+                    || EnvironmentSnapshot.integer(reply, "version", 3, 3) != 3
+                    || ticket.frame == null
+                    || !ticket.frame.matchesProof(reply.getJSONObject("notification"))
+                    || !isCurrent(ticket))
+                throw new Stale("Notification transport confirmation changed");
+            JSONObject receipt = reply.getJSONObject("receipt");
+            if (!Boolean.TRUE.equals(receipt.opt("accepted"))) {
+                String reason = receipt.optString("rejection", "PROTOCOL_REJECTED");
+                if (reason.equals("NOTIFICATION_PENDING") || reason.equals("REPORT_SUPERSEDED")
+                        || reason.equals("EVIDENCE_ADVANCED"))
+                    throw new Stale("Notification coordination not yet confirmed");
+                if (!reason.matches("REFERENCE_UNAVAILABLE|COVERAGE_INCOMPLETE|COLLECTOR_UNAVAILABLE|PUBLICATION_FAILED|REQUEST_INVALID|PROTOCOL_REJECTED"))
+                    throw new IOException("Invalid coordination rejection code");
+                throw new Rejected(reason);
+            }
+            return receipt;
+        }
+        void verify(Ticket ticket, EnvironmentSnapshot snapshot, long now) throws Exception {
+            if (!isCurrent(ticket) || now < snapshot.completed || now - snapshot.completed >= 2000)
+                throw new Stale("Notification confirmation unbound, superseded or stale");
+            try { ticket.frame.verify(snapshot); }
+            catch (Exception e) { throw new Stale("Environment does not confirm latest notice"); }
+            // Logical commit boundary: later hints revoke subsequent work. This
+            // is not a global atomic snapshot or rollback of in-flight I/O.
+            if (!current.compareAndSet(ticket, ticket)) throw new Stale("Notification changed at commit");
+        }
+    }
+}
diff --git a/services/core/java/com/android/server/platformintegrity/AsterNotificationClient.java b/services/core/java/com/android/server/platformintegrity/AsterNotificationClient.java
new file mode 100644
index 000000000..e683c2cb9
--- /dev/null
+++ b/services/core/java/com/android/server/platformintegrity/AsterNotificationClient.java
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+import android.os.SystemClock;
+import android.system.Os;
+import android.system.OsConstants;
+import android.system.ErrnoException;
+import java.io.FileDescriptor;
+import java.util.UUID;
+import org.json.JSONObject;
+
+/** One authenticated subscription. No classification, policy or idle heartbeat. */
+final class AsterNotificationClient implements Runnable {
+    interface Listener {
+        void onNotice(AsterNotification.Frame frame);
+        void onInterrupted();
+    }
+    private final Listener listener;
+    private Input input;
+    private boolean waitingForInput;
+    private volatile boolean stopping;
+    private FileDescriptor ownedFd;
+    private volatile String status = "WAITING_FOR_REPORT";
+    private volatile String lastFailure = "";
+
+    private static final class Input {
+        final JSONObject identity;
+        final int protocol;
+        final long expires;
+        Input(EnvironmentSnapshot snapshot) throws Exception {
+            identity = new JSONObject(snapshot.report.getJSONObject("identity").toString());
+            protocol = snapshot.report.getJSONObject("collection").getInt("measurement_protocol");
+            expires = snapshot.completed + 2000;
+        }
+    }
+
+    AsterNotificationClient(Listener listener) { this.listener = listener; }
+    void start() { new Thread(this, "AsterNotifications").start(); }
+    String status() { return status; }
+    String lastFailure() { return lastFailure; }
+
+    synchronized void offer(EnvironmentSnapshot snapshot) throws Exception {
+        if (stopping) return;
+        input = new Input(snapshot);
+        if (waitingForInput) notifyAll();
+    }
+
+    private synchronized Input awaitInput(long retryAt) throws InterruptedException {
+        for (;;) {
+            if (stopping) return null;
+            long delay = retryAt - SystemClock.uptimeMillis();
+            if (delay > 0) {
+                waitingForInput = false;
+                wait(delay);
+            } else if (input == null || SystemClock.elapsedRealtime() >= input.expires) {
+                waitingForInput = true;
+                wait();
+            } else {
+                waitingForInput = false;
+                return input;
+            }
+        }
+    }
+
+    // The connecting worker has authenticated this fd and retains its close.
+    synchronized boolean attach(FileDescriptor fd) {
+        if (stopping || ownedFd != null) return false;
+        ownedFd = fd;
+        return true;
+    }
+
+    // Called only after the host has sealed the exact notification ticket.
+    // Shutdown wakes a blocking receive; only the worker closes its descriptor.
+    synchronized void stopForShutdown() {
+        stopping = true;
+        notifyAll();
+        if (ownedFd != null) {
+            try { Os.shutdown(ownedFd, OsConstants.SHUT_RDWR); } catch (ErrnoException ignored) { }
+        }
+    }
+
+    @Override public void run() {
+        boolean everBound = false;
+        boolean interruptionReported = false;
+        long retryAt = 0, backoff = 1000;
+        for (;;) {
+            FileDescriptor fd = null;
+            try {
+                Input selected = awaitInput(retryAt);
+                if (selected == null) { status = "STOPPED_FOR_SHUTDOWN"; return; }
+                String challenge = UUID.randomUUID().toString().replace("-", "");
+                JSONObject request = new JSONObject().put("version", 1).put("challenge", challenge);
+                for (String key : new String[]{"boot_id", "collector_instance", "classifier_instance", "baseline_sha256"})
+                    request.put(key, selected.identity.getString(key));
+                status = "CONNECTING";
+                fd = IntegritySocket.connect("platform_integrity", SystemClock.elapsedRealtime() + 500);
+                if (!attach(fd)) { status = "STOPPED_FOR_SHUTDOWN"; return; }
+                IntegritySocket.sendNotice(fd, "SUBSCRIBE_V1\t" + request);
+                AsterNotification.Frame previous = null;
+                for (;;) {
+                    String raw = IntegritySocket.receiveNotice(fd, previous == null);
+                    AsterNotification.Frame frame = new AsterNotification.Frame(raw, selected.identity,
+                            selected.protocol, challenge, previous);
+                    if (stopping) { status = "STOPPED_FOR_SHUTDOWN"; return; }
+                    everBound = true;
+                    interruptionReported = false;
+                    status = "CONNECTED";
+                    // Listener only changes an independent ticket/posts work;
+                    // it must not acquire the host lock or block ACK delivery.
+                    listener.onNotice(frame);
+                    IntegritySocket.sendNotice(fd, frame.ack);
+                    previous = frame;
+                    // Do not reset failure backoff after a short-lived handshake.
+                    // A fresh valid report drives retries; no periodic heartbeat.
+                }
+            } catch (InterruptedException e) {
+                if (stopping) { status = "STOPPED_FOR_SHUTDOWN"; return; }
+                if (everBound && !interruptionReported) listener.onInterrupted();
+                Thread.currentThread().interrupt();
+                status = "STOPPED";
+                return;
+            } catch (Exception e) {
+                if (stopping) { status = "STOPPED_FOR_SHUTDOWN"; return; }
+                String failure = (e.getClass().getSimpleName() + ": " + e.getMessage())
+                        .replace('\n', ' ').replace('\r', ' ');
+                lastFailure = failure.substring(0, Math.min(failure.length(), 256));
+                if (everBound && !interruptionReported) {
+                    interruptionReported = true;
+                    listener.onInterrupted();
+                }
+                status = everBound ? "INTERRUPTED_RETRYING" : "UNAVAILABLE_QUERY_ONLY";
+                retryAt = SystemClock.uptimeMillis() + backoff;
+                backoff = Math.min(backoff * 2, 30000);
+            } finally {
+                synchronized (this) {
+                    if (ownedFd == fd) ownedFd = null;
+                }
+                IntegritySocket.close(fd);
+            }
+        }
+    }
+}
diff --git a/services/core/java/com/android/server/platformintegrity/EnvironmentSnapshot.java b/services/core/java/com/android/server/platformintegrity/EnvironmentSnapshot.java
new file mode 100644
index 000000000..bdce840c1
--- /dev/null
+++ b/services/core/java/com/android/server/platformintegrity/EnvironmentSnapshot.java
@@ -0,0 +1,415 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+import android.os.Bundle;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Locale;
+import java.util.TreeSet;
+import java.util.UUID;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/** Strict host adapter for ASTER observations. This class issues no permission. */
+final class EnvironmentSnapshot {
+    static final class Pending extends IOException {
+        private static final long serialVersionUID = 1L;
+        Pending() { super("Collector snapshot is changing or measurements are pending"); }
+    }
+    static final long MAX_AGE_MS = 2000;
+    final JSONObject report;
+    // Private-to-host policy inputs, not another daemon/wire protocol.
+    final JSONObject facts = new JSONObject();
+    final String bootId;
+    final String classifier;
+    final long serial;
+    final long completed;
+    // Optional presentation only. Never copied into the policy facts object.
+    String tsaStatus = "unavailable";
+    boolean tsaSourceReady;
+    Bundle tsaSourceState = new Bundle();
+    final ArrayList<Bundle> tsaCandidates = new ArrayList<>();
+    final TreeSet<String> tsaResolvedNames = new TreeSet<>();
+    final TreeSet<String> tsaOfficialReasons = new TreeSet<>(), tsaCommunityReasons = new TreeSet<>();
+
+    static long integer(JSONObject value, String key, long min, long max) throws Exception {
+        Object n = value.get(key);
+        if (!(n instanceof Integer) && !(n instanceof Long))
+            throw new IOException("Non-integral environment field: " + key);
+        long result = ((Number) n).longValue();
+        if (result < min || result > max) throw new IOException("Environment bound: " + key);
+        return result;
+    }
+
+    static boolean bool(JSONObject value, String key) throws Exception {
+        Object result = value.get(key);
+        if (!(result instanceof Boolean)) throw new IOException("Non-boolean environment field: " + key);
+        return (Boolean) result;
+    }
+
+    private static String text(JSONObject value, String key) throws Exception {
+        Object result = value.get(key);
+        if (!(result instanceof String)) throw new IOException("Non-string environment field: " + key);
+        return (String) result;
+    }
+
+    private static void expect(JSONObject value, String key, String expected) throws Exception {
+        if (!expected.equals(text(value, key))) throw new IOException("Environment field: " + key);
+    }
+
+    static JSONArray boundedNames(JSONObject scope) throws Exception {
+        JSONArray result = scope.getJSONArray("unknown_names");
+        if (result.length() > 512) throw new IOException("Oversize unknown-name list");
+        TreeSet<String> unique = new TreeSet<>();
+        for (int i = 0; i < result.length(); i++) {
+            Object item = result.get(i);
+            if (!(item instanceof String)) throw new IOException("Invalid module name type");
+            String name = (String) item;
+            if (name.isEmpty() || name.length() >= 64 || name.indexOf('\0') >= 0
+                    || name.indexOf('\r') >= 0 || name.indexOf('\n') >= 0 || !unique.add(name))
+                throw new IOException("Invalid module name");
+        }
+        return result;
+    }
+
+    private static JSONArray names(JSONObject scope) throws Exception {
+        long count = integer(scope, "unknown_modules", 0, Integer.MAX_VALUE);
+        JSONArray result = boundedNames(scope);
+        boolean overflowPrefix = Boolean.TRUE.equals(scope.opt("unknown_overflow"))
+                && count > 512 && result.length() == 512;
+        if (result.length() != count && !overflowPrefix) throw new IOException("Incomplete unknown-name list");
+        return result;
+    }
+
+    private static JSONArray versionNames(JSONObject scope) throws Exception {
+        JSONObject wrapped = new JSONObject().put("unknown_names", scope.getJSONArray("unapproved_names"));
+        JSONArray names = boundedNames(wrapped);
+        bool(scope, "unapproved_names_overflow");
+        long count = integer(scope, "unapproved_versions", 0, Long.MAX_VALUE);
+        if (names.length() > count || (count == 0 && bool(scope, "unapproved_names_overflow")))
+            throw new IOException("Invalid version finding names");
+        return names;
+    }
+
+    EnvironmentSnapshot(JSONObject value, String expectedBoot, long now) throws Exception {
+        report = value;
+        expect(value, "kind", "aster.environment");
+        if (integer(value, "version", 3, 3) != 3) throw new IOException("Environment version");
+        expect(value, "status", "observed");
+        JSONObject id = value.getJSONObject("identity");
+        bootId = text(id, "boot_id");
+        if (!bootId.matches("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
+                || !bootId.replace("-", "").equals(expectedBoot)) throw new IOException("Environment boot changed");
+        for (String key : new String[]{"collector_instance", "classifier_instance", "baseline_sha256"}) {
+            String s = text(id, key);
+            if (!s.matches(key.equals("baseline_sha256") ? "[0-9a-f]{64}" : "[0-9a-f]{32}"))
+                throw new IOException("Invalid environment identity: " + key);
+            facts.put(key, s);
+        }
+        classifier = facts.getString("classifier_instance");
+        JSONObject observation = value.getJSONObject("observation");
+        expect(observation, "clock", "BOOTTIME");
+        serial = integer(observation, "serial", 1, Long.MAX_VALUE - 1);
+        long started = integer(observation, "started_ms", 0, Long.MAX_VALUE - MAX_AGE_MS);
+        completed = integer(observation, "completed_ms", started, Long.MAX_VALUE - MAX_AGE_MS);
+        if (now < completed || now - completed >= MAX_AGE_MS) throw new IOException("Stale environment observation");
+        JSONObject collection = value.getJSONObject("collection");
+        expect(collection, "status", "consistent");
+        if (bool(collection, "evidence_lost") || integer(collection, "pending_measurements", 0, Long.MAX_VALUE) != 0)
+            throw new IOException("Incomplete collection");
+        facts.put("evidence_lost", false).put("collection_healthy", true);
+        facts.put("sequence", integer(collection, "evidence_sequence", 0, Long.MAX_VALUE));
+        String backend = text(collection, "backend");
+        facts.put("collector_backend", backend);
+        JSONObject classification = value.getJSONObject("classification");
+        expect(classification, "status", "classified");
+        JSONObject official = classification.getJSONObject("official");
+        expect(official, "status", "classified");
+        facts.put("unknown_names", names(official));
+        facts.put("unknown_modules", integer(official, "unknown_modules", 0, Integer.MAX_VALUE));
+        facts.put("unknown_overflow", bool(official, "unknown_overflow"));
+        long mismatches = integer(official, "unapproved_versions", 0, Long.MAX_VALUE);
+        facts.put("hash_mismatches", mismatches).put("normal_unapproved_versions", mismatches);
+        facts.put("unapproved_names", versionNames(official));
+        facts.put("unapproved_names_overflow", bool(official, "unapproved_names_overflow"));
+        JSONObject community = classification.getJSONObject("community");
+        expect(community, "status", "classified");
+        facts.put("compromise_unknown_names", names(community));
+        facts.put("compromise_unknown_modules", integer(community, "unknown_modules", 0, Integer.MAX_VALUE));
+        facts.put("compromise_unknown_overflow", bool(community, "unknown_overflow"));
+        facts.put("compromise_unapproved_versions", integer(community, "unapproved_versions", 0, Long.MAX_VALUE));
+        facts.put("compromise_unapproved_names", versionNames(community));
+        facts.put("compromise_unapproved_names_overflow", bool(community, "unapproved_names_overflow"));
+        facts.put("classification_ready", true);
+        JSONObject coverage = value.getJSONObject("coverage");
+        for (String field : new String[]{"full_measurement", "raw_hashes_measured", "syscall_measured", "early_history_gap"})
+            facts.put(field, bool(coverage, field));
+        if (backend.equals("full")) {
+            for (JSONObject scope : new JSONObject[]{official, community}) {
+                if (scope.getLong("unapproved_versions") != 0 && scope.getJSONArray("unapproved_names").length() == 0)
+                    throw new IOException("Full version findings lack module names");
+            }
+            expect(id, "collector_identity_kind", "boot_scope");
+            if (!facts.getString("collector_instance").equals(expectedBoot)) throw new IOException("Full collector boot mismatch");
+            expect(coverage, "status", "full_measurement");
+            expect(classification, "scope", "load_history_and_inventory");
+            if (integer(collection, "measurement_protocol", 1, 1) != 1
+                    || integer(collection, "loss_count", 0, Long.MAX_VALUE) != 0
+                    || !facts.getBoolean("full_measurement") || !facts.getBoolean("raw_hashes_measured")
+                    || !facts.getBoolean("syscall_measured") || facts.getBoolean("early_history_gap")
+                    || integer(coverage, "syscall_abis", 3, 3) != 3
+                    || integer(coverage, "syscall_check_ns", 1, Long.MAX_VALUE) == 0)
+                throw new IOException("Incomplete full measurement");
+            facts.put("healthy", true).put("syscall_changed", integer(coverage, "syscall_changed", 0, 3));
+        } else if (backend.equals("later_digest")) {
+            expect(id, "collector_identity_kind", "collector_instance");
+            expect(coverage, "status", "partial_measurement");
+            expect(classification, "scope", "captured_inputs_and_name_inventory");
+            if (integer(collection, "measurement_protocol", 4, 4) != 4
+                    || integer(collection, "coverage_gap_mask", 0, Long.MAX_VALUE) != 0
+                    || facts.getBoolean("full_measurement") || facts.getBoolean("raw_hashes_measured")
+                    || facts.getBoolean("syscall_measured") || !facts.getBoolean("early_history_gap")
+                    || bool(coverage, "early_versions_verified") || !bool(coverage, "later_hashes_measured"))
+                throw new IOException("Invalid V4 coverage");
+            facts.put("compromise_unknown_names", names(community));
+            facts.put("compromise_unknown_modules", integer(community, "unknown_modules", 0, 512));
+            facts.put("compromise_unapproved_versions", integer(community, "unapproved_versions", 0, 512));
+            facts.put("approved_candidate_rows", integer(community, "approved_candidate_rows", 0, 512));
+            facts.put("unapproved_candidate_rows", integer(community, "unapproved_candidate_rows", 0, 512));
+            facts.put("healthy", false).put("digest_protocol", 4).put("later_hashes_measured", true)
+                    .put("pending_measurements", 0).put("coverage_gap_mask", 0)
+                    .put("early_versions_verified", false)
+                    .put("early_name_only_rows", integer(coverage, "early_name_only_rows", 0, 512));
+        } else throw new IOException("Unsupported environment backend");
+        Object token = value.get("resident_token");
+        if (!(token instanceof String) || !((String) token).matches("|[0-9a-f]{64}"))
+            throw new IOException("Invalid resident binding");
+        facts.put("resident_green", false).put("resident_until_ms", 0)
+                .put("resident_changed_names", new JSONArray());
+        if (backend.equals("later_digest")) {
+            JSONObject resident = value.getJSONObject("resident");
+            if (((String) token).isEmpty() || integer(resident, "version", 1, 1) != 1
+                    || !"community".equals(text(resident, "scope"))
+                    || bool(resident, "full_module_verified")) throw new IOException("Invalid resident report");
+            long required = integer(resident, "required", 0, 512);
+            long accepted = integer(resident, "accepted", 0, required);
+            long unknown = integer(resident, "unknown", 0, required);
+            long different = integer(resident, "different", 0, required);
+            if (accepted + unknown + different != required) throw new IOException("Incomplete resident totals");
+            integer(resident, "round_id", 0, Long.MAX_VALUE);
+            integer(resident, "pm_epoch", 0, Long.MAX_VALUE);
+            String state = text(resident, "status");
+            if (!state.matches("green|pending|difference|unavailable")) throw new IOException("Resident state");
+            if ((state.equals("green") || state.equals("difference"))
+                    && (required != facts.getInt("early_name_only_rows")
+                        || !text(resident, "target_set_sha256").matches("[0-9a-f]{64}")))
+                throw new IOException("Resident target binding");
+            if (state.equals("difference") != (different != 0)) throw new IOException("Resident difference state");
+            JSONObject names = new JSONObject().put("unknown_names", resident.getJSONArray("changed_names"));
+            JSONArray changed = boundedNames(names);
+            if (changed.length() != different) throw new IOException("Resident difference names");
+            facts.put("resident_changed_names", changed);
+            long untilNs = integer(resident, "valid_until_ns", 0, Long.MAX_VALUE);
+            long oldest = integer(resident, "oldest_sample_ns", 0, Long.MAX_VALUE);
+            long newest = integer(resident, "newest_sample_ns", oldest, Long.MAX_VALUE);
+            if (state.equals("green")) {
+                if (required != facts.getInt("early_name_only_rows") || accepted != required || unknown != 0
+                        || different != 0 || untilNs / 1_000_000L <= now
+                        || (required != 0 && (oldest == 0 || newest / 1_000_000L > completed
+                            || untilNs != Math.addExact(oldest, 10_000_000_000L)))
+                        || (required == 0 && untilNs / 1_000_000L > completed + MAX_AGE_MS))
+                    throw new IOException("Expired or incomplete resident green");
+                facts.put("resident_green", true).put("resident_until_ms", untilNs / 1_000_000L);
+            } else if (untilNs != 0) throw new IOException("Unaccepted resident deadline");
+        } else if (!((String) token).isEmpty() || !value.isNull("resident")) {
+            throw new IOException("Full backend has unexpected partial acceptance");
+        }
+        readTsaEffective(value, backend);
+        readTsa(value.optJSONObject("tsa"), backend);
+    }
+
+    private void readTsaEffective(JSONObject value, String backend) throws Exception {
+        if (!value.has("classification_token")) {
+            if (value.getJSONObject("classification").has("syscall_changed"))
+                throw new IOException("Unbound effective syscall classification");
+            return;
+        }
+        if (!backend.equals("full") || !text(value, "classification_token").matches("[0-9a-f]{64}"))
+            throw new IOException("Invalid effective classification binding");
+        JSONObject effective = value.getJSONObject("tsa").getJSONObject("effective");
+        integer(effective, "version", 1, 1);
+        if (integer(effective, "sequence", 1, Long.MAX_VALUE) != facts.getLong("sequence")
+                || integer(effective, "check_ns", 1, Long.MAX_VALUE)
+                    != value.getJSONObject("coverage").getLong("syscall_check_ns"))
+            throw new IOException("Stale TSA classification");
+        long raw = integer(effective, "raw_syscall_changed", 0, 3);
+        long active = integer(effective, "syscall_changed", 0, 3);
+        if (raw != facts.getLong("syscall_changed") || (active & ~raw) != 0
+                || integer(value.getJSONObject("classification"), "syscall_changed", 0, 3) != active)
+            throw new IOException("Invalid effective syscall mask");
+        JSONArray proofs = effective.getJSONArray("proofs");
+        if (proofs.length() < 1 || proofs.length() > 8) throw new IOException("Invalid proof count");
+        TreeSet<String> provedNames = new TreeSet<>();
+        TreeSet<Long> instances = new TreeSet<>();
+        for (int i = 0; i < proofs.length(); ++i) {
+            JSONObject proof = proofs.getJSONObject(i);
+            String name = text(proof, "module_name"), repo = text(proof, "repository");
+            if (!name.matches("[A-Za-z0-9_][A-Za-z0-9_.-]{0,54}")
+                    || !repo.matches("[A-Za-z0-9_.-]{1,255}/[A-Za-z0-9_.-]{1,255}")
+                    || !text(proof, "release_root").equals("https://github.com/" + repo + "/releases")
+                    || !instances.add(integer(proof, "load_id", 1, Long.MAX_VALUE)))
+                throw new IOException("Invalid proof identity");
+            for (String field : new String[]{"manager_certificate_sha256", "input_sha256", "source_sha256"})
+                if (!text(proof, field).matches("[0-9a-f]{64}")) throw new IOException("Invalid proof digest");
+            integer(proof, "input_length", 64, 8 * 1024 * 1024);
+            integer(proof, "dispatcher_offset", 0, 8 * 1024 * 1024 - 1);
+            integer(proof, "native_slot", 0, 65535);
+            expect(proof, "transform_profile", "ksu-orig-undef-abs-v1");
+            expect(proof, "syscall_profile", "ksu-native-unused-dispatcher-v1");
+            provedNames.add(name);
+        }
+        JSONObject wrapped = new JSONObject().put("unknown_names", effective.getJSONArray("resolved_names"));
+        JSONArray names = boundedNames(wrapped);
+        if (names.length() > 8) throw new IOException("Oversize proof names");
+        for (int i = 0; i < names.length(); ++i) {
+            String name = names.getString(i);
+            if (!provedNames.contains(name)) throw new IOException("Unproved resolution");
+            tsaResolvedNames.add(name);
+        }
+        for (String scope : new String[]{"official", "community"}) {
+            JSONArray reasons = effective.getJSONObject("resolved_reasons").getJSONArray(scope);
+            TreeSet<String> target = scope.equals("official") ? tsaOfficialReasons : tsaCommunityReasons;
+            if (reasons.length() > 3) throw new IOException("Oversize proof reasons");
+            JSONObject classification = value.getJSONObject("classification").getJSONObject(scope);
+            for (int i = 0; i < reasons.length(); ++i) {
+                String reason = reasons.getString(i);
+                if (!reason.matches("UNKNOWN_MODULE|UNAPPROVED_VERSION|SYSCALL_CHANGED") || !target.add(reason)
+                        || (reason.equals("UNKNOWN_MODULE") && classification.getLong("unknown_modules") != 0)
+                        || (reason.equals("UNAPPROVED_VERSION") && classification.getLong("unapproved_versions") != 0)
+                        || (reason.equals("SYSCALL_CHANGED") && (raw == 0 || active != 0)))
+                    throw new IOException("Invalid resolved reason");
+            }
+        }
+        facts.put("raw_syscall_changed", raw).put("syscall_changed", active);
+    }
+
+    private void readTsa(JSONObject tsa, String backend) {
+        if (tsa == null) return;
+        try {
+            integer(tsa, "version", 1, 1);
+            String status = text(tsa, "status");
+            if (!status.matches("observed|partial|disabled|policy_unavailable|unsupported_backend|omitted_report_size"))
+                throw new IOException("Invalid TSA status");
+            if (!status.equals("observed") && !status.equals("partial")) {
+                tsaStatus = status;
+                return;
+            }
+            if (!backend.equals("full")
+                    || integer(tsa, "sequence", 1, Long.MAX_VALUE) != facts.getLong("sequence")
+                    || (bool(tsa, "overflow") && !status.equals("partial")))
+                throw new IOException("Unbound TSA candidates");
+            JSONArray rows = tsa.getJSONArray("candidates");
+            if (rows.length() > 8) throw new IOException("Oversize TSA candidate list");
+            TreeSet<Long> instances = new TreeSet<>();
+            for (int i = 0; i < rows.length(); ++i) {
+                JSONObject row = rows.getJSONObject(i);
+                String candidateStatus = text(row, "status");
+                if (!candidateStatus.matches("source_pending|source_verified")) throw new IOException("Candidate state");
+                String module = text(row, "module_name");
+                String manager = text(row, "manager_certificate_sha256");
+                String input = text(row, "input_sha256");
+                long load = integer(row, "load_id", 1, Long.MAX_VALUE);
+                if (!module.matches("[A-Za-z0-9_][A-Za-z0-9_.-]{0,54}")
+                        || !manager.matches("[0-9a-f]{64}") || !input.matches("[0-9a-f]{64}")
+                        || !instances.add(load)) throw new IOException("Invalid TSA instance");
+                long length = integer(row, "input_length", 64, 8 * 1024 * 1024);
+                integer(row, "scanned_bytes", 1, 128 * 1024);
+                JSONArray forks = row.getJSONArray("forks");
+                if (forks.length() < 1 || forks.length() > 8) throw new IOException("Invalid TSA Fork list");
+                ArrayList<String> names = new ArrayList<>(), repositories = new ArrayList<>(), roots = new ArrayList<>();
+                TreeSet<String> unique = new TreeSet<>();
+                for (int j = 0; j < forks.length(); ++j) {
+                    JSONObject fork = forks.getJSONObject(j);
+                    String name = text(fork, "name"), repo = text(fork, "repository");
+                    String root = text(fork, "release_root");
+                    if (name.isEmpty() || name.getBytes(java.nio.charset.StandardCharsets.UTF_8).length > 96
+                            || !name.equals(name.trim()) || name.matches("(?s).*[\\x00-\\x1f\\x7f].*")
+                            || !repo.matches("[A-Za-z0-9_.-]{1,255}/[A-Za-z0-9_.-]{1,255}")
+                            || !root.equals("https://github.com/" + repo + "/releases")
+                            || !unique.add(repo.toLowerCase(Locale.ROOT))) throw new IOException("Invalid TSA Fork");
+                    names.add(name); repositories.add(repo); roots.add(root);
+                }
+                Bundle candidate = new Bundle();
+                candidate.putString("module_name", module);
+                candidate.putString("status", candidateStatus);
+                if (candidateStatus.equals("source_verified")) {
+                    String verifiedRepo = text(row, "verified_repository");
+                    if (!repositories.contains(verifiedRepo) || !report.has("classification_token"))
+                        throw new IOException("Unbound verified candidate");
+                    candidate.putString("verified_repository", verifiedRepo);
+                    candidate.putString("verified_name", names.get(repositories.indexOf(verifiedRepo)));
+                    String tag = text(row, "verified_tag"), asset = text(row, "verified_asset");
+                    if (!tag.matches("[A-Za-z0-9][A-Za-z0-9._+-]{0,127}")
+                            || !asset.matches("[A-Za-z0-9_.+-]{1,200}\\.ko")) throw new IOException("Verified source version");
+                    candidate.putString("verified_tag", tag); candidate.putString("verified_asset", asset);
+                }
+                candidate.putLong("load_id", load);
+                candidate.putLong("input_length", length);
+                candidate.putString("input_sha256", input);
+                candidate.putString("manager_certificate_sha256", manager);
+                candidate.putStringArrayList("fork_names", names);
+                candidate.putStringArrayList("repositories", repositories);
+                candidate.putStringArrayList("release_roots", roots);
+                tsaCandidates.add(candidate);
+            }
+            tsaStatus = status;
+            if (tsa.has("source_ready")) {
+                boolean ready = bool(tsa, "source_ready");
+                if (ready && (!backend.equals("full") || integer(tsa, "source_executor_generation", 1, Long.MAX_VALUE) < 1))
+                    throw new IOException("Source executor binding");
+                Bundle job = KernelSuSourceVerifier.parse(tsa.getJSONObject("source_job"));
+                tsaSourceReady = ready;
+                tsaSourceState = job;
+            }
+        } catch (Exception ignored) {
+            // An optional display section must not change the original policy.
+            tsaCandidates.clear();
+            tsaStatus = "unavailable";
+            tsaSourceReady = false; tsaSourceState = new Bundle();
+        }
+    }
+
+    JSONObject request(String action, String scope, JSONArray historical) throws Exception {
+        JSONObject request = new JSONObject().put("action", action).put("scope", scope)
+                .put("challenge", UUID.randomUUID().toString().replace("-", ""))
+                .put("boot_id", bootId).put("classifier_instance", classifier)
+                .put("collector_instance", facts.getString("collector_instance"))
+                .put("baseline_sha256", facts.getString("baseline_sha256"))
+                .put("observation_serial", serial).put("evidence_sequence", facts.getLong("sequence"))
+                .put("historical", historical).put("host_revision", 0).put("history_generation", 0)
+                .put("resident_token", report.getString("resident_token"));
+        if (report.has("classification_token")) request.put("classification_token", report.getString("classification_token"));
+        return request;
+    }
+
+    void validateReceipt(JSONObject request, JSONObject receipt, long now) throws Exception {
+        expect(receipt, "kind", "aster.coordination");
+        if (integer(receipt, "version", 3, 3) != 3 || !bool(receipt, "accepted")
+                || bool(receipt, "published") != request.getString("action").equals("publish")
+                || integer(receipt, "expires_ms", 0, Long.MAX_VALUE) != completed + MAX_AGE_MS
+                || now < completed || now - completed >= MAX_AGE_MS
+                || integer(receipt, "observation_serial", 1, Long.MAX_VALUE - 1) != serial
+                || integer(receipt, "evidence_sequence", 0, Long.MAX_VALUE) != facts.getLong("sequence"))
+            throw new IOException("Stale or rejected environment coordination");
+        for (String key : new String[]{"action", "scope", "challenge", "boot_id", "collector_instance", "classifier_instance", "baseline_sha256", "resident_token"})
+            expect(receipt, key, request.getString(key));
+        if (request.has("classification_token")) expect(receipt, "classification_token", request.getString("classification_token"));
+        if (facts.optBoolean("resident_green") && now >= facts.getLong("resident_until_ms"))
+            throw new Pending();
+        for (String field : new String[]{"host_revision", "history_generation"})
+            if (integer(receipt, field, 0, Long.MAX_VALUE) != integer(request, field, 0, Long.MAX_VALUE))
+                throw new IOException("Host coordination generation changed");
+        if (!receipt.getJSONArray("historical").toString().equals(request.getJSONArray("historical").toString()))
+            throw new IOException("Publication history changed");
+    }
+}
diff --git a/services/core/java/com/android/server/platformintegrity/IntegritySocket.java b/services/core/java/com/android/server/platformintegrity/IntegritySocket.java
new file mode 100644
index 000000000..eceb019ee
--- /dev/null
+++ b/services/core/java/com/android/server/platformintegrity/IntegritySocket.java
@@ -0,0 +1,217 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+import android.net.LocalSocket;
+import android.os.Process;
+import android.os.SystemClock;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+import android.system.StructPollfd;
+import android.system.UnixSocketAddress;
+import java.io.FileDescriptor;
+import java.io.IOException;
+import java.io.InterruptedIOException;
+import java.nio.charset.StandardCharsets;
+
+/** One SEQPACKET request/reply with a single deadline covering connect and I/O. */
+final class IntegritySocket {
+    private static final int LIMIT = 65536;
+    private static final long BUDGET_MS = 500;
+    // Linux/Bionic MSG_NOSIGNAL (bionic/libc/include/sys/socket.h); not exported
+    // by this tree's android.system.OsConstants. Prevent EPIPE from signalling.
+    private static final int MSG_NOSIGNAL = 0x4000;
+
+    private IntegritySocket() { }
+
+    static String exchange(String name, String request) throws IOException {
+        if (!"platform_integrity".equals(name) && !"fasd".equals(name)) {
+            throw new IOException("Unexpected integrity endpoint");
+        }
+        byte[] bytes = request.getBytes(StandardCharsets.UTF_8);
+        if (bytes.length == 0 || bytes.length >= LIMIT) {
+            throw new IOException("Invalid integrity request size");
+        }
+        final long deadline = SystemClock.elapsedRealtime() + BUDGET_MS;
+        FileDescriptor fd = connect(name, deadline);
+        try {
+            return transact(fd, bytes, deadline);
+        } finally {
+            close(fd);
+        }
+    }
+
+    static FileDescriptor connect(String name, long deadline) throws IOException {
+        if (!"platform_integrity".equals(name) && !"fasd".equals(name)) {
+            throw new IOException("Unexpected integrity endpoint");
+        }
+        FileDescriptor fd = null;
+        boolean connected = false;
+        try {
+            fd = Os.socket(OsConstants.AF_UNIX, OsConstants.SOCK_SEQPACKET
+                    | OsConstants.SOCK_CLOEXEC | OsConstants.SOCK_NONBLOCK, 0);
+            remaining(deadline);
+            try {
+                Os.connect(fd, UnixSocketAddress.createFileSystem("/dev/socket/" + name));
+            } catch (ErrnoException e) {
+                // AF_UNIX backlog EAGAIN is not a pending asynchronous connect.
+                // Fail this attempt; never spin/reconnect or reset its budget.
+                if (e.errno != OsConstants.EINPROGRESS && e.errno != OsConstants.EALREADY) {
+                    throw e;
+                }
+                await(fd, OsConstants.POLLOUT, deadline);
+                if (Os.getsockoptInt(fd, OsConstants.SOL_SOCKET, OsConstants.SO_ERROR) != 0) {
+                    throw new IOException("Integrity endpoint connect failed");
+                }
+            }
+            remaining(deadline);
+            if (peerUid(fd) != Process.SYSTEM_UID) {
+                throw new IOException("Unexpected integrity endpoint UID");
+            }
+            connected = true;
+            return fd;
+        } catch (ErrnoException e) {
+            throw new IOException("Integrity endpoint syscall failed: " + e.errno, e);
+        } finally {
+            if (!connected) close(fd);
+        }
+    }
+
+    static void close(FileDescriptor fd) {
+        if (fd != null) {
+            try { Os.close(fd); } catch (ErrnoException ignored) { }
+        }
+    }
+
+    static void sendNotice(FileDescriptor fd, String packet) throws IOException {
+        byte[] data = packet.getBytes(StandardCharsets.UTF_8);
+        if (data.length == 0 || data.length >= 2048) throw new IOException("Invalid notice request size");
+        long deadline = SystemClock.uptimeMillis() + BUDGET_MS;
+        try {
+            for (;;) {
+                remaining(deadline, true);
+                try {
+                    if (Os.sendto(fd, data, 0, data.length, MSG_NOSIGNAL, null) != data.length)
+                        throw new IOException("Partial notice packet");
+                    remaining(deadline, true);
+                    return;
+                } catch (ErrnoException e) {
+                    if (e.errno == OsConstants.EINTR) continue;
+                    if (e.errno != OsConstants.EAGAIN) throw e;
+                    await(fd, OsConstants.POLLOUT, deadline, true);
+                }
+            }
+        } catch (ErrnoException e) { throw new IOException("Notice send failed", e); }
+    }
+
+    static String receiveNotice(FileDescriptor fd, boolean initial) throws IOException {
+        long deadline = initial ? SystemClock.uptimeMillis() + BUDGET_MS : 0;
+        byte[] data = new byte[2048];
+        try {
+            for (;;) {
+                await(fd, OsConstants.POLLIN, deadline, true);
+                try {
+                    int count = Os.recvfrom(fd, data, 0, data.length, OsConstants.MSG_TRUNC, null);
+                    if (count <= 0 || count >= data.length) throw new IOException("Invalid notice packet");
+                    if (deadline != 0) remaining(deadline, true);
+                    return new String(data, 0, count, StandardCharsets.UTF_8);
+                } catch (ErrnoException e) {
+                    if (e.errno != OsConstants.EINTR && e.errno != OsConstants.EAGAIN) throw e;
+                }
+            }
+        } catch (ErrnoException e) { throw new IOException("Notice receive failed", e); }
+    }
+
+    static int peerUid(FileDescriptor fd) throws IOException {
+        // Framework bridge to SO_PEERCRED; Os.getsockoptUcred is absent from
+        // the libcore API stubs used by services.core. This wrapper borrows the
+        // already-connected fd, never connects/changes flags or owns its close.
+        try (LocalSocket socket = new LocalSocket(fd)) {
+            return socket.getPeerCredentials().getUid();
+        }
+    }
+
+    // Package-private for connected socketpair tests. The fd must be nonblocking;
+    // production ownership/flags come exclusively from exchange().
+    static String transact(FileDescriptor fd, byte[] request, long deadline) throws IOException {
+        if (request.length == 0 || request.length >= LIMIT) {
+            throw new IOException("Invalid integrity request size");
+        }
+        try {
+            for (;;) {
+                remaining(deadline);
+                try {
+                    int count = Os.sendto(fd, request, 0, request.length,
+                            MSG_NOSIGNAL, null);
+                    if (count != request.length) throw new IOException("Partial integrity packet");
+                    break;
+                } catch (ErrnoException e) {
+                    if (e.errno == OsConstants.EINTR) continue;
+                    if (e.errno != OsConstants.EAGAIN) throw e;
+                    await(fd, OsConstants.POLLOUT, deadline);
+                }
+            }
+            byte[] response = new byte[LIMIT];
+            for (;;) {
+                remaining(deadline);
+                try {
+                    int count = Os.recvfrom(fd, response, 0, response.length,
+                            OsConstants.MSG_TRUNC, null);
+                    if (count <= 0 || count >= response.length) {
+                        throw new IOException("Invalid or oversized integrity packet");
+                    }
+                    remaining(deadline); // late complete packets are still stale
+                    return new String(response, 0, count, StandardCharsets.UTF_8);
+                } catch (ErrnoException e) {
+                    if (e.errno == OsConstants.EINTR) continue;
+                    if (e.errno != OsConstants.EAGAIN) throw e;
+                    await(fd, OsConstants.POLLIN, deadline);
+                }
+            }
+        } catch (ErrnoException e) {
+            throw new IOException("Integrity packet syscall failed: " + e.errno, e);
+        }
+    }
+
+    private static int remaining(long deadline) throws InterruptedIOException {
+        return remaining(deadline, false);
+    }
+
+    private static int remaining(long deadline, boolean active) throws InterruptedIOException {
+        long left = deadline - (active ? SystemClock.uptimeMillis() : SystemClock.elapsedRealtime());
+        if (left <= 0) throw new InterruptedIOException("Integrity exchange deadline expired");
+        return (int) Math.min(left, BUDGET_MS);
+    }
+
+    private static void await(FileDescriptor fd, int events, long deadline)
+            throws ErrnoException, IOException {
+        await(fd, events, deadline, false);
+    }
+
+    private static void await(FileDescriptor fd, int events, long deadline, boolean active)
+            throws ErrnoException, IOException {
+        StructPollfd waiter = new StructPollfd();
+        waiter.fd = fd;
+        waiter.events = (short) events;
+        for (;;) {
+            try {
+                int timeout = active && deadline == 0 ? -1 : remaining(deadline, active);
+                if (Os.poll(new StructPollfd[]{waiter}, timeout) == 0) {
+                    throw new InterruptedIOException("Integrity exchange wait expired");
+                }
+                if ((waiter.revents & OsConstants.POLLNVAL) != 0) {
+                    throw new IOException("Invalid integrity descriptor");
+                }
+                // Buffered final data can accompany HUP. recvfrom checks EOF;
+                // a terminal-only event cannot be treated as successful I/O.
+                if ((waiter.revents & events) != 0) return;
+                if ((waiter.revents & (OsConstants.POLLERR | OsConstants.POLLHUP)) != 0) {
+                    throw new IOException("Integrity endpoint disconnected");
+                }
+                throw new IOException("Unexpected integrity poll event");
+            } catch (ErrnoException e) {
+                if (e.errno != OsConstants.EINTR) throw e;
+            }
+        }
+    }
+}
diff --git a/services/core/java/com/android/server/platformintegrity/KernelSuSourceVerifier.java b/services/core/java/com/android/server/platformintegrity/KernelSuSourceVerifier.java
new file mode 100644
index 000000000..92cb829dc
--- /dev/null
+++ b/services/core/java/com/android/server/platformintegrity/KernelSuSourceVerifier.java
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+import android.os.Bundle;
+import java.io.IOException;
+import java.util.ArrayList;
+import org.json.JSONObject;
+
+/** UI request adapter only. No HTTP, submitted file bytes or cached approvals. */
+final class KernelSuSourceVerifier {
+    interface Binding { Bundle get(long loadId, String repository) throws Exception; }
+    private final Binding mBinding;
+    private Bundle mState = new Bundle();
+    KernelSuSourceVerifier(Binding binding) { mBinding = binding; }
+    synchronized Bundle state() { return new Bundle(mState); }
+    synchronized void offer(Bundle state) { mState = state == null ? new Bundle() : new Bundle(state); }
+    Bundle request(Bundle request) {
+        Bundle result = new Bundle(); result.putString("status", "rejected");
+        if (request == null) return result;
+        try {
+            JSONObject packet = new JSONObject();
+            String action = request.getString("action", ""); packet.put("action", action);
+            if (action.equals("list")) {
+                Bundle binding = mBinding.get(request.getLong("load_id"), request.getString("repository", ""));
+                if (!binding.getBoolean("source_ready")) throw new IOException("Source executor unavailable");
+                JSONObject identity = new JSONObject();
+                for (String key : new String[]{"boot_id", "collector_instance", "classifier_instance", "baseline_sha256"})
+                    identity.put(key, binding.getString(key));
+                packet.put("identity", identity).put("load_id", binding.getLong("load_id"))
+                        .put("repository", binding.getString("repository")).put("tag", request.getString("tag", ""));
+            } else if (action.equals("download") || action.equals("cancel")) {
+                packet.put("token", request.getString("token", ""));
+                if (action.equals("download")) packet.put("asset_id", request.getLong("asset_id"));
+            } else return result;
+            JSONObject reply = new JSONObject(IntegritySocket.exchange("platform_integrity", "TSA_V1\t" + packet));
+            return parse(reply);
+        } catch (Exception ignored) { return result; }
+    }
+    static Bundle parse(JSONObject value) throws Exception {
+        Bundle result = new Bundle();
+        String status = value.optString("status", "idle");
+        if (!status.matches("idle|listing|choose_asset|downloading|verifying|verified|different|unsupported|capacity|asset_limit|cancelled|failed|rejected"))
+            throw new IOException("Source job status");
+        result.putString("status", status);
+        if (value.has("token")) {
+            String token = value.getString("token");
+            if (!token.matches("[0-9a-f]{32}")) throw new IOException("Source job token");
+            result.putString("token", token);
+        }
+        for (String field : new String[]{"repository", "tag"}) {
+            String text = value.optString(field, "");
+            if (text.length() > 512 || text.indexOf('\0') >= 0 || text.indexOf('\n') >= 0 || text.indexOf('\r') >= 0)
+                throw new IOException("Source job field");
+            result.putString(field, text);
+        }
+        if (value.has("load_id")) result.putLong("load_id", EnvironmentSnapshot.integer(value, "load_id", 1, Long.MAX_VALUE));
+        if (value.has("assets")) {
+            var assets = value.getJSONArray("assets");
+            if (assets.length() > 256) throw new IOException("Source asset count");
+            ArrayList<Bundle> choices = new ArrayList<>();
+            java.util.HashSet<Long> unique = new java.util.HashSet<>();
+            for (int i = 0; i < assets.length(); ++i) {
+                var asset = assets.getJSONObject(i); String name = asset.getString("name");
+                long id = EnvironmentSnapshot.integer(asset, "id", 1, Long.MAX_VALUE);
+                long size = EnvironmentSnapshot.integer(asset, "size", 64, 8 * 1024 * 1024);
+                if (!unique.add(id) || !name.matches("[A-Za-z0-9_.+-]{1,200}\\.ko")) throw new IOException("Source asset");
+                Bundle choice = new Bundle(); choice.putLong("id", id); choice.putLong("size", size); choice.putString("name", name); choices.add(choice);
+            }
+            result.putParcelableArrayList("assets", choices);
+        }
+        return result;
+    }
+}
diff --git a/services/core/java/com/android/server/platformintegrity/PermitRenewal.java b/services/core/java/com/android/server/platformintegrity/PermitRenewal.java
new file mode 100644
index 000000000..db1bfdb35
--- /dev/null
+++ b/services/core/java/com/android/server/platformintegrity/PermitRenewal.java
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+/** Successful-value tracking only; caller owns publication locking and proof checks. */
+final class PermitRenewal {
+    static final long LEASE_MS = 4000;
+    static final long MARGIN_MS = 2000;
+    static final long MAX_TIME = 0xffffffffffffL;
+    enum Decision { WRITE, SKIP, REPLACED, CLOCK_INVALID }
+
+    private String lastWritten;
+    private long lastNow = -1;
+    private boolean clockInvalid;
+
+    // All methods are called with the host's permit-write lock held.
+    Decision decide(String actual, String identity, int features, long deadline, long now) {
+        if (now < 0 || now < lastNow || now > MAX_TIME - LEASE_MS) clockInvalid = true;
+        lastNow = Math.max(lastNow, now);
+        if (clockInvalid) return Decision.CLOCK_INVALID;
+        // Zero/clear, shutdown and all forced revocations bypass coalescing.
+        if (features <= 0 || features > 7) return Decision.WRITE;
+        if (lastWritten != null && !lastWritten.equals(actual)) {
+            failed();
+            return Decision.REPLACED;
+        }
+        String expected = identity + ":" + Long.toHexString(deadline) + ":" + features;
+        return lastWritten != null && lastWritten.equals(actual) && expected.equals(actual)
+                && deadline > now && deadline - now <= LEASE_MS
+                && deadline - now > MARGIN_MS ? Decision.SKIP : Decision.WRITE;
+    }
+
+    void succeeded(String value) { lastWritten = value; }
+    void failed() { lastWritten = null; }
+}
