+    private void beginHostShutdown() {
+        if (!mShutdown.begin()) return;
+        // No host lock, Binder, fsync or unbounded property setter on the caller.
+        // The publication lock orders this revoke after any earlier writer.
+        if (writePermitProperty(null)) mShutdown.confirmRevoked();
+        mHandler.removeCallbacks(mPoll);
+        mHandler.postAtFrontOfQueue(this::drainHostShutdown);
+    }
+
+    private void requireShutdownBudget() throws IOException {
+        if (mShutdown.remaining() == 0) throw new IOException("Shutdown drain budget expired");
+    }
+
+    private void requireZeroPermitLocked(String identity) throws IOException {
+        PlatformIntegrity.Permit permit = PlatformIntegrity.current();
+        if (permit.features != 0 || !identity.equals(permit.identity) || !permit.allows(0))
+            throw new IOException("Shutdown zero permit unconfirmed");
+    }
+
+    private void drainHostShutdown() {
+        if (mShutdown.terminal()) return;
+        mInShutdownDrain = true;
+        try {
+            synchronized (mLock) {
+                requireShutdownBudget();
+                consumeNotificationInterruptionLocked(mNotificationGate.capture());
+                if (!mRecordValid) throw new IOException("Policy record unavailable at shutdown");
+                publishLocked(0);
+                requireShutdownBudget();
+                final String identity = identityLocked();
+                requireZeroPermitLocked(identity);
+                // Persist denial before any endpoint teardown. A later failed
+                // drain must not let a replacement coordinator reauthorize.
+                mShutdownBoot = mBoot;
+                if (!saveLocked(mRequested, mRequestBoot))
+                    throw new IOException("Cannot persist initial shutdown freeze");
+                requireShutdownBudget();
+
+                // Only stop a context this host has actually bound. With V4
+                // partial coverage this path issues no positive permission; absence
+                // of a binding is not a proof of hardware-release completion.
+                if (!mDaemon.isEmpty() && !mBackend.isEmpty()) {
+                    mShutdownFasStop = "stop_request_unconfirmed";
+                    JSONObject stop = new JSONObject(exchange("fasd", "STOP_V4\t" + identity + "\t" + mGrant));
+                    if (EnvironmentSnapshot.integer(stop, "protocol", 4, 4) != 4
+                            || !identity.equals(stop.getString("identity"))
+                            || !mGrant.equals(stop.getString("challenge"))
+                            || !mDaemon.equals(stop.getString("daemon_instance"))
+                            || !mBackend.equals(stop.getString("backend_instance"))
+                            || !EnvironmentSnapshot.bool(stop, "healthy") || !EnvironmentSnapshot.bool(stop, "release_attempted"))
+                        throw new IOException("FAS shutdown request unconfirmed");
+                    mShutdownFasStop = "stop_acknowledged_release_unconfirmed";
+                } else {
+                    mShutdownFasStop = "no_current_host_binding_release_unconfirmed";
+                }
+                mBound = mEndpointsConfirmed = false;
+                requireShutdownBudget();
