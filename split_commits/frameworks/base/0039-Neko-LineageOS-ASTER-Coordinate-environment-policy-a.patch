+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+/** In-process host lifecycle only. Not a Binder interface or an ASTER protocol. */
+public abstract class PlatformIntegrityInternal {
+    /** Called only after a shutdown request has passed its cancelable confirmation. */
+    public abstract void beginShutdown();
+    /** Waits only for the remaining one-shot drain budget; never delays shutdown indefinitely. */
+    public abstract void awaitShutdown();
+}
