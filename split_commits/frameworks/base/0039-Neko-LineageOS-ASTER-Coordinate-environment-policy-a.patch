+    private JSONObject coordinate(JSONObject request, AsterNotification.Ticket ticket) throws Exception {
+        if (mShutdown.closing() && !mInShutdownDrain) throw new EnvironmentSnapshot.Pending();
+        if (!mNotificationGate.isCurrent(ticket)) throw new AsterNotification.Stale("Notification ticket superseded");
+        synchronized (mLock) {
+            request.put("host_revision", mRevision).put("history_generation", mAlarmGeneration);
+        }
+        JSONObject envelope = new JSONObject().put("request", request).put("notification", ticket.frame.proof());
+        JSONObject reply = new JSONObject(exchange("platform_integrity", "COORDINATE_NOTIFIED_V3\t" + envelope));
+        synchronized (mLock) {
+            if (request.getLong("host_revision") != mRevision || request.getLong("history_generation") != mAlarmGeneration)
+                throw new AsterNotification.Stale("Host policy changed during coordination");
+        }
+        return mNotificationGate.coordinationReceipt(ticket, reply);
+    }
+
+    private EnvironmentSnapshot readEnvironment() throws Exception {
+        final String scope;
+        synchronized (mLock) {
+            scope = (mRequested.equals("COMPROMISE") || (mRequested.equals("ENTER_COMPROMISE")
+                    && !mBoot.equals(mRequestBoot))) ? "community" : "official";
+        }
+        JSONObject report = new JSONObject(exchange("platform_integrity", "ENVIRONMENT_V3\t"
+                + new JSONObject().put("scope", scope)));
+        synchronized (mLock) {
+            mLastEnvironment = report.toString();
+            // Retain explicit loss/overflow even when the observation itself
+            // cannot be used. A null/unsupported field is never a zero finding.
+            JSONObject id = report.optJSONObject("identity");
+            JSONObject collection = report.optJSONObject("collection");
+            String boot = id == null ? "" : id.optString("boot_id");
+            boolean boundEnvelope = "aster.environment".equals(report.optString("kind"))
+                    && EnvironmentSnapshot.integer(report, "version", 3, 3) == 3
+                    && boot.matches("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
+                    && boot.replace("-", "").equals(mBoot) && collection != null;
+            if (boundEnvelope && collection.opt("evidence_lost") instanceof Boolean)
+                mCurrentEvidenceLost = collection.getBoolean("evidence_lost");
+            if (boundEnvelope && Boolean.TRUE.equals(collection.opt("evidence_lost"))) {
+                publishLocked(0);
+                if (latchModeLocked() && !mEvidenceLost) {
+                    mEffective = "RESTRICTED_ERROR";
+                    mReason = "Collection evidence was lost";
+                    mEvidenceLost = true;
+                    retainReasonLocked("EVIDENCE_LOST");
+                    mRecoveryBoot = mBoot;
+                    mEvidenceLoss = new JSONObject(report.toString()).put("boot", mBoot)
+                            .put("observed_ms", SystemClock.elapsedRealtime());
+                    if (!saveLocked(mRequested, mRequestBoot)) throw new IOException("Cannot retain collection loss");
+                }
+            }
+            // A changing snapshot is not proof of a lost component. It still
+            // revokes permission; only an explicit loss or actual I/O failure
+            // contributes a compromise failure latch.
+            if (boundEnvelope && "unavailable".equals(report.optString("status"))
+                    && Boolean.FALSE.equals(collection.opt("evidence_lost"))
+                    && ("full".equals(collection.optString("backend"))
+                        || "later_digest".equals(collection.optString("backend")))
+                    ) {
+                JSONObject diagnostics = report.optJSONObject("diagnostics");
+                if (diagnostics != null && diagnostics.isNull("collector_errno"))
+                    throw new EnvironmentSnapshot.Pending();
+            }
+            JSONObject classification = report.optJSONObject("classification");
+            JSONObject selectedClassification = classification == null ? null
+                    : classification.optJSONObject(communityScopeLocked() ? "community" : "official");
+            if (latchModeLocked() && boundEnvelope && "full".equals(collection.optString("backend"))
+                    && "consistent".equals(collection.optString("status")) && selectedClassification != null
+                    && Boolean.TRUE.equals(selectedClassification.opt("unknown_overflow"))) {
+                publishLocked(0);
+                JSONArray names = EnvironmentSnapshot.boundedNames(selectedClassification);
+                long sequence = EnvironmentSnapshot.integer(collection, "evidence_sequence", 0, Long.MAX_VALUE);
+                String collector = id.getString("collector_instance"), classifier = id.getString("classifier_instance");
+                if (!collector.matches("[0-9a-f]{32}") || !classifier.matches("[0-9a-f]{32}"))
+                    throw new IOException("Invalid overflow identity");
+                boolean save = !mAlarmOverflow || !mBoot.equals(mRecoveryBoot);
+                mAlarmOverflow = true;
+                save |= retainReasonLocked("FINDING_OVERFLOW");
+                mRecoveryBoot = mBoot;
+                for (int i = 0; i < names.length(); ++i) {
+                    String name = names.getString(i);
+                    if (!mAlarms.contains(name) && mAlarms.size() < 512) {
+                        mAlarms.add(name);
+                        mAlarmEvidence.put(name, new JSONObject().put("boot", mBoot)
+                                .put("collector", collector).put("classifier", classifier)
+                                .put("sequence", sequence).put("observed_ms", SystemClock.elapsedRealtime())
+                                .put("ordinal", mRevision)
+                                .put("release", SystemProperties.get("ro.system.build.version.incremental")));
+                        save = true;
+                    }
+                }
+                if (save && !saveLocked(mRequested, mRequestBoot)) throw new IOException("Cannot retain alarm overflow");
+            }
+        }
+        EnvironmentSnapshot snapshot = new EnvironmentSnapshot(report, mBoot, SystemClock.elapsedRealtime());
+        synchronized (mLock) {
+            if (mObservationClassifier.equals(snapshot.classifier) && snapshot.serial <= mObservationSerial)
+                throw new IOException("Environment observation replayed");
+            mObservationClassifier = snapshot.classifier;
+            mObservationSerial = snapshot.serial;
+        }
+        // Reuse the serialized query worker's validated identity. A second
+        // ENVIRONMENT_V2 request from the listener would invalidate an in-flight
+        // COORDINATE preparation in the daemon.
+        if (mNotifications != null) mNotifications.offer(snapshot);
+        return snapshot;
+    }
+
+    private static String teeHeartbeat(String identity) {
+        String[] fields = SystemProperties.get("sys.integrity.tee_status", "").split(":");
+        if (fields.length != 6 || !identity.equals(fields[0] + ":" + fields[1] + ":" + fields[2])
+                || !fields[3].matches("[0-9a-f]{16}") || !fields[5].matches("[01]")) return "";
+        try {
+            long left = Long.parseLong(fields[4], 16) - SystemClock.elapsedRealtime();
+            return left > 0 && left <= 2000 ? fields[3] : "";
+        } catch (NumberFormatException e) { return ""; }
+    }
+
+    private static boolean teeStopped(String identity, String instance) {
+        String[] fields = SystemProperties.get("sys.integrity.tee_ack", "").split(":");
+        if (fields.length != 6 || !identity.equals(fields[0] + ":" + fields[1] + ":" + fields[2])
+                || !fields[3].equals(instance) || !fields[5].equals("0")) return false;
+        try {
+            long left = Long.parseLong(fields[4], 16) - SystemClock.elapsedRealtime();
+            return left > 0 && left <= 2000;
+        } catch (NumberFormatException e) { return false; }
+    }
+
+    private static boolean healthyRecord(String value, String instance) {
+        return instance.matches("[0-9a-f]{32}")
+                && value.matches("2:" + instance + ":[01]:0");
+    }
+
+    private static boolean fullClean(JSONObject facts) {
+        return facts.optBoolean("healthy") && facts.optBoolean("full_measurement")
+                && facts.optBoolean("raw_hashes_measured") && facts.optBoolean("syscall_measured")
+                && !facts.optBoolean("early_history_gap", true)
+                && !facts.optBoolean("evidence_lost", true)
+                && !facts.optBoolean("unknown_overflow", true)
+                && !facts.optBoolean("unapproved_names_overflow", true)
+                && facts.optInt("unknown_modules", -1) == 0
+                && facts.optLong("hash_mismatches", -1) == 0
+                && facts.optInt("syscall_changed", -1) == 0;
+    }
+
+    private String restrictionReasonLocked(JSONObject facts) {
+        // Exit requires official clean evidence even while the still-effective
+        // compromise policy continues to classify/publicize the union scope.
+        boolean community = !mRequested.equals("EXIT_COMPROMISE") && communityScopeLocked();
+        if (facts.optInt(community ? "compromise_unknown_modules" : "unknown_modules") != 0) return "UNKNOWN_MODULE";
+        if (facts.optLong(community ? "compromise_unapproved_versions" : "hash_mismatches") != 0) return "HASH_MISMATCH";
+        if (facts.optInt("syscall_changed") != 0) return "SYSCALL_CHANGED";
+        if (mRequested.equals("NORMAL") && facts.optInt("hash_mismatches") != 0)
+            return "HASH_MISMATCH";
+        if (hasAlarmsLocked()) return mBoot.equals(mRecoveryBoot)
+                ? "RECOVERY_RESTART" : "HISTORICAL_ALERTS";
+        if (mRequested.equals("NORMAL") && !mFullMeasurement) return "COVERAGE_INCOMPLETE";
+        return "ENDPOINTS_UNCONFIRMED";
+    }
+
+    private boolean recoverLocked(EnvironmentSnapshot snapshot, String collector, String classifier,
+            AsterNotification.Ticket ticket)
+            throws Exception {
+        if (mShutdown.closing()) throw new EnvironmentSnapshot.Pending();
+        publishLocked(0);
+        mNotificationGate.verify(ticket, snapshot, SystemClock.elapsedRealtime());
+        JSONObject facts = snapshot.facts;
+        EnvironmentSnapshot refreshed = readEnvironment();
+        JSONObject recheck = refreshed.facts;
+        if (!fullClean(recheck)
+                || !recheck.getString("baseline_sha256").equals(facts.getString("baseline_sha256")) || recheck.getLong("sequence") != facts.getLong("sequence")
+                || !collector.equals(recheck.getString("collector_instance"))
+                || !classifier.equals(recheck.getString("classifier_instance"))
+                || !teeStopped(identityLocked(), mTee))
+            throw new IOException("Recovery evidence changed");
+        if (mAlarmGeneration == Long.MAX_VALUE) throw new IOException("Recovery generation exhausted");
+        JSONObject confirmation = refreshed.request("acknowledge", "official", new JSONArray());
+        refreshed.validateReceipt(confirmation, coordinate(confirmation, ticket), SystemClock.elapsedRealtime());
+        // Logical recovery commit: hints accepted before here prevent clearing.
+        // A later hint revokes subsequent work; it cannot roll back committed
+        // storage/operations. No positive permit is granted by this recovery.
+        mNotificationGate.verify(ticket, refreshed, SystemClock.elapsedRealtime());
+        TreeSet<String> old = new TreeSet<>(mAlarms);
+        TreeSet<String> oldReasons = new TreeSet<>(mLatchedReasons);
+        java.util.Map<String, Object> oldReasonEvidence = new java.util.TreeMap<>(mReasonEvidence);
+        JSONObject evidence = mAlarmEvidence, loss = mEvidenceLoss;
+        boolean overflow = mAlarmOverflow, lost = mEvidenceLost, uncertain = mLegacyAlarmUncertain;
+        long generation = mAlarmGeneration;
+        String recoveryBoot = mRecoveryBoot;
+        mAlarms.clear();
+        mLatchedReasons.clear();
+        mReasonEvidence.clear();
+        mAlarmEvidence = new JSONObject();
+        mEvidenceLoss = new JSONObject();
+        mAlarmOverflow = mEvidenceLost = mLegacyAlarmUncertain = false;
+        mRecoveryBoot = "";
+        ++mAlarmGeneration;
+        if (!saveLocked("NORMAL", mBoot)) {
+            mAlarms.addAll(old);
+            mLatchedReasons.addAll(oldReasons);
+            mReasonEvidence.putAll(oldReasonEvidence);
+            mAlarmEvidence = evidence;
+            mEvidenceLoss = loss;
+            mAlarmOverflow = overflow;
+            mEvidenceLost = lost;
+            mLegacyAlarmUncertain = uncertain;
+            mRecoveryBoot = recoveryBoot;
+            mAlarmGeneration = generation;
+            return false;
+        }
+        // Rebind in normal mode with a zero permit before automatic authorization.
+        mBound = false;
+        mEndpointsConfirmed = true;
+        mEffective = "BOOT_UNKNOWN";
+        mReason = "Recovery committed; confirming normal-mode endpoints";
+        mReasonCode = "CHECKING";
+        return true;
+    }
+
+    private JSONArray publicationHistoryLocked() {
+        JSONArray historical = new JSONArray();
+        java.util.ArrayList<String> retained = new java.util.ArrayList<>(mAlarms);
+        retained.sort((a, b) -> Long.compare(
+                mAlarmEvidence.optJSONObject(a).optLong("ordinal", 0),
+                mAlarmEvidence.optJSONObject(b).optLong("ordinal", 0)));
+        for (String name : retained) if (!tsaResolvedLocked(name, false)) historical.put(name);
+        return historical;
+    }
+
+    private void putCurrentFindingsLocked(Bundle state) {
+        state.putBoolean("current_findings_available", false);
+        state.putString("ksu_candidate_status", "unavailable");
+        if (mCurrentFindings == null || mCurrentFindingsTicket == null) return;
+        try {
+            mNotificationGate.verify(mCurrentFindingsTicket, mCurrentFindings, SystemClock.elapsedRealtime());
+            JSONObject facts = mCurrentFindings.facts;
+            boolean community = communityScopeLocked();
+            TreeSet<String> names = new TreeSet<>();
+            for (String field : new String[]{community ? "compromise_unknown_names" : "unknown_names",
+                    community ? "compromise_unapproved_names" : "unapproved_names"}) {
+                JSONArray list = facts.getJSONArray(field);
+                for (int i = 0; i < list.length(); ++i) names.add(list.getString(i));
+            }
+            if (community) {
+                JSONArray changed = facts.getJSONArray("resident_changed_names");
+                for (int i = 0; i < changed.length(); ++i) names.add(changed.getString(i));
+            }
+            state.putStringArrayList("current_module_names", new java.util.ArrayList<>(names));
+            state.putInt("current_module_count", names.size());
+            state.putString("ksu_candidate_status", mCurrentFindings.tsaStatus);
+            java.util.ArrayList<Bundle> candidates = new java.util.ArrayList<>();
+            for (Bundle candidate : mCurrentFindings.tsaCandidates) candidates.add(new Bundle(candidate));
+            state.putParcelableArrayList("ksu_candidates", candidates);
+            state.putBoolean("current_findings_available", true);
+        } catch (Exception ignored) {
+            // The UI drops a stale or interrupted observation independently of history.
+        }
+    }
