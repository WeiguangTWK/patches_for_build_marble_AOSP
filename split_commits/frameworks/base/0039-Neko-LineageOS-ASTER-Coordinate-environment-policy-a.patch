diff --git a/core/java/android/os/PlatformIntegrity.java b/core/java/android/os/PlatformIntegrity.java
new file mode 100644
index 000000000..fad5a99f0
--- /dev/null
+++ b/core/java/android/os/PlatformIntegrity.java
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: Apache-2.0
+package android.os;
+
+/** Device-wide feature permits; reads never perform Binder IPC or disk I/O. @hide */
+public final class PlatformIntegrity {
+    public static final int TEE = 1;
+    public static final int FAS = 2;
+    public static final int VISIBILITY = 4;
+    public static final String SERVICE = "platform_integrity";
+    public static final String PROPERTY = "sys.integrity.policy";
+    public static final long MAX_LEASE_MS = 5000;
+    private static volatile Permit sCached = new Permit("", "", 0, 0);
+
+    private PlatformIntegrity() {}
+
+    public static boolean enabled() {
+        return SystemProperties.getBoolean("ro.platform.integrity.enabled", false);
+    }
+
+    public static final class Permit {
+        public final String value;
+        public final String identity;
+        public final long deadline;
+        public final int features;
+        private Permit(String value, String identity, long deadline, int features) {
+            this.value = value;
+            this.identity = identity;
+            this.deadline = deadline;
+            this.features = features;
+        }
+        public boolean allows(int feature) {
+            long now = SystemClock.elapsedRealtime();
+            return (features & feature) == feature && now < deadline
+                    && deadline - now <= MAX_LEASE_MS;
+        }
+    }
+
+    public static Permit current() {
+        String value = SystemProperties.get(PROPERTY, "");
+        Permit cached = sCached;
+        if (cached.value.equals(value)) return cached;
+        Permit result = new Permit(value, "", 0, 0);
+        if (value.matches("[0-9a-f]{32}:[0-9a-f]{16}:[0-9a-f]{1,8}:[0-9a-f]{1,12}:[0-7]")) {
+            String[] fields = value.split(":");
+            result = new Permit(value, fields[0] + ":" + fields[1] + ":" + fields[2],
+                    Long.parseLong(fields[3], 16), Integer.parseInt(fields[4], 16));
+        }
+        sCached = result;
+        return result;
+    }
+
+    public static boolean allowed(int feature) {
+        return !enabled() || current().allows(feature);
+    }
+
+    private static IPlatformIntegrityService service() {
+        return IPlatformIntegrityService.Stub.asInterface(ServiceManager.getService(SERVICE));
+    }
+
+    /** Legacy compatibility query. Feature permits are automatically managed. */
+    @Deprecated
+    public static boolean setFeatureEnabled(int feature, boolean enabled) {
+        if (!enabled()) return true;
+        try {
+            IPlatformIntegrityService service = service();
+            return service != null && service.setFeatureEnabled(feature, enabled);
+        } catch (RemoteException e) {
+            return false;
+        }
+    }
+
+    public static boolean requestRecheck() {
+        try {
+            IPlatformIntegrityService service = service();
+            return service != null && service.requestRecheck();
+        } catch (RemoteException e) {
+            return false;
+        }
+    }
+
+    /** User-initiated KSU source selection; never grants a feature permit. @hide */
+    public static Bundle requestKernelSuSource(Bundle request) {
+        try {
+            IPlatformIntegrityService service = service();
+            return service == null ? new Bundle() : service.requestKernelSuSource(request);
+        } catch (RemoteException e) { return new Bundle(); }
+    }
+
+    public static boolean requestCompromise(boolean enabled) {
+        try {
+            IPlatformIntegrityService service = service();
+            return service != null && service.requestCompromise(enabled);
+        } catch (RemoteException e) {
+            return false;
+        }
+    }
+
+    public static Bundle getState() {
+        try {
+            IPlatformIntegrityService service = service();
+            if (service != null) return service.getState();
+        } catch (RemoteException ignored) {}
+        Bundle result = new Bundle();
+        result.putString("state", "BOOT_UNKNOWN");
+        result.putString("reason", "Service unavailable");
+        return result;
+    }
+}
