+            if (!facts.optBoolean("resident_green") || SystemClock.elapsedRealtime() >= facts.getLong("resident_until_ms"))
+                throw new EnvironmentSnapshot.Pending();
+            mNotificationGate.verify(ticket, snapshot, SystemClock.elapsedRealtime());
+            if (!retainFindingsLocked(snapshot, true)) return;
