@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+import static org.junit.Assert.*;
+import android.os.SystemClock;
+import android.system.Os;
+import android.system.OsConstants;
+import java.io.FileDescriptor;
+import java.io.IOException;
+import java.util.concurrent.FutureTask;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.Test;
+
+/** No live daemon or policy mutation; only an idle worker and socketpairs. */
+public class AsterNotificationLifecycleTest {
+    private AsterNotificationClient client(AtomicInteger callbacks) {
+        return new AsterNotificationClient(new AsterNotificationClient.Listener() {
+            @Override public void onNotice(AsterNotification.Frame frame) { callbacks.incrementAndGet(); }
+            @Override public void onInterrupted() { callbacks.incrementAndGet(); }
+        });
+    }
+
+    @Test public void stopWakesIdleInputWaitWithoutConnectingOrReportingFailure() throws Exception {
+        AtomicInteger callbacks = new AtomicInteger();
+        AsterNotificationClient client = client(callbacks);
+        client.start(); // no input is ever offered, so no live connect is possible
+        client.stopForShutdown();
+        long end = SystemClock.elapsedRealtime() + 1000;
+        while (!client.status().equals("STOPPED_FOR_SHUTDOWN") && SystemClock.elapsedRealtime() < end)
+            Thread.sleep(5);
+        assertEquals("STOPPED_FOR_SHUTDOWN", client.status());
+        assertEquals(0, callbacks.get());
+    }
+
+    @Test public void shutdownWakesReceiveButWorkerKeepsDescriptorOwnership() throws Exception {
+        FileDescriptor fd = new FileDescriptor(), peer = new FileDescriptor();
+        Os.socketpair(OsConstants.AF_UNIX, OsConstants.SOCK_SEQPACKET
+                | OsConstants.SOCK_NONBLOCK | OsConstants.SOCK_CLOEXEC, 0, fd, peer);
+        try {
+            AsterNotificationClient client = client(new AtomicInteger());
+            assertTrue(client.attach(fd));
+            FutureTask<Boolean> waiter = new FutureTask<>(() -> {
+                try { IntegritySocket.receiveNotice(fd, false); return false; }
+                catch (IOException expected) { return true; }
+            });
+            new Thread(waiter, "AsterShutdownReceiveTest").start();
+            client.stopForShutdown();
+            assertTrue(waiter.get(2, TimeUnit.SECONDS));
+            assertTrue(fd.valid()); // callback used shutdown, not an asynchronous close
+            assertTrue((Os.fcntlInt(fd, OsConstants.F_GETFL, 0) & OsConstants.O_NONBLOCK) != 0);
+        } finally {
+            IntegritySocket.close(fd);
+            IntegritySocket.close(peer);
+        }
+    }
+
+    @Test public void stoppedClientCannotAdoptLateConnectedDescriptor() throws Exception {
+        FileDescriptor fd = new FileDescriptor(), peer = new FileDescriptor();
+        Os.socketpair(OsConstants.AF_UNIX, OsConstants.SOCK_SEQPACKET
+                | OsConstants.SOCK_NONBLOCK | OsConstants.SOCK_CLOEXEC, 0, fd, peer);
+        try {
+            AsterNotificationClient client = client(new AtomicInteger());
+            client.stopForShutdown();
+            assertFalse(client.attach(fd));
+            assertTrue(fd.valid()); // connecting worker, not the client, must close it
+        } finally {
+            IntegritySocket.close(fd);
+            IntegritySocket.close(peer);
+        }
+    }
+}
