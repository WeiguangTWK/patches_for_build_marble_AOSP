+        UserManager users = getContext().getSystemService(UserManager.class);
+        if (users != null && users.isUserUnlocked(UserHandle.of(ActivityManager.getCurrentUser())))
+            requestCeRecheck();
+    }
+
+    @Override public void onUserUnlocked(TargetUser user) {
+        if (user.getUserIdentifier() == ActivityManager.getCurrentUser()) requestCeRecheck();
+    }
+
+    private void requestCeRecheck() {
+        synchronized (mLock) {
+            if (mCeUnlockSeen) return;
+            mCeUnlockSeen = true;
+        }
+        enqueueSyscallRecheck(RECHECK_CE);
+    }
