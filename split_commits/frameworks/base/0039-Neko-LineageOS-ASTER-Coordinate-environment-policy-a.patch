+    private boolean enqueueSyscallRecheck(int triggers) {
+        synchronized (mLock) {
+            if (mShutdown.closing() || mHandler == null) return false;
+            // A manual click during the same in-flight action shares its result.
+            if (mRecheckRunning && triggers == RECHECK_MANUAL) return true;
+            mRecheckPending |= triggers;
+            if (!mRecheckQueued && !mRecheckRunning) {
+                mRecheckQueued = true;
+                mRecheckStatus = "queued";
+                mRecheckBlocksFull = true;
+                mRecheckMinimumNs = 0;
+                mLastEvidence = 0;
+                mCurrentFindings = null;
+                publishLocked(0);
+                mHandler.postDelayed(mRecheckWork,
+                        Math.max(0L, mRecheckNotBefore - SystemClock.elapsedRealtime()));
+            }
+            return true;
+        }
+    }
