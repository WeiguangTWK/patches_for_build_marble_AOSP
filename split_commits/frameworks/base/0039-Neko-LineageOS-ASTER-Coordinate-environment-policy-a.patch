+    private boolean saveLocked(String requested, String boot) {
+        FileOutputStream out = null;
+        try {
+            if (mShutdown.closing() && !requested.equals(mRequested)) return false;
+            if (mRevision == Long.MAX_VALUE || mAlarmGeneration < 0)
+                throw new IOException("Policy generation exhausted");
+            boolean wasCompromise = requested.equals("COMPROMISE")
+                    || (requested.equals("EXIT_COMPROMISE") && mWasCompromise);
+            JSONObject record = new JSONObject().put("was_compromise", wasCompromise)
+                    .put("version", 6).put("shutdown_boot", mShutdownBoot)
+                    .put("shutdown_fas_stop", mShutdownFasStop).put("revision", mRevision + 1)
+                    .put("requested", requested).put("request_boot", boot)
+                    .put("recovery_boot", mRecoveryBoot);
+            JSONArray alarms = new JSONArray();
+            for (String name : mAlarms) alarms.put(name);
+            record.put("alarms", alarms).put("latched_reasons", new JSONArray(mLatchedReasons))
+                    .put("syscall_recheck_attempts", mAutoRecheckAttempts)
+                    .put("latched_reason_evidence", new JSONObject(mReasonEvidence))
+                    .put("alarm_evidence", mAlarmEvidence)
+                    .put("alarm_overflow", mAlarmOverflow)
+                    .put("evidence_lost", mEvidenceLost).put("evidence_loss", mEvidenceLoss)
+                    .put("legacy_alarm_uncertain", mLegacyAlarmUncertain)
+                    .put("alarm_generation", mAlarmGeneration).put("runtime_boot", mBoot)
+                    .put("collector", mCollector).put("classifier", mClassifier)
+                    .put("daemon", mDaemon).put("backend", mBackend).put("tee", mTee);
+            byte[] bytes = record.toString().getBytes(StandardCharsets.UTF_8);
+            out = mFile.startWrite();
+            out.write(bytes);
+            mFile.finishWrite(out);
+            out = null;
+            if (!java.util.Arrays.equals(bytes, mFile.readFully())) throw new IOException("Commit verification failed");
+            FileDescriptor directory = Os.open(mFile.getBaseFile().getParent(),
+                    OsConstants.O_RDONLY | OsConstants.O_CLOEXEC, 0);
+            try {
+                if (!OsConstants.S_ISDIR(Os.fstat(directory).st_mode)) {
+                    throw new IOException("Policy parent is not a directory");
+                }
+                Os.fsync(directory);
+            } finally {
+                Os.close(directory);
+            }
+            mRuntimeBoot = mBoot;
+            mRecordValid = true;
+            mWasCompromise = wasCompromise;
+            mRequested = requested;
+            mRequestBoot = boot;
+            ++mRevision;
+            return true;
+        } catch (Exception e) {
+            if (out != null) mFile.failWrite(out);
+            mRecordValid = false;
+            mEffective = "RESTRICTED_ERROR";
+            mReason = "Unable to persist policy";
+            mReasonCode = "POLICY_UNAVAILABLE";
+            ++mEpoch;
+            publishLocked(0);
+            Slog.e("PlatformIntegrity", mReason, e);
+            return false;
+        }
+    }
+
+    private String identityLocked() {
+        return mBoot + ":" + mAuthority + ":" + Long.toHexString(mEpoch);
+    }
+
+    private void publishLocked(int features) {
+        final AsterNotification.Ticket ticket = mValidatedNotification;
+        if (features != 0 && (mShutdown.closing() || !mNotificationGate.isCurrent(ticket))) features = 0;
+        if (mBoot.isEmpty() || mEpoch > 0xffffffffL) {
+            writePermitProperty("");
+            return;
+        }
+        long now;
+        PermitRenewal.Decision renewal;
+        // Shutdown revocation uses this same writer lock without taking mLock.
+        // Never decide to skip against a value that it has already replaced.
+        if (mShutdown.closing()) {
+            features = 0;
+            renewal = PermitRenewal.Decision.WRITE;
+        } else {
+            mPermitWriteLock.lock();
+            try {
+                now = SystemClock.elapsedRealtime();
+                renewal = mPermitRenewal.decide(SystemProperties.get(PlatformIntegrity.PROPERTY, ""),
+                        identityLocked(), features, mLastDeadline, now);
+            } finally {
+                mPermitWriteLock.unlock();
+            }
+        }
+        if (renewal == PermitRenewal.Decision.CLOCK_INVALID) {
+            mShutdown.fail();
+            writePermitProperty("");
+            return;
+        }
+        if (features != 0 && renewal == PermitRenewal.Decision.REPLACED) {
+            permitReplacedLocked();
+            return;
+        }
+        if (features != 0 && renewal == PermitRenewal.Decision.SKIP && !mShutdown.closing()) {
+            // Skipping I/O is still a publication decision: retain the final
+            // notice/shutdown/age and actual-property checks. Do not advance the
+            // successful deadline, epoch or package cache state on a skip.
+            mPermitWriteLock.lock();
+            try {
+                renewal = mPermitRenewal.decide(SystemProperties.get(PlatformIntegrity.PROPERTY, ""),
+                        identityLocked(), features, mLastDeadline, SystemClock.elapsedRealtime());
+                if (renewal == PermitRenewal.Decision.SKIP && !mShutdown.closing()
+                        && mNotificationGate.isCurrent(ticket) && allowedFeaturesLocked() == features)
+                    return;
+            } finally {
+                mPermitWriteLock.unlock();
+            }
+            if (renewal == PermitRenewal.Decision.REPLACED) {
+                permitReplacedLocked();
+                return;
+            }
+            // A late hint, age boundary or shutdown must not turn a skipped
+            // stale positive into a new positive write.
+            features = 0;
+        }
+        now = SystemClock.elapsedRealtime();
+        if (now < 0 || now > PermitRenewal.MAX_TIME - PermitRenewal.LEASE_MS
+                || renewal == PermitRenewal.Decision.CLOCK_INVALID) {
+            mShutdown.fail();
+            writePermitProperty("");
+            return;
+        }
+        if (features != 0 && (mShutdown.closing() || !mNotificationGate.isCurrent(ticket)
+                || allowedFeaturesLocked() != features)) features = 0;
+        if (mPublishedFeatures != features || (mLastDeadline != 0 && now >= mLastDeadline)) ++mEpoch;
+        if (mEpoch > 0xffffffffL) {
+            writePermitProperty("");
+            return;
+        }
+        final long deadline = features != 0 && mPartialResident
+                ? Math.min(now + PermitRenewal.LEASE_MS, mResidentUntil) : now + PermitRenewal.LEASE_MS;
+        if (!writePermitProperty(identityLocked() + ":" + Long.toHexString(deadline) + ":" + features)) return;
+        mLastDeadline = deadline;
+        // A hint can arrive between the check and property write. Do not let a
+        // stale positive write survive this operation; in-flight side effects
+        // remain subject to the existing execution-end cleanup boundaries.
+        if (features != 0 && (mShutdown.closing() || !mNotificationGate.isCurrent(ticket)
+                || allowedFeaturesLocked() != features)) {
+            features = 0;
+            ++mEpoch;
+            if (!writePermitProperty(mEpoch > 0xffffffffL ? ""
+                    : identityLocked() + ":" + Long.toHexString(mLastDeadline) + ":0")) return;
+        }
+        if (mPublishedFeatures != features) {
+            PackageManager.invalidatePackageInfoCache();
+            ApplicationPackageManager.invalidateGetPackagesForUidCache();
+            ApplicationPackageManager.invalidateQueryIntentActivitiesCache();
+        }
+        mPublishedFeatures = features;
+    }
+
+    private void permitReplacedLocked() {
+        // Never adopt a foreign/malformed value as this coordinator's success.
+        ++mEpoch;
+        mBound = mEndpointsConfirmed = false;
+        mLastEvidence = 0;
+        publishLocked(0); // Force actual revocation before possible disk I/O.
+        mEffective = "RESTRICTED_ERROR";
+        mReason = "Feature permit property changed; fresh validation required";
+        mReasonCode = "CONTROL_INTERRUPTED";
+        if (latchModeLocked()) {
+            mInterrupted = true;
+            if (retainReasonLocked("CONTROL_INTERRUPTED")) saveLocked(mRequested, mRequestBoot);
+        }
+    }
