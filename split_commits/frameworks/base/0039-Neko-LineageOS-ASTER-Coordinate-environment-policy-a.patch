new file mode 100644
index 000000000..68cefc91f
--- /dev/null
+++ b/services/tests/servicestests/src/com/android/server/platformintegrity/IntegritySocketTest.java
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+import static org.junit.Assert.*;
+
+import android.os.SystemClock;
+import android.os.Process;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+import java.io.FileDescriptor;
+import java.io.IOException;
+import java.io.InterruptedIOException;
+import java.nio.charset.StandardCharsets;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+
+public class IntegritySocketTest {
+    private FileDescriptor client;
+    private FileDescriptor peer;
+    private static final byte[] REQUEST = "ENVIRONMENT_V2".getBytes(StandardCharsets.UTF_8);
+
+    @Before public void createPair() throws Exception {
+        client = new FileDescriptor();
+        peer = new FileDescriptor();
+        Os.socketpair(OsConstants.AF_UNIX, OsConstants.SOCK_SEQPACKET
+                | OsConstants.SOCK_NONBLOCK | OsConstants.SOCK_CLOEXEC, 0, client, peer);
+    }
+
+    @After public void closePair() {
+        for (FileDescriptor fd : new FileDescriptor[]{client, peer}) {
+            if (fd == null) continue;
+            try { Os.close(fd); } catch (ErrnoException ignored) { }
+        }
+    }
+
+    @Test public void exactPacketRoundTrip() throws Exception {
+        byte[] response = "{\"kind\":\"test\"}".getBytes(StandardCharsets.UTF_8);
+        assertEquals(response.length, Os.sendto(peer, response, 0, response.length, 0, null));
+        assertEquals(new String(response, StandardCharsets.UTF_8),
+                IntegritySocket.transact(client, REQUEST, SystemClock.elapsedRealtime() + 500));
+        byte[] request = new byte[64];
+        int count = Os.recvfrom(peer, request, 0, request.length, OsConstants.MSG_TRUNC, null);
+        assertEquals(REQUEST.length, count);
+        assertEquals("ENVIRONMENT_V2", new String(request, 0, count, StandardCharsets.UTF_8));
+    }
+
+    @Test public void credentialWrapperPreservesOwnedNonblockingFd() throws Exception {
+        int flags = Os.fcntlInt(client, OsConstants.F_GETFL, 0);
+        assertEquals(Process.myUid(), IntegritySocket.peerUid(client));
+        assertTrue(client.valid());
+        assertEquals(flags, Os.fcntlInt(client, OsConstants.F_GETFL, 0));
+        assertTrue((flags & OsConstants.O_NONBLOCK) != 0);
+        // The borrowed LocalSocket is closed; caller's descriptor still works.
+        exactPacketRoundTrip();
+    }
+
+    @Test public void oversizedResponseIsRejectedAsOnePacket() throws Exception {
+        byte[] response = new byte[65536];
+        assertEquals(response.length, Os.sendto(peer, response, 0, response.length, 0, null));
+        try {
+            IntegritySocket.transact(client, REQUEST, SystemClock.elapsedRealtime() + 500);
+            fail("oversized response accepted");
+        } catch (IOException expected) { }
+    }
+
+    @Test public void expiredDeadlineDoesNotSend() throws Exception {
+        try {
+            IntegritySocket.transact(client, REQUEST, SystemClock.elapsedRealtime());
+            fail("expired deadline accepted");
+        } catch (InterruptedIOException expected) { }
+        try {
+            Os.recvfrom(peer, new byte[64], 0, 64, 0, null);
+            fail("request sent after deadline");
+        } catch (ErrnoException expected) {
+            assertEquals(OsConstants.EAGAIN, expected.errno);
+        }
+    }
+
+    @Test(timeout = 3000) public void silentPeerDoesNotResetDeadline() throws Exception {
+        long deadline = SystemClock.elapsedRealtime() + 50;
+        try {
+            IntegritySocket.transact(client, REQUEST, deadline);
+            fail("silent peer accepted");
+        } catch (InterruptedIOException expected) { }
+    }
+
+    @Test public void closedPeerFailsWithoutRetryingConnection() throws Exception {
+        Os.close(peer);
+        peer = null;
+        try {
+            IntegritySocket.transact(client, REQUEST, SystemClock.elapsedRealtime() + 500);
+            fail("closed peer accepted");
+        } catch (IOException expected) { }
+    }
+
+    @Test public void unapprovedEndpointAndEmptyRequestAreRejected() throws Exception {
+        try {
+            IntegritySocket.exchange("unapproved_integrity_endpoint", "x");
+            fail("unexpected endpoint accepted");
+        } catch (IOException expected) { }
+        try {
+            IntegritySocket.transact(client, new byte[0], SystemClock.elapsedRealtime() + 500);
+            fail("empty request accepted");
+        } catch (IOException expected) { }
+    }
+
+    @Test public void noticeAckIsOnePacketAndClosedIdlePeerFails() throws Exception {
+        IntegritySocket.sendNotice(client, "ACK_NOTIFY_V1\t{}");
+        byte[] data = new byte[64];
+        int count = Os.recvfrom(peer, data, 0, data.length, OsConstants.MSG_TRUNC, null);
+        assertEquals("ACK_NOTIFY_V1\t{}", new String(data, 0, count, StandardCharsets.UTF_8));
+        Os.close(peer);
+        peer = null;
+        try { IntegritySocket.receiveNotice(client, false); fail("closed notice peer accepted"); }
+        catch (IOException expected) { }
+    }
+
+    @Test(timeout = 3000) public void initialNoticeHasActiveTimeDeadline() throws Exception {
+        try { IntegritySocket.receiveNotice(client, true); fail("silent initial peer accepted"); }
+        catch (InterruptedIOException expected) { }
+    }
+
+    @Test public void oversizedNoticeIsNotSilentlyTruncated() throws Exception {
+        byte[] data = new byte[2048];
+        assertEquals(data.length, Os.sendto(peer, data, 0, data.length, 0, null));
+        try { IntegritySocket.receiveNotice(client, true); fail("oversized notice accepted"); }
+        catch (IOException expected) { }
+    }
+}
diff --git a/services/tests/servicestests/src/com/android/server/platformintegrity/PermitRenewalTest.java b/services/tests/servicestests/src/com/android/server/platformintegrity/PermitRenewalTest.java
new file mode 100644
index 000000000..79a11bc3f
--- /dev/null
+++ b/services/tests/servicestests/src/com/android/server/platformintegrity/PermitRenewalTest.java
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+import static org.junit.Assert.*;
+import org.junit.Test;
+
+/** Pure helper tests. They do not change live system properties or grant features. */
+public class PermitRenewalTest {
+    private static final String ID = "0123456789abcdef0123456789abcdef:0123456789abcdef:1";
+
+    private static String value(String identity, long deadline, int mask) {
+        return identity + ":" + Long.toHexString(deadline) + ":" + mask;
+    }
+
+    private PermitRenewal ready() {
+        PermitRenewal renewal = new PermitRenewal();
+        renewal.succeeded(value(ID, 4000, 2));
+        return renewal;
+    }
+
+    @Test public void startupNeverAdoptsActualValueAsCachedSuccess() {
+        assertEquals(PermitRenewal.Decision.WRITE, new PermitRenewal().decide(
+                value(ID, 4000, 2), ID, 2, 4000, 500));
+    }
+
+    @Test public void unchangedSuccessfulPermitSkipsOnlyAboveMargin() {
+        PermitRenewal renewal = ready();
+        assertEquals(PermitRenewal.Decision.SKIP,
+                renewal.decide(value(ID, 4000, 2), ID, 2, 4000, 1999));
+        assertEquals(PermitRenewal.Decision.WRITE,
+                renewal.decide(value(ID, 4000, 2), ID, 2, 4000, 2000));
+        assertEquals(PermitRenewal.Decision.WRITE,
+                renewal.decide(value(ID, 4000, 2), ID, 2, 4000, 2001));
+    }
+
+    @Test public void skipNeverMovesSuccessfulDeadline() {
+        PermitRenewal renewal = ready();
+        for (long now : new long[]{500, 1000, 1500}) {
+            assertEquals(PermitRenewal.Decision.SKIP,
+                    renewal.decide(value(ID, 4000, 2), ID, 2, 4000, now));
+        }
+        assertEquals(PermitRenewal.Decision.WRITE,
+                renewal.decide(value(ID, 4000, 2), ID, 2, 4000, 2000));
+    }
+
+    @Test public void zeroAndInvalidMasksAlwaysWrite() {
+        for (int mask : new int[]{0, -1, 8}) {
+            assertEquals(PermitRenewal.Decision.WRITE,
+                    ready().decide(value(ID, 4000, 2), ID, mask, 4000, 500));
+        }
+    }
+
+    @Test public void maskAndIdentityChangesCannotSkip() {
+        assertEquals(PermitRenewal.Decision.WRITE,
+                ready().decide(value(ID, 4000, 2), ID, 7, 4000, 500));
+        assertEquals(PermitRenewal.Decision.WRITE,
+                ready().decide(value(ID, 4000, 2), ID + "0", 2, 4000, 500));
+    }
+
+    @Test public void replacementClearAndMalformedValuesRetireSuccessfulCache() {
+        for (String actual : new String[]{"", "malformed", value(ID, 4500, 2),
+                value(ID, 4000, 7), value(ID + "0", 4000, 2)}) {
+            PermitRenewal renewal = ready();
+            assertEquals(PermitRenewal.Decision.REPLACED,
+                    renewal.decide(actual, ID, 2, 4000, 500));
+            // Restoring the old raw value cannot resurrect cleared success.
+            assertEquals(PermitRenewal.Decision.WRITE,
+                    renewal.decide(value(ID, 4000, 2), ID, 2, 4000, 501));
+        }
+    }
+
+    @Test public void failedWriteCannotBecomeSuccess() {
+        PermitRenewal renewal = ready();
+        renewal.failed();
+        assertEquals(PermitRenewal.Decision.WRITE,
+                renewal.decide(value(ID, 4000, 2), ID, 2, 4000, 500));
+    }
+
+    @Test public void actualSuccessfulRenewalEstablishesNewDeadline() {
+        PermitRenewal renewal = ready();
+        renewal.decide(value(ID, 4000, 2), ID, 2, 4000, 2000);
+        renewal.succeeded(value(ID, 6000, 2));
+        assertEquals(PermitRenewal.Decision.SKIP,
+                renewal.decide(value(ID, 6000, 2), ID, 2, 6000, 2500));
+    }
+
+    @Test public void expiredLeaseCannotSkip() {
+        assertEquals(PermitRenewal.Decision.WRITE,
+                ready().decide(value(ID, 4000, 2), ID, 2, 4000, 4000));
+        assertEquals(PermitRenewal.Decision.WRITE,
+                ready().decide(value(ID, 4000, 2), ID, 2, 4000, 4500));
+    }
+
+    @Test public void overlongFutureLeaseCannotSkip() {
+        PermitRenewal renewal = new PermitRenewal();
+        renewal.succeeded(value(ID, 6000, 2));
+        assertEquals(PermitRenewal.Decision.WRITE,
+                renewal.decide(value(ID, 6000, 2), ID, 2, 6000, 500));
+    }
+
+    @Test public void clockRegressionAndOverflowAreTerminalForCoalescing() {
+        PermitRenewal renewal = ready();
+        renewal.decide(value(ID, 4000, 2), ID, 2, 4000, 1000);
+        assertEquals(PermitRenewal.Decision.CLOCK_INVALID,
+                renewal.decide(value(ID, 4000, 2), ID, 2, 4000, 999));
+        assertEquals(PermitRenewal.Decision.CLOCK_INVALID,
+                renewal.decide(value(ID, 4000, 2), ID, 2, 4000, 1500));
+        assertEquals(PermitRenewal.Decision.CLOCK_INVALID, ready().decide(
+                value(ID, 4000, 2), ID, 2, 4000, PermitRenewal.MAX_TIME - PermitRenewal.LEASE_MS + 1));
+    }
+
+    @Test public void decisionMustBeRecheckedAfterDelayOrReplacement() {
+        PermitRenewal renewal = ready();
+        assertEquals(PermitRenewal.Decision.SKIP,
+                renewal.decide(value(ID, 4000, 2), ID, 2, 4000, 1999));
+        assertEquals(PermitRenewal.Decision.WRITE,
+                renewal.decide(value(ID, 4000, 2), ID, 2, 4000, 2000));
+        assertEquals(PermitRenewal.Decision.REPLACED,
+                renewal.decide("replaced", ID, 2, 4000, 2001));
+    }
+
+    @Test public void stableFixtureSkipsFifteenOfTwentyWrites() {
+        PermitRenewal renewal = new PermitRenewal();
+        String actual = "";
+        long deadline = 0;
+        int writes = 0, skips = 0;
+        for (long now = 0; now < 10000; now += 500) {
+            PermitRenewal.Decision decision = renewal.decide(actual, ID, 2, deadline, now);
+            if (decision == PermitRenewal.Decision.SKIP) {
+                ++skips;
+            } else {
+                assertEquals(PermitRenewal.Decision.WRITE, decision);
+                deadline = now + PermitRenewal.LEASE_MS;
+                actual = value(ID, deadline, 2);
+                renewal.succeeded(actual);
+                ++writes;
+            }
+        }
+        assertEquals(5, writes);
+        assertEquals(15, skips);
+    }
+}
diff --git a/services/tests/servicestests/src/com/android/server/platformintegrity/ShutdownGateTest.java b/services/tests/servicestests/src/com/android/server/platformintegrity/ShutdownGateTest.java
new file mode 100644
index 000000000..6dd2d8500
--- /dev/null
+++ b/services/tests/servicestests/src/com/android/server/platformintegrity/ShutdownGateTest.java
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+import static org.junit.Assert.*;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+import org.junit.Test;
+
+public class ShutdownGateTest {
+    @Test public void noConfirmedRequestLeavesGateRunning() {
+        ShutdownGate gate = new ShutdownGate(() -> 100);
+        gate.await(); // A canceled dialog must never call begin.
+        assertFalse(gate.closing());
+        assertEquals("RUNNING", gate.status());
+    }
+
+    @Test public void beginImmediatelyAndIrreversiblyFencesAuthorization() {
+        ShutdownGate gate = new ShutdownGate(() -> 100);
+        assertTrue(gate.begin());
+        assertTrue(gate.closing());
+        assertFalse(gate.begin());
+        assertFalse(gate.terminal());
+    }
+
+    @Test public void duplicateRequestDoesNotExtendBudget() {
+        AtomicLong now = new AtomicLong(100);
+        ShutdownGate gate = new ShutdownGate(now::get);
+        gate.begin();
+        now.set(1000);
+        assertFalse(gate.begin());
+        assertEquals(1100, gate.remaining());
+    }
+
+    @Test public void completeRequiresConfirmedZeroPermit() {
+        ShutdownGate gate = new ShutdownGate(() -> 100);
+        gate.begin();
+        AtomicInteger calls = new AtomicInteger();
+        assertFalse(gate.complete(() -> { calls.incrementAndGet(); return true; }));
+        assertEquals(0, calls.get());
+        assertEquals("FAILED", gate.status());
+        assertTrue(gate.closing());
+    }
+
+    @Test public void changedNotificationTicketPreventsExpectedClose() {
+        ShutdownGate gate = new ShutdownGate(() -> 100);
+        gate.begin();
+        gate.confirmRevoked();
+        assertFalse(gate.complete(() -> false));
+        assertFalse(gate.terminal());
+        assertTrue(gate.closing());
+    }
+
+    @Test public void completedHandoffIsTerminalEvenIfShutdownLaterFails() {
+        ShutdownGate gate = new ShutdownGate(() -> 100);
+        gate.begin();
+        gate.confirmRevoked();
+        assertTrue(gate.complete(() -> true));
+        gate.fail();
+        gate.await();
+        assertTrue(gate.terminal());
+        assertFalse(gate.begin());
+    }
+
+    @Test public void expiredDrainRejectsLateReceiptAndSeal() {
+        AtomicLong now = new AtomicLong(100);
+        ShutdownGate gate = new ShutdownGate(now::get);
+        gate.begin();
+        gate.confirmRevoked();
+        now.set(2100);
+        AtomicInteger calls = new AtomicInteger();
+        assertFalse(gate.complete(() -> { calls.incrementAndGet(); return true; }));
+        assertEquals(0, calls.get());
+        assertEquals("FAILED", gate.status());
+    }
+
+    @Test public void awaitExpiryCannotBeRevivedByWorker() {
+        AtomicLong now = new AtomicLong(100);
+        ShutdownGate gate = new ShutdownGate(now::get);
+        gate.begin();
+        now.set(2100);
+        gate.await();
+        gate.confirmRevoked();
+        assertFalse(gate.complete(() -> true));
+        assertEquals("FAILED", gate.status());
+    }
+
+    @Test public void explicitFailureCannotBeRevived() {
+        ShutdownGate gate = new ShutdownGate(() -> 100);
+        gate.begin();
+        gate.confirmRevoked();
+        gate.fail();
+        assertFalse(gate.complete(() -> true));
+        assertFalse(gate.begin());
+    }
+
+    @Test public void persistedFreezeIsDenialNotExpectedCloseAuthority() {
+        ShutdownGate gate = new ShutdownGate(() -> 100);
+        gate.restoreFrozen();
+        assertTrue(gate.closing());
+        assertFalse(gate.terminal());
+        assertFalse(gate.complete(() -> true));
+    }
+
+    @Test public void newBootStillNeedsFreshAuthorityOutsideThisGate() {
+        ShutdownGate old = new ShutdownGate(() -> 100);
+        old.restoreFrozen();
+        ShutdownGate fresh = new ShutdownGate(() -> 100);
+        assertFalse(fresh.closing()); // no permit is created by this object
+    }
+
+    @Test public void regressedClockCannotFinish() {
+        AtomicLong now = new AtomicLong(100);
+        ShutdownGate gate = new ShutdownGate(now::get);
+        gate.begin();
+        gate.confirmRevoked();
+        now.set(99);
+        assertFalse(gate.complete(() -> true));
+        assertTrue(gate.closing());
+    }
+
+    @Test public void clockOverflowNeverStartsAnAuthorizingWindow() {
+        for (long now : new long[]{-1, Long.MAX_VALUE}) {
+            ShutdownGate gate = new ShutdownGate(() -> now);
+            assertFalse(gate.begin());
+            assertTrue(gate.closing());
+            assertFalse(gate.terminal());
+        }
+    }
+}
diff --git a/services/tests/servicestests/src/com/android/server/platformintegrity/ShutdownPermitWriterTest.java b/services/tests/servicestests/src/com/android/server/platformintegrity/ShutdownPermitWriterTest.java
new file mode 100644
index 000000000..f912d77b4
--- /dev/null
+++ b/services/tests/servicestests/src/com/android/server/platformintegrity/ShutdownPermitWriterTest.java
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+import static org.junit.Assert.*;
+import android.os.PlatformIntegrity;
+import android.os.SystemClock;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+import android.system.StructPollfd;
+import java.io.FileDescriptor;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.FutureTask;
+import java.util.concurrent.TimeUnit;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+
+/** Socketpair-only property protocol tests. Never connects to the property service. */
+public class ShutdownPermitWriterTest {
+    private FileDescriptor client, peer;
+    private static final String ID = "a".repeat(32) + ":" + "b".repeat(16) + ":3";
+
+    @Before public void createPair() throws Exception {
+        client = new FileDescriptor();
+        peer = new FileDescriptor();
+        Os.socketpair(OsConstants.AF_UNIX, OsConstants.SOCK_STREAM
+                | OsConstants.SOCK_CLOEXEC | OsConstants.SOCK_NONBLOCK, 0, client, peer);
+    }
+    @After public void closePair() {
+        IntegritySocket.close(client);
+        IntegritySocket.close(peer);
+    }
+
+    private byte[] read(int length) throws Exception {
+        byte[] result = new byte[length];
+        int offset = 0;
+        long deadline = SystemClock.elapsedRealtime() + 1000;
+        while (offset < length) {
+            long left = deadline - SystemClock.elapsedRealtime();
+            assertTrue("Test peer deadline", left > 0);
+            StructPollfd wait = new StructPollfd();
+            wait.fd = peer; wait.events = (short) OsConstants.POLLIN;
+            assertEquals(1, Os.poll(new StructPollfd[]{wait}, (int) left));
+            int n = Os.recvfrom(peer, result, offset, length - offset, 0, null);
+            assertTrue(n > 0);
+            offset += n;
+        }
+        return result;
+    }
+    private int readInt() throws Exception {
+        return ByteBuffer.wrap(read(4)).order(ByteOrder.nativeOrder()).getInt();
+    }
+    private String request() throws Exception {
+        assertEquals(0x00020001, readInt());
+        int nameLength = readInt();
+        assertTrue(nameLength > 0 && nameLength < 92);
+        assertEquals(PlatformIntegrity.PROPERTY, new String(read(nameLength), StandardCharsets.UTF_8));
+        int valueLength = readInt();
+        assertTrue(valueLength >= 0 && valueLength < 92);
+        return new String(read(valueLength), StandardCharsets.UTF_8);
+    }
+    private void reply(int status) throws Exception {
+        byte[] data = ByteBuffer.allocate(4).order(ByteOrder.nativeOrder()).putInt(status).array();
+        assertEquals(4, Os.sendto(peer, data, 0, 4, 0, null));
+    }
+    private FutureTask<Boolean> start(String value, long budget) {
+        FutureTask<Boolean> future = new FutureTask<>(() -> {
+            try {
+                ShutdownPermitWriter.transact(client, value, SystemClock.elapsedRealtime() + budget);
+                return true;
+            } catch (IOException expected) { return false; }
+        });
+        new Thread(future, "ShutdownPropertyProtocolTest").start();
+        return future;
+    }
+    private void noPacket() throws Exception {
+        try {
+            Os.recvfrom(peer, new byte[1], 0, 1, 0, null);
+            fail("Unexpected property request");
+        } catch (ErrnoException expected) { assertEquals(OsConstants.EAGAIN, expected.errno); }
+    }
+
+    @Test public void emptyRevokeUsesExactFixedPropertyAndProtocol() throws Exception {
+        FutureTask<Boolean> future = start("", 500);
+        assertEquals("", request());
+        reply(0);
+        assertTrue(future.get(2, TimeUnit.SECONDS));
+    }
+
+    @Test public void validZeroPermitRoundTrips() throws Exception {
+        FutureTask<Boolean> future = start(ID + ":1004:0", 500);
+        assertEquals(ID + ":1004:0", request());
+        reply(0);
+        assertTrue(future.get(2, TimeUnit.SECONDS));
+    }
+
+    @Test public void positiveOrMalformedPermitNeverSends() throws Exception {
+        for (String value : new String[]{ID + ":1004:2", ID + ":1004:7", "bad:0"}) {
+            try {
+                ShutdownPermitWriter.transact(client, value, SystemClock.elapsedRealtime() + 500);
+                fail("Non-revocation request accepted");
+            } catch (IOException expected) { }
+            noPacket();
+        }
+    }
+
+    @Test public void expiredDeadlineDoesNotSend() throws Exception {
+        try {
+            ShutdownPermitWriter.transact(client, "", SystemClock.elapsedRealtime());
+            fail("Expired request accepted");
+        } catch (IOException expected) { }
+        noPacket();
+    }
+
+    @Test public void nonzeroStatusIsFailure() throws Exception {
+        FutureTask<Boolean> future = start("", 500);
+        request(); reply(1);
+        assertFalse(future.get(2, TimeUnit.SECONDS));
+    }
+
+    @Test public void partialStatusIsReassembled() throws Exception {
+        FutureTask<Boolean> future = start("", 500);
+        request();
+        assertEquals(1, Os.sendto(peer, new byte[1], 0, 1, 0, null));
+        Thread.sleep(10);
+        assertEquals(3, Os.sendto(peer, new byte[3], 0, 3, 0, null));
+        assertTrue(future.get(2, TimeUnit.SECONDS));
+    }
+
+    @Test public void eofDuringStatusFails() throws Exception {
+        FutureTask<Boolean> future = start("", 500);
+        request();
+        assertEquals(2, Os.sendto(peer, new byte[2], 0, 2, 0, null));
+        Os.shutdown(peer, OsConstants.SHUT_WR);
+        assertFalse(future.get(2, TimeUnit.SECONDS));
+    }
+
+    @Test public void silentPeerCannotExtendDeadline() throws Exception {
+        long began = SystemClock.elapsedRealtime();
+        FutureTask<Boolean> future = start("", 150);
+        request();
+        assertFalse(future.get(2, TimeUnit.SECONDS));
+        assertTrue(SystemClock.elapsedRealtime() - began < 2000);
+    }
+
+    @Test public void firstRevokePreservesAuthorityButDropsAllFeatures() {
+        assertEquals(ID + ":1004:0", ShutdownPermitWriter.zeroFor(ID + ":ffff:2", 100));
+        assertEquals(ID + ":1004:0", ShutdownPermitWriter.zeroFor(ID + ":ffff:7", 100));
+    }
+
+    @Test public void invalidCurrentPermitOrClockBecomesEmptyDenial() {
+        assertEquals("", ShutdownPermitWriter.zeroFor("malformed", 100));
+        assertEquals("", ShutdownPermitWriter.zeroFor(ID + ":ffff:7", -1));
+        assertEquals("", ShutdownPermitWriter.zeroFor(ID + ":ffff:7", Long.MAX_VALUE));
+    }
+}
