+    private JSONObject identity() throws Exception {
+        return new JSONObject().put("boot_id", BOOT).put("collector_instance", COMPACT)
+                .put("classifier_instance", CLASSIFIER).put("baseline_sha256", BASELINE);
+    }
+    private JSONObject notice() throws Exception {
+        return new JSONObject().put("kind", "aster.notification").put("version", 1)
+                .put("session", "d".repeat(32)).put("challenge", CHALLENGE)
+                .put("identity", identity().put("notification_stream", "e".repeat(32)))
+                .put("serial", 1).put("state", "initial").put("generation", 10)
+                .put("evidence_sequence", 17).put("pending", 0)
+                .put("measurement_protocol", 1).put("change_mask", 15);
+    }
+    private AsterNotification.Frame parse(String raw, AsterNotification.Frame previous) throws Exception {
+        return new AsterNotification.Frame(raw, identity(), 1, CHALLENGE, previous);
+    }
+    private void reject(String raw) throws Exception {
+        try { parse(raw, null); fail("invalid notice accepted"); } catch (Exception expected) { }
+    }
+    private EnvironmentSnapshot environment() throws Exception {
+        JSONObject report = new JSONObject().put("kind", "aster.environment").put("version", 2)
+                .put("status", "observed").put("identity", identity().put("collector_identity_kind", "boot_scope"))
+                .put("observation", new JSONObject().put("serial", 1).put("clock", "BOOTTIME")
+                        .put("started_ms", 100).put("completed_ms", 101))
+                .put("collection", new JSONObject().put("status", "consistent").put("backend", "full")
+                        .put("measurement_protocol", 1).put("evidence_sequence", 17)
+                        .put("pending_measurements", 0).put("evidence_lost", false).put("loss_count", 0))
+                .put("coverage", new JSONObject().put("status", "full_measurement").put("full_measurement", true)
+                        .put("raw_hashes_measured", true).put("syscall_measured", true).put("early_history_gap", false)
+                        .put("syscall_abis", 3).put("syscall_check_ns", 90).put("syscall_changed", 0))
+                .put("classification", new JSONObject().put("status", "classified").put("scope", "load_history_and_inventory")
+                        .put("official", new JSONObject().put("status", "classified").put("unknown_modules", 0)
+                                .put("unknown_names", new JSONArray()).put("unknown_overflow", false).put("unapproved_versions", 0)
+                                .put("unapproved_names", new JSONArray()).put("unapproved_names_overflow", false))
+                        .put("community", new JSONObject().put("status", "classified").put("unknown_modules", 0)
+                                .put("unknown_names", new JSONArray()).put("unknown_overflow", false).put("unapproved_versions", 0)
+                                .put("unapproved_names", new JSONArray()).put("unapproved_names_overflow", false)));
+        return new EnvironmentSnapshot(report, COMPACT, 102);
+    }
+
+    @Test public void fullStreamDoesNotBecomeMeasurementIdentity() throws Exception {
+        AsterNotification.Frame frame = parse(notice().toString(), null);
+        assertNotEquals(COMPACT, frame.stream);
+        assertEquals(COMPACT, frame.collector);
+        assertTrue(frame.ack.startsWith("ACK_NOTIFY_V1\t"));
+        frame.verify(environment());
+    }
+
+    @Test public void duplicatesExtraFieldsAndNonIntegralNumbersReject() throws Exception {
+        String raw = notice().toString();
+        reject(raw.replace("\"version\":1", "\"version\":1,\"version\":1"));
+        reject(raw.replace("\"generation\":10", "\"generation\":1e1"));
+        reject(raw.replace("\"generation\":10", "\"generation\":9223372036854775808"));
+        reject(notice().put("feature_mask", 7).toString());
+        reject(raw + "{}");
+        reject(notice().put("challenge", "f".repeat(32)).toString());
+    }
+
+    @Test public void digestRequiresSelectedCollectorStream() throws Exception {
+        JSONObject raw = notice().put("measurement_protocol", 4);
+        try {
+            new AsterNotification.Frame(raw.toString(), identity(), 4, CHALLENGE, null);
+            fail("V4 foreign stream accepted");
+        } catch (Exception expected) { }
+        raw.getJSONObject("identity").put("notification_stream", COMPACT);
+        assertEquals(4, new AsterNotification.Frame(raw.toString(), identity(), 4, CHALLENGE, null).protocol);
+    }
+
+    @Test public void serialGapOrChangedStreamReject() throws Exception {
+        AsterNotification.Frame previous = parse(notice().toString(), null);
+        for (boolean stream : new boolean[]{false, true}) {
+            JSONObject raw = notice().put("state", "changed").put("serial", stream ? 2 : 3)
+                    .put("generation", 11);
+            if (stream) raw.getJSONObject("identity").put("notification_stream", "f".repeat(32));
+            try { parse(raw.toString(), previous); fail("broken stream accepted"); }
+            catch (Exception expected) { }
+        }
+    }
+
+    @Test public void staleTicketCannotCommitAfterHint() throws Exception {
+        AsterNotification.Gate gate = new AsterNotification.Gate();
+        AsterNotification.Ticket before = gate.capture();
+        gate.notice(parse(notice().toString(), null));
+        assertFalse(gate.isCurrent(before));
+        try { gate.verify(before, environment(), 103); fail("late work committed"); }
+        catch (Exception expected) { }
+        gate.verify(gate.capture(), environment(), 103);
+    }
+
+    @Test public void pendingOrOlderEnvironmentNeverConfirms() throws Exception {
+        for (String key : new String[]{"pending", "evidence_sequence"}) {
+            AsterNotification.Gate gate = new AsterNotification.Gate();
+            gate.notice(parse(notice().put(key, key.equals("pending") ? 1 : 18).toString(), null));
+            try { gate.verify(gate.capture(), environment(), 103); fail("incomplete confirmation"); }
+            catch (Exception expected) { }
+        }
+    }
+
+    @Test public void reconnectCannotClearInterruptionAndExpiryNeverGrants() throws Exception {
+        AsterNotification.Gate gate = new AsterNotification.Gate();
+        gate.notice(parse(notice().toString(), null));
+        gate.interrupted();
+        gate.notice(parse(notice().put("session", "f".repeat(32)).toString(), null));
+        assertTrue(gate.capture().broken);
+        try { gate.verify(gate.capture(), environment(), 103); fail("interruption cleared"); }
+        catch (Exception expected) { }
+        gate = new AsterNotification.Gate();
+        gate.notice(parse(notice().toString(), null));
+        try { gate.verify(gate.capture(), environment(), 2101); fail("expired evidence accepted"); }
+        catch (Exception expected) { }
+    }
+
+    @Test public void explicitRebindNeedsNewChallengeAndRetiresOldTicket() throws Exception {
+        AsterNotification.Gate gate = new AsterNotification.Gate();
+        AsterNotification.Frame old = parse(notice().toString(), null);
+        gate.notice(old);
+        AsterNotification.Ticket ticket = gate.capture();
+        gate.interrupted();
+        gate.rebound(parse(notice().put("session", "f".repeat(32)).toString(), null));
+        assertTrue(gate.capture().broken); // a new session alone is insufficient
+        String challenge = "9".repeat(32);
+        JSONObject raw = notice().put("session", "8".repeat(32)).put("challenge", challenge);
+        AsterNotification.Frame fresh = new AsterNotification.Frame(raw.toString(), identity(), 1, challenge, null);
+        gate.rebound(fresh);
+        assertFalse(gate.capture().broken);
+        assertEquals(1, gate.capture().interruptions); // reconnect cannot erase the host latch input
+        assertFalse(gate.isCurrent(ticket));
+        // This validates only a transport ticket. Host latches, endpoint stop
+        // checks and a new report-bound publication still precede any permit.
+        gate.verify(gate.capture(), environment(), 103);
+    }
+
+    @Test public void explicitCoordinationRejectionIsNotTemporaryWaiting() throws Exception {
+        AsterNotification.Gate gate = new AsterNotification.Gate();
+        AsterNotification.Frame frame = parse(notice().toString(), null);
+        gate.notice(frame);
+        JSONObject reply = new JSONObject().put("kind", "aster.notified_coordination")
+                .put("version", 2).put("notification", frame.proof())
+                .put("receipt", new JSONObject().put("accepted", false).put("rejection", "REFERENCE_UNAVAILABLE"));
+        try {
+            gate.coordinationReceipt(gate.capture(), reply);
+            fail("Unsupported scope accepted");
+        } catch (AsterNotification.Rejected expected) {
+            assertEquals("REFERENCE_UNAVAILABLE", expected.getMessage());
+        }
+    }
+
+    @Test public void coalescedInterruptionsRemainObservableAfterRebind() throws Exception {
+        AsterNotification.Gate gate = new AsterNotification.Gate();
+        gate.notice(parse(notice().toString(), null));
+        gate.interrupted();
+        gate.interrupted();
+        String challenge = "9".repeat(32);
+        JSONObject raw = notice().put("session", "8".repeat(32)).put("challenge", challenge);
+        gate.rebound(new AsterNotification.Frame(raw.toString(), identity(), 1, challenge, null));
+        assertFalse(gate.capture().broken);
+        assertEquals(2, gate.capture().interruptions);
+        // The host consumes this counter before a poll can authorize, even if
+        // both failures and the reconnect shared one queued notification task.
+    }
+
+    @Test public void sealedShutdownTicketCannotReconnectOrAccumulateExpectedClose() throws Exception {
+        AsterNotification.Gate gate = new AsterNotification.Gate();
+        AsterNotification.Frame frame = parse(notice().toString(), null);
+        gate.notice(frame);
+        AsterNotification.Ticket ticket = gate.capture();
+        assertTrue(gate.seal(ticket));
+        assertTrue(gate.capture().sealed);
+        assertFalse(gate.isCurrent(ticket));
+        gate.interrupted();
+        gate.rebound(frame);
+        gate.notice(frame);
+        assertTrue(gate.capture().sealed);
+        assertEquals(ticket.interruptions, gate.capture().interruptions);
+        assertFalse(gate.isCurrent(gate.capture()));
+    }
+
+    @Test public void interruptionBeforeSealCannotBeMarkedExpected() throws Exception {
+        AsterNotification.Gate gate = new AsterNotification.Gate();
+        gate.notice(parse(notice().toString(), null));
+        AsterNotification.Ticket ticket = gate.capture();
+        gate.interrupted();
+        assertFalse(gate.seal(ticket));
+        assertFalse(gate.capture().sealed);
+        assertEquals(1, gate.capture().interruptions);
+    }
+
+    @Test public void unconfirmedSubscriptionIsQueryOnly() throws Exception {
+        AsterNotification.Gate gate = new AsterNotification.Gate();
+        assertFalse(gate.isCurrent(gate.capture()));
+        try { gate.verify(gate.capture(), environment(), 103); fail("query-only path authorized"); }
+        catch (Exception expected) { }
+    }
+
+    @Test public void proofIsOrderIndependentButNotTypeOrIdentityIndependent() throws Exception {
+        AsterNotification.Frame frame = parse(notice().toString(), null);
+        JSONObject proof = frame.proof();
+        JSONObject reordered = new JSONObject();
+        JSONArray keys = proof.names();
+        for (int i = keys.length() - 1; i >= 0; --i) {
+            String key = keys.getString(i);
+            reordered.put(key, proof.get(key));
+        }
+        assertTrue(frame.matchesProof(reordered));
+        proof.put("generation", "10");
+        assertFalse(frame.matchesProof(proof));
