+        long kernelSequence = EnvironmentSnapshot.integer(fas, "kernel_sequence", 0, Long.MAX_VALUE);
+        if (kernelSequence != facts.getLong("sequence")) throw new EnvironmentSnapshot.Pending();
+        long submission = EnvironmentSnapshot.integer(fas, "submission", 0, 1);
+        long kernelSubmission = EnvironmentSnapshot.integer(fas, "kernel_submission", 0, 1);
+        String tee = teeHeartbeat(identity);
+        if (tee.isEmpty() || !teeStopped(identity, tee)) throw new EnvironmentSnapshot.Pending();
