+public class AsterNotificationTest {
+    private static final String BOOT = "ed12be49-1b58-45ca-8204-c27520f7727e";
+    private static final String COMPACT = BOOT.replace("-", "");
+    private static final String CHALLENGE = "a".repeat(32);
+    private static final String CLASSIFIER = "b".repeat(32);
+    private static final String BASELINE = "c".repeat(64);
