+                String stoppedTee = "";
+                for (;;) {
+                    String tee = teeHeartbeat(identity);
+                    if (!tee.isEmpty() && !mTee.isEmpty() && !mTee.equals(tee)) {
+                        if (retainReasonLocked("CONTROL_INTERRUPTED")) saveLocked(mRequested, mRequestBoot);
+                        throw new IOException("TEE instance changed during shutdown");
+                    }
+                    if (!tee.isEmpty() && teeStopped(identity, tee)) {
+                        stoppedTee = tee;
+                        break;
+                    }
+                    requireShutdownBudget();
+                    Thread.sleep(Math.min(25, mShutdown.remaining()));
+                }
+
+                for (int attempt = 0; ; ++attempt) {
+                    requireShutdownBudget();
+                    try {
+                        EnvironmentSnapshot snapshot = readEnvironment();
+                        AsterNotification.Ticket ticket = mNotificationGate.capture();
+                        consumeNotificationInterruptionLocked(ticket);
+                        if ((!mCollector.isEmpty() && !mCollector.equals(snapshot.facts.getString("collector_instance")))
+                                || (!mClassifier.isEmpty() && !mClassifier.equals(snapshot.classifier))) {
+                            if (retainReasonLocked("CONTROL_INTERRUPTED")) saveLocked(mRequested, mRequestBoot);
+                            throw new IOException("Collector instance changed during shutdown");
+                        }
+                        mNotificationGate.verify(ticket, snapshot, SystemClock.elapsedRealtime());
+                        if (!retainFindingsLocked(snapshot, communityScopeLocked()))
+                            throw new IOException("Cannot retain final shutdown findings");
+                        requireShutdownBudget();
+                        requireZeroPermitLocked(identity);
+
+                        // This marker only freezes authorization for this boot.
+                        // It never asserts clean health or grants expected-close
+                        // grace to a replacement system_server process.
+                        mShutdownBoot = mBoot;
+                        if (!saveLocked(mRequested, mRequestBoot))
+                            throw new IOException("Cannot persist shutdown freeze");
+                        requireShutdownBudget();
+                        // Recheck raw evidence AFTER persistence, so a slow
+                        // commit cannot hide events that advanced meanwhile.
+                        JSONObject request = snapshot.request("acknowledge",
+                                communityScopeLocked() ? "community" : "official", new JSONArray());
+                        snapshot.validateReceipt(request, coordinate(request, ticket), SystemClock.elapsedRealtime());
+                        mNotificationGate.verify(ticket, snapshot, SystemClock.elapsedRealtime());
+                        if (!stoppedTee.equals(teeHeartbeat(identity)) || !teeStopped(identity, stoppedTee))
+                            throw new IOException("TEE shutdown confirmation expired or changed");
+                        if (!mShutdown.complete(() -> mNotificationGate.seal(ticket)))
+                            throw new IOException("Shutdown evidence changed before terminal handoff");
+                        mNotifications.stopForShutdown();
+                        mHandler.removeCallbacks(mNotificationWork);
+                        mNotificationWorkQueued.set(false);
+                        mEffective = "RESTRICTED_ERROR";
+                        mReason = "Shutdown authorization terminated";
+                        mReasonCode = "RESTART_REQUIRED";
+                        return;
+                    } catch (AsterNotification.Stale | EnvironmentSnapshot.Pending retry) {
+                        if (attempt >= 1) throw retry;
+                    }
+                }
+            }
+        } catch (Exception e) {
+            mShutdown.fail(); // Releases the caller even if later persistence blocks.
+            if (e instanceof InterruptedException) Thread.currentThread().interrupt();
+            synchronized (mLock) {
+                consumeNotificationInterruptionLocked(mNotificationGate.capture());
+                retainReasonLocked("SHUTDOWN_UNCONFIRMED");
+                // Also freeze normal mode on failure, without inventing a
+                // normal-mode alarm latch or claiming that a failed write stuck.
+                mShutdownBoot = mBoot;
+                if (mRecordValid) saveLocked(mRequested, mRequestBoot);
+                mEffective = "RESTRICTED_ERROR";
+                mReason = "Shutdown drain unconfirmed; restart required";
+                mReasonCode = "RESTART_REQUIRED";
+                Slog.w("PlatformIntegrity", mReason, e);
+            }
+        } finally {
+            mInShutdownDrain = false;
+            mHandler.removeCallbacks(mPoll);
+        }
+    }
