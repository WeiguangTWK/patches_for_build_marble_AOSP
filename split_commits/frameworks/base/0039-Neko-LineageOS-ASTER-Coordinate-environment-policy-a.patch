+                    throw new EnvironmentSnapshot.Pending();
+                if (!saveLocked("COMPROMISE", mRequestBoot)) return;
+            } else if (!mRequested.equals("COMPROMISE")) {
+                throw new EnvironmentSnapshot.Pending();
+            } else if (firstBinding && !saveLocked(mRequested, mRequestBoot)) return;
+            if (hasAlarmsLocked() || mInterrupted || !mRecordValid) throw new EnvironmentSnapshot.Pending();
+            readyRevision = mRevision;
+            request = snapshot.request("acknowledge", "community", new JSONArray());
+        }
+        JSONObject receipt = coordinate(request, ticket);
+        synchronized (mLock) {
+            if (readyRevision != mRevision || !identity.equals(identityLocked()) || mShutdown.closing()) return;
+            snapshot.validateReceipt(request, receipt, SystemClock.elapsedRealtime());
+            mNotificationGate.verify(ticket, snapshot, SystemClock.elapsedRealtime());
+            if (!mRequested.equals("COMPROMISE") || hasAlarmsLocked() || mInterrupted || !mRecordValid
+                    || SystemClock.elapsedRealtime() >= facts.getLong("resident_until_ms"))
+                throw new EnvironmentSnapshot.Pending();
+            mFullMeasurement = false;
+            mPartialResident = true; mResidentUntil = facts.getLong("resident_until_ms");
+            mCollectionHealthy = mClassificationReady = mLaterHashesMeasured = true;
+            mEarlyNameOnlyRows = facts.getInt("early_name_only_rows");
+            mBound = mEndpointsConfirmed = true;
+            mLastEvidence = snapshot.completed; mValidatedNotification = ticket;
+            mRestrictionReceipt = receipt.toString();
+            mEffective = "COMPROMISE_ACTIVE"; mReasonCode = "COMPROMISE_READY";
+            mReason = "Partial resident A/B checks accepted; only FAS may be enabled";
+            mCoverage = "Partial resident A/B accepted; load history and syscall coverage remain incomplete";
+            mLastFailure = mLastFailureStage = "";
+            publishLocked(allowedFeaturesLocked());
+        }
+    }
+
+    /** Negotiate a restricted V4 snapshot. This path never grants or enters a mode. */
+    private void acceptRestrictedV4(EnvironmentSnapshot snapshot, long revision,
+            AsterNotification.Ticket ticket) throws Exception {
+        mNotificationGate.verify(ticket, snapshot, SystemClock.elapsedRealtime());
+        JSONObject facts = snapshot.facts;
+        if (facts.getInt("digest_protocol") != 4
+                || !facts.getBoolean("collection_healthy")
+                || !facts.getBoolean("classification_ready")
+                || facts.getBoolean("healthy")
+                || !facts.getBoolean("later_hashes_measured")
+                || facts.getLong("pending_measurements") != 0
+                || facts.getLong("coverage_gap_mask") != 0
+                || facts.getBoolean("evidence_lost")
+                || !facts.getBoolean("early_history_gap")
+                || facts.getBoolean("early_versions_verified")
+                || facts.getBoolean("full_measurement")
+                || facts.getBoolean("raw_hashes_measured")
+                || facts.getBoolean("syscall_measured")
+                || facts.getInt("early_name_only_rows") < 0
+                || facts.getInt("early_name_only_rows") > 512
+                || facts.getInt("normal_unapproved_versions") < 0
+                || facts.getInt("normal_unapproved_versions") > 512
+                || facts.getInt("compromise_unapproved_versions") < 0
+                || facts.getInt("compromise_unapproved_versions") > 512
+                || facts.getInt("compromise_unknown_modules") < 0
+                || facts.getInt("compromise_unknown_modules") > 512
+                || facts.getLong("sequence") <= 0
+                || !facts.getString("baseline_sha256").matches("[0-9a-f]{64}")
+                || !facts.getString("collector_instance").matches("[0-9a-f]{32}")
+                || !facts.getString("classifier_instance").matches("[0-9a-f]{32}"))
+            throw new IOException("Invalid restricted V4 evidence");
+        final JSONObject request;
+        final String identity;
+        synchronized (mLock) {
+            if (revision != mRevision) return;
+            if (!mRecordValid) throw new IOException("Policy record unavailable");
+            // Revoke before requesting a receipt. Epoch may change on revocation.
+            publishLocked(0);
+            identity = identityLocked();
+            boolean community = communityScopeLocked();
+            if (!retainFindingsLocked(snapshot, community)) return;
+            request = snapshot.request("publish", community ? "community" : "official", publicationHistoryLocked());
+        }
+        JSONObject receipt = coordinate(request, ticket);
+        synchronized (mLock) {
+            if (!identity.equals(identityLocked())) return;
+            PlatformIntegrity.Permit permit = PlatformIntegrity.current();
+            snapshot.validateReceipt(request, receipt, SystemClock.elapsedRealtime());
+            mNotificationGate.verify(ticket, snapshot, SystemClock.elapsedRealtime());
+            if (permit.features != 0 || !identity.equals(permit.identity) || !permit.allows(0))
+                throw new IOException("Host revocation changed before environment acknowledgement");
+            String collector = facts.getString("collector_instance");
+            String classifier = facts.getString("classifier_instance");
+            if ((!mCollector.isEmpty() && !mCollector.equals(collector))
+                    || (!mClassifier.isEmpty() && !mClassifier.equals(classifier))) {
+                if (latchModeLocked()) {
+                    mInterrupted = true;
+                    retainReasonLocked("CONTROL_INTERRUPTED");
+                    if (!saveLocked(mRequested, mRequestBoot)) return;
+                } else resetNormalBindingLocked();
+            } else if (mCollector.isEmpty() || mClassifier.isEmpty()) {
+                mCollector = collector;
+                mClassifier = classifier;
+                if (!saveLocked(mRequested, mRequestBoot)) return;
+            }
+            mFullMeasurement = false;
+            mPartialResident = false; mResidentUntil = 0;
+            mBound = mEndpointsConfirmed = false;
+            mLaterHashesMeasured = mCollectionHealthy = mClassificationReady = true;
+            mEarlyNameOnlyRows = facts.getInt("early_name_only_rows");
+            mLastEvidence = snapshot.completed;
+            mRestrictionReceipt = receipt.toString();
+            mModulePublicationReceipt = receipt.toString();
+            mEffective = "RESTRICTED_ERROR";
+            boolean communityScope = communityScopeLocked();
+            boolean unknown = facts.getInt(communityScope ? "compromise_unknown_modules"
+                    : "unknown_modules") != 0;
+            boolean mismatch = facts.getInt(communityScope ? "compromise_unapproved_versions"
+                    : "normal_unapproved_versions") != 0;
+            mReasonCode = mInterrupted ? "CONTROL_INTERRUPTED"
+                    : mEvidenceLost ? "EVIDENCE_LOST"
+                    : hasAlarmsLocked() ? "HISTORICAL_ALERTS"
+                    : unknown ? "UNKNOWN_MODULE" : mismatch ? "HASH_MISMATCH"
+                    : mEarlyNameOnlyRows != 0 ? "COVERAGE_INCOMPLETE" : "POLICY_PENDING";
+            mReason = mInterrupted ? "Collector or classifier changed; restart required"
+                    : hasAlarmsLocked() ? "Retained evidence requires normal-mode recovery"
+                    : unknown || mismatch ? "Selected reference scope has unapproved module evidence"
+                    : mEarlyNameOnlyRows != 0
+                            ? "Initial resident module versions are unverified"
+                            : "Execution authorization is not established";
+            mCoverage = "Captured inputs classified; " + mEarlyNameOnlyRows
+                    + " initial name-only rows; syscalls unavailable";
+            mLastFailure = mLastFailureStage = "";
+            mValidatedNotification = ticket;
+            // Module publication is independent of FAS binding and feature permits.
+        }
+    }
+
+    private void poll() {
+        if (mShutdown.closing()) return;
+        String stage = "collector";
+        final AsterNotification.Ticket ticket = mNotificationGate.capture();
+        try {
+            final long revision;
+            final String identity;
+            final boolean bound;
+            final boolean compromise;
+            synchronized (mLock) {
+                // Consume the monotonic interruption counter even if a new
+                // handshake overtook the queued notification handler.
+                consumeNotificationInterruptionLocked(ticket);
+                revision = mRevision;
+                identity = identityLocked();
+                bound = mBound;
+                compromise = !mRequested.equals("NORMAL");
+            }
+            EnvironmentSnapshot snapshot = readEnvironment();
+            synchronized (mLock) {
+                if (mShutdown.closing()) return;
+                boolean changed = (!mCollector.isEmpty()
+                        && !mCollector.equals(snapshot.facts.getString("collector_instance")))
+                        || (!mClassifier.isEmpty() && !mClassifier.equals(snapshot.classifier));
+                if (changed && !mInterrupted) {
+                    publishLocked(0);
+                    if (latchModeLocked()) {
+                        mInterrupted = true;
+                        retainReasonLocked("CONTROL_INTERRUPTED");
+                        if (!saveLocked(mRequested, mRequestBoot)) return;
+                    } else resetNormalBindingLocked();
+                }
+            }
+            mNotificationGate.verify(ticket, snapshot, SystemClock.elapsedRealtime());
+            JSONObject facts = snapshot.facts;
+            synchronized (mLock) {
+                if (revision != mRevision || mShutdown.closing()) throw new EnvironmentSnapshot.Pending();
+                mCurrentFindings = snapshot;
+                mCurrentFindingsTicket = ticket;
+                observeRecheckLocked(snapshot);
+            }
+            mKsuSource.offer(snapshot.tsaSourceState);
+            if ("later_digest".equals(facts.optString("collector_backend"))
+                    && facts.optInt("digest_protocol") == 4) {
+                boolean partial;
+                synchronized (mLock) {
+                    partial = (mRequested.equals("COMPROMISE") || (mRequested.equals("ENTER_COMPROMISE")
+                            && !mBoot.equals(mRequestBoot))) && !hasAlarmsLocked() && !mInterrupted
+                            && facts.optBoolean("resident_green")
+                            && facts.getInt("compromise_unknown_modules") == 0
+                            && facts.getInt("compromise_unapproved_versions") == 0
+                            && facts.getInt("unapproved_candidate_rows") == 0
+                            && !facts.getBoolean("compromise_unknown_overflow")
+                            && !facts.getBoolean("compromise_unapproved_names_overflow");
+                }
+                if (partial) acceptPartialV4(snapshot, revision, ticket);
+                else acceptRestrictedV4(snapshot, revision, ticket);
+                return;
+            }
+            if (!facts.getBoolean("healthy"))
+                throw new IOException(facts.optString("reason", "Collection unavailable"));
+            if (!facts.getString("collector_instance").matches("[0-9a-f]{32}")
+                    || !facts.getString("classifier_instance").matches("[0-9a-f]{32}"))
+                throw new IOException("Invalid measurement identities");
+            synchronized (mLock) {
+                if (revision != mRevision || !identity.equals(identityLocked())) return;
+                if (mRequested.equals("NORMAL") && !fullClean(facts)) publishLocked(0);
+                if (!retainFindingsLocked(snapshot, communityScopeLocked())) return;
+            }
+            synchronized (mLock) {
+                if (!identity.equals(identityLocked())) return;
+            }
+            String collector = facts.getString("collector_instance");
+            String classifier = facts.getString("classifier_instance");
+            if (!collector.matches("[0-9a-f]{32}") || !classifier.matches("[0-9a-f]{32}"))
+                throw new IOException("Invalid collector identity");
+            String command = (bound && mBound) ? "STATUS_V4\t" + identity + "\t" + mGrant
+                    : "BIND_V4\t" + identity + "\t" + collector + "\t" + mGrant
+                            + "\t" + (compromise ? "1" : "0");
+            stage = "FAS control";
+            if (mShutdown.closing()) return;
+            String fasResponse = exchange("fasd", command);
+            if (mShutdown.closing()) return;
+            JSONObject fas = new JSONObject(fasResponse);
+            String daemon = fas.getString("daemon_instance");
+            String backend = fas.getString("backend_instance");
+            if (EnvironmentSnapshot.integer(fas, "protocol", 4, 4) != 4 || !fas.getBoolean("healthy")
+                    || !identity.equals(fas.getString("identity"))
+                    || !mGrant.equals(fas.getString("challenge"))
+                    || !healthyRecord(fas.getString("daemon_record"), daemon)
+                    || !healthyRecord(fas.getString("backend_record"), backend)
+                    || !mGrant.equals(fas.getString("bound_grant"))
+                    || !collector.equals(fas.getString("bound_collector"))
+                    || !daemon.equals(fas.getString("bound_daemon")))
+                throw new IOException("FAS execution continuity unavailable");
+            if (EnvironmentSnapshot.integer(fas, "kernel_submission", 0, 2) == 2
+                    || EnvironmentSnapshot.integer(fas, "kernel_sequence", 0, Long.MAX_VALUE)
+                            != facts.getLong("sequence"))
+                throw new IOException("Kernel FAS submission evidence unavailable or changed");
+            stage = "TEE monitor";
+            if (mShutdown.closing()) return;
+            String tee = teeHeartbeat(identity);
+            if (tee.isEmpty()) throw new IOException("TEE monitor unavailable");
+            boolean teeStop = teeStopped(identity, tee);
+            synchronized (mLock) {
+                if (!identity.equals(identityLocked())) return;
+                if (!mRecordValid) throw new IOException("Policy record unavailable");
+                mNotificationGate.verify(ticket, snapshot, SystemClock.elapsedRealtime());
+                boolean identitiesChanged = (!mCollector.isEmpty() && !mCollector.equals(collector))
+                        || (!mClassifier.isEmpty() && !mClassifier.equals(classifier))
+                        || (!mDaemon.isEmpty() && !mDaemon.equals(daemon))
+                        || (!mBackend.isEmpty() && !mBackend.equals(backend))
+                        || (!mTee.isEmpty() && !mTee.equals(tee));
+                boolean save = mCollector.isEmpty() || mClassifier.isEmpty()
+                        || mDaemon.isEmpty() || mBackend.isEmpty() || mTee.isEmpty();
+                if (identitiesChanged) {
+                    publishLocked(0);
+                    if (latchModeLocked()) {
+                        mInterrupted = true;
+                        retainReasonLocked("CONTROL_INTERRUPTED");
+                    } else resetNormalBindingLocked();
+                } else {
+                    mCollector = collector;
+                    mClassifier = classifier;
+                    mDaemon = daemon;
+                    mBackend = backend;
+                    mTee = tee;
+                    mBound = true;
+                }
+                if (identitiesChanged) save = true;
+                if (save && !saveLocked(mRequested, mRequestBoot)) return;
+                mPartialResident = false; mResidentUntil = 0;
+                mFullMeasurement = facts.getBoolean("full_measurement");
+                mCollectionHealthy = mClassificationReady = true;
+                mEarlyNameOnlyRows = 0;
+                mRestrictionReceipt = "";
+                mLaterHashesMeasured = false;
+                mCoverage = "Full kernel measurement";
+                mLastEvidence = snapshot.completed;
+                boolean communityScope = communityScopeLocked();
+                boolean currentClean = facts.getInt(communityScope ? "compromise_unknown_modules" : "unknown_modules") == 0
+                        && facts.getLong(communityScope ? "compromise_unapproved_versions" : "hash_mismatches") == 0
+                        && !facts.getBoolean(communityScope ? "compromise_unknown_overflow" : "unknown_overflow")
+                        && !facts.getBoolean(communityScope ? "compromise_unapproved_names_overflow" : "unapproved_names_overflow")
+                        && facts.getInt("syscall_changed") == 0;
+                boolean clean = fullClean(facts);
+                boolean stopped = teeStop && fas.getInt("submission") == 0
+                        && fas.getInt("kernel_submission") == 0;
+                boolean nextBoot = !mBoot.equals(mRequestBoot);
+                if (mInterrupted) {
+                    mEffective = "RESTRICTED_ERROR";
+                    mReason = "Control or collector instance changed; restart required";
+                    mReasonCode = "CONTROL_INTERRUPTED";
+                } else if (mRequested.equals("NORMAL")) {
+                    if (hasAlarmsLocked() && !mRecoveryBoot.isEmpty()
+                            && !mBoot.equals(mRecoveryBoot) && clean && stopped) {
+                        stage = "recovery recheck";
+                        recoverLocked(snapshot, collector, classifier, ticket);
+                        return;
+                    }
+                    mEndpointsConfirmed |= teeStop && fas.getInt("submission") != 2;
+                    mEffective = clean && !hasAlarmsLocked() && mEndpointsConfirmed
+                            ? "NORMAL_READY" : "RESTRICTED_ERROR";
+                    mReason = mEffective.equals("NORMAL_READY") ? "Checks complete"
+                            : "Full checks, cleared historical alarms and execution confirmation required";
+                    mReasonCode = mEffective.equals("NORMAL_READY") ? "READY"
+                            : restrictionReasonLocked(facts);
+                } else if (mRequested.equals("ENTER_COMPROMISE")) {
+                    mEffective = "ENTER_PENDING";
+                    mReason = nextBoot ? "Waiting for checks and feature shutdown" : "Restart required";
+                    mReasonCode = nextBoot ? restrictionReasonLocked(facts) : "RESTART_REQUIRED";
+                    if (nextBoot && stopped && currentClean && !hasAlarmsLocked()) {
+                        mNotificationGate.verify(ticket, snapshot, SystemClock.elapsedRealtime());
+                        if (saveLocked("COMPROMISE", mRequestBoot)) {
+                            mEffective = "COMPROMISE_ACTIVE";
+                            mReason = "Only FAS may be enabled";
+                            mReasonCode = "COMPROMISE_READY";
+                        }
+                    }
+                } else if (mRequested.equals("COMPROMISE")) {
+                    mEffective = teeStop && currentClean && !hasAlarmsLocked()
+                            ? "COMPROMISE_ACTIVE" : "RESTRICTED_ERROR";
+                    mReason = mEffective.equals("COMPROMISE_ACTIVE") ? "Only FAS may be enabled"
+                            : "Unknown module, historical alarm or feature shutdown unconfirmed";
+                    mReasonCode = mEffective.equals("COMPROMISE_ACTIVE") ? "COMPROMISE_READY"
+                            : restrictionReasonLocked(facts);
+                } else {
+                    mEffective = "EXIT_PENDING";
+                    mReason = "Restart and unfiltered full validation required";
+                    mReasonCode = nextBoot ? restrictionReasonLocked(facts) : "RESTART_REQUIRED";
+                    if (nextBoot && stopped && clean
+                            && (!hasAlarmsLocked() || !mBoot.equals(mRecoveryBoot))) {
+                        stage = "recovery recheck";
+                        recoverLocked(snapshot, collector, classifier, ticket);
+                        return;
+                    }
+                }
+
+                // Publish the report-bound proc view BEFORE granting host feature permits.
+                JSONArray historical = new JSONArray();
+                java.util.ArrayList<String> retained = new java.util.ArrayList<>(mAlarms);
+                retained.sort((a, b) -> Long.compare(
+                        mAlarmEvidence.optJSONObject(a).optLong("ordinal", 0),
+                        mAlarmEvidence.optJSONObject(b).optLong("ordinal", 0)));
+                for (String name : retained) historical.put(name);
+                // A retained syscall change from an earlier boot cannot be
+                // represented by this boot's empty raw syscall journal. Keep
+                // proc unavailable rather than publish a false clean view.
+                boolean syscallHistoryUnrepresented = mLatchedReasons.contains("SYSCALL_CHANGED")
+                        && facts.getInt("syscall_changed") == 0;
+                JSONObject publication = snapshot.request(syscallHistoryUnrepresented ? "acknowledge" : "publish",
+                        communityScope ? "community" : "official",
+                        syscallHistoryUnrepresented ? new JSONArray() : historical);
+                stage = "environment publication";
+                mNotificationGate.verify(ticket, snapshot, SystemClock.elapsedRealtime());
+                JSONObject receipt = coordinate(publication, ticket);
+                snapshot.validateReceipt(publication, receipt, SystemClock.elapsedRealtime());
+                mNotificationGate.verify(ticket, snapshot, SystemClock.elapsedRealtime());
+                mLastFailure = "";
+                mLastFailureStage = "";
+                mValidatedNotification = ticket;
+                publishLocked(allowedFeaturesLocked());
+            }
+        } catch (Exception e) {
+            synchronized (mLock) {
+                if (e instanceof AsterNotification.Stale) {
+                    stage = "notification";
+                    if (latchModeLocked()) mInterrupted |= mNotificationGate.capture().broken;
+                }
+                if (!(e instanceof AsterNotification.Stale) && !(e instanceof EnvironmentSnapshot.Pending)
+                        && (mLastEvidence > 0 || mBound)) {
+                    if (latchModeLocked()) {
+                        if (retainReasonLocked("COMPONENT_UNAVAILABLE")) saveLocked(mRequested, mRequestBoot);
+                    } else if (!(e instanceof AsterNotification.Rejected)) {
+                        // A rejected publication does not itself lose endpoint
+                        // ownership. Avoid rewriting bindings every retry.
+                        resetNormalBindingLocked();
+                    }
+                }
+                String failure = e.getClass().getSimpleName() + ": " + e.getMessage();
+                if (!failure.equals(mLastFailure) || !stage.equals(mLastFailureStage))
+                    Slog.w("PlatformIntegrity", stage + ": " + failure);
+                mLastFailure = failure;
+                mLastFailureStage = stage;
+                mEffective = "RESTRICTED_ERROR";
+                mBound = false;
+                mReason = stage + ": " + failure;
+                mReasonCode = !mRecordValid ? "POLICY_UNAVAILABLE"
+                        : mInterrupted ? "CONTROL_INTERRUPTED"
+                        : e instanceof EnvironmentSnapshot.Pending ? "CHECKING"
+                        : e instanceof AsterNotification.Rejected ? "VALIDATION_FAILED"
+                        : stage.equals("notification") ? "CHECKING"
+                        : stage.equals("collector") ? ((mEvidenceLost || mCurrentEvidenceLost) ? "EVIDENCE_LOST" : "COLLECTOR_UNAVAILABLE")
+                        : stage.equals("FAS control") ? "CONTROL_UNAVAILABLE"
+                        : stage.equals("TEE monitor") ? "TEE_UNAVAILABLE" : "VALIDATION_FAILED";
+                mLaterHashesMeasured = false;
+                mCollectionHealthy = mClassificationReady = false;
+                mEarlyNameOnlyRows = 0;
+                mRestrictionReceipt = "";
+                mCoverage = "Collection or execution confirmation unavailable";
+                publishLocked(0);
+            }
+        } finally {
+            synchronized (mLock) {
+                mHandler.removeCallbacks(mPoll);
+                if (!mShutdown.closing()) mHandler.postDelayed(mPoll, 500);
+            }
+        }
+    }
+}
diff --git a/services/core/java/com/android/server/platformintegrity/ShutdownGate.java b/services/core/java/com/android/server/platformintegrity/ShutdownGate.java
new file mode 100644
index 000000000..d20d80dba
--- /dev/null
+++ b/services/core/java/com/android/server/platformintegrity/ShutdownGate.java
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.function.BooleanSupplier;
+import java.util.function.LongSupplier;
+
+/** One-way, boot-local authorization fence. No I/O or host-mode policy. */
+final class ShutdownGate {
+    static final long BUDGET_MS = 2000;
+    enum Phase { RUNNING, DRAINING, TERMINAL, FAILED }
+    private final LongSupplier clock;
+    private final CountDownLatch done = new CountDownLatch(1);
+    private volatile Phase phase = Phase.RUNNING;
+    private long started, deadline;
+    private boolean revoked;
+
+    ShutdownGate(LongSupplier clock) { this.clock = clock; }
+    boolean closing() { return phase != Phase.RUNNING; }
+    boolean terminal() { return phase == Phase.TERMINAL; }
+    String status() { return phase.name(); }
+
+    synchronized boolean begin() {
+        if (closing()) return false;
+        started = clock.getAsLong();
+        if (started < 0 || started > Long.MAX_VALUE - BUDGET_MS) {
+            phase = Phase.FAILED;
+            done.countDown();
+            return false;
+        }
+        deadline = started + BUDGET_MS;
+        phase = Phase.DRAINING;
+        return true;
+    }
+
+    synchronized long remaining() {
+        long now = clock.getAsLong();
+        return phase == Phase.DRAINING && now >= started && now < deadline ? deadline - now : 0;
+    }
+
+    synchronized void confirmRevoked() {
+        if (remaining() > 0) revoked = true;
+    }
+
+    synchronized boolean complete(BooleanSupplier seal) {
+        // seal performs only an atomic ticket CAS, never I/O or a host lock.
+        if (remaining() == 0 || !revoked || !seal.getAsBoolean()) {
+            fail();
+            return false;
+        }
+        phase = Phase.TERMINAL;
+        done.countDown();
+        return true;
+    }
+
+    synchronized void fail() {
+        if (phase == Phase.TERMINAL) return;
+        phase = Phase.FAILED;
+        done.countDown();
+    }
+
+    void restoreFrozen() { fail(); } // Denial only; never inherits expected-close grace.
+
+    void await() {
+        if (!closing()) return;
+        long left = remaining();
+        if (left == 0) {
+            if (!terminal()) fail();
+            return;
+        }
+        try {
+            if (!done.await(left, TimeUnit.MILLISECONDS)) fail();
+        } catch (InterruptedException e) {
+            fail();
+            Thread.currentThread().interrupt();
+        }
+    }
+}
diff --git a/services/core/java/com/android/server/platformintegrity/ShutdownPermitWriter.java b/services/core/java/com/android/server/platformintegrity/ShutdownPermitWriter.java
new file mode 100644
index 000000000..7fc2aebe4
--- /dev/null
+++ b/services/core/java/com/android/server/platformintegrity/ShutdownPermitWriter.java
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.android.server.platformintegrity;
+
+import android.os.Process;
+import android.os.SystemClock;
+import android.os.SystemProperties;
+import android.os.PlatformIntegrity;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+import android.system.StructPollfd;
+import android.system.UnixSocketAddress;
+import java.io.FileDescriptor;
+import java.io.IOException;
+import java.io.InterruptedIOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+
+/** Bounded revocation of one fixed host property, not a general property setter. */
+final class ShutdownPermitWriter {
+    // bionic/libc/include/sys/system_properties.h and system_property_set.cpp.
+    private static final int SETPROP2 = 0x00020001;
+    private static final int MSG_NOSIGNAL = 0x4000;
+    private ShutdownPermitWriter() { }
+
+    static String zeroFor(String current, long now) {
+        // Keep the current authority identity while the serialized worker
+        // drains. Changing it here could invalidate an already-running STATUS
+        // request and turn our own revoke into a false component failure.
+        if (now < 0 || now > 0xffffffffffffL - 4000
+                || !current.matches("[0-9a-f]{32}:[0-9a-f]{16}:[0-9a-f]{1,8}:[0-9a-f]{1,12}:[0-7]")) return "";
+        int mask = current.lastIndexOf(':');
+        int expiry = current.lastIndexOf(':', mask - 1);
+        return current.substring(0, expiry) + ":" + Long.toHexString(now + 4000) + ":0";
+    }
+
+    static void set(String value, long deadline) throws IOException {
+        FileDescriptor fd = null;
+        try {
+            left(deadline);
+            fd = Os.socket(OsConstants.AF_UNIX, OsConstants.SOCK_STREAM
+                    | OsConstants.SOCK_CLOEXEC | OsConstants.SOCK_NONBLOCK, 0);
+            try {
+                Os.connect(fd, UnixSocketAddress.createFileSystem("/dev/socket/property_service"));
+            } catch (ErrnoException e) {
+                if (e.errno != OsConstants.EINPROGRESS && e.errno != OsConstants.EALREADY) throw e;
+                ready(fd, OsConstants.POLLOUT, deadline);
+                if (Os.getsockoptInt(fd, OsConstants.SOL_SOCKET, OsConstants.SO_ERROR) != 0)
+                    throw new IOException("Property service connect failed");
+            }
+            left(deadline);
+            if (IntegritySocket.peerUid(fd) != Process.ROOT_UID)
+                throw new IOException("Unexpected property service UID");
+            transact(fd, value, deadline);
+            if (!value.equals(SystemProperties.get(PlatformIntegrity.PROPERTY, "")))
+                throw new IOException("Revocation readback mismatch");
+            left(deadline);
+        } catch (ErrnoException e) {
+            throw new IOException("Property revocation syscall failed", e);
+        } finally {
+            IntegritySocket.close(fd);
+        }
+    }
+
+    // Socketpair tests exercise the real protocol without writing live properties.
+    static void transact(FileDescriptor fd, String value, long deadline) throws IOException {
+        if (!value.isEmpty() && !value.matches("[0-9a-f]{32}:[0-9a-f]{16}:[0-9a-f]{1,8}:[0-9a-f]{1,12}:0"))
+            throw new IOException("Only permit revocation is allowed");
+        byte[] name = PlatformIntegrity.PROPERTY.getBytes(StandardCharsets.UTF_8);
+        byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+        byte[] packet = ByteBuffer.allocate(12 + name.length + bytes.length).order(ByteOrder.nativeOrder())
+                .putInt(SETPROP2).putInt(name.length).put(name).putInt(bytes.length).put(bytes).array();
+        try {
+            int sent = 0;
+            while (sent < packet.length) {
+                left(deadline);
+                try {
+                    int count = Os.sendto(fd, packet, sent, packet.length - sent, MSG_NOSIGNAL, null);
+                    if (count <= 0) throw new IOException("Property request closed");
+                    sent += count;
+                } catch (ErrnoException e) {
+                    if (e.errno == OsConstants.EINTR) continue;
+                    if (e.errno != OsConstants.EAGAIN) throw e;
+                    ready(fd, OsConstants.POLLOUT, deadline);
+                }
+            }
+            byte[] reply = new byte[4];
+            int received = 0;
+            while (received < reply.length) {
+                left(deadline);
+                try {
+                    int count = Os.recvfrom(fd, reply, received, reply.length - received, 0, null);
+                    if (count <= 0) throw new IOException("Property response closed");
+                    received += count;
+                } catch (ErrnoException e) {
+                    if (e.errno == OsConstants.EINTR) continue;
+                    if (e.errno != OsConstants.EAGAIN) throw e;
+                    ready(fd, OsConstants.POLLIN, deadline);
+                }
+            }
+            left(deadline);
+            if (ByteBuffer.wrap(reply).order(ByteOrder.nativeOrder()).getInt() != 0)
+                throw new IOException("Property revocation rejected");
+        } catch (ErrnoException e) {
+            throw new IOException("Property revocation I/O failed", e);
+        }
+    }
+
+    private static int left(long deadline) throws InterruptedIOException {
+        long now = SystemClock.elapsedRealtime();
+        if (now < 0 || deadline <= now) throw new InterruptedIOException("Revocation deadline expired");
+        return (int) Math.min(deadline - now, 500);
+    }
+
+    private static void ready(FileDescriptor fd, int events, long deadline) throws IOException, ErrnoException {
+        StructPollfd poll = new StructPollfd();
+        poll.fd = fd;
+        poll.events = (short) events;
+        for (;;) {
+            try {
+                if (Os.poll(new StructPollfd[]{poll}, left(deadline)) == 0)
+                    throw new InterruptedIOException("Revocation wait expired");
+                if ((poll.revents & events) != 0) return;
+                throw new IOException("Property service disconnected");
+            } catch (ErrnoException e) {
+                if (e.errno != OsConstants.EINTR) throw e;
+            }
+        }
+    }
+}
