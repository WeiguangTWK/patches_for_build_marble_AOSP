+    @Override public void onBootPhase(int phase) {
+        if (phase != PHASE_BOOT_COMPLETED) return;
+        synchronized (mLock) {
+            if (mBootPhaseSeen) return;
+            mBootPhaseSeen = true;
+        }
+        enqueueSyscallRecheck(RECHECK_BOOT);
