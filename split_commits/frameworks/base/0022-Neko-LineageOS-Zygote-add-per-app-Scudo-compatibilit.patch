+static bool PrepareExecSystemResources(std::string* error) {
+    ZipArchiveHandle archive = nullptr;
+    int32_t result = OpenArchive(kSystemResourcesPath, &archive);
+    if (result != 0) {
+        *error = StringPrintf("failed to open system resources: %s", ErrorCodeString(result));
+        return false;
+    }
+    auto archive_guard = android::base::make_scope_guard([&]() { CloseArchive(archive); });
+
+    android::base::unique_fd resource_fd(
+            memfd_create(kSystemResourcesDebugName, MFD_ALLOW_SEALING));
+    if (resource_fd.get() == -1) {
+        *error = StringPrintf("memfd_create failed: %s", strerror(errno));
+        return false;
+    }
+    const int output_fd = dup(resource_fd.get());
+    if (output_fd == -1) {
+        *error = StringPrintf("dup resource memfd failed: %s", strerror(errno));
+        return false;
+    }
+    FILE* output = fdopen(output_fd, "w+b");
+    if (output == nullptr) {
+        close(output_fd);
+        *error = StringPrintf("fdopen resource memfd failed: %s", strerror(errno));
+        return false;
+    }
+    auto output_guard = android::base::make_scope_guard([&]() { fclose(output); });
+
+    bool found_table = false;
+    {
+        ZipWriter writer(output);
+        void* cookie = nullptr;
+        result = StartIteration(archive, &cookie);
+        if (result != 0) {
+            *error = StringPrintf("failed to iterate system resources: %s",
+                                  ErrorCodeString(result));
+            return false;
+        }
+        auto iteration_guard =
+                android::base::make_scope_guard([&]() { EndIteration(cookie); });
+
+        ZipEntry64 entry;
+        std::string name;
+        while ((result = Next(cookie, &entry, &name)) == 0) {
+            const bool is_table = name == "resources.arsc";
+            const bool is_resource = name.compare(0, 4, "res/") == 0;
+            const bool is_asset = name.compare(0, 7, "assets/") == 0;
+            if ((!is_table && !is_resource && !is_asset) ||
+                (!name.empty() && name.back() == '/')) {
+                continue;
+            }
+            if (entry.uncompressed_length > std::numeric_limits<uint32_t>::max()) {
+                *error = StringPrintf("system resource entry is too large: %s", name.c_str());
+                return false;
+            }
+            std::vector<uint8_t> contents(static_cast<size_t>(entry.uncompressed_length));
+            result = ExtractToMemory(archive, &entry, contents.data(), contents.size());
+            if (result != 0) {
+                *error = StringPrintf("failed to extract %s: %s", name.c_str(),
+                                      ErrorCodeString(result));
+                return false;
+            }
+            if (is_table) {
+                if (found_table) {
+                    *error = "system resource APK contains duplicate resources.arsc";
+                    return false;
+                }
+                if (!RewriteSystemResourcePackageName(&contents, error)) return false;
+                found_table = true;
+                result = writer.StartAlignedEntry(name, 0, 4);
+            } else {
+                result = writer.StartEntry(
+                        name, ZipWriter::kCompress | ZipWriter::kDefaultCompression);
+            }
+            if (result == 0) result = writer.WriteBytes(contents.data(), contents.size());
+            if (result == 0) result = writer.FinishEntry();
+            if (result != 0) {
+                *error = StringPrintf("failed to write %s: %s", name.c_str(),
+                                      ZipWriter::ErrorCodeString(result));
+                return false;
+            }
+        }
+        if (result != -1) {
+            *error = StringPrintf("failed while iterating system resources: %s",
+                                  ErrorCodeString(result));
+            return false;
+        }
+        if (!found_table) {
+            *error = "system resource APK has no resources.arsc";
+            return false;
+        }
+        result = writer.Finish();
+        if (result != 0) {
+            *error = StringPrintf("failed to finish system resource ZIP: %s",
+                                  ZipWriter::ErrorCodeString(result));
+            return false;
+        }
+    }
+
+    if (fflush(output) != 0) {
+        *error = StringPrintf("failed to flush system resource ZIP: %s", strerror(errno));
+        return false;
+    }
+    const off64_t resource_size = ftello64(output);
+    if (resource_size <= 0) {
+        *error = StringPrintf("failed to determine system resource ZIP size: %s", strerror(errno));
+        return false;
+    }
+    output_guard.Disable();
+    if (fclose(output) != 0) {
+        *error = StringPrintf("failed to close system resource ZIP: %s", strerror(errno));
+        return false;
+    }
+
+    const int seals = F_SEAL_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL;
+    if (fcntl(resource_fd.get(), F_ADD_SEALS, seals) == -1) {
+        *error = StringPrintf("failed to seal system resource memfd: %s", strerror(errno));
+        return false;
+    }
+    const std::string fd_string = std::to_string(resource_fd.get());
+    const std::string size_string = std::to_string(resource_size);
+    if (setenv(kExecSystemResourcesFd, fd_string.c_str(), 1) == -1 ||
+        setenv(kExecSystemResourcesSize, size_string.c_str(), 1) == -1) {
+        *error = StringPrintf("failed to export system resource memfd: %s", strerror(errno));
+        unsetenv(kExecSystemResourcesFd);
+        unsetenv(kExecSystemResourcesSize);
+        return false;
+    }
+    (void)resource_fd.release();
+    return true;
+}
