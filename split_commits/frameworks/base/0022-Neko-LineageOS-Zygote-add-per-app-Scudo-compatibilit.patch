+static bool RewriteSystemResourcePackageName(std::vector<uint8_t>* data, std::string* error) {
+    using android::ResChunk_header;
+    using android::ResTable_header;
+    using android::ResTable_package;
+
+    if (data->size() < sizeof(ResTable_header)) {
+        *error = "resources.arsc is smaller than its table header";
+        return false;
+    }
+    auto* table = reinterpret_cast<ResTable_header*>(data->data());
+    const size_t table_size = dtohl(table->header.size);
+    size_t offset = dtohs(table->header.headerSize);
+    if (dtohs(table->header.type) != android::RES_TABLE_TYPE ||
+        offset < sizeof(ResTable_header) || table_size > data->size()) {
+        *error = "resources.arsc has an invalid table header";
+        return false;
+    }
+
+    constexpr uint32_t kPackageId = 0x3f;
+    constexpr std::string_view kOriginalName = "lineageos.platform";
+    constexpr std::string_view kPublicName = "org.system.platform";
+    size_t rewritten = 0;
+    while (offset < table_size) {
+        if (table_size - offset < sizeof(ResChunk_header)) {
+            *error = "resources.arsc contains a truncated chunk header";
+            return false;
+        }
+        auto* chunk = reinterpret_cast<ResChunk_header*>(data->data() + offset);
+        const size_t chunk_size = dtohl(chunk->size);
+        const size_t header_size = dtohs(chunk->headerSize);
+        if (chunk_size < header_size || chunk_size > table_size - offset) {
+            *error = "resources.arsc contains an invalid chunk";
+            return false;
+        }
+        if (dtohs(chunk->type) == android::RES_TABLE_PACKAGE_TYPE) {
+            if (header_size < sizeof(ResTable_package)) {
+                *error = "resources.arsc contains a truncated package header";
+                return false;
+            }
+            auto* package = reinterpret_cast<ResTable_package*>(chunk);
+            if (dtohl(package->id) == kPackageId) {
+                std::string current_name;
+                for (uint16_t code_unit : package->name) {
+                    const uint16_t value = dtohs(code_unit);
+                    if (value == 0) break;
+                    if (value > 0x7f) {
+                        *error = "0x3f resource package has a non-ASCII name";
+                        return false;
+                    }
+                    current_name.push_back(static_cast<char>(value));
+                }
+                if (current_name != kOriginalName) {
+                    *error = StringPrintf("unexpected 0x3f resource package name: %s",
+                                          current_name.c_str());
+                    return false;
+                }
+                std::fill(std::begin(package->name), std::end(package->name), 0);
+                for (size_t i = 0; i < kPublicName.size(); ++i) {
+                    package->name[i] = htods(static_cast<uint16_t>(kPublicName[i]));
+                }
+                ++rewritten;
+            }
+        }
+        offset += chunk_size;
+    }
+    if (offset != table_size || rewritten != 1) {
+        *error = StringPrintf("expected one 0x3f resource package, rewrote %zu", rewritten);
+        return false;
+    }
+    return true;
+}
