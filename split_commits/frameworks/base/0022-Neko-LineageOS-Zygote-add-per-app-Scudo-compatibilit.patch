+package com.android.internal.os;
+
+import android.os.Process;
+import android.os.Trace;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.util.Slog;
+import android.util.TimingsTraceLog;
+
+import dalvik.system.VMRuntime;
+
+/**
+ * Re-executes a specialized Zygote child so libc can select its native allocator at startup.
+ *
+ * @hide
+ */
+public final class ExecInit {
+    private ExecInit() {}
+
+    public static final String IS_EXEC_SPAWNED_APP_PROCESS =
+            "IS_EXEC_SPAWNED_APP_PROCESS";
+    public static final String SYSTEM_RESOURCES_FD =
+            "EXEC_SYSTEM_RESOURCES_FD";
+    public static final String SYSTEM_RESOURCES_SIZE =
+            "EXEC_SYSTEM_RESOURCES_SIZE";
+
+    public static void main(String[] args) {
+        final int targetSdkVersion = Integer.parseInt(args[0], 10);
+        final int runtimeFlags = Integer.parseInt(args[1], 10);
+        isExecSpawned = true;
+
+        // The exec discarded Zygote preloaded Java state. Recreate the subset expected by apps.
+        ZygoteInit.preload(new TimingsTraceLog("ExecInitTiming", Trace.TRACE_TAG_DALVIK), false);
+
+        final String[] runtimeArgs = new String[args.length - 2];
+        System.arraycopy(args, 2, runtimeArgs, 0, runtimeArgs.length);
+        final Runnable r = execInit(targetSdkVersion, runtimeArgs);
+
+        Zygote.nativeHandleRuntimeFlags(runtimeFlags);
+        pendingExecInit = r;
+    }
+
+    private static Runnable pendingExecInit;
+
+    static Runnable getPendingExecInit() {
+        final Runnable result = pendingExecInit;
+        if (result == null) {
+            throw new IllegalStateException("pendingExecInit is null");
+        }
+        pendingExecInit = null;
+        return result;
+    }
+
+    /** This method does not return after a successful exec. */
+    public static void execApplication(String niceName, int targetSdkVersion,
+            String instructionSet, int runtimeFlags, String[] args) {
+        final int niceArgs = niceName == null ? 0 : 1;
+        final int baseArgs = 6 + niceArgs;
+        final String[] argv = new String[baseArgs + args.length];
+        argv[0] = VMRuntime.is64BitInstructionSet(instructionSet)
+                ? "/system/bin/app_process64" : "/system/bin/app_process32";
+        argv[1] = "/system/bin";
+        argv[2] = "--application";
+        if (niceName != null) {
+            argv[3] = "--nice-name=" + niceName;
+        }
+        argv[3 + niceArgs] = "com.android.internal.os.ExecInit";
+        argv[4 + niceArgs] = Integer.toString(targetSdkVersion);
+        argv[5 + niceArgs] = Integer.toString(runtimeFlags);
+        System.arraycopy(args, 0, argv, baseArgs, args.length);
+
+        WrapperInit.preserveCapabilities();
+        try {
+            if ((runtimeFlags & Zygote.USE_SCUDO_ALLOCATOR) != 0) {
+                // Read by bionic before the new process performs allocator initialization.
+                Os.setenv("LIBC_USE_SCUDO", "1", true);
+            }
+            Os.setenv(IS_EXEC_SPAWNED_APP_PROCESS, "1", true);
+            Os.execv(argv[0], argv);
+        } catch (ErrnoException e) {
+            throw new RuntimeException(e);
+        }
+    }
+
+    public static boolean isExecSpawned;
+
+    private static Runnable execInit(int targetSdkVersion, String[] argv) {
+        if (RuntimeInit.DEBUG) {
+            Slog.d(RuntimeInit.TAG, "RuntimeInit: Starting application from exec");
+        }
+
+        ClassLoader classLoader = null;
+        if (argv != null && argv.length > 2 && argv[0].equals("-cp")) {
+            classLoader = ZygoteInit.createPathClassLoader(argv[1], targetSdkVersion);
+            Thread.currentThread().setContextClassLoader(classLoader);
+
+            final String[] removedArgs = new String[argv.length - 2];
+            System.arraycopy(argv, 2, removedArgs, 0, argv.length - 2);
+            argv = removedArgs;
+        }
+
+        Zygote.nativePreApplicationInit();
+        if (Process.isIsolated()) {
+            System.gc();
+        }
+        return RuntimeInit.applicationInit(targetSdkVersion, null, argv, classLoader);
+    }
+}
