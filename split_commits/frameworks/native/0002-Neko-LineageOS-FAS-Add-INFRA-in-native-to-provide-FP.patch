+
+    const sp<TestableFpsListener> secondListener = sp<TestableFpsListener>::make();
+    EXPECT_CALL(mFrameTimeline, getFrameTimes(UnorderedElementsAre(1), 0)).Times(2);
+    EXPECT_CALL(mFrameTimeline, computeFps(UnorderedElementsAre(1)))
+            .Times(2)
+            .WillRepeatedly(Return(60.0f));
+
+    mFpsReporter->addListener(mFpsListener, kTaskId);
+    mFpsReporter->addListener(secondListener, kTaskId);
+    mClock->advanceTime(600ms);
+    mFpsReporter->dispatchLayerFps(hierarchyBuilder.getHierarchy());
+
+    EXPECT_EQ(60.0f, mFpsListener->lastReportedFps);
+    EXPECT_EQ(60.0f, secondListener->lastReportedFps);
+    mFpsReporter->removeListener(mFpsListener);
+    mFpsReporter->removeListener(secondListener);
