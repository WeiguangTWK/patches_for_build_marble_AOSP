+FrameTimeline::FrameTimes FrameTimeline::getFrameTimes(const std::unordered_set<int32_t>& layerIds,
+                                                       nsecs_t presentTimeExclusive) {
+    FrameTimes result;
+    if (layerIds.empty()) {
+        return result;
+    }
+
+    std::unordered_map<pid_t, size_t> bufferOwnerCounts;
+    std::unordered_map<pid_t, size_t> ownerCounts;
+    {
+        std::scoped_lock lock(mMutex);
+        result.presentTimes.reserve(mDisplayFrames.size());
+        for (const auto& displayFrame : mDisplayFrames) {
+            const nsecs_t presentTime = displayFrame->getActuals().presentTime;
+            if (presentTime <= presentTimeExclusive) {
+                continue;
+            }
+
+            bool matched = false;
+            for (const auto& surfaceFrame : displayFrame->getSurfaceFrames()) {
+                if (surfaceFrame->getPresentState() != SurfaceFrame::PresentState::Presented ||
+                    layerIds.count(surfaceFrame->getLayerId()) == 0) {
+                    continue;
+                }
+
+                matched = true;
+                const pid_t ownerPid = surfaceFrame->getOwnerPid();
+                if (ownerPid > 0) {
+                    ++ownerCounts[ownerPid];
+                    if (surfaceFrame->getIsBuffer()) {
+                        ++bufferOwnerCounts[ownerPid];
+                    }
+                }
+            }
+            if (matched) {
+                result.presentTimes.push_back(presentTime);
+            }
+        }
+    }
+
+    const auto& preferredCounts = bufferOwnerCounts.empty() ? ownerCounts : bufferOwnerCounts;
+    for (const auto& [ownerPid, count] : preferredCounts) {
+        const size_t currentCount =
+                result.dominantOwnerPid > 0 ? preferredCounts.at(result.dominantOwnerPid) : 0;
+        if (count > currentCount) {
+            result.dominantOwnerPid = ownerPid;
+        }
+    }
+    return result;
+}
+
 void FrameTimeline::generateFrameStats(int32_t layer, size_t count, FrameStats* outStats) const {
     std::scoped_lock lock(mMutex);
 
