diff --git a/build/soong/integrity/collector.go b/build/soong/integrity/collector.go
new file mode 100644
index 0000000..2a526d6
--- /dev/null
+++ b/build/soong/integrity/collector.go
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: Apache-2.0
+package integrity
+
+import "android/soong/android"
+
+func init() {
+	android.RegisterModuleType("integrity_collector_output", collectorFactory)
+	android.RegisterModuleType("integrity_signer_output", signerFactory)
+	android.RegisterModuleType("integrity_early_output", earlyFactory)
+}
+
+type earlyOutput struct {
+	android.ModuleBase
+	properties struct{ Filename *string }
+	srcs       android.Paths
+}
+
+func earlyFactory() android.Module {
+	m := &earlyOutput{}
+	m.AddProperties(&m.properties)
+	android.InitAndroidModule(m)
+	return m
+}
+
+func (m *earlyOutput) UseGenericConfig() bool { return false }
+
+func (m *earlyOutput) GenerateAndroidBuildActions(ctx android.ModuleContext) {
+	if !ctx.Config().HasDeviceProduct() || m.properties.Filename == nil {
+		ctx.ModuleErrorf("requires a device product and manifest filename")
+		return
+	}
+	name := *m.properties.Filename
+	if name != "collector_manifest.json" && name != "collector_manifest.sig" {
+		ctx.PropertyErrorf("filename", "unsupported early output %q", name)
+		return
+	}
+	m.srcs = android.Paths{android.PathForArbitraryOutput(ctx, "target", "product",
+		ctx.Config().DeviceName(), "obj", "platform_integrity", "early_manifest", name)}
+}
+
+func (m *earlyOutput) Srcs() android.Paths { return append(android.Paths{}, m.srcs...) }
+
+// Public C++ input generated by Make from the selected certificate only. It
+// must not depend on the kernel, signed baseline, APEX or final system image.
+type signerOutput struct {
+	android.ModuleBase
+	srcs android.Paths
+}
+
+func signerFactory() android.Module {
+	m := &signerOutput{}
+	android.InitAndroidModule(m)
+	return m
+}
+
+func (m *signerOutput) UseGenericConfig() bool { return false }
+
+func (m *signerOutput) GenerateAndroidBuildActions(ctx android.ModuleContext) {
+	if !ctx.Config().HasDeviceProduct() {
+		ctx.ModuleErrorf("requires a configured device product")
+		return
+	}
+	m.srcs = android.Paths{android.PathForArbitraryOutput(ctx, "target", "product",
+		ctx.Config().DeviceName(), "obj", "platform_integrity", "trust_anchor", "signer.cpp")}
+}
+
+func (m *signerOutput) Srcs() android.Paths { return append(android.Paths{}, m.srcs...) }
+
+// Only the fixed Make-produced collector is exposed. No source-path escape,
+// glob of existing output files, or second producer of the kernel artifacts.
+type collectorOutput struct {
+	android.ModuleBase
+	srcs android.Paths
+}
+
+func collectorFactory() android.Module {
+	m := &collectorOutput{}
+	android.InitAndroidModule(m)
+	return m
+}
+
+// The Make-produced path belongs to the selected product, not the generic
+// configuration. DeviceName() is deliberately unavailable in generic modules.
+func (m *collectorOutput) UseGenericConfig() bool { return false }
+
+func (m *collectorOutput) GenerateAndroidBuildActions(ctx android.ModuleContext) {
+	if !ctx.Config().HasDeviceProduct() {
+		ctx.ModuleErrorf("requires a configured device product")
+		return
+	}
+	m.srcs = android.Paths{android.PathForArbitraryOutput(ctx, "target", "product",
+		ctx.Config().DeviceName(), "obj", "platform_integrity", "collector", "inte.ko")}
+}
+
+func (m *collectorOutput) Srcs() android.Paths { return append(android.Paths{}, m.srcs...) }
diff --git a/build/tasks/kernel.mk b/build/tasks/kernel.mk
index a4846e3..986be96 100644
--- a/build/tasks/kernel.mk
+++ b/build/tasks/kernel.mk
@@ -251,6 +251,12 @@ else
     endif
 endif
 
+ifeq ($(TARGET_PLATFORM_INTEGRITY_COLLECTOR),true)
+ifneq ($(FULL_KERNEL_BUILD),true)
+$(error Source-built integrity collector requires FULL_KERNEL_BUILD=true)
+endif
+endif
+
 ifeq ($(FULL_KERNEL_BUILD),true)
 # Add host bin out dir to path
 PATH_OVERRIDE := PATH=$(KERNEL_BUILD_OUT_PREFIX)$(HOST_OUT_EXECUTABLES):$$PATH
@@ -394,6 +400,7 @@ ifneq ($(filter $(FULL_KERNEL_BUILD),true)$(TARGET_KERNEL_PLATFORM_TARGET),)
 # $(8): external dependency module intermediates dir
 # Depmod requires a well-formed kernel version so 0.0 is used as a placeholder.
 define build-image-kernel-modules-lineage
+    $(if $(filter true,$(TARGET_PLATFORM_INTEGRITY)),for MODULE in $(1); do printf '%s\n' "$(2)/lib/modules$(6)/$$(basename $$MODULE)" >> $(PLATFORM_INTEGRITY_MODULE_MANIFEST).tmp; done)
     mkdir -p $(2)/lib/modules$(6)
     cp $(1) $(2)/lib/modules$(6)
     rm -rf $(4)
@@ -531,7 +538,11 @@ $(KERNEL_CONFIG): $(KERNEL_OUT) $(ALL_KERNEL_DEFCONFIG_SRCS)
 	@echo "Building Kernel Config"
 	$(call make-kernel-config,$(KERNEL_OUT),$(ALL_KERNEL_DEFCONFIG_SRCS))
 
+# ASTER owns nested source/output bookkeeping; host recipe hooks stay below.
+include external/aster/build/kernel_outputs.mk
+
 $(TARGET_PREBUILT_INT_KERNEL): $(KERNEL_CONFIG) $(DEPMOD) $(DTC) $(KERNEL_MODULES_PARTITION_FILE_LIST) $(SYSTEM_KERNEL_MODULES_PARTITION_FILE_LIST) $(BOOT_KERNEL_MODULES_FINDER) $(RECOVERY_KERNEL_MODULES_FINDER)
+	$(if $(filter true,$(TARGET_PLATFORM_INTEGRITY)),mkdir -p $(dir $(PLATFORM_INTEGRITY_MODULE_MANIFEST)); rm -rf $(MODULES_INTERMEDIATES); : > $(PLATFORM_INTEGRITY_MODULE_MANIFEST).tmp)
 	@echo "Building Kernel Image ($(BOARD_KERNEL_IMAGE_NAME))"
 	$(call make-kernel-target,$(BOARD_KERNEL_IMAGE_NAME))
 	$(hide) if [ -d "$(KERNEL_SRC)/arch/$(KERNEL_ARCH)/boot/dts/" ]; then \
@@ -625,6 +636,8 @@ $(TARGET_PREBUILT_INT_KERNEL): $(KERNEL_CONFIG) $(DEPMOD) $(DTC) $(KERNEL_MODULE
 			) \
 		fi
 
+	$(if $(filter true,$(TARGET_PLATFORM_INTEGRITY)),test -s $(PLATFORM_INTEGRITY_MODULE_MANIFEST).tmp && sort -u $(PLATFORM_INTEGRITY_MODULE_MANIFEST).tmp > $(PLATFORM_INTEGRITY_MODULE_MANIFEST))
+
 .PHONY: kerneltags
 kerneltags: $(KERNEL_CONFIG)
 	$(call make-kernel-target,tags)
diff --git a/config/BoardConfigKernel.mk b/config/BoardConfigKernel.mk
index 3d9fc0c..ea380b2 100644
--- a/config/BoardConfigKernel.mk
+++ b/config/BoardConfigKernel.mk
@@ -141,6 +141,8 @@ endif
 # Clear this first to prevent accidental poisoning from env
 KERNEL_MAKE_FLAGS :=
 
