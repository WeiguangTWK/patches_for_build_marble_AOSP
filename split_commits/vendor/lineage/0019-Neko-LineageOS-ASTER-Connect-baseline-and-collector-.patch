 build/soong/Android.bp              | 33 +++++++---
 build/soong/integrity/collector.go  | 95 +++++++++++++++++++++++++++++
 build/tasks/kernel.mk               | 13 ++++
 config/BoardConfigKernel.mk         |  2 +
 5 files changed, 136 insertions(+), 10 deletions(-)
 create mode 100644 build/platform_integrity/Android.mk
 create mode 100644 build/soong/integrity/collector.go

