+++ b/overlay/rro_packages/NetworkStackOverlay/res/values-mcc460/config.xml
@@ -0,0 +1,13 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     Copyright (C) 2026 Neko LineageOS
+     SPDX-License-Identifier: Apache-2.0
+-->
+<resources>
+    <!-- Network validation probe URLs for MCC 460. -->
+    <string name="config_captive_portal_http_url" translatable="false">http://connect.rom.miui.com/generate_204</string>
+    <string name="config_captive_portal_https_url" translatable="false">https://connect.rom.miui.com/generate_204</string>
+    <string-array name="config_captive_portal_fallback_urls" translatable="false">
+        <item>http://connect.rom.miui.com/generate_204</item>
+    </string-array>
+</resources>
diff --git a/overlay/rro_packages/NetworkStackOverlay/res/values/config.xml b/overlay/rro_packages/NetworkStackOverlay/res/values/config.xml
index aef5c9c..ecc1408 100644
--- a/overlay/rro_packages/NetworkStackOverlay/res/values/config.xml
