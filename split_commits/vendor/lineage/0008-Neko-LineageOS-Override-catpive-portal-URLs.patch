 .../res/values-mcc460/config.xml                    | 13 +++++++++++++
 .../NetworkStackOverlay/res/values/config.xml       |  7 +++++++
 2 files changed, 20 insertions(+)
 create mode 100644 overlay/rro_packages/NetworkStackOverlay/res/values-mcc460/config.xml

diff --git a/overlay/rro_packages/NetworkStackOverlay/res/values-mcc460/config.xml b/overlay/rro_packages/NetworkStackOverlay/res/values-mcc460/config.xml
