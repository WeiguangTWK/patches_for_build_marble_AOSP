diff --git a/CleanSpec.mk b/CleanSpec.mk
new file mode 100644
index 0000000..f5539c9
--- /dev/null
+++ b/CleanSpec.mk
@@ -0,0 +1,11 @@
+# Remove the obsolete feature filenames from incremental product images.
+# Clean steps are append-only; do not reorder or remove existing entries.
+$(call add-clean-step, rm -f \
+    $(TARGET_OUT_PRODUCT)/etc/permissions/org.lineageos.android.xml \
+    $(TARGET_OUT_PRODUCT)/etc/permissions/org.lineageos.globalactions.xml \
+    $(TARGET_OUT_PRODUCT)/etc/permissions/org.lineageos.hardware.xml \
+    $(TARGET_OUT_PRODUCT)/etc/permissions/org.lineageos.health.xml \
+    $(TARGET_OUT_PRODUCT)/etc/permissions/org.lineageos.livedisplay.xml \
+    $(TARGET_OUT_PRODUCT)/etc/permissions/org.lineageos.profiles.xml \
+    $(TARGET_OUT_PRODUCT)/etc/permissions/org.lineageos.settings.xml \
+    $(TARGET_OUT_PRODUCT)/etc/permissions/org.lineageos.trust.xml)
diff --git a/config/common.mk b/config/common.mk
index e4a69fb..bf9059c 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -81,10 +81,6 @@ PRODUCT_PACKAGES += \
