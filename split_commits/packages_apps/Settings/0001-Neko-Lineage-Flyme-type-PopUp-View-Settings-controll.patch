+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.notification;
+
+import static android.provider.Settings.System.POP_UP_NOTIFICATION_BLACKLIST;
+import static android.provider.Settings.System.POP_UP_NOTIFICATION_JUMP_LANDSCAPE;
+import static android.provider.Settings.System.POP_UP_NOTIFICATION_JUMP_PORTRAIT;
+
+import android.content.Context;
+import android.provider.Settings;
+import android.text.TextUtils;
+
+import androidx.annotation.NonNull;
+
+import java.util.Arrays;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+final class NotificationPopUpViewSettingsUtils {
+    private static final String BLACKLIST_DELIMITER = ";";
+
+    private NotificationPopUpViewSettingsUtils() {}
+
+    static boolean isEnabled(@NonNull Context context, int userId) {
+        return Settings.System.getIntForUser(
+                context.getContentResolver(), POP_UP_NOTIFICATION_JUMP_PORTRAIT, 0, userId) == 1
+                && Settings.System.getIntForUser(
+                context.getContentResolver(), POP_UP_NOTIFICATION_JUMP_LANDSCAPE, 0, userId) == 1;
+    }
+
+    static void setEnabled(@NonNull Context context, int userId, boolean enabled) {
+        final int value = enabled ? 1 : 0;
+        Settings.System.putIntForUser(
+                context.getContentResolver(), POP_UP_NOTIFICATION_JUMP_PORTRAIT, value, userId);
+        Settings.System.putIntForUser(
+                context.getContentResolver(), POP_UP_NOTIFICATION_JUMP_LANDSCAPE, value, userId);
+    }
+
+    static @NonNull Set<String> getUserBlacklist(@NonNull Context context, int userId) {
+        final String stored = Settings.System.getStringForUser(
+                context.getContentResolver(), POP_UP_NOTIFICATION_BLACKLIST, userId);
+        if (TextUtils.isEmpty(stored)) {
+            return new LinkedHashSet<>();
+        }
+        return Arrays.stream(stored.split(BLACKLIST_DELIMITER))
+                .filter(packageName -> !TextUtils.isEmpty(packageName))
+                .collect(Collectors.toCollection(LinkedHashSet::new));
+    }
+
+    static void setUserBlacklist(@NonNull Context context, int userId, @NonNull Set<String> packages) {
+        final String serialized = packages.stream()
+                .filter(packageName -> !TextUtils.isEmpty(packageName))
+                .collect(Collectors.joining(BLACKLIST_DELIMITER));
+        Settings.System.putStringForUser(
+                context.getContentResolver(), POP_UP_NOTIFICATION_BLACKLIST, serialized, userId);
+    }
+}
