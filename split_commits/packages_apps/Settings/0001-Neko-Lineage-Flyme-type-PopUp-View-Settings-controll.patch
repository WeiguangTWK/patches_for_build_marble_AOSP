+    }
+
+    @Override
+    public void displayPreference(@NonNull PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mPreferenceCategory = screen.findPreference(getPreferenceKey());
+        updateState(mPreferenceCategory);
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        if (mPreferenceCategory == null) {
+            return;
+        }
+        mPreferenceCategory.removeAll();
+        final int userId = mContext.getUserId();
+        final Set<String> blacklistedApps = NotificationPopUpViewSettingsUtils.getUserBlacklist(
+                mContext, userId);
+        final PackageManager pm = mContext.getPackageManager();
+        final List<ApplicationInfo> apps = new ArrayList<>(
+                pm.getInstalledApplications(PackageManager.MATCH_DISABLED_COMPONENTS));
+        final Collator collator = Collator.getInstance();
+        apps.sort(Comparator.comparing(
+                app -> String.valueOf(app.loadLabel(pm)), collator));
+
+        int order = 0;
+        for (ApplicationInfo app : apps) {
+            final String packageName = app.packageName;
+            final boolean hasLauncherEntry = pm.getLaunchIntentForPackage(packageName) != null;
+            if ((!app.enabled && !blacklistedApps.contains(packageName))
+                    || (!hasLauncherEntry && !blacklistedApps.contains(packageName))
+                    || SYSTEM_BLACKLIST.contains(packageName)) {
+                continue;
+            }
+            final SwitchPreferenceCompat pref =
+                    new SwitchPreferenceCompat(mPreferenceCategory.getContext());
+            pref.setKey(packageName);
+            pref.setOrder(order++);
+            pref.setTitle(app.loadLabel(pm));
+            pref.setIcon(app.loadIcon(pm));
+            pref.setChecked(blacklistedApps.contains(packageName));
+            pref.setOnPreferenceChangeListener((changedPref, newValue) -> {
+                if ((boolean) newValue) {
+                    blacklistedApps.add(packageName);
+                } else {
+                    blacklistedApps.remove(packageName);
+                }
+                NotificationPopUpViewSettingsUtils.setUserBlacklist(mContext, userId, blacklistedApps);
+                return true;
+            });
+            mPreferenceCategory.addPreference(pref);
+        }
+    }
+}
