+package com.android.settings.notification;
+
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+
+import androidx.annotation.NonNull;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.core.BasePreferenceController;
+
+import java.util.Set;
+
+public class NotificationPopUpViewBlacklistedAppsPreferenceController extends BasePreferenceController {
+    private static final String MANAGE_APPS_KEY = "notification_pop_up_view_manage_apps";
+
+    private PreferenceCategory mPreferenceCategory;
+
+    public NotificationPopUpViewBlacklistedAppsPreferenceController(
+            Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void displayPreference(@NonNull PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mPreferenceCategory = screen.findPreference(getPreferenceKey());
+        updateState(mPreferenceCategory);
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        if (mPreferenceCategory == null) {
+            return;
+        }
+        clearDynamicPreferences();
+        final PackageManager pm = mContext.getPackageManager();
+        final Set<String> blacklistedApps = NotificationPopUpViewSettingsUtils.getUserBlacklist(
+                mContext, mContext.getUserId());
+        int order = 0;
+        for (String packageName : blacklistedApps) {
+            final Preference pref = new Preference(mPreferenceCategory.getContext());
+            pref.setKey(packageName);
+            pref.setOrder(order++);
+            pref.setSelectable(false);
+            try {
+                final ApplicationInfo info = pm.getApplicationInfo(packageName, 0);
+                pref.setTitle(info.loadLabel(pm));
+                pref.setIcon(info.loadIcon(pm));
+            } catch (PackageManager.NameNotFoundException e) {
+                pref.setTitle(packageName);
+            }
+            mPreferenceCategory.addPreference(pref);
+        }
+    }
+
+    private void clearDynamicPreferences() {
+        for (int i = mPreferenceCategory.getPreferenceCount() - 1; i >= 0; i--) {
+            final Preference pref = mPreferenceCategory.getPreference(i);
+            if (!MANAGE_APPS_KEY.equals(pref.getKey())) {
+                mPreferenceCategory.removePreference(pref);
+            }
+        }
+    }
+}
