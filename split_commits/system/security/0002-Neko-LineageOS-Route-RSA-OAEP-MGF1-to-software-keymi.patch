+
+    fn rsa_oaep_params(mgf_digests: &[Digest]) -> Vec<KeyParameter> {
+        let mut params = vec![
+            KeyParameter {
+                tag: Tag::ALGORITHM,
+                value: KeyParameterValue::Algorithm(Algorithm::RSA),
+            },
+            KeyParameter {
+                tag: Tag::PADDING,
+                value: KeyParameterValue::PaddingMode(PaddingMode::RSA_OAEP),
+            },
+        ];
+        params.extend(mgf_digests.iter().map(|digest| KeyParameter {
+            tag: Tag::RSA_OAEP_MGF_DIGEST,
+            value: KeyParameterValue::Digest(*digest),
+        }));
+        params
+    }
+
+    #[test]
+    fn auto_classifier_routes_non_default_mgf1_to_software() {
+        assert!(is_rsa_oaep_non_default_mgf1_request(&rsa_oaep_params(&[Digest::SHA_2_256])));
+    }
+
+    #[test]
+    fn auto_classifier_keeps_default_mgf1_on_hardware() {
+        assert!(!is_rsa_oaep_non_default_mgf1_request(&rsa_oaep_params(&[
+            Digest::SHA1,
+            Digest::SHA_2_256,
+        ])));
+    }
+
+    #[test]
+    fn auto_classifier_requires_rsa_oaep_and_an_mgf_digest() {
+        assert!(!is_rsa_oaep_non_default_mgf1_request(&[]));
+
+        let mut params = rsa_oaep_params(&[Digest::SHA_2_256]);
+        params.retain(|param| param.tag != Tag::PADDING);
+        assert!(!is_rsa_oaep_non_default_mgf1_request(&params));
+    }
