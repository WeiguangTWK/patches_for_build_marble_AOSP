+fn auto_software_fallback_error(error: &anyhow::Error) -> Option<ErrorCode> {
+    // Only errors which identify an unavailable attestation implementation are sticky. Request
+    // validation and transient operation errors must continue to use the hardware path.
+    error.chain().find_map(|cause| {
+        let Error::Km(code) = cause.downcast_ref::<Error>()? else {
+            return None;
+        };
+        matches!(
+            *code,
+            ErrorCode::HARDWARE_TYPE_UNAVAILABLE
+                | ErrorCode::KEYMINT_NOT_CONFIGURED
+                | ErrorCode::ATTESTATION_KEYS_NOT_PROVISIONED
+        )
+        .then_some(*code)
+    })
+}
