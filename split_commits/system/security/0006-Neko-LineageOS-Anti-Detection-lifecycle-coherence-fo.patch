+#[test]
+fn test_tee_soft_attest_metadata_follows_keyentry_lifecycle() -> Result<()> {
+    let temp_dir = TempDir::new("tee_soft_attest_metadata")?;
+    let mut db = KeystoreDB::new(temp_dir.path(), None)?;
+    const OWNER: AppUid = AppUid(41001);
+    const GRANTEE: AppUid = AppUid(41002);
+    const SOURCE_ALIAS: &str = "tee_soft_attest_source";
+    const DEST_ALIAS: &str = "tee_soft_attest_destination";
+
+    let key_guard = make_test_key_entry(&mut db, Domain::APP, OWNER.0, SOURCE_ALIAS, None)?;
+    let mut metadata = KeyMetaData::new();
+    metadata.add(KeyMetaEntry::TeeSoftAttestKeyVersion(1));
+    metadata.add(KeyMetaEntry::TeeSoftAttestKeySource(1));
+    metadata.add(KeyMetaEntry::TeeSoftAttestKeyAlgorithm(b"rsa".to_vec()));
+    metadata.add(KeyMetaEntry::TeeSoftAttestKeyMaterialId(b"material-id".to_vec()));
+    metadata.add(KeyMetaEntry::TeeSoftAttestKeySignerCert(vec![1, 2, 3, 4]));
+    metadata.add(KeyMetaEntry::TeeSoftAttestKeySignerKey(vec![5, 6, 7, 8]));
+    db.insert_key_metadata(&key_guard, &metadata)?;
+    drop(key_guard);
+    drop(db);
+
+    // Reopen the persistent database to model a keystore2 restart/reboot.
+    let mut db = KeystoreDB::new(temp_dir.path(), None)?;
+
+    let source = KeyDescriptor {
+        domain: Domain::APP,
+        nspace: OWNER.0,
+        alias: Some(SOURCE_ALIAS.to_string()),
+        blob: None,
+    };
+    let grant = db.grant(&source, OWNER, GRANTEE, key_perm_set![KeyPerm::Use], |_k, _av| Ok(()))?;
+    {
+        let (_guard, entry) = db.load_key_entry(
+            &grant,
+            KeyType::Client,
+            KeyEntryLoadBits::BOTH,
+            GRANTEE,
+            |_k, _av| Ok(()),
+        )?;
+        assert_eq!(entry.metadata().tee_soft_attest_key_version(), Some(&1));
+        assert_eq!(
+            entry.metadata().tee_soft_attest_key_material_id(),
+            Some(&b"material-id".to_vec())
+        );
+        assert_eq!(entry.metadata().tee_soft_attest_key_signer_key(), Some(&vec![5, 6, 7, 8]));
+    }
+
+    let (source_guard, _) =
+        db.load_key_entry(&source, KeyType::Client, KeyEntryLoadBits::NONE, OWNER, |_k, _av| {
+            Ok(())
+        })?;
+    let destination = KeyDescriptor {
+        domain: Domain::APP,
+        nspace: OWNER.0,
+        alias: Some(DEST_ALIAS.to_string()),
+        blob: None,
+    };
+    db.migrate_key_namespace(source_guard, &destination, OWNER, |_k| Ok(()))?;
+
+    let (destination_guard, entry) = db.load_key_entry(
+        &destination,
+        KeyType::Client,
+        KeyEntryLoadBits::BOTH,
+        OWNER,
+        |_k, _av| Ok(()),
+    )?;
+    assert_eq!(entry.metadata().tee_soft_attest_key_signer_cert(), Some(&vec![1, 2, 3, 4]));
+
+    db.set_public_blobs_and_invalidate_tee_soft_attest_key(
+        &destination_guard,
+        Some(b"replacement-cert"),
+        Some(b"replacement-chain"),
+    )?;
+    drop(destination_guard);
+    let (_guard, entry) = db.load_key_entry(
+        &destination,
+        KeyType::Client,
+        KeyEntryLoadBits::BOTH,
+        OWNER,
+        |_k, _av| Ok(()),
+    )?;
+    assert_eq!(entry.metadata().tee_soft_attest_key_version(), None);
+    assert_eq!(entry.metadata().tee_soft_attest_key_signer_key(), None);
+    Ok(())
+}
+
+#[test]
+fn test_rebind_explicitly_invalidates_old_tee_soft_attest_metadata() -> Result<()> {
+    let mut db = new_test_db()?;
+    const OWNER: AppUid = AppUid(42001);
+    const ALIAS: &str = "tee_soft_attest_rebind";
+
+    let old_guard = make_test_key_entry(&mut db, Domain::APP, OWNER.0, ALIAS, None)?;
+    let old_id = old_guard.id();
+    let mut metadata = KeyMetaData::new();
+    metadata.add(KeyMetaEntry::TeeSoftAttestKeyVersion(1));
+    metadata.add(KeyMetaEntry::TeeSoftAttestKeySource(2));
+    metadata.add(KeyMetaEntry::TeeSoftAttestKeySignerKey(vec![9, 8, 7]));
+    db.insert_key_metadata(&old_guard, &metadata)?;
+    drop(old_guard);
+
+    // Both generate and import replace aliases through store_new_key/rebind_alias.
+    let replacement = make_test_key_entry(&mut db, Domain::APP, OWNER.0, ALIAS, None)?;
+    drop(replacement);
+    let stale_rows: i64 = db.conn.query_row(
+        "SELECT COUNT(*) FROM persistent.keymetadata
+         WHERE keyentryid = ? AND tag IN (?, ?, ?, ?, ?, ?);",
+        params![
+            old_id,
+            KeyMetaData::TeeSoftAttestKeyVersion,
+            KeyMetaData::TeeSoftAttestKeySource,
+            KeyMetaData::TeeSoftAttestKeyAlgorithm,
+            KeyMetaData::TeeSoftAttestKeyMaterialId,
+            KeyMetaData::TeeSoftAttestKeySignerCert,
+            KeyMetaData::TeeSoftAttestKeySignerKey,
+        ],
+        |row| row.get(0),
+    )?;
+    assert_eq!(stale_rows, 0);
+    Ok(())
+}
