+const TEE_SOFT_ATTEST_KEY_METADATA_VERSION: i32 = 1;
+const TEE_SOFT_ATTEST_KEY_SOURCE_SOFTWARE: i32 = 1;
+const TEE_SOFT_ATTEST_KEY_SOURCE_HARDWARE: i32 = 2;
+
+/// Persistent TEE Soft state belonging to one concrete Keystore keyentry. Keeping this state on
+/// the keyentry makes alias rebinding/import replacement invalidate it automatically, while grants
+/// and namespace migration continue to reference the same state.
+#[derive(Clone, Eq, PartialEq)]
+pub(crate) struct TeeSoftAttestKeyMetadata {
+    source: i32,
+    algorithm: Option<String>,
+    material_id: Option<String>,
+    signer: Option<TrackedAttestSignerState>,
+}
+
+impl TeeSoftAttestKeyMetadata {
+    pub(crate) fn for_generation(used_software_generation: bool) -> Self {
+        Self {
+            source: if used_software_generation {
+                TEE_SOFT_ATTEST_KEY_SOURCE_SOFTWARE
+            } else {
+                TEE_SOFT_ATTEST_KEY_SOURCE_HARDWARE
+            },
+            algorithm: None,
+            material_id: None,
+            signer: None,
+        }
+    }
+
+    pub(crate) fn from_key_metadata(metadata: &KeyMetaData) -> Option<Self> {
+        if metadata.tee_soft_attest_key_version().copied()
+            != Some(TEE_SOFT_ATTEST_KEY_METADATA_VERSION)
+        {
+            return None;
+        }
+        let source = metadata.tee_soft_attest_key_source().copied()?;
+        if source != TEE_SOFT_ATTEST_KEY_SOURCE_SOFTWARE
+            && source != TEE_SOFT_ATTEST_KEY_SOURCE_HARDWARE
+        {
+            return None;
+        }
+        let algorithm = metadata
+            .tee_soft_attest_key_algorithm()
+            .and_then(|v| String::from_utf8(v.clone()).ok());
+        let material_id = metadata
+            .tee_soft_attest_key_material_id()
+            .and_then(|v| String::from_utf8(v.clone()).ok());
+        let signer = match (
+            metadata.tee_soft_attest_key_signer_cert(),
+            metadata.tee_soft_attest_key_signer_key(),
+        ) {
+            (Some(cert), Some(key)) if !cert.is_empty() && !key.is_empty() => {
+                Some(TrackedAttestSignerState {
+                    signer_cert: cert.clone(),
+                    signer_key: key.clone(),
+                    algorithm: algorithm.clone(),
+                })
+            }
+            (None, None) => None,
+            _ => return None,
+        };
+        Some(Self { source, algorithm, material_id, signer })
+    }
+
+    pub(crate) fn add_to_key_metadata(&self, metadata: &mut KeyMetaData) {
+        metadata.add(KeyMetaEntry::TeeSoftAttestKeyVersion(TEE_SOFT_ATTEST_KEY_METADATA_VERSION));
+        metadata.add(KeyMetaEntry::TeeSoftAttestKeySource(self.source));
+        if let Some(algorithm) = &self.algorithm {
+            metadata.add(KeyMetaEntry::TeeSoftAttestKeyAlgorithm(algorithm.as_bytes().to_vec()));
+        }
+        if let Some(material_id) = &self.material_id {
+            metadata.add(KeyMetaEntry::TeeSoftAttestKeyMaterialId(material_id.as_bytes().to_vec()));
+        }
+        if let Some(signer) = &self.signer {
+            metadata.add(KeyMetaEntry::TeeSoftAttestKeySignerCert(signer.signer_cert.clone()));
+            metadata.add(KeyMetaEntry::TeeSoftAttestKeySignerKey(signer.signer_key.clone()));
+        }
+    }
+
+    fn signer(&self) -> Option<&TrackedAttestSignerState> {
+        self.signer.as_ref()
+    }
+}
