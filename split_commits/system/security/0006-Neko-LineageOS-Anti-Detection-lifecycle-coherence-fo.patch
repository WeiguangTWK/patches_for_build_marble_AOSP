+    /// Atomically updates both public certificate components and invalidates TEE Soft ATTEST_KEY
+    /// signer metadata. Once callers replace either public component, retaining the old signer
+    /// selection would make the key's persisted identity internally inconsistent.
+    pub fn set_public_blobs_and_invalidate_tee_soft_attest_key(
+        &mut self,
+        key_id: &KeyIdGuard,
+        public_cert: Option<&[u8]>,
+        certificate_chain: Option<&[u8]>,
+    ) -> Result<()> {
+        let _wp = wd::watch("KeystoreDB::set_public_blobs_and_invalidate_tee_soft_attest_key");
+        self.with_transaction(Immediate("TX_set_public_blobs_invalidate_tee_soft"), |tx| {
+            Self::set_blob_internal(tx, key_id.0, SubComponentType::CERT, public_cert, None)?;
+            Self::set_blob_internal(
+                tx,
+                key_id.0,
+                SubComponentType::CERT_CHAIN,
+                certificate_chain,
+                None,
+            )?;
+            tx.execute(
+                "DELETE FROM persistent.keymetadata
+                 WHERE keyentryid = ? AND tag IN (?, ?, ?, ?, ?, ?);",
+                params![
+                    key_id.0,
+                    KeyMetaData::TeeSoftAttestKeyVersion,
+                    KeyMetaData::TeeSoftAttestKeySource,
+                    KeyMetaData::TeeSoftAttestKeyAlgorithm,
+                    KeyMetaData::TeeSoftAttestKeyMaterialId,
+                    KeyMetaData::TeeSoftAttestKeySignerCert,
+                    KeyMetaData::TeeSoftAttestKeySignerKey,
+                ],
+            )
+            .context("Trying to invalidate TEE Soft ATTEST_KEY metadata.")?;
+            Ok(()).need_gc()
+        })
+        .context(ks_err!())
+    }
+
     /// Why would we insert a deleted blob? This weird function is for the purpose of legacy
     /// key migration in the case where we bulk delete all the keys of an app or even a user.
     /// We use this to insert key blobs into the database which can then be garbage collected
@@ -1811,6 +1863,29 @@ impl KeystoreDB {
                     .context(ks_err!("Domain {:?} must be either App or SELinux.", domain));
             }
         }
+        // Explicitly invalidate TEE Soft signer material on alias replacement. The old keyentry
+        // becomes unreachable below, but deleting this metadata in the rebind transaction avoids
+        // retaining stale private signer material until a later garbage-collection pass.
+        tx.execute(
+            "DELETE FROM persistent.keymetadata
+             WHERE keyentryid IN (
+                 SELECT id FROM persistent.keyentry
+                 WHERE alias = ? AND domain = ? AND namespace = ? AND key_type = ?
