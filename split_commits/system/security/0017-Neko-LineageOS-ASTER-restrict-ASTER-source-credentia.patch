--- /dev/null
+++ b/keystore2/src/aster_credentials.rs
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Only the ASTER namespace is gated; ordinary keys never query ASTER.
+use crate::error::Error;
+use anyhow::{Context, Result};
+use android_system_keystore2::aidl::android::system::keystore2::{
+    Domain::Domain, KeyDescriptor::KeyDescriptor, ResponseCode::ResponseCode,
+};
+use android_hardware_security_keymint::aidl::android::hardware::security::keymint::{
+    Algorithm::Algorithm, Digest::Digest, KeyParameter::KeyParameter,
+    KeyParameterValue::KeyParameterValue as V, KeyPurpose::KeyPurpose,
+    SecurityLevel::SecurityLevel, Tag::Tag,
+};
+
+pub(crate) const NAMESPACE: i64 = 121;
+pub(crate) const ALIAS: &str = "aster.ksu.source.hmac.v1";
+pub(crate) const LOCAL_NAMESPACE: i64 = 122;
+pub(crate) const LOCAL_ALIAS: &str = "aster.ksu.source.local.hmac.v1";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct SourceIdentity {
+    generation: u64,
+    backend: u32,
+}
+
+unsafe extern "C" {
+    fn aster_keystore_source_identity(generation: *mut u64, backend: *mut u32) -> i32;
+}
+
+fn denied<T>() -> Result<T> {
+    Err(Error::Rc(ResponseCode::PERMISSION_DENIED)).context("ASTER credential access denied")
+}
+
+pub(crate) fn protected(key: &KeyDescriptor) -> bool {
+    (key.domain == Domain::SELINUX || key.domain == Domain::BLOB)
+        && (key.nspace == NAMESPACE || key.nspace == LOCAL_NAMESPACE)
+}
+
+pub(crate) fn generation() -> Result<SourceIdentity> {
+    let mut generation = 0;
+    let mut backend = 0;
+    // SAFETY: native helper writes only these live outputs and checks the current Binder transaction.
+    if unsafe { aster_keystore_source_identity(&mut generation, &mut backend) } != 0
+        || generation == 0 || (backend != 1 && backend != 2) {
+        return denied();
+    }
+    Ok(SourceIdentity { generation, backend })
+}
+
+pub(crate) fn authorize(key: &KeyDescriptor) -> Result<Option<SourceIdentity>> {
+    if !protected(key) { return Ok(None); }
+    if key.domain != Domain::SELINUX { return denied(); }
+    let source = generation()?;
+    let backend = if key.nspace == NAMESPACE { 1 } else { 2 };
+    // KEY_ID resolution supplies the stored namespace but may omit the alias.
+    // Enforce the single permitted alias at creation, not on that permission tuple.
+    if source.backend != backend { return denied(); }
+    Ok(Some(source))
+}
+
+pub(crate) fn reject_import(key: &KeyDescriptor) -> Result<()> {
+    if protected(key) { return denied(); }
+    Ok(())
+}
+
+pub(crate) fn check_generation(key: &KeyDescriptor, level: SecurityLevel,
+                               params: &[KeyParameter]) -> Result<()> {
+    if !protected(key) { return Ok(()); }
+    authorize(key)?;
+    let alias = if key.nspace == NAMESPACE { ALIAS } else { LOCAL_ALIAS };
+    if level != SecurityLevel::TRUSTED_ENVIRONMENT || key.alias.as_deref() != Some(alias) {
+        return denied();
+    }
+    let required = [
+        KeyParameter { tag: Tag::ALGORITHM, value: V::Algorithm(Algorithm::HMAC) },
+        KeyParameter { tag: Tag::KEY_SIZE, value: V::Integer(256) },
+        KeyParameter { tag: Tag::PURPOSE, value: V::KeyPurpose(KeyPurpose::SIGN) },
+        KeyParameter { tag: Tag::DIGEST, value: V::Digest(Digest::SHA_2_256) },
+        KeyParameter { tag: Tag::MIN_MAC_LENGTH, value: V::Integer(256) },
+        KeyParameter { tag: Tag::NO_AUTH_REQUIRED, value: V::BoolValue(true) },
+    ];
+    if params.len() != required.len() || required.iter().any(|p| !params.contains(p)) {
+        return denied();
+    }
+    Ok(())
+}
