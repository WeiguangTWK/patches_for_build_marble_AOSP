+# SPDX-License-Identifier: Apache-2.0
+import unittest
+from dataclasses import replace
+
+from model import Context, LEASE, MAX_TIME, Monitor, consumer_accepts
+
+CTX = Context("a" * 32 + ":" + "b" * 16 + ":1", "c" * 16, False, False)
+
+
+class Renewal(unittest.TestCase):
+    def setUp(self):
+        self.m = Monitor()
+        self.props = {"status": "", "ack": ""}
+        self.m.observe(CTX, 0)
+
+    def write(self, channel, now, *, success=True):
+        self.m.observe(self.m.context, now)
+        d = self.m.plan(channel, self.props[channel])
+        self.assertEqual("WRITE", d.action)
+        if success:
+            self.props[channel] = d.value
+        self.m.finish(d, success, now)
+        return d
+
+    def seed(self):
+        self.write("status", 0)
+        self.write("ack", 0)
+
+    def test_startup_cannot_infer_success_from_existing_value(self):
+        self.assertEqual("WRITE", self.m.plan("status", "anything").action)
+        self.assertEqual("WRITE", self.m.plan("ack", "anything").action)
+
+    def test_margin_boundary_renews_without_extending_consumer_lease(self):
+        self.seed()
+        self.m.observe(CTX, 999)
+        self.assertEqual("SKIP", self.m.plan("status", self.props["status"]).action)
+        self.m.observe(CTX, 1000)
+        d = self.m.plan("status", self.props["status"])
+        self.assertEqual("WRITE", d.action)
+        self.assertEqual(3000, d.deadline)
+
+    def test_stable_denied_state_has_one_write_per_second_per_channel(self):
+        count = dict(status=0, ack=0)
+        for now in range(0, 4000, 250):
+            self.m.observe(CTX, now)
+            for channel in count:
+                d = self.m.plan(channel, self.props[channel])
+                if d.action == "WRITE":
+                    self.props[channel] = d.value
+                    self.assertTrue(self.m.finish(d, True, now))
+                    count[channel] += 1
+                self.assertTrue(consumer_accepts(self.props[channel], CTX.identity,
+                                                CTX.instance, now, stopped=channel == "ack"))
+        self.assertEqual(dict(status=4, ack=4), count)
+
+    def test_each_context_component_forces_both_channels(self):
+        for ctx in (replace(CTX, identity="d" * 32 + ":" + "b" * 16 + ":1"),
+                    replace(CTX, instance="d" * 16), replace(CTX, permitted=True),
+                    replace(CTX, active=True)):
+            with self.subTest(ctx=ctx):
+                self.setUp()
+                self.seed()
+                self.m.observe(ctx, 250)
+                for ch in self.props:
+                    self.assertEqual("WRITE", self.m.plan(ch, self.props[ch]).action)
+
+    def test_active_work_keeps_every_check_status_write(self):
+        ctx = replace(CTX, active=True)
+        for now in range(0, 1500, 250):
+            self.m.observe(ctx, now)
+            self.write("status", now)
+            self.assertEqual("", self.m.plan("ack", self.props["ack"]).value)
+
+    def test_failed_write_retries_next_check(self):
+        self.write("status", 0, success=False)
+        self.m.observe(CTX, 250)
+        self.assertEqual("WRITE", self.m.plan("status", self.props["status"]).action)
+
+    def test_failed_renewal_does_not_keep_old_success_cache(self):
+        self.seed()
+        self.write("status", 1000, success=False)
+        self.assertNotIn("status", self.m.saved)
+        self.assertIn("ack", self.m.saved)
+
+    def test_partial_success_is_not_shared_between_channels(self):
+        self.write("status", 0)
+        self.write("ack", 0, success=False)
+        self.m.observe(CTX, 250)
+        self.assertEqual("SKIP", self.m.plan("status", self.props["status"]).action)
+        self.assertEqual("WRITE", self.m.plan("ack", self.props["ack"]).action)
+
+    def test_replacement_missing_and_read_failure_force_write(self):
+        for actual in ("replaced", "", None):
+            self.setUp()
+            self.seed()
+            self.m.observe(CTX, 250)
+            self.assertEqual("WRITE", self.m.plan("status", actual).action)
+
+    def test_successful_clear_can_be_skipped_but_is_read_back(self):
+        self.m.observe(replace(CTX, permitted=True), 0)
+        self.write("ack", 0)
+        self.m.observe(self.m.context, 250)
+        self.assertEqual("SKIP", self.m.plan("ack", "").action)
+        self.assertEqual("WRITE", self.m.plan("ack", "foreign").action)
+
+    def test_failed_clear_is_never_cached(self):
+        self.m.observe(replace(CTX, permitted=True), 0)
+        self.write("ack", 0, success=False)
+        self.assertEqual("WRITE", self.m.plan("ack", "").action)
+
+    def test_permit_revocation_emits_stop_ack_after_successful_clear(self):
+        self.m.observe(replace(CTX, permitted=True), 0)
+        self.write("ack", 0)
+        self.m.observe(CTX, 250)
+        d = self.m.plan("ack", "")
+        self.assertEqual("WRITE", d.action)
+        self.assertTrue(consumer_accepts(d.value, CTX.identity, CTX.instance, 250, stopped=True))
+
+    def test_stop_ack_is_cleared_on_permit_or_active_change(self):
+        for ctx in (replace(CTX, permitted=True), replace(CTX, active=True)):
+            self.setUp()
+            self.seed()
+            self.m.observe(ctx, 250)
+            d = self.m.plan("ack", self.props["ack"])
+            self.assertEqual(("WRITE", ""), (d.action, d.value))
+
+    def test_active_drain_forces_new_stop_confirmation(self):
+        self.m.observe(replace(CTX, active=True), 0)
+        self.write("ack", 0)
+        self.m.observe(CTX, 250)
+        self.assertNotEqual("", self.m.plan("ack", "").value)
+
+    def test_invalid_policy_discards_success_without_publishing_old_identity(self):
+        self.seed()
+        self.assertFalse(self.m.observe(None, 250))
+        self.assertEqual("UNAVAILABLE", self.m.plan("ack", self.props["ack"]).action)
+        self.m.observe(CTX, 500)
+        self.assertEqual("WRITE", self.m.plan("ack", self.props["ack"]).action)
+
+    def test_suspend_expiry_forces_fresh_write(self):
+        self.seed()
+        self.m.observe(CTX, 10000)
+        self.assertEqual("WRITE", self.m.plan("status", self.props["status"]).action)
+        self.assertFalse(consumer_accepts(self.props["status"], CTX.identity, CTX.instance, 10000))
+
+    def test_clock_fault_cannot_write_future_success_or_recover_silently(self):
+        for bad in (None, -1, True, MAX_TIME, MAX_TIME - LEASE + 1):
+            self.setUp()
+            self.seed()
+            self.assertFalse(self.m.observe(CTX, bad))
+            self.assertEqual("UNAVAILABLE", self.m.plan("status", "").action)
+            self.assertFalse(self.m.observe(CTX, 1000))
+
+    def test_clock_regression_invalidates_both_channels(self):
+        self.seed()
+        self.m.observe(CTX, 500)
+        self.assertFalse(self.m.observe(CTX, 499))
+        self.assertFalse(self.m.saved)
+
+    def test_late_write_success_does_not_create_a_fresh_deadline(self):
+        d = self.m.plan("status", "")
