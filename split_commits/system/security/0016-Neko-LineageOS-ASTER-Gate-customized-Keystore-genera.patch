+// SPDX-License-Identifier: Apache-2.0
+use super::*;
+use std::collections::BTreeMap;
+
+struct Fake {
+    now: u64,
+    state: Option<State>,
+    properties: [Option<String>; 2],
+    fail: [bool; 2],
+    writes: Vec<(Channel, String)>,
+    reads: usize,
+    samples: usize,
+    changes: BTreeMap<usize, Option<State>>,
+    slow: u64,
+}
+
+fn state() -> State {
+    State {
+        identity: format!("{}:{}:1", "a".repeat(32), "b".repeat(16)),
+        permitted: false,
+        active: false,
+    }
+}
+
+impl Fake {
+    fn new() -> Self {
+        Self {
+            now: 0,
+            state: Some(state()),
+            properties: [Some(String::new()), Some(String::new())],
+            fail: [false; 2],
+            writes: vec![],
+            reads: 0,
+            samples: 0,
+            changes: BTreeMap::new(),
+            slow: 0,
+        }
+    }
+    fn at(&mut self, now: u64, m: &mut Monitor) {
+        self.now = now;
+        m.tick(self);
+    }
+    fn count(&self, ch: Channel) -> usize {
+        self.writes.iter().filter(|(channel, _)| *channel == ch).count()
+    }
+}
+
+impl Io for Fake {
+    fn sample(&mut self) -> Option<Sample> {
+        self.samples += 1;
+        if let Some(state) = self.changes.remove(&self.samples) {
+            self.state = state;
+        }
+        self.state.clone().map(|state| Sample { state, now: self.now })
+    }
+    fn read(&mut self, channel: Channel) -> Option<String> {
+        self.reads += 1;
+        self.properties[channel as usize].clone()
+    }
+    fn write(&mut self, channel: Channel, value: &str) -> bool {
+        self.writes.push((channel, value.to_owned()));
+        self.now += self.slow;
+        if self.fail[channel as usize] {
+            return false;
+        }
+        self.properties[channel as usize] = Some(value.to_owned());
+        true
+    }
+}
+
+fn monitor() -> Monitor {
+    Monitor::new("c".repeat(16))
+}
+
+#[test]
+fn stable_denied_renews_each_channel_once_per_second() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    for now in (0..4000).step_by(250) {
+        io.at(now, &mut m);
+    }
+    assert_eq!(io.count(Channel::Status), 4);
+    assert_eq!(io.count(Channel::Ack), 4);
+    assert_eq!(io.reads, 32); // Actual properties are checked even when skipping.
+}
+
+#[test]
+fn exact_margin_renews_and_keeps_two_second_deadline() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.at(0, &mut m);
+    io.at(999, &mut m);
+    assert_eq!(io.writes.len(), 2);
+    io.at(1000, &mut m);
+    assert_eq!(io.writes.len(), 4);
+    assert_eq!(m.saved[0].as_ref().unwrap().deadline, Some(3000));
+}
+
+#[test]
+fn startup_does_not_adopt_preexisting_success() {
+    let mut first = monitor();
+    let mut io = Fake::new();
+    io.at(0, &mut first);
+    let mut restarted = monitor();
+    io.at(250, &mut restarted);
+    assert_eq!(io.writes.len(), 4);
+}
+
+#[test]
+fn failed_status_does_not_suppress_ack_or_retry() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.fail[0] = true;
+    io.at(0, &mut m);
+    assert!(m.saved[0].is_none());
+    assert!(m.saved[1].is_some());
+    io.at(250, &mut m);
+    assert_eq!(io.count(Channel::Status), 2);
+    assert_eq!(io.count(Channel::Ack), 1);
+}
+
+#[test]
+fn failed_ack_does_not_suppress_status_success() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.fail[1] = true;
+    io.at(0, &mut m);
+    io.at(250, &mut m);
+    assert_eq!(io.count(Channel::Status), 1);
+    assert_eq!(io.count(Channel::Ack), 2);
+}
+
+#[test]
+fn failed_renewal_discards_cached_success() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.at(0, &mut m);
+    io.fail[0] = true;
+    io.at(1000, &mut m);
+    assert!(m.saved[0].is_none());
+    io.at(1250, &mut m);
+    assert_eq!(io.count(Channel::Status), 3);
+}
+
+#[test]
+fn replacement_missing_and_read_error_cannot_skip() {
+    for actual in [Some("foreign".to_owned()), Some(String::new()), None] {
+        let mut m = monitor();
+        let mut io = Fake::new();
+        io.at(0, &mut m);
+        io.properties[0] = actual;
+        io.at(250, &mut m);
+        assert_eq!(io.count(Channel::Status), 2);
+    }
+}
+
+#[test]
+fn permit_change_forces_status_and_ack_clear() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.at(0, &mut m);
+    io.state.as_mut().unwrap().permitted = true;
+    io.at(250, &mut m);
+    assert_eq!(io.writes.len(), 4);
+    assert_eq!(io.properties[1].as_deref(), Some(""));
+    io.at(500, &mut m);
+    assert_eq!(io.writes.len(), 4);
+}
+
+#[test]
+fn failed_clear_retries_without_claiming_success() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.at(0, &mut m);
+    io.state.as_mut().unwrap().permitted = true;
+    io.fail[1] = true;
+    io.at(250, &mut m);
+    assert!(m.saved[1].is_none());
+    assert_ne!(io.properties[1].as_deref(), Some(""));
+    io.at(500, &mut m);
+    assert_eq!(io.count(Channel::Ack), 3);
+}
+
+#[test]
+fn replaced_empty_ack_is_cleared_again() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.state.as_mut().unwrap().permitted = true;
+    io.at(0, &mut m);
+    io.properties[1] = Some("foreign".to_owned());
+    io.at(250, &mut m);
+    assert_eq!(io.count(Channel::Ack), 2);
+    assert_eq!(io.properties[1].as_deref(), Some(""));
+}
+
+#[test]
+fn active_status_is_written_each_check_and_drain_reconfirms_stop() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.state.as_mut().unwrap().active = true;
+    for now in (0..1000).step_by(250) {
+        io.at(now, &mut m);
+    }
+    assert_eq!(io.count(Channel::Status), 4);
+    assert_eq!(io.count(Channel::Ack), 1);
+    io.state.as_mut().unwrap().active = false;
+    io.at(1000, &mut m);
+    assert_eq!(io.count(Channel::Status), 5);
+    assert_eq!(io.count(Channel::Ack), 2);
+    assert!(io.properties[1].as_ref().unwrap().ends_with(":0"));
+}
+
+#[test]
+fn invalid_policy_leaves_old_expiry_but_discards_cache() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.at(0, &mut m);
+    let old = io.properties.clone();
+    io.state = None;
+    io.at(250, &mut m);
+    assert_eq!(io.writes.len(), 2);
+    assert_eq!(io.properties, old);
+    assert!(m.saved.iter().all(Option::is_none));
+    io.state = Some(state());
+    io.at(500, &mut m);
+    assert_eq!(io.writes.len(), 4);
+}
+
+#[test]
+fn identity_change_forces_new_records() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.at(0, &mut m);
+    io.state.as_mut().unwrap().identity = "new-validated-identity".to_owned();
+    io.at(250, &mut m);
+    assert_eq!(io.writes.len(), 4);
+    assert!(io.properties.iter().all(|s| s.as_ref().unwrap().starts_with("new-validated")));
+}
+
+#[test]
+fn change_before_write_defers_without_looping() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    let mut changed = state();
+    changed.permitted = true;
+    io.changes.insert(2, Some(changed));
+    io.at(0, &mut m);
+    assert!(io.writes.is_empty());
+    assert_eq!(io.samples, 2);
+    io.at(250, &mut m);
+    assert_eq!(io.writes.len(), 2);
+    assert_eq!(io.properties[1].as_deref(), Some(""));
+}
+
+#[test]
+fn change_after_write_cannot_cache_success_or_publish_stopped_ack() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    let mut changed = state();
+    changed.active = true;
+    io.changes.insert(3, Some(changed));
+    io.at(0, &mut m);
+    assert_eq!(io.writes.len(), 1); // Cannot undo the already written status.
+    assert!(m.saved.iter().all(Option::is_none));
+    assert_eq!(io.samples, 3);
+}
+
+#[test]
+fn change_before_ack_never_reuses_initial_zero_activity() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    let mut changed = state();
+    changed.active = true;
+    io.changes.insert(4, Some(changed));
+    io.at(0, &mut m);
+    assert_eq!(io.count(Channel::Ack), 0);
+    assert!(m.saved.iter().all(Option::is_none));
+}
+
+#[test]
+fn invalid_policy_during_write_does_not_commit_cache() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.changes.insert(3, None);
+    io.at(0, &mut m);
+    assert!(m.saved.iter().all(Option::is_none));
+    assert_eq!(io.count(Channel::Ack), 0);
+}
+
+#[test]
+fn slow_success_cannot_move_deadline_or_skip_expiry() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.slow = LEASE_MS;
+    io.at(0, &mut m);
+    assert!(m.saved.iter().all(Option::is_none));
+    assert!(io.properties[0].as_ref().unwrap().contains(":7d0:"));
+}
+
+#[test]
+fn suspend_expiry_forces_both_writes() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.at(0, &mut m);
+    io.at(10_000, &mut m);
+    assert_eq!(io.writes.len(), 4);
+}
+
+#[test]
+fn regression_and_overflow_fail_closed_until_monitor_restart() {
+    for bad in [499, u64::MAX, MAX_NOW + 1] {
+        let mut m = monitor();
+        let mut io = Fake::new();
+        io.at(500, &mut m);
+        io.at(bad, &mut m);
+        io.at(1000, &mut m);
+        assert_eq!(io.writes.len(), 2);
+        assert!(m.clock_failed);
+        assert!(m.saved.iter().all(Option::is_none));
+    }
+}
+
+#[test]
+fn cached_skip_still_rechecks_policy_after_readback() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.at(0, &mut m);
+    let mut changed = state();
+    changed.permitted = true;
+    io.changes.insert(io.samples + 2, Some(changed));
+    io.at(250, &mut m);
+    assert_eq!(io.writes.len(), 2);
+    assert!(m.saved.iter().all(Option::is_none));
+    io.at(500, &mut m);
+    assert_eq!(io.writes.len(), 4);
+    assert_eq!(io.properties[1].as_deref(), Some(""));
+}
+
+#[test]
+fn changed_instance_never_adopts_old_property() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    io.at(0, &mut m);
+    let mut restarted = Monitor::new("d".repeat(16));
+    io.at(250, &mut restarted);
+    assert_eq!(io.writes.len(), 4);
+    assert!(io.properties[1].as_ref().unwrap().contains(&"d".repeat(16)));
+}
+
+#[test]
+fn change_after_ack_set_discards_both_cached_successes() {
+    let mut m = monitor();
+    let mut io = Fake::new();
+    let mut changed = state();
+    changed.permitted = true;
+    io.changes.insert(5, Some(changed));
+    io.at(0, &mut m);
+    assert_eq!(io.writes.len(), 2); // ACK already set: not an atomic transaction.
+    assert!(m.saved.iter().all(Option::is_none));
+    io.at(250, &mut m);
+    assert_eq!(io.properties[1].as_deref(), Some(""));
+}
