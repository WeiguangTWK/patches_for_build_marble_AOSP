index 0000000..5966351
--- /dev/null
+++ b/keystore2/src/integrity_policy.rs
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Permits apply to new customized generation, never to existing-key operations.
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::Duration;
+use std::io::Read;
+use rustutils::system_properties;
+
+#[path = "integrity_monitor.rs"]
+mod monitor;
+
+static ACTIVE: AtomicUsize = AtomicUsize::new(0);
+const POLICY: &str = "sys.integrity.policy";
+
+pub(crate) fn enabled() -> bool {
+    system_properties::read_bool("ro.platform.integrity.enabled", false).unwrap_or(true)
+}
+
+fn elapsed_ms() -> u64 {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: ts is writable and CLOCK_BOOTTIME is supported by Android kernels.
+    if unsafe { libc::clock_gettime(libc::CLOCK_BOOTTIME, &mut ts) } != 0 { return u64::MAX; }
+    if ts.tv_sec < 0 || !(0..1_000_000_000).contains(&ts.tv_nsec) { return u64::MAX; }
+    (ts.tv_sec as u64).checked_mul(1000)
+        .and_then(|ms| ms.checked_add(ts.tv_nsec as u64 / 1_000_000))
+        .unwrap_or(u64::MAX)
+}
+
+fn current() -> Option<(String, u64, u32)> {
+    let value = system_properties::read(POLICY).ok()??;
+    let fields: Vec<_> = value.split(':').collect();
+    if fields.len() != 5 || fields[0].len() != 32 || fields[1].len() != 16
+        || fields[2].is_empty() || fields[2].len() > 8
+        || fields[3].is_empty() || fields[3].len() > 12 || fields[4].len() != 1
+        || !fields.iter().all(|f| f.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))) {
+        return None;
+    }
+    let deadline = u64::from_str_radix(fields[3], 16).ok()?;
+    let mask = u32::from_str_radix(fields[4], 16).ok()?;
+    if mask > 7 { return None; }
+    Some((fields[..3].join(":"), deadline, mask))
+}
+
+pub(crate) fn permit() -> Option<String> {
+    if !enabled() { return Some("legacy".to_owned()); }
+    let (identity, deadline, mask) = current()?;
+    let now = elapsed_ms();
+    if mask & 1 == 0 || deadline <= now || deadline - now > 5000 { return None; }
+    Some(identity)
+}
+
+pub(crate) struct GenerationGuard(String);
+impl GenerationGuard {
+    pub(crate) fn begin(identity: &str) -> Option<Self> {
+        ACTIVE.fetch_add(1, Ordering::SeqCst);
+        if permit().as_deref() == Some(identity) {
+            Some(Self(identity.to_owned()))
+        } else {
+            ACTIVE.fetch_sub(1, Ordering::SeqCst);
+            None
+        }
+    }
+    pub(crate) fn valid(&self) -> bool { permit().as_deref() == Some(self.0.as_str()) }
+}
+impl Drop for GenerationGuard {
+    fn drop(&mut self) { ACTIVE.fetch_sub(1, Ordering::SeqCst); }
+}
+
+struct MonitorIo;
+impl monitor::Io for MonitorIo {
+    fn sample(&mut self) -> Option<monitor::Sample> {
+        // Identity and permit come from the same parsed policy. A later change
+        // is checked again by the synchronous renewal layer before/after set.
+        let (identity, deadline, mask) = current()?;
+        let active = ACTIVE.load(Ordering::SeqCst) != 0;
+        let now = elapsed_ms();
+        let permitted = mask & 1 != 0 && deadline > now && deadline - now <= 5000;
+        Some(monitor::Sample { state: monitor::State { identity, permitted, active }, now })
+    }
+
+    fn read(&mut self, channel: monitor::Channel) -> Option<String> {
+        system_properties::read(monitor_property(channel)).ok().flatten()
+    }
+
+    fn write(&mut self, channel: monitor::Channel, value: &str) -> bool {
+        system_properties::write(monitor_property(channel), value).is_ok()
+    }
+}
+
+fn monitor_property(channel: monitor::Channel) -> &'static str {
+    match channel {
+        monitor::Channel::Status => "sys.integrity.tee_status",
+        monitor::Channel::Ack => "sys.integrity.tee_ack",
+    }
+}
+
+/// Acknowledges only that customized generation is gated and has drained.
+/// No private application property mappings or historical certificates are recalled.
+pub fn start_monitor() {
+    if !enabled() { return; }
+    std::thread::spawn(|| {
+        // 64 random bits keep the boot/authority/epoch-bound record within PROP_VALUE_MAX.
+        let mut nonce = [0u8; 8];
+        if std::fs::File::open("/dev/urandom")
+            .and_then(|mut file| file.read_exact(&mut nonce)).is_err() { return; }
+        let instance: String = nonce.iter().map(|byte| format!("{:02x}", byte)).collect();
+        let mut renewal = monitor::Monitor::new(instance);
+        let mut io = MonitorIo;
+        loop {
+            renewal.tick(&mut io);
+            std::thread::sleep(Duration::from_millis(250));
+        }
+    });
+}
