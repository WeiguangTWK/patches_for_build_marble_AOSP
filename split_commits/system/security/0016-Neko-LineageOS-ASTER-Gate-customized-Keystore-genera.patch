index 0000000..f8fcbe5
--- /dev/null
+++ b/keystore2/tests/integrity_monitor_model/model.py
@@ -0,0 +1,119 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Host-only proposed renewal model. Not imported by keystore2 production code."""
+from dataclasses import dataclass
+
+LEASE = 2000
+MARGIN = 1000
+MAX_TIME = (1 << 63) - 1
+CHANNELS = ("status", "ack")
+
+
+@dataclass(frozen=True)
+class Context:
+    # Identity parsing and permit validation remain the production caller's job.
+    identity: str
+    instance: str
+    permitted: bool
+    active: bool
+
+
+@dataclass(frozen=True)
+class Decision:
+    channel: str
+    action: str
+    value: str | None
+    deadline: int | None
+    generation: int
+    context: Context | None
+
+
+class Monitor:
+    def __init__(self):
+        self.context = None
+        self.generation = 0
+        self.last_now = -1
+        self.clock_failed = False
+        self.saved = {}
+
+    def observe(self, context, now):
+        """One sampled context; no added polling, alarm or activity guarantee."""
+        valid = (type(now) is int and 0 <= now <= MAX_TIME - LEASE
+                 and now >= self.last_now)
+        if not valid or self.clock_failed:
+            self.clock_failed = True
+            self.saved.clear()
+            self.context = None
+            self.generation += 1
+            return False
+        self.last_now = now
+        if context != self.context or context is None:
+            self.saved.clear()
+            self.generation += 1
+        self.context = context
+        return context is not None
+
+    def plan(self, channel, actual):
+        if channel not in CHANNELS:
+            raise ValueError("unknown property")
+        ctx = self.context
+        def result(action, value=None, deadline=None):
+            return Decision(channel, action, value, deadline, self.generation, ctx)
+        if ctx is None or self.clock_failed:
+            return result("UNAVAILABLE")
+        clearing = channel == "ack" and (ctx.permitted or ctx.active)
+        old = self.saved.get(channel)
+        # None represents a failed actual-property read, never an empty value.
+        if actual is None or old is None or old.value != actual:
+            self.saved.pop(channel, None)
+            old = None
+        if clearing:
+            if old is not None and old.value == "":
+                return result("SKIP", "")
+            return result("WRITE", "")
+        # Preserve existing per-check activity reporting during customized work.
+        if old is not None and not ctx.active:
+            left = old.deadline - self.last_now
+            if MARGIN < left <= LEASE:
+                return result("SKIP", old.value, old.deadline)
+        deadline = self.last_now + LEASE
+        active = int(ctx.active) if channel == "status" else 0
+        value = f"{ctx.identity}:{ctx.instance}:{deadline:x}:{active}"
+        return result("WRITE", value, deadline)
+
+    def finish(self, decision, success, now):
+        """Save only a still-current successful write. No implicit deadline bump.
+
+        Production integration must keep the current single-writer loop. This
+        token rejects stale bookkeeping; it cannot undo an already performed set.
+        """
+        if decision.action != "WRITE":
+            raise ValueError("only actual writes have completion")
+        if not self.observe(self.context, now):
+            return False
+        if (decision.generation != self.generation
+                or decision.context != self.context):
+            return False
+        self.saved.pop(decision.channel, None)
+        if not success:
+            return False
+        if decision.deadline is not None:
+            left = decision.deadline - now
+            if not 0 < left <= LEASE:
+                return False
+        self.saved[decision.channel] = decision
+        return True
+
+
+def consumer_accepts(value, identity, instance, now, *, stopped=False):
+    """Valid-format subset of current Java consumers; not a new wire parser."""
+    if value is None:
+        return False
+    parts = value.split(":")
+    if len(parts) != 6 or ":".join(parts[:3]) != identity or parts[3] != instance:
+        return False
+    if parts[5] not in ("0", "1") or (stopped and parts[5] != "0"):
+        return False
+    try:
+        return 0 < int(parts[4], 16) - now <= LEASE
+    except ValueError:
+        return False
