+        self.assertNotIn("status", self.m.saved)
+
+    def test_changed_context_rejects_old_completion(self):
+        d = self.m.plan("status", "")
+        self.m.observe(replace(CTX, permitted=True), 250)
+        self.assertFalse(self.m.finish(d, True, 250))
+        self.assertNotIn("status", self.m.saved)
+
+    def test_observed_aba_rejects_old_completion(self):
+        d = self.m.plan("ack", "")
+        self.m.observe(replace(CTX, active=True), 250)
+        self.m.observe(CTX, 500)
+        self.assertFalse(self.m.finish(d, True, 500))
+
+    def test_new_monitor_cannot_adopt_previous_instance_success(self):
+        self.seed()
+        other = Monitor()
+        other.observe(replace(CTX, instance="d" * 16), 250)
+        self.assertEqual("WRITE", other.plan("ack", self.props["ack"]).action)
+
+    def test_host_rejects_expired_future_wrong_identity_and_active_ack(self):
+        self.seed()
+        value = self.props["ack"]
+        for now in (-1, LEASE, LEASE + 1):
+            self.assertFalse(consumer_accepts(value, CTX.identity, CTX.instance, now, stopped=True))
+        self.assertFalse(consumer_accepts(value, "wrong", CTX.instance, 0, stopped=True))
+        self.assertFalse(consumer_accepts(value, CTX.identity, "wrong", 0, stopped=True))
+        self.assertFalse(consumer_accepts(value[:-1] + "1", CTX.identity, CTX.instance, 0, stopped=True))
+
+    def test_bad_channel_and_nonwrite_completion_reject(self):
