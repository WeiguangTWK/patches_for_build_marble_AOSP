+// SPDX-License-Identifier: Apache-2.0
+//! Synchronous TEE monitor renewal; no Android dependencies, timers or workers.
+
+pub(super) const LEASE_MS: u64 = 2000;
+const MARGIN_MS: u64 = 1000;
+const MAX_NOW: u64 = i64::MAX as u64 - LEASE_MS;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct State {
+    pub identity: String,
+    pub permitted: bool,
+    pub active: bool,
+}
+
+#[derive(Clone, Debug)]
+pub(super) struct Sample {
+    pub state: State,
+    pub now: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Channel {
+    Status = 0,
+    Ack = 1,
+}
+
+pub(super) trait Io {
+    fn sample(&mut self) -> Option<Sample>;
+    fn read(&mut self, channel: Channel) -> Option<String>;
+    fn write(&mut self, channel: Channel, value: &str) -> bool;
+}
+
+struct Success {
+    value: String,
+    deadline: Option<u64>,
+}
+
+pub(super) struct Monitor {
+    instance: String,
+    state: Option<State>,
+    last_now: Option<u64>,
+    clock_failed: bool,
+    saved: [Option<Success>; 2],
+}
+
+impl Monitor {
+    pub fn new(instance: String) -> Self {
+        Self { instance, state: None, last_now: None, clock_failed: false, saved: [None, None] }
+    }
+
+    fn invalidate(&mut self) {
+        self.saved = [None, None];
+        self.state = None;
+    }
+
+    fn observe(&mut self, sample: Option<Sample>) -> Option<Sample> {
+        let Some(sample) = sample else {
+            self.invalidate();
+            return None;
+        };
+        if self.clock_failed
+            || sample.now > MAX_NOW
+            || self.last_now.is_some_and(|last| sample.now < last)
+        {
+            self.clock_failed = true;
+            self.invalidate();
+            return None;
+        }
+        self.last_now = Some(sample.now);
+        if self.state.as_ref() != Some(&sample.state) {
+            self.saved = [None, None];
+            self.state = Some(sample.state.clone());
+        }
+        Some(sample)
+    }
+
+    // No retry loop: a changed sample defers work to the next regular check.
+    fn recheck(&mut self, io: &mut impl Io, expected: &State) -> Option<Sample> {
+        let sample = self.observe(io.sample())?;
+        if &sample.state != expected {
+            return None;
+        }
+        Some(sample)
+    }
+
+    pub fn tick(&mut self, io: &mut impl Io) {
+        let Some(sample) = self.observe(io.sample()) else { return };
+        for channel in [Channel::Status, Channel::Ack] {
+            if !self.service(io, channel, &sample.state) {
+                return;
+            }
+        }
+    }
+
+    fn service(&mut self, io: &mut impl Io, channel: Channel, expected: &State) -> bool {
+        // Reading actual values prevents adoption of somebody else's success.
+        // The read/recheck/set sequence is not an atomic property transaction.
+        let actual = io.read(channel);
+        let Some(sample) = self.recheck(io, expected) else { return false };
+        let slot = channel as usize;
+        if self.saved[slot].as_ref().map(|s| s.value.as_str()) != actual.as_deref() {
+            self.saved[slot] = None;
+        }
+        let clearing = channel == Channel::Ack && (expected.permitted || expected.active);
+        if let Some(old) = &self.saved[slot] {
+            if clearing && old.value.is_empty() {
+                return true;
+            }
+            if !clearing
+                && !expected.active
+                && old
+                    .deadline
+                    .and_then(|d| d.checked_sub(sample.now))
+                    .is_some_and(|left| left > MARGIN_MS && left <= LEASE_MS)
+            {
+                return true;
+            }
+        }
+        let deadline = if clearing { None } else { Some(sample.now + LEASE_MS) };
+        let value = match deadline {
+            None => String::new(),
+            Some(deadline) => format!(
+                "{}:{}:{:x}:{}",
+                expected.identity,
+                self.instance,
+                deadline,
+                u8::from(expected.active)
+            ),
+        };
+        self.saved[slot] = None;
+        let success = io.write(channel, &value);
+        let Some(after) = self.recheck(io, expected) else { return false };
+        // Never move the deadline to the return time of a slow property set.
+        if success && deadline.is_none_or(|d| d > after.now && d - after.now <= LEASE_MS) {
+            self.saved[slot] = Some(Success { value, deadline });
+        }
+        true
+    }
+}
+
+#[cfg(test)]
+#[path = "integrity_monitor_tests.rs"]
+mod tests;
