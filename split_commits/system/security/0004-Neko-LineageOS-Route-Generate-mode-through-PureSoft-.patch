+++ b/keystore2/src/km_compat/km_compat.cpp
@@ -40,6 +40,7 @@ using ::aidl::android::hardware::security::keymint::CreateKeyMintDevice;
 using ::aidl::android::hardware::security::keymint::Digest;
 using ::aidl::android::hardware::security::keymint::KeyParameterValue;
 using ::aidl::android::hardware::security::keymint::PaddingMode;
+using ::aidl::android::hardware::security::keymint::PureSoftBootMode;
 using ::aidl::android::hardware::security::keymint::Tag;
 using ::android::hardware::hidl_vec;
 using ::android::hardware::keymaster::V4_0::TagType;
@@ -1537,6 +1538,23 @@ std::shared_ptr<IKeyMintDevice> getSoftwareKeymintDevice() {
     return swDevice;
 }
 
+std::shared_ptr<IKeyMintDevice> getTeeSoftKeymintDevice() {
+    static std::mutex mutex;
+    static std::shared_ptr<IKeyMintDevice> teeSoftDevice;
+    std::lock_guard<std::mutex> lock(mutex);
+    if (!teeSoftDevice) {
+        // Keep this device behind a dedicated internal selector. Keystore assigns its generated
+        // blobs the distinct SOFTWARE routing UUID, while the implementation deliberately uses
+        // the pure-software TEE persona for self-consistent attestation records,
+        // KeyCharacteristics and KeyInfo. Its attestation boot state is an explicit part of this
+        // internal persona rather than a snapshot of runtime-spoofed boot properties. Genuine
+        // /default TEE remains independently selected.
+        teeSoftDevice = CreateKeyMintDevice(KeyMintSecurityLevel::TRUSTED_ENVIRONMENT,
+                                            PureSoftBootMode::VERIFIED_LOCKED);
+    }
+    return teeSoftDevice;
+}
+
 std::shared_ptr<KeyMintDevice>
 KeyMintDevice::getWrappedKeymasterDevice(KeyMintSecurityLevel securityLevel) {
     if (auto dev = getDevice(securityLevel)) {
@@ -1549,6 +1567,8 @@ std::shared_ptr<IKeyMintDevice>
 KeyMintDevice::createKeyMintDevice(KeyMintSecurityLevel securityLevel) {
     if (securityLevel == KeyMintSecurityLevel::SOFTWARE) {
         return getSoftwareKeymintDevice();
+    } else if (securityLevel == KeyMintSecurityLevel::KEYSTORE) {
+        return getTeeSoftKeymintDevice();
     } else {
         return getWrappedKeymasterDevice(securityLevel);
     }
