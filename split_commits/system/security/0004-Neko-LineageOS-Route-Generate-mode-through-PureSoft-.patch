+    if has_external_attestation_key && uses_tracked_attest_key && used_software_generation {
+        // The SOFTWARE KeyMint generated this leaf with the private half of the selected
+        // ATTEST_KEY.  Keep that signature intact: callers construct the effective chain as
+        // `generated leaf + ATTEST_KEY certificate + ATTEST_KEY certificateChain`.  Re-signing
