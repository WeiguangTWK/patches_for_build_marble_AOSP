 keystore2/src/globals.rs                      | 10 +++-
 keystore2/src/km_compat/km_compat.cpp         | 20 ++++++++
 keystore2/src/km_compat/tests.rs              | 17 ++++++-
 keystore2/src/security_level.rs               | 15 ++++--
 keystore2/src/service.rs                      | 48 +++++++++----------
