+fn test_tee_soft_internal_device_reports_tee() {
+    ensure_compat_service_started();
+
+    let compat_service: Strong<dyn IKeystoreCompatService> =
+        binder::get_interface(COMPAT_NAME).expect("Failed to get compat service");
