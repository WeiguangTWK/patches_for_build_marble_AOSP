                 .context(ks_err!("Trying to connect to compat service."))?;
+        // Keep the platform SOFTWARE compat device untouched for back-level KeyMint emulation.
+        // KEYSTORE is an internal selector for the separate pure-software TEE persona; the cache
+        // and key-blob routing UUID remain SOFTWARE so this device cannot replace genuine TEE.
+        let compat_selector = if *security_level == SecurityLevel::SOFTWARE {
+            SecurityLevel::KEYSTORE
+        } else {
+            *security_level
+        };
         let km =
-            map_binder_status(keystore_compat_service.getKeyMintDevice(*security_level))
