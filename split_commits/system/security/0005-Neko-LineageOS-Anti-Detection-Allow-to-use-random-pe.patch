+#ifndef KEYSTORE2_TEE_SOFT_BOOT_IDENTITY_H_
+#define KEYSTORE2_TEE_SOFT_BOOT_IDENTITY_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+static constexpr size_t TEE_SOFT_BOOT_IDENTITY_SIZE = 32;
+static constexpr const char* TEE_SOFT_BOOT_IDENTITY_PATH =
+    "/data/misc/keystore/tee_soft_boot_identity.v1";
+
+// Load the persistent per-device fallback identity used by TEE Soft Emu, creating it atomically
+// with cryptographically random values when it does not exist. Existing malformed, insecurely
+// permissioned, or unreadable files are rejected rather than silently rotating the identity.
+bool loadOrCreateTeeSoftBootIdentityAtPath(const char* path, uint8_t* out_boot_key,
+                                           size_t out_boot_key_len, uint8_t* out_boot_hash,
+                                           size_t out_boot_hash_len);
+
+// Process-cached form of loadOrCreateTeeSoftBootIdentityAtPath() for the production location.
+bool getTeeSoftBootIdentity(uint8_t* out_boot_key, size_t out_boot_key_len, uint8_t* out_boot_hash,
+                            size_t out_boot_hash_len);
+
+#endif  // KEYSTORE2_TEE_SOFT_BOOT_IDENTITY_H_
