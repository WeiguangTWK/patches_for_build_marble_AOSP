+bool loadOrCreateTeeSoftBootIdentityAtPath(const char* path, uint8_t* out_boot_key,
+                                           size_t out_boot_key_len, uint8_t* out_boot_hash,
+                                           size_t out_boot_hash_len) {
+    if (path == nullptr || path[0] == '\0' || out_boot_key == nullptr || out_boot_hash == nullptr ||
+        out_boot_key_len != TEE_SOFT_BOOT_IDENTITY_SIZE ||
+        out_boot_hash_len != TEE_SOFT_BOOT_IDENTITY_SIZE) {
+        errno = EINVAL;
+        return false;
+    }
+
+    std::lock_guard<std::mutex> lock(teeSoftIdentityIoMutex());
+    TeeSoftBootIdentity identity = {};
+    if (!readIdentityFile(path, &identity)) {
+        if (errno != ENOENT || !createIdentityFile(path, &identity)) {
+            return false;
+        }
+    }
+    std::copy(identity.boot_key.begin(), identity.boot_key.end(), out_boot_key);
+    std::copy(identity.boot_hash.begin(), identity.boot_hash.end(), out_boot_hash);
+    return true;
+}
+
+bool getTeeSoftBootIdentity(uint8_t* out_boot_key, size_t out_boot_key_len, uint8_t* out_boot_hash,
+                            size_t out_boot_hash_len) {
+    if (out_boot_key == nullptr || out_boot_hash == nullptr ||
+        out_boot_key_len != TEE_SOFT_BOOT_IDENTITY_SIZE ||
+        out_boot_hash_len != TEE_SOFT_BOOT_IDENTITY_SIZE) {
+        errno = EINVAL;
+        return false;
+    }
+
+    static std::mutex cache_mutex;
+    static std::optional<TeeSoftBootIdentity> cached_identity;
+    std::lock_guard<std::mutex> lock(cache_mutex);
+    if (!cached_identity.has_value()) {
+        TeeSoftBootIdentity identity = {};
+        if (!loadOrCreateTeeSoftBootIdentityAtPath(
+                TEE_SOFT_BOOT_IDENTITY_PATH, identity.boot_key.data(), identity.boot_key.size(),
+                identity.boot_hash.data(), identity.boot_hash.size())) {
+            return false;
+        }
+        cached_identity = identity;
+    }
+    std::copy(cached_identity->boot_key.begin(), cached_identity->boot_key.end(), out_boot_key);
+    std::copy(cached_identity->boot_hash.begin(), cached_identity->boot_hash.end(), out_boot_hash);
+    return true;
+}
