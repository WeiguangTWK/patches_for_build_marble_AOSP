@@ -44,6 +59,138 @@
 constexpr size_t kGcmTagLength = 128 / 8;
 constexpr size_t kAes128KeySizeBytes = 128 / 8;
 
+namespace {
+
+constexpr std::array<uint8_t, 8> kTeeSoftIdentityMagic = {'T', 'S', 'B', 'I', 0, 0, 0, 1};
+constexpr size_t kTeeSoftIdentityPayloadSize =
+    kTeeSoftIdentityMagic.size() + 2 * TEE_SOFT_BOOT_IDENTITY_SIZE;
+constexpr size_t kTeeSoftIdentityFileSize = kTeeSoftIdentityPayloadSize + SHA256_DIGEST_LENGTH;
+
+struct TeeSoftBootIdentity {
+    std::array<uint8_t, TEE_SOFT_BOOT_IDENTITY_SIZE> boot_key;
+    std::array<uint8_t, TEE_SOFT_BOOT_IDENTITY_SIZE> boot_hash;
+};
+
+std::mutex& teeSoftIdentityIoMutex() {
+    static std::mutex mutex;
+    return mutex;
+}
+
+bool writeFully(int fd, const uint8_t* data, size_t size) {
+    while (size > 0) {
+        const ssize_t written = TEMP_FAILURE_RETRY(write(fd, data, size));
+        if (written <= 0) return false;
+        data += written;
+        size -= static_cast<size_t>(written);
+    }
+    return true;
+}
+
+bool readIdentityFile(const char* path, TeeSoftBootIdentity* identity) {
+    int fd = TEMP_FAILURE_RETRY(open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW));
+    if (fd < 0) return false;
+
+    struct stat st = {};
+    if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) || st.st_uid != geteuid() ||
+        (st.st_mode & 0077) != 0 || st.st_size != static_cast<off_t>(kTeeSoftIdentityFileSize)) {
+        ALOGE("TEE Soft boot identity has invalid owner, mode, type, or size: %s", path);
+        close(fd);
+        errno = EINVAL;
+        return false;
+    }
+
+    std::array<uint8_t, kTeeSoftIdentityFileSize> encoded = {};
+    size_t offset = 0;
+    while (offset < encoded.size()) {
+        const ssize_t count =
+            TEMP_FAILURE_RETRY(read(fd, encoded.data() + offset, encoded.size() - offset));
+        if (count <= 0) {
+            close(fd);
+            errno = EIO;
+            return false;
+        }
+        offset += static_cast<size_t>(count);
+    }
+    uint8_t extra = 0;
+    const ssize_t trailing = TEMP_FAILURE_RETRY(read(fd, &extra, sizeof(extra)));
+    close(fd);
+    if (trailing != 0 ||
+        !std::equal(kTeeSoftIdentityMagic.begin(), kTeeSoftIdentityMagic.end(), encoded.begin())) {
+        ALOGE("TEE Soft boot identity has invalid framing: %s", path);
+        errno = EINVAL;
+        return false;
+    }
+
+    std::array<uint8_t, SHA256_DIGEST_LENGTH> digest = {};
+    if (SHA256(encoded.data(), kTeeSoftIdentityPayloadSize, digest.data()) == nullptr ||
+        CRYPTO_memcmp(digest.data(), encoded.data() + kTeeSoftIdentityPayloadSize, digest.size()) !=
+            0) {
+        ALOGE("TEE Soft boot identity checksum mismatch: %s", path);
+        errno = EINVAL;
+        return false;
+    }
+
+    auto cursor = encoded.begin() + kTeeSoftIdentityMagic.size();
+    std::copy_n(cursor, identity->boot_key.size(), identity->boot_key.begin());
+    cursor += identity->boot_key.size();
+    std::copy_n(cursor, identity->boot_hash.size(), identity->boot_hash.begin());
+    return true;
+}
+
+bool fsyncParentDirectory(const char* path) {
+    const std::string path_string(path);
+    const size_t slash = path_string.rfind('/');
+    const std::string parent = slash == std::string::npos ? "." : path_string.substr(0, slash);
+    int fd = TEMP_FAILURE_RETRY(open(parent.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+    if (fd < 0) return false;
+    const bool ok = TEMP_FAILURE_RETRY(fsync(fd)) == 0;
+    close(fd);
+    return ok;
+}
+
+bool createIdentityFile(const char* path, TeeSoftBootIdentity* identity) {
+    do {
+        if (RAND_bytes(identity->boot_key.data(), identity->boot_key.size()) != 1 ||
+            RAND_bytes(identity->boot_hash.data(), identity->boot_hash.size()) != 1) {
+            ALOGE("Failed to generate TEE Soft boot identity");
+            return false;
+        }
+    } while (std::all_of(identity->boot_key.begin(), identity->boot_key.end(),
+                         [](uint8_t value) { return value == 0; }) ||
+             std::all_of(identity->boot_hash.begin(), identity->boot_hash.end(),
+                         [](uint8_t value) { return value == 0; }));
+
+    std::array<uint8_t, kTeeSoftIdentityFileSize> encoded = {};
+    auto cursor =
+        std::copy(kTeeSoftIdentityMagic.begin(), kTeeSoftIdentityMagic.end(), encoded.begin());
+    cursor = std::copy(identity->boot_key.begin(), identity->boot_key.end(), cursor);
+    std::copy(identity->boot_hash.begin(), identity->boot_hash.end(), cursor);
+    if (SHA256(encoded.data(), kTeeSoftIdentityPayloadSize,
+               encoded.data() + kTeeSoftIdentityPayloadSize) == nullptr) {
+        return false;
+    }
+
+    std::string temp_template = std::string(path) + ".tmp.XXXXXX";
+    std::vector<char> temp_path(temp_template.begin(), temp_template.end());
+    temp_path.push_back('\0');
+    int fd = mkstemp(temp_path.data());
+    if (fd < 0) return false;
+    (void)fcntl(fd, F_SETFD, FD_CLOEXEC);
+
+    bool ok = fchmod(fd, 0600) == 0 && writeFully(fd, encoded.data(), encoded.size()) &&
+              TEMP_FAILURE_RETRY(fsync(fd)) == 0;
+    if (close(fd) != 0) ok = false;
+    if (ok && rename(temp_path.data(), path) == 0) {
+        ok = fsyncParentDirectory(path);
+    } else {
+        ok = false;
+    }
+    if (!ok) unlink(temp_path.data());
+    return ok;
+}
+
