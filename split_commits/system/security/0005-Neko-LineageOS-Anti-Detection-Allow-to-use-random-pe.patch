+#include "tee_soft_boot_identity.h"
+
+#include <android-base/file.h>
+#include <fcntl.h>
+#include <gtest/gtest.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <array>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+
+using IdentityPart = std::array<uint8_t, TEE_SOFT_BOOT_IDENTITY_SIZE>;
+
+bool allZero(const IdentityPart& value) {
+    return std::all_of(value.begin(), value.end(), [](uint8_t byte) { return byte == 0; });
+}
+
+std::string identityPath(const android::base::TemporaryDir& dir) {
+    return std::string(dir.path) + "/tee_soft_boot_identity.v1";
+}
+
+TEST(TeeSoftBootIdentityTest, CreatesPrivateStableRandomIdentity) {
+    android::base::TemporaryDir dir;
+    const std::string path = identityPath(dir);
+
+    IdentityPart first_key = {};
+    IdentityPart first_hash = {};
+    ASSERT_TRUE(loadOrCreateTeeSoftBootIdentityAtPath(
+        path.c_str(), first_key.data(), first_key.size(), first_hash.data(), first_hash.size()));
+    EXPECT_FALSE(allZero(first_key));
+    EXPECT_FALSE(allZero(first_hash));
+    EXPECT_NE(first_key, first_hash);
+
+    IdentityPart second_key = {};
+    IdentityPart second_hash = {};
+    ASSERT_TRUE(loadOrCreateTeeSoftBootIdentityAtPath(path.c_str(), second_key.data(),
+                                                      second_key.size(), second_hash.data(),
+                                                      second_hash.size()));
+    EXPECT_EQ(first_key, second_key);
+    EXPECT_EQ(first_hash, second_hash);
+
+    struct stat st = {};
+    ASSERT_EQ(0, stat(path.c_str(), &st));
+    EXPECT_EQ(0, st.st_mode & 0077);
+    EXPECT_TRUE(S_ISREG(st.st_mode));
+}
+
+TEST(TeeSoftBootIdentityTest, RejectsCorruptionWithoutRotatingIdentity) {
+    android::base::TemporaryDir dir;
+    const std::string path = identityPath(dir);
+
+    IdentityPart original_key = {};
+    IdentityPart original_hash = {};
+    ASSERT_TRUE(loadOrCreateTeeSoftBootIdentityAtPath(path.c_str(), original_key.data(),
+                                                      original_key.size(), original_hash.data(),
+                                                      original_hash.size()));
+
+    int fd = open(path.c_str(), O_WRONLY | O_CLOEXEC);
+    ASSERT_GE(fd, 0);
+    const uint8_t corrupt = 0xff;
+    ASSERT_EQ(1, pwrite(fd, &corrupt, sizeof(corrupt), 12));
+    ASSERT_EQ(0, close(fd));
+
+    IdentityPart output_key = {};
+    IdentityPart output_hash = {};
+    EXPECT_FALSE(loadOrCreateTeeSoftBootIdentityAtPath(path.c_str(), output_key.data(),
+                                                       output_key.size(), output_hash.data(),
+                                                       output_hash.size()));
+    EXPECT_TRUE(allZero(output_key));
+    EXPECT_TRUE(allZero(output_hash));
+}
+
+TEST(TeeSoftBootIdentityTest, ConcurrentInitializationReturnsOneIdentity) {
+    android::base::TemporaryDir dir;
+    const std::string path = identityPath(dir);
+    constexpr size_t kThreadCount = 8;
+    std::array<IdentityPart, kThreadCount> keys = {};
+    std::array<IdentityPart, kThreadCount> hashes = {};
+    std::array<bool, kThreadCount> results = {};
+    std::vector<std::thread> threads;
+
+    for (size_t i = 0; i < kThreadCount; ++i) {
+        threads.emplace_back([&, i]() {
+            results[i] = loadOrCreateTeeSoftBootIdentityAtPath(
+                path.c_str(), keys[i].data(), keys[i].size(), hashes[i].data(), hashes[i].size());
+        });
+    }
+    for (auto& thread : threads)
+        thread.join();
+
+    for (size_t i = 0; i < kThreadCount; ++i) {
+        EXPECT_TRUE(results[i]);
+        EXPECT_EQ(keys[0], keys[i]);
+        EXPECT_EQ(hashes[0], hashes[i]);
+    }
+}
+
+TEST(TeeSoftBootIdentityTest, RejectsInsecureFileMode) {
+    android::base::TemporaryDir dir;
+    const std::string path = identityPath(dir);
+
+    IdentityPart key = {};
+    IdentityPart hash = {};
+    ASSERT_TRUE(loadOrCreateTeeSoftBootIdentityAtPath(path.c_str(), key.data(), key.size(),
+                                                      hash.data(), hash.size()));
+    ASSERT_EQ(0, chmod(path.c_str(), 0644));
+
+    EXPECT_FALSE(loadOrCreateTeeSoftBootIdentityAtPath(path.c_str(), key.data(), key.size(),
+                                                       hash.data(), hash.size()));
+}
+
+TEST(TeeSoftBootIdentityTest, RejectsInvalidOutputSizes) {
+    android::base::TemporaryDir dir;
+    const std::string path = identityPath(dir);
+    IdentityPart key = {};
+    IdentityPart hash = {};
+
+    EXPECT_FALSE(loadOrCreateTeeSoftBootIdentityAtPath(path.c_str(), key.data(), key.size() - 1,
+                                                       hash.data(), hash.size()));
+    EXPECT_EQ(-1, access(path.c_str(), F_OK));
+}
+
+}  // namespace
