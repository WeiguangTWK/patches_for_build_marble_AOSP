+/// ATTEST_KEY creation commonly omits ATTESTATION_CHALLENGE, but its returned certificate and
+/// signer state still have to enter the same virtualized chain lifecycle as challenged keys.
+pub(crate) fn should_process_attestation_response(params: &[KeyParameter]) -> bool {
+    has_attestation_challenge(params) || is_attest_key_request(params)
+}
+
 fn has_attestation_challenge(params: &[KeyParameter]) -> bool {
     params.iter().any(|p| p.tag == Tag::ATTESTATION_CHALLENGE)
 }
@@ -1248,6 +1254,41 @@ fn select_best_chain(
