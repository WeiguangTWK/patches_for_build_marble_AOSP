 }
 
+/// Select a complete native keybox identity for an ATTEST_KEY whose original self-signed
+/// certificate has no attestation extension. Such a certificate cannot be passed through the
+/// normal RootOfTrust patch-and-resign candidate path, but the virtual ATTEST_KEY response will be
+/// replaced by this native chain and its matching private signer material.
+fn select_native_attest_key_chain(
+    original_leaf: &[u8],
+    materials: &[KeyboxMaterial],
+    forced_algorithm_family: Option<&'static str>,
+) -> Option<(Vec<Vec<u8>>, Option<String>, Option<String>)> {
+    let preferred_family =
+        forced_algorithm_family.or_else(|| certificate_public_key_family(original_leaf));
+    let (_, score, chain, algorithm, material_id) = materials
+        .iter()
+        .filter(|material| !material.certs.is_empty() && material.signing_key.is_some())
+        .filter_map(|material| {
+            let chain = material.certs.clone();
+            validate_chain_for_keyattestation(&chain).ok()?;
+            validate_chain_in_keyattestation_view(&chain).ok()?;
+            let family = normalize_algorithm_family(material.algorithm.as_deref());
+            Some((
+                preferred_family.is_some() && preferred_family == family,
+                chain_transition_score(&chain),
+                chain,
+                material.algorithm.clone(),
+                Some(material_id(material)),
+            ))
+        })
+        .min_by_key(|(family_match, score, ..)| (!*family_match, *score))?;
+    info!(
+        "tee soft debug: selected native ATTEST_KEY identity score={}, preferred_family={:?}, algorithm={:?}",
+        score, preferred_family, algorithm
+    );
+    Some((chain, algorithm, material_id))
+}
+
 fn parse_keybox_material_legacy(xml: &str) -> Result<KeyboxMaterial> {
     let mut certs = Vec::new();
     for cert_text in extract_tag_values(xml, "Certificate") {
