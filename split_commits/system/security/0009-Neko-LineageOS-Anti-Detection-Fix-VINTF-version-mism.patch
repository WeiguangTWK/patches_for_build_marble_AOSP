diff --git a/keystore2/src/km_compat/km_compat.cpp b/keystore2/src/km_compat/km_compat.cpp
index e2bc218..4ee5fc0 100644
--- a/keystore2/src/km_compat/km_compat.cpp
+++ b/keystore2/src/km_compat/km_compat.cpp
@@ -55,6 +55,7 @@ using V4_0_VerificationToken = ::android::hardware::keymaster::V4_0::Verificatio
 namespace V4_0 = ::android::hardware::keymaster::V4_0;
 namespace V4_1 = ::android::hardware::keymaster::V4_1;
 namespace KMV1 = ::aidl::android::hardware::security::keymint;
+using ::keymaster::KmVersion;
 
 using namespace std::chrono_literals;
 using std::chrono::duration_cast;
@@ -488,10 +489,10 @@ ScopedAStatus KeyMintDevice::generateKey(const std::vector<KeyParameter>& inKeyP
     KMV1::ErrorCode errorCode;
 
     for (const auto& keyParam : inKeyParams) {
-        if((int32_t)keyParam.tag==(int32_t)KM_TAG_FBE_ICE) {
+        if ((int32_t)keyParam.tag == (int32_t)KM_TAG_FBE_ICE) {
             android::hardware::keymaster::V4_0::KeyParameter param1;
-            param1.tag = static_cast<::android::hardware::keymaster::V4_0::Tag>
-			(android::hardware::keymaster::V4_0::KM_TAG_FBE_ICE);
+            param1.tag = static_cast<::android::hardware::keymaster::V4_0::Tag>(
+                android::hardware::keymaster::V4_0::KM_TAG_FBE_ICE);
             param1.f.boolValue = true;
             legacyKeyGenParams.push_back(param1);
             break;
@@ -1539,11 +1540,37 @@ std::shared_ptr<IKeyMintDevice> getSoftwareKeymintDevice() {
     return swDevice;
 }
 
-std::shared_ptr<IKeyMintDevice> getTeeSoftKeymintDevice() {
+std::optional<KmVersion> teeSoftKeyMintVersion(int32_t version) {
+    switch (version) {
+    case 30:
+        return KmVersion::KEYMASTER_3;
+    case 40:
+        return KmVersion::KEYMASTER_4;
+    case 41:
+        return KmVersion::KEYMASTER_4_1;
+    case 100:
+        return KmVersion::KEYMINT_1;
+    case 200:
+        return KmVersion::KEYMINT_2;
+    case 300:
+        return KmVersion::KEYMINT_3;
+    case 400:
+        return KmVersion::KEYMINT_4;
+    default:
+        return std::nullopt;
+    }
+}
+
+std::shared_ptr<IKeyMintDevice> getTeeSoftKeymintDevice(int32_t keyMintVersion) {
     static std::mutex mutex;
     static std::shared_ptr<IKeyMintDevice> teeSoftDevice;
     std::lock_guard<std::mutex> lock(mutex);
     if (!teeSoftDevice) {
+        const auto version = teeSoftKeyMintVersion(keyMintVersion);
+        if (!version) {
+            LOG(ERROR) << "Unsupported TEE Soft KeyMint persona version " << keyMintVersion;
+            return {};
+        }
         // Keep this device behind a dedicated internal selector. Keystore assigns its generated
         // blobs the distinct SOFTWARE routing UUID, while the implementation deliberately uses
         // the pure-software TEE persona for self-consistent attestation records,
@@ -1560,7 +1587,7 @@ std::shared_ptr<IKeyMintDevice> getTeeSoftKeymintDevice() {
         teeSoftDevice = CreateKeyMintDevice(
             KeyMintSecurityLevel::TRUSTED_ENVIRONMENT, PureSoftBootMode::VERIFIED_LOCKED,
             std::vector<uint8_t>(fallbackBootKey.begin(), fallbackBootKey.end()),
-            std::vector<uint8_t>(fallbackBootHash.begin(), fallbackBootHash.end()));
+            std::vector<uint8_t>(fallbackBootHash.begin(), fallbackBootHash.end()), *version);
     }
     return teeSoftDevice;
 }
@@ -1574,11 +1601,11 @@ KeyMintDevice::getWrappedKeymasterDevice(KeyMintSecurityLevel securityLevel) {
 }
 
 std::shared_ptr<IKeyMintDevice>
-KeyMintDevice::createKeyMintDevice(KeyMintSecurityLevel securityLevel) {
+KeyMintDevice::createKeyMintDevice(KeyMintSecurityLevel securityLevel, int32_t keyMintVersion) {
     if (securityLevel == KeyMintSecurityLevel::SOFTWARE) {
         return getSoftwareKeymintDevice();
     } else if (securityLevel == KeyMintSecurityLevel::KEYSTORE) {
-        return getTeeSoftKeymintDevice();
+        return getTeeSoftKeymintDevice(keyMintVersion);
     } else {
         return getWrappedKeymasterDevice(securityLevel);
     }
@@ -1602,12 +1629,25 @@ std::shared_ptr<SecureClock> SecureClock::createSecureClock(KeyMintSecurityLevel
 
 ScopedAStatus
 KeystoreCompatService::getKeyMintDevice(KeyMintSecurityLevel in_securityLevel,
+                                        int32_t in_keyMintVersion,
                                         std::shared_ptr<IKeyMintDevice>* _aidl_return) {
-    LOG(INFO) << "KeystoreCompatService::getKeyMintDevice(" << toString(in_securityLevel) << ")";
+    LOG(INFO) << "KeystoreCompatService::getKeyMintDevice(" << toString(in_securityLevel)
+              << ", version=" << in_keyMintVersion << ")";
+    if (in_securityLevel == KeyMintSecurityLevel::KEYSTORE) {
+        if (!teeSoftKeyMintVersion(in_keyMintVersion)) {
+            return ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+        }
+        if (mTeeSoftKeyMintVersion && *mTeeSoftKeyMintVersion != in_keyMintVersion) {
+            LOG(ERROR) << "TEE Soft KeyMint persona version changed from "
+                       << *mTeeSoftKeyMintVersion << " to " << in_keyMintVersion;
+            return ScopedAStatus::fromExceptionCode(EX_ILLEGAL_STATE);
+        }
+        mTeeSoftKeyMintVersion = in_keyMintVersion;
+    }
     auto i = mDeviceCache.find(in_securityLevel);
     if (i == mDeviceCache.end()) {
         LOG(INFO) << "createMintDevice(" << toString(in_securityLevel) << ")";
-        auto device = KeyMintDevice::createKeyMintDevice(in_securityLevel);
+        auto device = KeyMintDevice::createKeyMintDevice(in_securityLevel, in_keyMintVersion);
         if (!device) {
             LOG(INFO) << "failed to create compat KeyMint device for "
                       << toString(in_securityLevel);
diff --git a/keystore2/src/km_compat/km_compat.h b/keystore2/src/km_compat/km_compat.h
