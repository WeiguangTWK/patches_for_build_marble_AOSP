From 0265d347a6ace131c2e8ad8654c230572e5148b4 Mon Sep 17 00:00:00 2001
From: WeiguangTWK <weiguangtwk@outlook.com>
Date: Sun, 16 Aug 2026 08:34:10 +0800
Subject: [PATCH] Neko LineageOS: [Anti Detection] Fix VINTF version mismatch
 in Generate mode

In generate mode in previous release of TEE Soft Emu, it will report Keymint 4.0 when actual HW Keymint ver is 1.0,
causing detection (e.g. Duck Detector)

Change-Id: I891601ae265b3414e05b113c172aedf5539bafec
---
 .../compat/IKeystoreCompatService.aidl        |  5 +-
 keystore2/src/globals.rs                      | 52 ++++++++++++-----
 keystore2/src/km_compat.rs                    |  2 +-
 keystore2/src/km_compat/certificate_test.cpp  |  2 +-
 keystore2/src/km_compat/km_compat.cpp         | 58 ++++++++++++++++---
 keystore2/src/km_compat/km_compat.h           |  6 +-
 keystore2/src/km_compat/tests.rs              |  6 +-
 7 files changed, 97 insertions(+), 34 deletions(-)

diff --git a/keystore2/aidl/android/security/compat/IKeystoreCompatService.aidl b/keystore2/aidl/android/security/compat/IKeystoreCompatService.aidl
index 06fb54b..b51d061 100644
--- a/keystore2/aidl/android/security/compat/IKeystoreCompatService.aidl
+++ b/keystore2/aidl/android/security/compat/IKeystoreCompatService.aidl
@@ -42,9 +42,10 @@ interface IKeystoreCompatService {
      *   supports the current version of the IKeyMintDevice interface.
      * - KEYSTORE: an internal-only selector for the pure-software TEE persona used by TEE Soft
      *   Emu. The returned device reports TRUSTED_ENVIRONMENT; KEYSTORE is never returned as a
-     *   device security level.
+     *   device security level. keyMintVersion selects the genuine TEE version this persona must
+     *   reproduce. It is ignored for the other selectors.
      */
-    IKeyMintDevice getKeyMintDevice (SecurityLevel securityLevel);
+    IKeyMintDevice getKeyMintDevice (SecurityLevel securityLevel, int keyMintVersion);
 
     /**
      * Returns an implementation of ISecureClock, that is implemented by Keystore 2.0 itself
diff --git a/keystore2/src/globals.rs b/keystore2/src/globals.rs
index a2f5d12..253441b 100644
--- a/keystore2/src/globals.rs
+++ b/keystore2/src/globals.rs
@@ -229,6 +229,7 @@ fn keymint_service_name(security_level: &SecurityLevel) -> Result<Option<String>
 /// up the compatibility service and attempts to connect to the legacy wrapper.
 fn connect_keymint(
     security_level: &SecurityLevel,
+    tee_soft_keymint_version: Option<i32>,
 ) -> Result<(Strong<dyn IKeyMintDevice>, KeyMintHardwareInfo)> {
     // Show the keymint interface that is registered in the binder
     // service and use the security level to get the service name.
@@ -268,19 +269,21 @@ fn connect_keymint(
         } else {
             *security_level
         };
-        let km =
-            map_binder_status(keystore_compat_service.getKeyMintDevice(compat_selector))
-                .map_err(|e| match e {
-                    Error::BinderTransaction(StatusCode::NAME_NOT_FOUND) => {
-                        Error::Km(ErrorCode::HARDWARE_TYPE_UNAVAILABLE)
-                    }
-                    e => e,
-                })
-                .context(ks_err!(
-                    "Trying to get Legacy wrapper. Attempt to get keystore \
+        let km = map_binder_status(
+            keystore_compat_service
+                .getKeyMintDevice(compat_selector, tee_soft_keymint_version.unwrap_or_default()),
+        )
+        .map_err(|e| match e {
+            Error::BinderTransaction(StatusCode::NAME_NOT_FOUND) => {
+                Error::Km(ErrorCode::HARDWARE_TYPE_UNAVAILABLE)
+            }
+            e => e,
+        })
+        .context(ks_err!(
+            "Trying to get Legacy wrapper. Attempt to get keystore \
                     compat service for security level {:?}",
-                    *security_level
-                ))?;
+            *security_level
+        ))?;
         let hal_version = if *security_level == SecurityLevel::SOFTWARE {
             Some(km.getInterfaceVersion()? * 100)
         } else {
@@ -339,8 +342,12 @@ fn connect_keymint(
     //
     // This ensures that versionNumber value across KeyMaster and KeyMint is monotonically
     // increasing (and so comparisons like `versionNumber >= KEY_MINT_1` are valid).
-    if let Some(hal_version) = hal_version {
-        hw_info.versionNumber = hal_version;
+    if let Some(persona_version) = if *security_level == SecurityLevel::SOFTWARE {
+        tee_soft_keymint_version
+    } else {
+        hal_version
+    } {
+        hw_info.versionNumber = persona_version;
     }
 
     Ok((keymint, hw_info))
@@ -356,8 +363,21 @@ pub fn get_keymint_device(
     if let Some((dev, hw_info, uuid)) = devices_map.dev_by_sec_level(security_level) {
         Ok((dev, hw_info, uuid))
     } else {
-        let (dev, hw_info) =
-            connect_keymint(security_level).context(ks_err!("Cannot connect to Keymint"))?;
+        let tee_soft_keymint_version = if *security_level == SecurityLevel::SOFTWARE {
+            Some(
+                devices_map
+                    .dev_by_sec_level(&SecurityLevel::TRUSTED_ENVIRONMENT)
+                    .map(|(_, hw_info, _)| hw_info.versionNumber)
+                    .ok_or(Error::sys())
+                    .context(ks_err!(
+                        "Cannot construct the TEE Soft persona before the genuine TEE"
+                    ))?,
+            )
+        } else {
+            None
+        };
+        let (dev, hw_info) = connect_keymint(security_level, tee_soft_keymint_version)
+            .context(ks_err!("Cannot connect to Keymint"))?;
         devices_map.insert(*security_level, dev, hw_info);
         // Unwrap must succeed because we just inserted it.
         Ok(devices_map.dev_by_sec_level(security_level).unwrap())
diff --git a/keystore2/src/km_compat.rs b/keystore2/src/km_compat.rs
