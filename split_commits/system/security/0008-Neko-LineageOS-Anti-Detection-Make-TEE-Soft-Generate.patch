+        // Keystore security level. This also keeps keys written by the earlier single-UUID
+        // implementation coherent while they are naturally replaced or deleted.
+        if *uuid == SecurityLevel::SOFTWARE.into() {
+            return SecurityLevel::TRUSTED_ENVIRONMENT;
+        }
         self.reported_sec_level_by_uuid.get(uuid).copied().unwrap_or_else(|| {
             self.uuid_by_sec_level
                 .iter()
@@ -132,8 +144,29 @@ impl KeystoreService {
     }
 
     fn get_i_sec_level_by_uuid(&self, uuid: &Uuid) -> Result<Strong<dyn IKeystoreSecurityLevel>> {
-        if let Some(dev) = self.i_sec_level_by_uuid.get(uuid) {
-            Ok(dev.clone())
+        let cached = self.i_sec_level_by_uuid.read().unwrap().get(uuid).cloned();
+        if let Some(dev) = cached {
+            Ok(dev)
+        } else if *uuid == SecurityLevel::SOFTWARE.into() {
+            // Compatibility for TEE Soft keys produced before public proxy UUID and blob routing
+            // UUID were separated. SOFTWARE registration is optional during early service startup
+            // and may race the compat service, so retry it on demand instead of making existing
+            // persistent keys unreadable for the rest of the boot.
+            let (dev, resolved_uuid, _) = KeystoreSecurityLevel::new_native_binder(
+                SecurityLevel::SOFTWARE,
+                self.id_rotation_state.clone(),
+            )
+            .context(ks_err!("Trying to construct legacy TEE Soft security level proxy."))?;
+            if resolved_uuid != *uuid {
+                return Err(error::Error::sys()).context(ks_err!(
+                    "TEE Soft security level resolved to an unexpected KeyMint UUID."
+                ));
+            }
+            info!(
+                "tee soft debug: recovered legacy SOFTWARE-backed key through an on-demand proxy"
+            );
+            let mut devices = self.i_sec_level_by_uuid.write().unwrap();
+            Ok(devices.entry(*uuid).or_insert(dev).clone())
         } else {
             Err(error::Error::sys()).context(ks_err!("KeyMint instance for key not found."))
         }
@@ -146,9 +179,9 @@ impl KeystoreService {
