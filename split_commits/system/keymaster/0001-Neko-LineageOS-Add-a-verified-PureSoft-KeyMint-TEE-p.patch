+++ b/android_keymaster/keymaster_configuration.cpp
@@ -45,6 +45,7 @@ constexpr char kVendorPatchlevelProp[] = "ro.vendor.build.security_patch";
 constexpr char kPatchlevelRegex[] = "^([0-9]{4})-([0-9]{2})-([0-9]{2})$";
 constexpr char kVerifiedBootStateProp[] = "ro.boot.verifiedbootstate";
 constexpr char kVbmetaDeviceStateProp[] = "ro.boot.vbmeta.device_state";
+constexpr char kVbmetaPublicKeyDigestProp[] = "ro.boot.vbmeta.public_key_digest";
 constexpr char kVbmetaDigestProp[] = "ro.boot.vbmeta.digest";
 constexpr size_t kYearMatch = 1;
 constexpr size_t kMonthMatch = 2;
@@ -263,4 +264,13 @@ std::optional<std::vector<uint8_t>> GetVbmetaDigest() {
     return GetVbmetaDigest(vbmeta_string);
 }
 
+std::optional<std::vector<uint8_t>> GetVbmetaPublicKeyDigest() {
+    // Unlike ro.boot.vbmeta.digest, this property is not guaranteed to be supplied by every
+    // bootloader. Do not manufacture a zero value here; the PureSoft TEE context has a stable
+    // deterministic fallback when it is absent.
+    auto key_digest = android::base::GetProperty(kVbmetaPublicKeyDigestProp, "");
+    if (key_digest.empty()) return std::nullopt;
+    return GetVbmetaDigest(key_digest);
+}
+
 }  // namespace keymaster
diff --git a/contexts/pure_soft_keymaster_context.cpp b/contexts/pure_soft_keymaster_context.cpp
index f9ba15b..f641ea7 100644
--- a/contexts/pure_soft_keymaster_context.cpp
+++ b/contexts/pure_soft_keymaster_context.cpp
@@ -16,6 +16,7 @@
 
 #include <keymaster/contexts/pure_soft_keymaster_context.h>
 
+#include <algorithm>
 #include <assert.h>
 #include <memory>
 #include <utility>
@@ -110,6 +111,47 @@ PureSoftKeymasterContext::SetVerifiedBootInfo(std::string_view boot_state,
     verified_boot_state_ = boot_state;
     bootloader_state_ = bootloader_state;
     vbmeta_digest_ = vbmeta_digest;
+
+    const bool vbmeta_digest_usable =
+        vbmeta_digest.size() == SHA256_DIGEST_LENGTH &&
+        !std::all_of(vbmeta_digest.begin(), vbmeta_digest.end(), [](uint8_t b) { return b == 0; });
+    if (vbmeta_digest_usable) {
+        verified_boot_hash_ = vbmeta_digest;
+    } else {
+        static constexpr char kBootHashDomain[] = "pure_soft_tee_verified_boot_hash_v1";
+        std::vector<uint8_t> seed(vbmeta_digest.begin(), vbmeta_digest.end());
+        seed.insert(seed.end(), reinterpret_cast<const uint8_t*>(kBootHashDomain),
+                    reinterpret_cast<const uint8_t*>(kBootHashDomain) + sizeof(kBootHashDomain) -
+                        1);
+        verified_boot_hash_.emplace(SHA256_DIGEST_LENGTH);
+        SHA256(seed.data(), seed.size(), verified_boot_hash_->data());
+    }
+
+    // A real verified-boot public-key digest is not exposed on every device. Keep a stable,
+    // non-zero identity for the fake TEE in that case, domain-separated from the vbmeta digest.
+    if (!verified_boot_key_.has_value()) {
+        static constexpr char kBootKeyDomain[] = "pure_soft_tee_verified_boot_key_v1";
+        std::vector<uint8_t> seed(vbmeta_digest.begin(), vbmeta_digest.end());
+        seed.insert(seed.end(), reinterpret_cast<const uint8_t*>(kBootKeyDomain),
+                    reinterpret_cast<const uint8_t*>(kBootKeyDomain) + sizeof(kBootKeyDomain) - 1);
+        verified_boot_key_.emplace(SHA256_DIGEST_LENGTH);
+        SHA256(seed.data(), seed.size(), verified_boot_key_->data());
+    }
+
+    verified_boot_params_.verified_boot_key = {verified_boot_key_->data(),
+                                               verified_boot_key_->size()};
+    verified_boot_params_.verified_boot_hash = {verified_boot_hash_->data(),
+                                                verified_boot_hash_->size()};
+    verified_boot_params_.device_locked = bootloader_state == "locked";
+    if (boot_state == "green") {
+        verified_boot_params_.verified_boot_state = KM_VERIFIED_BOOT_VERIFIED;
+    } else if (boot_state == "yellow") {
+        verified_boot_params_.verified_boot_state = KM_VERIFIED_BOOT_SELF_SIGNED;
+    } else if (boot_state == "orange") {
+        verified_boot_params_.verified_boot_state = KM_VERIFIED_BOOT_UNVERIFIED;
+    } else {
+        verified_boot_params_.verified_boot_state = KM_VERIFIED_BOOT_FAILED;
+    }
     if (pure_soft_remote_provisioning_context_ != nullptr) {
         pure_soft_remote_provisioning_context_->SetVerifiedBootInfo(boot_state, bootloader_state,
                                                                     vbmeta_digest);
@@ -117,6 +159,22 @@ PureSoftKeymasterContext::SetVerifiedBootInfo(std::string_view boot_state,
     return KM_ERROR_OK;
 }
 
+keymaster_error_t
+PureSoftKeymasterContext::SetVerifiedBootKey(const std::vector<uint8_t>& verified_boot_key) {
+    if (verified_boot_key.size() != SHA256_DIGEST_LENGTH ||
+        std::all_of(verified_boot_key.begin(), verified_boot_key.end(),
+                    [](uint8_t b) { return b == 0; })) {
+        return KM_ERROR_INVALID_ARGUMENT;
+    }
+    if (verified_boot_key_.has_value() && verified_boot_key != verified_boot_key_.value()) {
+        return KM_ERROR_INVALID_ARGUMENT;
+    }
+    verified_boot_key_ = verified_boot_key;
+    verified_boot_params_.verified_boot_key = {verified_boot_key_->data(),
+                                               verified_boot_key_->size()};
+    return KM_ERROR_OK;
+}
+
 keymaster_error_t PureSoftKeymasterContext::SetVendorPatchlevel(uint32_t vendor_patchlevel) {
     if (vendor_patchlevel_.has_value() && vendor_patchlevel != vendor_patchlevel_.value()) {
         // Can't set patchlevel to a different value.
@@ -638,15 +696,16 @@ keymaster_error_t PureSoftKeymasterContext::UnwrapKey(
 
 const AttestationContext::VerifiedBootParams*
 PureSoftKeymasterContext::GetVerifiedBootParams(keymaster_error_t* error) const {
-    static VerifiedBootParams params;
-    static std::string fake_vb_key(32, 0);
-    params.verified_boot_key = {reinterpret_cast<uint8_t*>(fake_vb_key.data()), fake_vb_key.size()};
-    params.verified_boot_hash = {reinterpret_cast<uint8_t*>(fake_vb_key.data()),
-                                 fake_vb_key.size()};
-    params.verified_boot_state = KM_VERIFIED_BOOT_UNVERIFIED;
-    params.device_locked = false;
+    // Preserve the platform's established SOFTWARE KeyMint behavior. Only the explicitly
+    // constructed fake TEE consumes configured verified-boot state for its attestation records.
+    const bool configured = security_level_ == KM_SECURITY_LEVEL_TRUSTED_ENVIRONMENT &&
+                            verified_boot_state_.has_value() && bootloader_state_.has_value() &&
+                            verified_boot_key_.has_value() && verified_boot_hash_.has_value();
+    if (!configured) {
+        return SoftAttestationContext::GetVerifiedBootParams(error);
+    }
     *error = KM_ERROR_OK;
-    return &params;
+    return &verified_boot_params_;
 }
 
 }  // namespace keymaster
