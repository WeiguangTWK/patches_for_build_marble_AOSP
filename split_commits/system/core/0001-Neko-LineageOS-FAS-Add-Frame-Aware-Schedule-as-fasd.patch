--- /dev/null
+++ b/fasd/UpshiftProbe.h
@@ -0,0 +1,128 @@
+/*
+ * Copyright 2026 The LineageOS Project
+ * SPDX-License-Identifier: GPL-3.0-only
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+
+namespace android::fas {
+
+// Pure policy: callers supply a monotonic timestamp and the already measured recent FPS.
+// No clocks, Binder, sysfs or sleeping are needed to exercise the production state machine.
+class UpshiftProbe {
+  public:
+    static constexpr int64_t kTriggerConfirmationNs = 1'000'000'000;
+    static constexpr int64_t kSuccessConfirmationNs = 2'000'000'000;
+    static constexpr int64_t kDurationNs = 10'000'000'000;
+    static constexpr int64_t kRetryCooldownNs = 20'000'000'000;
+
+    enum class Event { None, Started, TimedOut, ConfirmedActive, ConfirmedPassive };
+    struct Decision {
+        Event event = Event::None;
+        int32_t candidateFps = 0;
+        bool forceMaximum = false;
+        bool refreshVote = false;
+    };
+
+    Decision update(int64_t nowNs, int32_t currentTarget,
+                    std::optional<int32_t> nextCandidate, double recentFps) {
+        if (currentTarget <= 0 || !nextCandidate || *nextCandidate <= currentTarget) {
+            resetEvidence();
+            return {};
+        }
+        if (mCurrentTarget != currentTarget || mCandidate != *nextCandidate) {
+            resetEvidence();
+            mCurrentTarget = currentTarget;
+            mCandidate = *nextCandidate;
+        }
+        const bool activeProbe = active();
+        const double successThreshold = (currentTarget + *nextCandidate) / 2.0 + 1.0;
+        if (recentFps >= successThreshold) {
+            if (!mSuccessSinceNs) mSuccessSinceNs = nowNs;
+            if (nowNs - *mSuccessSinceNs >= kSuccessConfirmationNs) {
+                const Event event = activeProbe ? Event::ConfirmedActive : Event::ConfirmedPassive;
+                const int32_t candidate = *nextCandidate;
+                reset();
+                return {.event = event, .candidateFps = candidate};
+            }
+        } else {
+            mSuccessSinceNs.reset();
+        }
+
+        if (activeProbe) {
+            if (nowNs < *mProbeUntilNs) {
+                return {.candidateFps = *nextCandidate, .forceMaximum = true};
+            }
+            // The pulse expires, not the cadence evidence. The caller replaces the vote without
+            // releasing its backend, preserving both a live lock and external-ceiling history.
+            mProbeUntilNs.reset();
+            mTriggerSinceNs.reset();
+            mCooldownUntilNs = nowNs + kRetryCooldownNs;
+            return {.event = Event::TimedOut, .candidateFps = *nextCandidate, .refreshVote = true};
+        }
+        if (mCooldownUntilNs && nowNs < *mCooldownUntilNs) {
+            mTriggerSinceNs.reset();
+            return {.candidateFps = *nextCandidate};
+        }
+        const double triggerMargin = std::max(4.0, currentTarget * 0.15);
+        if (recentFps < currentTarget + triggerMargin) {
+            mTriggerSinceNs.reset();
+            return {.candidateFps = *nextCandidate};
+        }
+        if (!mTriggerSinceNs) mTriggerSinceNs = nowNs;
+        if (nowNs - *mTriggerSinceNs < kTriggerConfirmationNs) {
+            return {.candidateFps = *nextCandidate};
+        }
+        mTriggerSinceNs.reset();
+        mProbeUntilNs = nowNs + kDurationNs;
+        return {.event = Event::Started,
+                .candidateFps = *nextCandidate,
+                .forceMaximum = true,
+                .refreshVote = true};
+    }
+
+    void resetEvidence() {
+        mCurrentTarget = 0;
+        mCandidate = 0;
+        mTriggerSinceNs.reset();
+        mSuccessSinceNs.reset();
+        mProbeUntilNs.reset();
+    }
+
+    void reset() {
+        resetEvidence();
+        mCooldownUntilNs.reset();
+    }
+
+    int32_t candidate() const { return mCandidate; }
+    bool active() const { return mProbeUntilNs.has_value(); }
+    bool armed() const { return mTriggerSinceNs.has_value(); }
+    bool confirming() const { return mSuccessSinceNs.has_value(); }
+
+  private:
+    int32_t mCurrentTarget = 0;
+    int32_t mCandidate = 0;
+    std::optional<int64_t> mTriggerSinceNs;
+    std::optional<int64_t> mSuccessSinceNs;
+    std::optional<int64_t> mProbeUntilNs;
+    std::optional<int64_t> mCooldownUntilNs;
+};
+
+// Shared by Engine and host tests. A timeout forces an ordinary update even if the regular
+// backend interval has not elapsed. The existing backend owns acquire-before-retire and TTL;
+// this handoff must never issue release. Failed updates leave those safety mechanisms intact.
+template <typename Backend, typename Votes>
+bool submitBackendVoteIfDue(int64_t nowNs, int64_t intervalNs, bool forceUpdate,
+                            uint64_t generation, const Votes& votes, Backend& backend,
+                            int64_t& lastUpdateNs, bool& lastDelivered) {
+    if (!forceUpdate && nowNs - lastUpdateNs < intervalNs) return false;
+    lastUpdateNs = nowNs;
+    lastDelivered = backend.update(generation, votes);
+    return true;
+}
+
+} // namespace android::fas
