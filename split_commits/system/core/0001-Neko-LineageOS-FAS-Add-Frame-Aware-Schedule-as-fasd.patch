+};
+
+struct PolicyRuntimeObservation {
+    std::map<int32_t, uint64_t> ticks;
+    std::map<int32_t, double> smoothedShares;
+    uint64_t unknownTicks = 0;
+    std::vector<int32_t> candidatePolicies;
+    std::vector<int32_t> fixedPolicies;
+    bool valid = false;
