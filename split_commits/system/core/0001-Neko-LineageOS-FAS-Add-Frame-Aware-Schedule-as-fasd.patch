+
+constexpr std::string_view kCpuFreqRoot = "/sys/devices/system/cpu/cpufreq";
+constexpr std::chrono::milliseconds kPolicyInterval = 100ms;
+constexpr std::chrono::milliseconds kLogInterval = 500ms;
+constexpr std::chrono::milliseconds kBackendInterval = 500ms;
+constexpr std::chrono::milliseconds kFrameCallbackGrace = 250ms;
+constexpr std::chrono::seconds kStartDelay = 3s;
+constexpr std::chrono::seconds kJankWindow = 1s;
+constexpr std::chrono::milliseconds kCadenceSubwindow = 500ms;
+constexpr std::chrono::seconds kDownshiftConfirmation = 3s;
+constexpr std::chrono::seconds kUpshiftConfirmation = 5s;
+constexpr std::chrono::seconds kTargetSwitchCooldown = 5s;
+constexpr std::chrono::seconds kTargetDiagnosticInterval = 1s;
+constexpr std::chrono::seconds kThreadDiagnosticInterval = 1s;
+constexpr std::chrono::milliseconds kThreadSampleInterval = 300ms;
+constexpr std::chrono::seconds kPolicyRuntimeStaleInterval = 2s;
+constexpr std::chrono::seconds kHealthyRecoveryConfirmation = 3s;
+constexpr std::chrono::seconds kHealthyRecoveryStepInterval = 1s;
+constexpr std::chrono::seconds kHealthyRecoveryCooldown = 5s;
+constexpr double kControllerKp = 0.0003;
+constexpr double kBalanceMarginFps = 1.0;
+constexpr double kCadenceFpsToleranceRatio = 0.06;
+constexpr double kHealthyRecoveryFpsMargin = 1.0;
+// A zero-tick process sample is common over a short sampling interval. Require positive
+// utilization evidence before allowing guarded recovery to lower the current vote.
+constexpr double kMinimumUtilizationForRecovery = 0.10;
+constexpr double kHighUtilizationForRecoveryHold = 0.65;
+// Keep fixed minimum votes on the policies carrying most of the observed top-thread runtime.
+// Weight runtime by each policy's maximum frequency as a portable performance-capacity proxy,
+// smooth it across complete windows, and use asymmetric confirmation so a short residency swap
+// neither fixes a policy nor relaxes a previously important policy immediately.
+constexpr double kFixedPolicyRuntimeCoverage = 0.75;
+constexpr double kPolicyRuntimeEwmaNewWindowWeight = 0.50;
+constexpr size_t kPolicyEnterWindowCount = 2;
+constexpr size_t kPolicyReleaseWindowCount = 5;
+// Keep a single delayed frame from taking the virtual controller straight to maximum, while
+// still allowing sustained misses to ramp quickly. Recover stale votes one guarded step at a time;
+// applying this step on every policy tick was fast enough to cause a drop-and-boost sawtooth.
+constexpr int64_t kMaximumControlIncreaseKhz = 150000;
+constexpr int64_t kHealthyRecoveryStepKhz = 25000;
+constexpr size_t kMinimumFrameSamples = 60;
+constexpr size_t kCadenceWindowCount = 4;
+constexpr size_t kRequiredStableWindows = 3;
+constexpr size_t kTopThreadCount = 8;
+
+struct Session {
