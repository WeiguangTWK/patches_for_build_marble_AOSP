diff --git a/fasd/FasTarget.h b/fasd/FasTarget.h
new file mode 100644
index 0000000..6936f0d
--- /dev/null
+++ b/fasd/FasTarget.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace android::fas {
+inline constexpr std::array<int32_t, 3> kTargetCandidates = {30, 60, 120};
+
+inline constexpr bool validFixedTarget(int32_t fps) {
+    return fps == 0 || fps == 30 || fps == 60 || fps == 120;
+}
+
+// Zero means there is no supported target at the current display refresh rate.
+inline constexpr int32_t effectiveFixedTarget(int32_t requested, int32_t refreshMilliHz) {
+    if (!validFixedTarget(requested) || requested == 0) return 0;
+    int32_t result = 0;
+    for (int32_t fps : kTargetCandidates) {
+        if (fps <= requested && static_cast<int64_t>(fps) * 1000 <=
+                                       static_cast<int64_t>(refreshMilliHz) + 500) result = fps;
+    }
+    return result;
+}
+}  // namespace android::fas
