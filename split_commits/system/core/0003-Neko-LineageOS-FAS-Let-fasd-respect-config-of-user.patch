+#include "FasTarget.h"
 
 #include <gtest/gtest.h>
 
@@ -11,6 +12,31 @@ namespace android::fas {
 namespace {
 
 using Event = UpshiftProbe::Event;
+
+TEST(FasTargetTest, AutomaticAndInvalidValuesDoNotProduceFixedTargets) {
+    EXPECT_EQ(effectiveFixedTarget(0, 120000), 0);
+    EXPECT_EQ(effectiveFixedTarget(90, 120000), 0);
+    EXPECT_EQ(effectiveFixedTarget(-1, 120000), 0);
+}
+
+TEST(FasTargetTest, FixedTargetsDoNotFollowHigherDisplayRefresh) {
+    EXPECT_EQ(effectiveFixedTarget(30, 120000), 30);
+    EXPECT_EQ(effectiveFixedTarget(60, 120000), 60);
+    EXPECT_EQ(effectiveFixedTarget(120, 120000), 120);
+}
+
+TEST(FasTargetTest, DisplayCapCanFallAndRecoverWithoutChangingRequestedMode) {
+    EXPECT_EQ(effectiveFixedTarget(120, 60000), 60);
+    EXPECT_EQ(effectiveFixedTarget(120, 30000), 30);
+    EXPECT_EQ(effectiveFixedTarget(120, 90000), 60);
+    EXPECT_EQ(effectiveFixedTarget(120, 120000), 120);
+    EXPECT_EQ(effectiveFixedTarget(60, 24000), 0);
+}
+
+TEST(FasTargetTest, DisplayToleranceMatchesAutomaticCandidates) {
+    EXPECT_EQ(effectiveFixedTarget(60, 59500), 60);
+    EXPECT_EQ(effectiveFixedTarget(60, 59499), 30);
+}
 constexpr int64_t ns(int64_t milliseconds) { return milliseconds * 1'000'000; }
 
