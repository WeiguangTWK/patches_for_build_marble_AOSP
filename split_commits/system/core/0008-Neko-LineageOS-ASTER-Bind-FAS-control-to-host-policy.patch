new file mode 100644
index 0000000..c5d3f3c
--- /dev/null
+++ b/libplatform_integrity_host/include/platform/integrity_policy.h
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <android-base/properties.h>
+#include <array>
+#include <charconv>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <time.h>
+
+namespace android::platform_integrity {
+
+constexpr unsigned kTee = 1;
+constexpr unsigned kFas = 2;
+constexpr unsigned kVisibility = 4;
+constexpr char kPolicyProperty[] = "sys.integrity.policy";
+constexpr uint64_t kMaxLeaseMillis = 5000;
+
+inline uint64_t elapsedMillis() {
+    timespec ts{};
+    if (clock_gettime(CLOCK_BOOTTIME, &ts) != 0) return UINT64_MAX;
+    return uint64_t(ts.tv_sec) * 1000 + ts.tv_nsec / 1000000;
+}
+
+inline bool enabled() {
+    return android::base::GetBoolProperty("ro.platform.integrity.enabled", false);
+}
+
+// boot UUID (without hyphens), authority instance, epoch, deadline, feature mask.
+// All numbers are hexadecimal. The complete record fits one atomic property value.
+struct Permit {
+    std::string identity;
+    uint64_t deadline = 0;
+    unsigned features = 0;
+    bool allows(unsigned feature) const {
+        const uint64_t now = elapsedMillis();
+        return (features & feature) == feature && now < deadline &&
+               deadline - now <= kMaxLeaseMillis;
+    }
+};
+
+inline std::optional<Permit> parsePermit(std::string_view value) {
+    std::array<std::string_view, 5> fields;
+    size_t offset = 0;
+    for (size_t i = 0; i < fields.size(); ++i) {
+        size_t end = value.find(':', offset);
+        if ((i == fields.size() - 1) != (end == std::string_view::npos)) return {};
+        if (end == std::string_view::npos) end = value.size();
+        fields[i] = value.substr(offset, end - offset);
+        offset = end + 1;
+    }
+    if (fields[0].size() != 32 || fields[1].size() != 16 || fields[2].empty() ||
+        fields[2].size() > 8 || fields[3].empty() || fields[3].size() > 12 ||
+        fields[4].size() != 1) return {};
+    for (const auto field : fields) {
+        for (char c : field) {
+            if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return {};
+        }
+    }
+    uint64_t deadline = 0;
+    const auto result = std::from_chars(fields[3].data(),
+                                      fields[3].data() + fields[3].size(), deadline, 16);
+    if (result.ec != std::errc{} || fields[4][0] > '7') return {};
+    const size_t identityEnd = fields[3].data() - value.data() - 1;
+    return Permit{std::string(value.substr(0, identityEnd)), deadline,
+                  unsigned(fields[4][0] - '0')};
+}
+
+inline std::optional<Permit> currentPermit() {
+    return parsePermit(android::base::GetProperty(kPolicyProperty, ""));
+}
+
+inline bool allowed(unsigned feature) {
+    if (!enabled()) return true;
+    const auto permit = currentPermit();
+    return permit && permit->allows(feature);
+}
+
+inline bool allowedForIdentity(std::string_view identity, unsigned feature) {
+    if (!enabled()) return true;
+    const auto current = currentPermit();
+    return current && current->identity == identity && current->allows(feature);
+}
+
+inline bool stillAllowed(const Permit& captured, unsigned feature) {
+    const auto current = currentPermit();
+    return current && current->identity == captured.identity && current->allows(feature);
+}
+
+}  // namespace android::platform_integrity
