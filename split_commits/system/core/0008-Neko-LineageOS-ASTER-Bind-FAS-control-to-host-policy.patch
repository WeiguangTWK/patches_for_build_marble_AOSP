+# SPDX-License-Identifier: Apache-2.0
+"""Shutdown/policy interleavings. Not a property writer or runtime authority."""
+from model import Finding, Mode, Policy
+
+
+class Shutdown:
+    def __init__(self, policy):
+        self.policy = policy
+        self.phase = "RUNNING"
+        self.start = self.deadline = None
+        self.zero_confirmed = False
+        self.notice = self.interruptions = 0
+        self.observed_notice = None
+        self.plan = None
+        self.frozen_boot = ""
+
+    def begin(self, now):
+        if self.phase != "RUNNING":
+            return False
+        self.phase = "DRAINING"
+        self.start, self.deadline = now, now + 2000
+        self.policy.invalidate("SHUTDOWN")
+        return True
+
+    def live(self, now):
+        return self.phase == "DRAINING" and self.start <= now < self.deadline
+
+    def fail(self):
+        if self.phase == "TERMINAL":
+            return
+        self.phase = "FAILED"
+        self.policy.fault("SHUTDOWN_UNCONFIRMED")
+
+    def confirm_zero(self, now, success=True):
+        if self.live(now) and success:
+            self.zero_confirmed = True
+        else:
+            self.fail()
+
+    def disconnect(self):
+        if self.phase == "TERMINAL":
+            return  # only after successful handoff is close expected
+        self.notice += 1
+        self.interruptions += 1
+        self.policy.fault("CONTROL_INTERRUPTED")
+
+    def change(self):
+        if self.phase != "TERMINAL":
+            self.notice += 1
+
+    def final_observation(self, evidence, now, stop_ack=True):
+        if not self.live(now) or not self.zero_confirmed:
+            self.fail()
+            return False
+        # Initial durable denial precedes endpoint teardown. It confers no
+        # expected-close authority if the later report/receipt/commit fails.
+        self.frozen_boot = self.policy.boot
+        if not stop_ack:
+            self.fail()
+            return False
+        # prepare applies current findings/retention but cannot issue permits.
+        self.plan = self.policy.prepare(evidence, now)
+        if self.plan is None:
+            self.fail()
+            return False
+        self.observed_notice = self.notice
+        return True
+
+    def finish(self, now, persist_ok=True, receipt_ok=True):
+        if (not self.live(now) or not self.zero_confirmed or self.plan is None
+                or not persist_ok):
+            self.fail()
+            return False
+        # Persistence precedes the final ticket CAS. A late/changed ticket can
+        # leave a durable denial marker but never expected-close authority.
+        self.frozen_boot = self.policy.boot
+        if (not receipt_ok or self.notice != self.observed_notice
+                or now < self.plan.evidence.completed_ms
+                or now - self.plan.evidence.completed_ms >= 2000):
+            self.fail()
+            return False
+        self.phase = "TERMINAL"
+        self.policy.invalidate("SHUTDOWN_TERMINAL")
+        return True
+
+    def commit_positive(self, receipt, now):
+        if self.phase != "RUNNING":
+            return False
+        return self.policy.commit(receipt, now)
+
+    def restart_same_boot(self):
+        # A persisted freeze is denial only, including when the old worker
+        # committed the marker but failed its final notification CAS.
+        if self.frozen_boot == self.policy.boot:
+            self.phase = "FAILED"
+            self.policy.invalidate("FROZEN_BOOT")
+
+    def reboot(self, boot):
+        self.policy.reboot(boot)
+        self.phase = "RUNNING"
+        self.start = self.deadline = None
+        self.zero_confirmed = False
+        self.plan = None
+        self.observed_notice = None
+        self.notice = self.interruptions = 0
+        self.frozen_boot = ""
