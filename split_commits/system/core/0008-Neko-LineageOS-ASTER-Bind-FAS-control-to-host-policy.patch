+++ b/libplatform_integrity_host/tests/lease_model/model.py
@@ -0,0 +1,154 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Sequential permit-write coalescing specification; no property or device I/O."""
+from dataclasses import dataclass
+
+LEASE_MS = 4000
+MARGIN_MS = 2000
+REPORT_MS = 2000
+MAX_TIME = (1 << 48) - 1  # Existing property deadline has at most 12 hex digits.
+
+
+@dataclass(frozen=True)
+class Proof:
+    generation: int
+    mask: int
+    completed: int
+    receipt_until: int
+    control_until: int
+    validated: bool = True
+
+
+@dataclass(frozen=True)
+class Value:
+    # Synthetic identity includes boot/coordinator/revision/notice fencing.
+    # This is not a model of the five-field property encoding.
+    generation: int
+    deadline: int
+    mask: int
+
+
+class Model:
+    def __init__(self, coalesce=True):
+        self.coalesce = coalesce
+        self.now = self.highwater = 0
+        self.clock_bad = False
+        self.generation = 1
+        self.closing = self.writer_failed = False
+        self.actual = None
+        self.last_written = None
+        self.accepted = None
+        self.calls = self.successes = self.skips = self.cycles = 0
+
+    def advance(self, now):
+        if now < self.highwater or now < 0 or now > MAX_TIME - LEASE_MS:
+            self.clock_bad = True
+            self.invalidate()
+        self.now = now
+        self.highwater = max(self.highwater, now)
+
+    def invalidate(self):
+        self.generation += 1
+        self.accepted = None
+
+    def shutdown(self):
+        self.closing = True
+        self.invalidate()
+
+    def proof(self, mask=2, *, completed=None, receipt_until=None, control_until=None):
+        # Represents successful CURRENT environment/control/proc coordination.
+        # Calling this fixture is not a real query, ACK or proof of their health.
+        completed = self.now if completed is None else completed
+        return Proof(self.generation, mask, completed,
+                     completed + REPORT_MS if receipt_until is None else receipt_until,
+                     self.now + REPORT_MS if control_until is None else control_until)
+
+    def valid(self, proof):
+        return (proof is not None and proof.validated and not self.clock_bad
+                and not self.closing and not self.writer_failed
+                and proof.generation == self.generation and proof.mask in range(8)
+                and 0 <= proof.completed <= self.now < proof.completed + REPORT_MS
+                and self.now < proof.receipt_until and self.now < proof.control_until)
+
+    def _write(self, value, *, success=True, readback=True):
+        self.calls += 1
+        if success:
+            self.actual = value
+            self.successes += 1
+        if not success or not readback or self.actual != value:
+            # A failed setter/readback cannot be cached as success. Model the
+            # current host's irreversible writer-failure denial conservatively.
+            self.writer_failed = True
+            self.last_written = None
+            self.invalidate()
+            return False
+        self.last_written = value
+        return True
+
+    def _deny(self, success=True):
+        self.accepted = None
+        deadline = self.now + LEASE_MS if not self.clock_bad else 0
+        # Zero/clear is forced, including if the last value was already zero.
+        self._write(Value(self.generation, deadline, 0), success=success)
+        return "denied"
+
+    def cycle(self, now, proof, *, force=False, before=None, after=None,
+              write_ok=True, readback_ok=True, revoke_ok=True):
+        self.advance(now)
+        self.cycles += 1
+        self.accepted = None
+        if before:
+            before(self)
+        # Unexpected property replacement is not silently blessed. First force
+        # zero and retire this proof; later recovery needs a fresh generation.
+        if self.last_written is not None and self.actual != self.last_written:
+            self.invalidate()
+            return self._deny(revoke_ok)
+        if not self.valid(proof):
+            return self._deny(revoke_ok)
+        if self.last_written is not None and self.now >= self.last_written.deadline:
+            # Expired authority cannot be resumed using an old accepted proof.
+            self.invalidate()
+            return self._deny(revoke_ok)
+        skip = (self.coalesce and not force and proof.mask != 0
+                and isinstance(self.actual, Value) and self.actual == self.last_written
+                and self.actual.generation == self.generation
+                and self.actual.mask == proof.mask
+                and self.actual.deadline - self.now > MARGIN_MS)
+        if skip:
+            if after:
+                after(self)
+            # The skipped-write branch needs the same late-ticket and state
+            # checks as the real-write branch. No time/deadline is extended.
+            if (not self.valid(proof) or self.actual != self.last_written
+                    or self.actual.deadline - self.now <= MARGIN_MS):
+                if self.actual != self.last_written:
+                    self.invalidate()
+                return self._deny(revoke_ok)
+            self.skips += 1
+            self.accepted = proof
+            return "skipped"
+        value = Value(self.generation, self.now + LEASE_MS, proof.mask)
+        if not self._write(value, success=write_ok, readback=readback_ok):
+            self.accepted = None
+            return "write_failed"
+        if after:
+            after(self)
+        if (not self.valid(proof) or self.actual != value
+                or not self.now < value.deadline):
+            if self.actual != value:
+                self.invalidate()
+            return self._deny(revoke_ok)
+        self.accepted = proof
+        return "written"
+
+    def host_mask(self):
+        return self.accepted.mask if self.valid(self.accepted) else 0
+
+    def consumer_mask(self):
+        # Deliberately independent: if a zero write fails, previously delivered
+        # authority cannot be erased by setting a process-local denied flag.
+        value = self.actual
+        if (isinstance(value, Value) and value.mask in range(8)
+                and self.now < value.deadline and value.deadline - self.now <= 5000):
+            return value.mask
+        return 0
diff --git a/libplatform_integrity_host/tests/lease_model/test_model.py b/libplatform_integrity_host/tests/lease_model/test_model.py
new file mode 100644
index 0000000..1a8bf53
--- /dev/null
+++ b/libplatform_integrity_host/tests/lease_model/test_model.py
@@ -0,0 +1,246 @@
+# SPDX-License-Identifier: Apache-2.0
+import unittest
+from dataclasses import replace
+
+from model import LEASE_MS, MARGIN_MS, MAX_TIME, Model, Value
+
+
+class PermitRenewal(unittest.TestCase):
+    def ready(self, coalesce=True, mask=2):
+        model = Model(coalesce)
+        self.assertEqual("written", model.cycle(0, model.proof(mask)))
+        return model
+
+    def run_cycle(self, model, now, mask=2, **kwargs):
+        model.advance(now)
+        return model.cycle(now, model.proof(mask), **kwargs)
+
+    def test_initial_positive_requires_real_write(self):
+        model = self.ready()
+        self.assertEqual(1, model.calls)
+        self.assertEqual(2, model.consumer_mask())
+
+    def test_skip_keeps_actual_deadline_and_last_success_unchanged(self):
+        model = self.ready()
+        old = model.last_written
+        self.assertEqual("skipped", self.run_cycle(model, 500))
+        self.assertIs(old, model.actual)
+        self.assertIs(old, model.last_written)
+        self.assertEqual(1, model.calls)
+
+    def test_margin_boundary_renews(self):
+        for now, expected in ((1999, "skipped"), (2000, "written"), (2001, "written")):
+            with self.subTest(now=now):
+                model = self.ready()
+                self.assertEqual(expected, self.run_cycle(model, now))
+
+    def test_stable_schedule_reduces_only_writes_not_validation_cycles(self):
+        optimized, baseline = self.ready(), self.ready(False)
+        for now in range(500, 10000, 500):
+            for model in (optimized, baseline):
+                self.run_cycle(model, now)
+                self.assertEqual(2, model.host_mask())
+                self.assertEqual(2, model.consumer_mask())
+        self.assertEqual(20, optimized.cycles)
+        self.assertEqual(baseline.cycles, optimized.cycles)
+        self.assertEqual(20, baseline.calls)
+        self.assertEqual(5, optimized.calls)
+
+    def test_invalid_control_or_receipt_forces_zero_before_margin(self):
+        for field in ("validated", "receipt_until", "control_until"):
+            with self.subTest(field=field):
+                model = self.ready()
+                model.advance(500)
+                value = False if field == "validated" else 500
+                proof = replace(model.proof(), **{field: value})
+                self.assertEqual("denied", model.cycle(500, proof))
+                self.assertEqual(0, model.consumer_mask())
+                self.assertEqual(2, model.calls)
+
+    def test_report_freshness_is_not_extended_by_skip(self):
+        model = self.ready()
+        proof = model.proof()
+        self.assertEqual("skipped", model.cycle(500, proof))
+        self.assertEqual("denied", model.cycle(2000, proof))
+        self.assertEqual(0, model.consumer_mask())
+
+    def test_future_report_rejected(self):
+        model = self.ready()
+        self.assertEqual("denied", model.cycle(500, model.proof(completed=501)))
+
+    def test_property_replacement_does_not_skip_or_bless_foreign_value(self):
+        for value in (None, "malformed", Value(999, 4500, 7), Value(1, 4500, 2)):
+            with self.subTest(value=value):
+                model = self.ready()
+                model.actual = value
+                self.assertEqual("denied", self.run_cycle(model, 500))
+                self.assertEqual(0, model.consumer_mask())
+                self.assertEqual(0, model.skips)
+
+    def test_property_replacement_recovery_requires_new_proof(self):
+        model = self.ready()
+        old = model.proof()
+        model.actual = "foreign"
+        model.cycle(500, old)
+        self.assertEqual("denied", model.cycle(501, old))
+        self.assertEqual("written", self.run_cycle(model, 502))
+
+    def test_identical_mask_but_changed_identity_forces_write(self):
+        model = self.ready()
+        model.invalidate()
+        self.assertEqual("written", self.run_cycle(model, 500))
+        self.assertEqual(model.generation, model.actual.generation)
+
+    def test_mask_changes_are_never_delayed(self):
+        for mask in (0, 7):
+            with self.subTest(mask=mask):
+                model = self.ready()
+                self.assertEqual("written", self.run_cycle(model, 500, mask))
+                self.assertEqual(mask, model.consumer_mask())
+
+    def test_zero_and_explicit_force_never_coalesce(self):
+        model = self.ready(mask=0)
+        self.assertEqual("written", self.run_cycle(model, 500, 0))
+        model = self.ready()
+        self.assertEqual("written", self.run_cycle(model, 500, force=True))
+
+    def test_failed_write_is_not_remembered_as_success(self):
+        model = self.ready()
+        old = model.actual
+        self.assertEqual("write_failed", self.run_cycle(model, 2000, write_ok=False))
+        self.assertIsNone(model.last_written)
+        self.assertIs(old, model.actual)
+        self.assertEqual(0, model.host_mask())
+        self.assertEqual(2, model.consumer_mask())
+        self.assertEqual("denied", self.run_cycle(model, 2001))
+        self.assertEqual(0, model.consumer_mask())
+
+    def test_readback_failure_is_not_success_even_if_value_was_written(self):
+        model = self.ready()
+        self.assertEqual("write_failed", self.run_cycle(model, 2000, readback_ok=False))
+        self.assertIsNone(model.last_written)
+        self.assertEqual(0, model.host_mask())
+
+    def test_notification_before_decision_revokes(self):
+        model = self.ready()
+        self.assertEqual("denied", self.run_cycle(model, 500, before=lambda m: m.invalidate()))
+        self.assertEqual(0, model.consumer_mask())
+
+    def test_notification_after_skip_decision_still_revokes(self):
+        model = self.ready()
+        self.assertEqual("denied", self.run_cycle(model, 500, after=lambda m: m.invalidate()))
+        self.assertEqual(0, model.consumer_mask())
+        self.assertEqual(0, model.skips)
+
+    def test_notification_after_write_requires_actual_zero_write(self):
+        model = self.ready()
+        self.assertEqual("denied", self.run_cycle(model, 2000, after=lambda m: m.invalidate()))
+        self.assertEqual(3, model.calls)  # initial, positive renewal, zero cleanup
+        self.assertEqual(0, model.consumer_mask())
+
+    def test_replacement_during_skip_is_not_accepted(self):
+        model = self.ready()
+        old_generation = model.generation
+        def replace_value(m):
+            m.actual = Value(900, 4500, 7)
+        self.assertEqual("denied", self.run_cycle(model, 500, after=replace_value))
+        self.assertEqual(0, model.consumer_mask())
+        self.assertGreater(model.generation, old_generation)
+
+    def test_skipped_write_is_not_property_writer_health_probe(self):
+        optimized, baseline = self.ready(), self.ready(False)
+        # The write channel has failed; read-only checks and other components
+        # remain healthy. A skipped setter cannot discover this channel failure.
+        self.assertEqual("skipped", self.run_cycle(optimized, 500, write_ok=False))
+        self.assertFalse(optimized.writer_failed)
+        self.assertEqual("write_failed", self.run_cycle(baseline, 500, write_ok=False))
+        self.assertEqual("write_failed", self.run_cycle(optimized, 2000, write_ok=False))
+        self.assertTrue(optimized.writer_failed)
+
+    def test_skipped_write_never_exceeds_four_seconds_from_last_actual_write(self):
+        model = self.ready()
+        for now in (500, 1000, 1500):
+            self.assertEqual("skipped", self.run_cycle(model, now))
+            self.assertEqual(LEASE_MS, model.actual.deadline)
+        model.advance(LEASE_MS)
+        self.assertEqual(0, model.consumer_mask())
+
+    def test_new_coordinator_cannot_adopt_existing_positive_as_cached_success(self):
+        old = self.ready()
+        restarted = Model()
+        restarted.actual = old.actual
+        self.assertEqual("written", self.run_cycle(restarted, 500))
+        self.assertEqual(1, restarted.calls)
+        self.assertEqual(0, restarted.skips)
+
+    def test_shutdown_before_after_skip_and_after_write_never_restores(self):
+        for time, hook in ((500, "before"), (500, "after"), (2000, "after")):
+            with self.subTest(time=time, hook=hook):
+                model = self.ready()
+                self.assertEqual("denied", self.run_cycle(model, time,
+                    **{hook: lambda m: m.shutdown()}))
+                self.assertEqual(0, model.consumer_mask())
+                self.assertEqual("denied", self.run_cycle(model, time + 1))
+
+    def test_failed_zero_cannot_erase_prior_consumer_authority(self):
+        model = self.ready()
+        self.run_cycle(model, 500, after=lambda m: m.shutdown(), revoke_ok=False)
+        self.assertEqual(0, model.host_mask())
+        self.assertEqual(2, model.consumer_mask())
+        model.advance(4000)
+        self.assertEqual(0, model.consumer_mask())
+
+    def test_short_suspend_uses_boottime_margin_and_fresh_proof(self):
+        model = self.ready()
+        # No timer executes during the synthetic suspend. Uptime is not advanced
+        # in this model; BOOTTIME alone decides expiry at the next call.
+        self.assertEqual("written", self.run_cycle(model, 2500))
+        self.assertEqual(6500, model.actual.deadline)
+
+    def test_expired_lease_after_suspend_requires_new_generation(self):
+        model = self.ready()
+        self.assertEqual("denied", self.run_cycle(model, 4500))
+        self.assertEqual(0, model.consumer_mask())
+        self.assertEqual("written", self.run_cycle(model, 4501))
+
+    def test_stale_pre_suspend_proof_cannot_renew(self):
+        model = self.ready()
+        proof = model.proof()
+        self.assertEqual("denied", model.cycle(2500, proof))
+
+    def test_less_availability_headroom_during_stall_is_explicit(self):
+        optimized, baseline = self.ready(), self.ready(False)
+        for now in (500, 1000, 1500):
+            self.run_cycle(optimized, now)
+            self.run_cycle(baseline, now)
+        # Both keep the same four-second maximum issued lease. The optimized
+        # value nevertheless expires earlier when the coordinator stops running.
+        for model in (optimized, baseline):
+            model.advance(4500)
+            self.assertEqual(0, model.host_mask())  # stale environment either way
+        self.assertEqual(0, optimized.consumer_mask())
+        self.assertEqual(2, baseline.consumer_mask())
+
+    def test_boundary_delay_during_skip_cannot_claim_skip_success(self):
+        model = self.ready()
+        self.assertEqual("denied", self.run_cycle(model, 1999,
+            after=lambda m: m.advance(2000)))
+
+    def test_long_delay_after_write_rejects_stale_commit(self):
+        model = self.ready()
+        self.assertEqual("denied", self.run_cycle(model, 2000,
+            after=lambda m: m.advance(4000)))
+
+    def test_clock_regression_and_overflow_fail_closed(self):
+        for now in (-1, MAX_TIME - LEASE_MS + 1):
+            with self.subTest(now=now):
+                model = self.ready()
+                self.assertEqual("denied", self.run_cycle(model, now))
+                self.assertEqual(0, model.host_mask())
+        model = self.ready()
+        self.run_cycle(model, 1000)
+        self.assertEqual("denied", self.run_cycle(model, 999))
+
+
+if __name__ == "__main__":
+    unittest.main()
