@@ -0,0 +1,277 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Host policy contract model, not a report parser or production authority."""
+from dataclasses import dataclass
+from enum import Enum
+
+
+class Mode(Enum):
+    NORMAL = "NORMAL"
+    ENTER = "ENTER_PENDING"
+    COMPROMISE = "COMPROMISE"
+    EXIT = "EXIT_PENDING"
+
+
+@dataclass(frozen=True, order=True)
+class Finding:
+    kind: str
+    module: str = ""
+
+
+@dataclass(frozen=True)
+class Evidence:
+    # Identities are opaque labels here. Production must authenticate and parse
+    # them before using this contract; a caller-supplied boolean is not proof.
+    boot: str = "boot-a"
+    collector: str = "collector-a"
+    classifier: str = "classifier-a"
+    baseline: str = "baseline-a"
+    notice: str = "notice-a"
+    endpoints: str = "endpoints-a"
+    serial: int = 1
+    sequence: int = 1
+    completed_ms: int = 100
+    official: tuple | None = ()
+    union: tuple | None = ()
+    coverage_complete: bool = True
+    collection_consistent: bool = True
+    baseline_verified: bool = True
+    endpoints_confirmed: bool = True
+    endpoints_stopped: bool = True
+
+    @property
+    def identities(self):
+        return (self.boot, self.collector, self.classifier, self.baseline,
+                self.notice, self.endpoints)
+
+
+@dataclass(frozen=True)
+class Retained:
+    finding: Finding
+    identities: tuple
+    sequence: int
+    serial: int
+
+
+@dataclass(frozen=True)
+class Plan:
+    revision: int
+    evidence: Evidence
+    scope: str
+    historical: tuple
+    latch_generation: int
+    reason: str
+    publishable: bool
+    features: int
+    exit_verified: bool
+
+
+@dataclass(frozen=True)
+class Receipt:
+    # A real receipt must also bind the transport proof and fresh challenge.
+    # This immutable plan represents that exact binding for transition tests.
+    plan: Plan
+    accepted: bool = True
+    published: bool = True
+
+
+class Policy:
+    def __init__(self, mode=Mode.NORMAL, boot="boot-a"):
+        self.mode = mode
+        self.boot = boot
+        self.request_boot = boot
+        self.revision = 0
+        self.latch_generation = 0
+        self.retained = {}
+        self.overflow = False
+        self.features = 0
+        self.publication = None
+        self.reason = "CHECKING"
+        self.pending = None
+        self.bound = None
+        self.last_serial = 0
+        self.last_sequence = 0
+        self.retired_notices = set()
+        self.seen = {}
+        self.permit_completed = None
+
+    @property
+    def protected(self):
+        return self.mode in (Mode.COMPROMISE, Mode.EXIT)
+
+    def invalidate(self, reason):
+        self.revision += 1
+        self.features = 0
+        self.permit_completed = None
+        self.publication = None
+        self.pending = None
+        self.reason = reason
+
+    def retain(self, findings, evidence=None):
+        if not self.protected:
+            return
+        for finding in findings:
+            if finding in self.retained:
+                continue
+            if len(self.retained) >= 512:
+                if not self.overflow:
+                    self.overflow = True
+                    self.latch_generation += 1
+                continue
+            self.retained[finding] = Retained(
+                finding, evidence.identities if evidence else (),
+                evidence.sequence if evidence else 0,
+                evidence.serial if evidence else 0)
+            self.latch_generation += 1
+
+    def fault(self, kind):
+        """Confirmed local timeout/disconnect, not a pending handshake."""
+        if self.bound is not None:
+            self.retired_notices.add(self.bound[4])
+        self.invalidate(kind)
+        self.retain((Finding(kind),))
+        self.bound = None
+
+    def request_mode(self, compromise, persist_ok=True):
+        self.invalidate("RESTART_REQUIRED")
+        if not persist_ok:
+            self.reason = "PERSISTENCE_FAILED"
+            return False
+        self.mode = Mode.ENTER if compromise else Mode.EXIT
+        self.request_boot = self.boot
+        return True
+
+    def reboot(self, boot):
+        if boot == self.boot:
+            raise ValueError("reboot requires a new boot identity")
+        self.invalidate("CHECKING")
+        self.boot = boot
+        if self.mode == Mode.ENTER:
+            self.mode = Mode.COMPROMISE
+        self.bound = None
+        self.last_serial = self.last_sequence = 0
+
+    def prepare(self, evidence, now):
+        self.invalidate("CHECKING")
+        if not evidence.baseline_verified:
+            # This models a locally confirmed verification failure, not an
+            # unauthenticated remote field asserting that a signature is bad.
+            self.fault("BASELINE_INVALID")
+            return None
+        if (evidence.boot != self.boot
+                or not all(evidence.identities) or evidence.serial <= 0
+                or evidence.sequence < 0 or now < evidence.completed_ms
+                or now - evidence.completed_ms >= 2000):
+            self.reason = "INVALID_OR_STALE_EVIDENCE"
+            return None
+        if evidence.notice in self.retired_notices:
+            self.reason = "NEW_NOTIFICATION_BINDING_REQUIRED"
+            return None
+        stream = (evidence.boot, evidence.collector, evidence.classifier, evidence.baseline)
+        previous = self.seen.get(stream)
+        if previous and (evidence.serial <= previous[0] or evidence.sequence < previous[1]):
+            self.reason = "REGRESSED_EVIDENCE"
+            return None
+        if self.bound == evidence.identities:
+            if evidence.serial <= self.last_serial or evidence.sequence < self.last_sequence:
+                self.reason = "REGRESSED_EVIDENCE"
+                return None
+        elif self.bound is not None:
+            # Never transparently accept a new authority/endpoint instance.
+            self.fault("INSTANCE_CHANGED")
+            return None
+        if not evidence.endpoints_confirmed:
+            self.reason = "ENDPOINTS_UNCONFIRMED"
+            return None
+        self.bound = evidence.identities
+        self.last_serial, self.last_sequence = evidence.serial, evidence.sequence
+        self.seen[stream] = (evidence.serial, evidence.sequence)
+        scope = "union" if self.mode in (Mode.COMPROMISE, Mode.EXIT) else "official"
+        findings = evidence.union if scope == "union" else evidence.official
+        if findings is None:
+            self.reason = "REFERENCE_UNAVAILABLE"
+            return None
+        self.retain(findings, evidence)
+        historical = tuple(sorted(f.module for f in self.retained if f.module))
+        # Incomplete coverage cannot generate a normal empty proc view. A valid
+        # observation can still receive a diagnostic ACK, with features zero.
+        measured_complete = evidence.coverage_complete and evidence.collection_consistent
+        syscall_history_unrepresented = (any(f.kind == "SYSCALL_CHANGED" for f in self.retained)
+                                         and not any(f.kind == "SYSCALL_CHANGED" for f in findings))
+        publishable = measured_complete and not syscall_history_unrepresented
+        waiting = self.mode == Mode.ENTER or (
+            self.mode == Mode.EXIT and self.boot == self.request_boot)
+        exit_verified = (self.mode == Mode.EXIT and not waiting and measured_complete
+                         and evidence.official == () and evidence.endpoints_stopped)
+        latched = bool(self.retained) or self.overflow
+        features = 0
+        if waiting:
+            reason = "RESTART_REQUIRED"
+        elif not measured_complete:
+            reason = "COVERAGE_INCOMPLETE"
+        elif findings:
+            reason = "CURRENT_ANOMALY"
+        elif latched and not exit_verified:
+            reason = "LATCHED_ANOMALY"
+        elif self.mode == Mode.EXIT:
+            reason = "EXIT_VERIFIED" if exit_verified else "STOP_UNCONFIRMED"
+        elif not evidence.endpoints_stopped:
+            reason = "STOP_UNCONFIRMED"
+        else:
+            features = 2 if self.mode == Mode.COMPROMISE else 7
+            reason = "COMPROMISE_READY" if features == 2 else "NORMAL_READY"
+        if exit_verified:
+            # Official recovery ACK is separate from the still-effective union
+            # publication policy; it cannot use union cleanliness for exit.
+            scope, historical, publishable = "official", (), False
+        plan = Plan(self.revision, evidence, scope, historical,
+                    self.latch_generation, reason, publishable, features, exit_verified)
+        self.pending = plan
+        self.reason = reason
+        return plan
+
+    def commit(self, receipt, now, persist_ok=True):
+        plan = self.pending
+        if (plan is None or receipt.plan != plan or plan.revision != self.revision
+                or plan.latch_generation != self.latch_generation
+                or not receipt.accepted or receipt.published != plan.publishable
+                or now < plan.evidence.completed_ms
+                or now - plan.evidence.completed_ms >= 2000):
+            self.invalidate("COORDINATION_REJECTED")
+            return False
+        if self.protected and not persist_ok:
+            self.invalidate("PERSISTENCE_FAILED")
+            return False
+        self.pending = None
+        if plan.exit_verified:
+            # Atomic persistent exit precedes clearing. A following fresh
+            # normal observation/publication is required before granting seven.
+            self.mode = Mode.NORMAL
+            self.retained.clear()
+            self.overflow = False
+            self.latch_generation += 1
+            self.invalidate("NORMAL_RECHECK_REQUIRED")
+            return True
+        if plan.publishable:
+            current = evidence_names(plan.evidence, plan.scope)
+            # Compatibility projection only: full retention remains separate.
+            names = tuple(dict.fromkeys(plan.historical + current))[-10:]
+            self.publication = (names, now + 3000)
+        self.features = plan.features
+        self.permit_completed = plan.evidence.completed_ms
+        return True
+
+    def allowed(self, now):
+        if (self.permit_completed is None or now < self.permit_completed
+                or now - self.permit_completed >= 2000):
+            return 0
+        return self.features
+
+    def proc_names(self, now):
+        if self.publication is None or now >= self.publication[1]:
+            return None  # Unavailable, never an invented clean list.
+        return self.publication[0]
+
+
+def evidence_names(evidence, scope):
+    findings = evidence.union if scope == "union" else evidence.official
+    return tuple(f.module for f in findings if f.module)
