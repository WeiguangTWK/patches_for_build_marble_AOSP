index 0000000..c6dca3d
--- /dev/null
+++ b/libplatform_integrity_host/include/platform/fas_boot_record.h
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <platform/integrity_policy.h>
+#include <sys/random.h>
+#include <cerrno>
+
+namespace android::platform_integrity {
+
+constexpr char kFasDaemonBoot[] = "sys.integrity.fasd_boot";
+constexpr char kFasBackendBoot[] = "vendor.fas.integrity.boot";
+constexpr char kFasBootSeed[] = "2:unregistered:0:0";
+
+inline bool instanceId(std::string_view value) {
+    if (value.size() != 32) return false;
+    for (char c : value) if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
+    return true;
+}
+
+inline std::string randomInstance() {
+    unsigned char bytes[16];
+    size_t count = 0;
+    while (count < sizeof(bytes)) {
+        const ssize_t n = getrandom(bytes + count, sizeof(bytes) - count, 0);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return {};
+        count += static_cast<size_t>(n);
+    }
+    constexpr char hex[] = "0123456789abcdef";
+    std::string result;
+    for (unsigned char byte : bytes) {
+        result += hex[byte >> 4];
+        result += hex[byte & 15];
+    }
+    return result;
+}
+
+struct FasBootRecord {
+    std::string instance;
+    bool submitted = false;
+    bool interrupted = true;
+    bool valid = false;
+
+    static FasBootRecord parse(const std::string& value) {
+        if (value.size() != 38 || value.substr(0, 2) != "2:"
+                || value[34] != ':' || value[36] != ':'
+                || (value[35] != '0' && value[35] != '1')
+                || (value[37] != '0' && value[37] != '1')
+                || !instanceId(std::string_view(value).substr(2, 32))) return {};
+        return {value.substr(2, 32), value[35] == '1', value[37] == '1', true};
+    }
+    std::string encode() const {
+        return "2:" + instance + ":" + (submitted ? "1" : "0")
+                + ":" + (interrupted ? "1" : "0");
+    }
+};
+
+// The caller owns one init-managed service and serializes its writes. A new
+// process must never replace the first instance or turn an existing record clean.
+inline bool registerFasInstance(const char* property, const std::string& instance) {
+    if (!instanceId(instance)) return false;
+    const std::string previous = android::base::GetProperty(property, "");
+    FasBootRecord next;
+    if (previous == kFasBootSeed) {
+        next = {instance, false, false, true};
+    } else {
+        next = FasBootRecord::parse(previous);
+        if (!next.valid) return false;
+        next.interrupted = true;
+    }
+    const std::string value = next.encode();
+    if (!android::base::SetProperty(property, value)
+            || android::base::GetProperty(property, "") != value) return false;
+    return next.instance == instance && !next.interrupted;
+}
+
+inline bool fasInstanceHealthy(const char* property, std::string_view instance) {
+    const auto record = FasBootRecord::parse(android::base::GetProperty(property, ""));
+    return record.valid && !record.interrupted && record.instance == instance;
+}
+
+inline bool recordFasSubmission(const char* property, const std::string& instance) {
+    auto record = FasBootRecord::parse(android::base::GetProperty(property, ""));
+    if (!record.valid || record.interrupted || record.instance != instance) return false;
+    record.submitted = true;
+    const std::string value = record.encode();
+    return android::base::SetProperty(property, value)
+            && android::base::GetProperty(property, "") == value;
+}
+
+}  // namespace android::platform_integrity
