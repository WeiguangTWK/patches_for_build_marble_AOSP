@@ -0,0 +1,349 @@
+# SPDX-License-Identifier: Apache-2.0
+import unittest
+from dataclasses import replace
+
+from model import Evidence, Finding, Mode, Policy, Receipt
+
+
+UNKNOWN = Finding("UNKNOWN_MODULE", "unknown_ko")
+VERSION = Finding("UNAPPROVED_VERSION", "known_ko")
+COMMUNITY = Finding("UNAPPROVED_VERSION", "community_ko")
+
+
+class ModeContract(unittest.TestCase):
+    def apply(self, policy, evidence=None, now=101, persist_ok=True):
+        evidence = evidence or Evidence(boot=policy.boot)
+        plan = policy.prepare(evidence, now)
+        self.assertIsNotNone(plan)
+        ok = policy.commit(Receipt(plan, published=plan.publishable), now, persist_ok)
+        return ok, plan
+
+    def test_official_normal_grants_seven_after_receipt_only(self):
+        p = Policy()
+        plan = p.prepare(Evidence(), 101)
+        self.assertEqual(p.allowed(101), 0)
+        self.assertTrue(p.commit(Receipt(plan), 102))
+        self.assertEqual(p.allowed(102), 7)
+        self.assertEqual(p.proc_names(102), ())
+
+    def test_community_only_version_is_not_official(self):
+        p = Policy()
+        self.apply(p, Evidence(official=(COMMUNITY,), union=()))
+        self.assertEqual(p.features, 0)
+        self.assertFalse(p.retained)
+        self.assertEqual(p.proc_names(102), ("community_ko",))
+
+    def test_official_in_compromise_only_grants_fas(self):
+        p = Policy(Mode.COMPROMISE)
+        self.apply(p)
+        self.assertEqual(p.features, 2)
+
+    def test_approved_community_filtered_only_in_compromise(self):
+        p = Policy(Mode.COMPROMISE)
+        self.apply(p, Evidence(official=(COMMUNITY,), union=()))
+        self.assertEqual(p.features, 2)
+        self.assertEqual(p.proc_names(102), ())
+
+    def test_normal_anomaly_can_recover_without_host_latch(self):
+        p = Policy()
+        self.apply(p, Evidence(official=(UNKNOWN,)))
+        self.assertEqual(p.features, 0)
+        self.apply(p, Evidence(serial=2, sequence=2))
+        self.assertEqual(p.features, 7)
+        self.assertFalse(p.retained)
+
+    def test_raw_history_anomaly_still_blocks_normal(self):
+        p = Policy()
+        self.apply(p, Evidence(official=(UNKNOWN,)))
+        self.apply(p, Evidence(serial=2, sequence=2, official=(UNKNOWN,)))
+        self.assertFalse(p.retained)
+        self.assertEqual(p.features, 0)
+        self.assertEqual(p.proc_names(102), ("unknown_ko",))
+
+    def test_unknown_and_wrong_digest_both_latch_in_compromise(self):
+        for finding in (UNKNOWN, VERSION):
+            with self.subTest(finding=finding):
+                p = Policy(Mode.COMPROMISE)
+                self.apply(p, Evidence(union=(finding,)))
+                self.apply(p, Evidence(serial=2, sequence=2))
+                self.assertEqual(p.features, 0)
+                self.assertIn(finding, p.retained)
+                self.assertEqual(p.proc_names(102), (finding.module,))
+
+    def test_duplicate_findings_preserve_first_evidence(self):
+        p = Policy(Mode.COMPROMISE)
+        self.apply(p, Evidence(union=(UNKNOWN,)))
+        first = p.retained[UNKNOWN]
+        self.apply(p, Evidence(serial=2, sequence=5, union=(UNKNOWN,)))
+        self.assertEqual(p.latch_generation, 1)
+        self.assertEqual(p.retained[UNKNOWN], first)
+
+    def test_scalar_anomaly_is_not_a_fabricated_proc_module(self):
+        p = Policy(Mode.COMPROMISE)
+        self.apply(p, Evidence(union=(Finding("SYSCALL_CHANGED"),)))
+        self.assertEqual(p.features, 0)
