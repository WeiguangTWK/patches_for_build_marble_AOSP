--- a/private/adbd.te
+++ b/private/adbd.te
@@ -17,6 +17,8 @@ allow adbd adbd_tradeinmode:process dyntransition;
 
 userdebug_or_eng(`
   allow adbd su:process dyntransition;
+  allow adbd adbroot:binder call;
