+package com.android.server.pm;
+
+import static com.android.server.pm.PackageManagerServiceUtils.isSystemOrRootOrShell;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.annotation.UserIdInt;
+import android.content.Context;
+import android.content.pm.UserInfo;
+import android.database.ContentObserver;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.text.TextUtils;
+import android.util.ArraySet;
+import android.util.SparseArray;
+
+import com.android.server.LocalServices;
+import com.android.server.SystemService;
+import com.android.server.pm.pkg.PackageStateInternal;
+
+/**
+ * Tracks per-user app visibility overrides for hiding LineageOS packages.
+ *
+ * @hide
+ */
+public final class LineageAppVisibilityService extends SystemService {
+    private static final String LINEAGE_VISIBILITY_BLOCKED_PACKAGES_SETTING =
+            "lineage_visibility_blocked_packages";
+    private static final ArraySet<String> TARGET_PACKAGES = createTargetPackages();
+
+    private final Object mLock = new Object();
+    private final SparseArray<ArraySet<String>> mBlockedPackagesByUser = new SparseArray<>();
+    private final SettingsObserver mSettingsObserver;
+
+    private final UserManagerInternal.UserLifecycleListener mUserLifecycleListener =
+            new UserManagerInternal.UserLifecycleListener() {
+                @Override
+                public void onUserCreated(UserInfo user, @Nullable Object token) {
+                    invalidateBlockedPackages(user.id);
+                }
+
+                @Override
+                public void onUserRemoved(UserInfo user) {
+                    invalidateBlockedPackages(user.id);
+                }
+            };
+
+    private final LineageAppVisibilityManagerInternal mLocalService =
+            new LineageAppVisibilityManagerInternal() {
+                @Override
+                public boolean isLineageVisibilityTargetPackage(@Nullable String packageName) {
+                    return LineageAppVisibilityService.this
+                            .isLineageVisibilityTargetPackage(packageName);
+                }
+
+                @Override
+                public boolean shouldHideForCallingPackage(@Nullable String targetPackageName,
+                        @Nullable String callingPackage, int callingUid, @UserIdInt int userId) {
+                    if (!isLineageVisibilityTargetPackage(targetPackageName)) {
+                        return false;
+                    }
+                    if (!UserHandle.isApp(callingUid) || TextUtils.isEmpty(callingPackage)) {
+                        return false;
+                    }
+                    return getBlockedPackages(userId).contains(callingPackage);
+                }
+
+                @Override
+                public boolean shouldHideForCallingSetting(@Nullable String targetPackageName,
+                        @Nullable SettingBase callingSetting, int callingUid,
+                        @UserIdInt int userId) {
+                    if (!isLineageVisibilityTargetPackage(targetPackageName)) {
+                        return false;
+                    }
+                    if (isSystemOrRootOrShell(callingUid) || callingSetting == null) {
+                        return false;
+                    }
+                    final ArraySet<String> blockedPackages = getBlockedPackages(userId);
+                    if (blockedPackages.isEmpty()) {
+                        return false;
+                    }
+                    if (callingSetting instanceof PackageSetting) {
+                        return blockedPackages.contains(
+                                ((PackageSetting) callingSetting).getPackageName());
+                    }
+                    if (callingSetting instanceof SharedUserSetting) {
+                        @SuppressWarnings("unchecked")
+                        final ArraySet<PackageStateInternal> packageStates =
+                                (ArraySet<PackageStateInternal>)
+                                        ((SharedUserSetting) callingSetting).getPackageStates();
+                        for (int i = packageStates.size() - 1; i >= 0; i--) {
+                            if (blockedPackages.contains(
+                                    packageStates.valueAt(i).getPackageName())) {
+                                return true;
+                            }
+                        }
+                    }
+                    return false;
+                }
+            };
+
+    public LineageAppVisibilityService(Context context) {
+        super(context);
+        mSettingsObserver = new SettingsObserver(new Handler(context.getMainLooper()));
+    }
+
+    @Override
+    public void onStart() {
+        getContext().getContentResolver().registerContentObserver(
+                Settings.Secure.getUriFor(LINEAGE_VISIBILITY_BLOCKED_PACKAGES_SETTING),
+                false,
+                mSettingsObserver,
+                UserHandle.USER_ALL);
+        LocalServices.getService(UserManagerInternal.class)
+                .addUserLifecycleListener(mUserLifecycleListener);
+        publishLocalService(LineageAppVisibilityManagerInternal.class, mLocalService);
+    }
+
+    private boolean isLineageVisibilityTargetPackage(@Nullable String packageName) {
+        return packageName != null && TARGET_PACKAGES.contains(packageName);
+    }
+
+    @NonNull
+    private ArraySet<String> getBlockedPackages(@UserIdInt int userId) {
+        synchronized (mLock) {
+            final ArraySet<String> cached = mBlockedPackagesByUser.get(userId);
+            if (cached != null) {
+                return cached;
+            }
+            final ArraySet<String> loaded = loadBlockedPackages(userId);
+            mBlockedPackagesByUser.put(userId, loaded);
+            return loaded;
+        }
+    }
+
+    @NonNull
+    private ArraySet<String> loadBlockedPackages(@UserIdInt int userId) {
+        final String value = Settings.Secure.getStringForUser(
+                getContext().getContentResolver(),
+                LINEAGE_VISIBILITY_BLOCKED_PACKAGES_SETTING,
+                userId);
+        final ArraySet<String> packages = new ArraySet<>();
+        if (TextUtils.isEmpty(value)) {
+            return packages;
+        }
+        final String[] packageNames = value.split(",");
+        for (int i = 0; i < packageNames.length; i++) {
+            final String packageName = packageNames[i].trim();
+            if (!packageName.isEmpty()) {
+                packages.add(packageName);
+            }
+        }
+        return packages;
+    }
+
+    private void invalidateBlockedPackages(@UserIdInt int userId) {
+        synchronized (mLock) {
+            mBlockedPackagesByUser.remove(userId);
+        }
+    }
+
+    private void invalidateAllBlockedPackages() {
+        synchronized (mLock) {
+            mBlockedPackagesByUser.clear();
+        }
+    }
+
+    @NonNull
+    private static ArraySet<String> createTargetPackages() {
+        final ArraySet<String> packages = new ArraySet<>();
+        packages.add("org.lineageos.updater");
+        packages.add("org.lineageos.jelly");
+        packages.add("org.lineageos.aperture");
+        packages.add("org.lineageos.recorder");
+        packages.add("org.lineageos.etar");
+        packages.add("org.lineageos.twelve");
+        packages.add("org.lineageos.glimpse");
+        packages.add("org.lineageos.lineageparts");
+        packages.add("org.lineageos.profiles");
+        packages.add("org.lineageos.backgrounds");
+        packages.add("org.lineageos.camelot");
+        packages.add("org.lineageos.lineagesettings");
+        packages.add("org.lineageos.setupwizard");
+        packages.add("org.lineageos.audiofx");
+        packages.add("org.lineageos.overlay.customization.blacktheme");
+        packages.add("lineageos.platform");
+        packages.add("lineageos.platform.overlay.xiaomi");
+        packages.add("org.lineageos.aperture.frameworksbaseoverlay");
+        packages.add("org.lineageos.aperture.overlay.marble");
+        packages.add("org.lineageos.glimpse.frameworksbaseoverlay");
+        packages.add("org.lineageos.overlay.font.googlesansflex");
+        packages.add("org.lineageos.qtitelephony.compat");
+        packages.add("org.lineageos.settingsconfig");
+        packages.add("co.aospa.sense");
+        packages.add("org.protonaosp.deviceconfig");
+        packages.add("org.lineageos.dspvolume.xiaomi");
+        return packages;
+    }
+
+    private final class SettingsObserver extends ContentObserver {
+        SettingsObserver(Handler handler) {
+            super(handler);
+        }
+
+        @Override
+        public void onChange(boolean selfChange, Uri uri, int userId) {
+            if (userId == UserHandle.USER_ALL) {
+                invalidateAllBlockedPackages();
+            } else {
+                invalidateBlockedPackages(userId);
+            }
+        }
+    }
+}
