+package com.android.server.pm;
+
+import android.annotation.Nullable;
+import android.annotation.UserIdInt;
+
+/**
+ * Internal visibility policy for hiding LineageOS packages from selected callers.
+ *
+ * @hide
+ */
+public abstract class LineageAppVisibilityManagerInternal {
+
+    public abstract boolean isLineageVisibilityTargetPackage(@Nullable String packageName);
+
+    public abstract boolean shouldHideForCallingPackage(@Nullable String targetPackageName,
+            @Nullable String callingPackage, int callingUid, @UserIdInt int userId);
+
+    public abstract boolean shouldHideForCallingSetting(@Nullable String targetPackageName,
+            @Nullable SettingBase callingSetting, int callingUid, @UserIdInt int userId);
+}
